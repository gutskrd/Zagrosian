---
import SplitText from './SplitText.astro';
import Sun from './Sun.astro';
import { home } from '../site';
---

<section class="motto section" aria-labelledby="motto-title">
  <div class="container motto__inner">
    <div class="motto__sun" data-spin>
      <Sun />
    </div>
    <SplitText id="motto-title" class="motto__text kurdish" lang="ku" text={home.motto.ku} />
    <p class="motto__translation lead" data-reveal>{home.motto.en}</p>
  </div>
</section>

<style>
  .motto__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .motto__sun {
    font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  /* The motto is set in system serifs, whose widths vary by device. Sizes allow
     for the widest likely fallback (DejaVu Serif): "kurdî xweştire." is at most
     7.5em wide, the whole line at most 11.5em. Phones get two lines, wider
     screens one. */
  .motto__text {
    font-size: calc((100vw - 2 * var(--gutter)) / 7.8);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }

  @media (min-width: 48rem) {
    .motto__text {
      font-size: min(var(--text-display), calc((min(100vw, var(--container)) - 2 * var(--gutter)) / 11.8));
    }
  }

  .motto__translation {
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    color: var(--color-muted);
  }
</style>
