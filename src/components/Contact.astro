---
import Arrow from './Arrow.astro';
import type { ContactRoute } from '../site';

interface Props {
  routes: ContactRoute[];
}

const { routes } = Astro.props;
---

<section id="contact" class="contact section" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact__intro" data-reveal>
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title" class="heading-2 contact__title">Get in touch.</h2>
      <p class="contact__text lead">Choose the address that best fits your message.</p>
    </div>

    <ul class="contact__list">
      {
        routes.map((route) => (
          <li class="contact__item" data-reveal>
            <h3 class="contact__label">{route.label}</h3>
            <p class="contact__description">{route.description}</p>
            <div class="contact__address">
              <a class="contact__email" href={`mailto:${route.email}`}>
                <span>{route.email}</span>
                <Arrow class="contact__arrow" />
              </a>
              {/* Shown by script only where the Clipboard API is available. */}
              <button class="contact__copy" type="button" data-copy={route.email} aria-label={`Copy ${route.email}`} hidden>
                <svg class="contact__icon contact__icon--copy" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <rect x="5.25" y="5.25" width="8" height="8" rx="1.75" />
                  <path d="M10.75 5.25V4.5a1.75 1.75 0 0 0-1.75-1.75H4.5A1.75 1.75 0 0 0 2.75 4.5V9a1.75 1.75 0 0 0 1.75 1.75h.75" />
                </svg>
                <svg class="contact__icon contact__icon--done" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <path d="M3 8.5 6.5 12 13 4.5" />
                </svg>
              </button>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="visually-hidden" role="status" data-copy-status></p>

    <p class="contact__note" data-reveal>
      Found a security issue? Read our <a href="/security">security policy</a>.
    </p>
  </div>
</section>

<style>
  .contact__title {
    margin-top: 1.25rem;
  }

  .contact__text {
    margin-top: 1.25rem;
  }

  .contact__list {
    display: grid;
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .contact__item {
    display: grid;
    align-content: start;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--color-line);
  }

  .contact__label {
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.011em;
  }

  .contact__description {
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .contact__address {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .contact__email {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    min-height: 2.75rem;
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .contact__email span {
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition: text-decoration-color 0.25s ease;
  }

  .contact__email:hover span {
    text-decoration-color: currentColor;
  }

  .contact__email :global(.contact__arrow) {
    transition: transform 0.4s var(--ease-out);
  }

  .contact__email:hover :global(.contact__arrow) {
    transform: translateX(3px);
  }

  .contact__copy {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.625rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  /* Hover only on devices with a real pointer; on touch screens it would stick after a tap. */
  @media (hover: hover) {
    .contact__copy:hover {
      background: var(--color-surface);
      color: var(--color-ink);
    }
  }

  .contact__icon {
    grid-area: 1 / 1;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity 0.2s ease,
      transform 0.3s var(--ease-out);
  }

  .contact__icon--done,
  .contact__copy[data-copied] .contact__icon--copy {
    opacity: 0;
    transform: scale(0.6);
  }

  .contact__copy[data-copied] {
    color: var(--color-ink);
  }

  .contact__copy[data-copied] .contact__icon--done {
    opacity: 1;
    transform: none;
  }

  .contact__note {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .contact__note a {
    color: var(--color-ink);
    text-decoration-color: var(--color-underline);
  }

  .contact__note a:hover {
    text-decoration-color: currentColor;
  }

  @media (min-width: 40rem) {
    .contact__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }
  }

  @media (min-width: 64rem) {
    .contact__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .contact__item:nth-child(3n + 2) {
      --reveal-delay: 0.08s;
    }

    .contact__item:nth-child(3n + 3) {
      --reveal-delay: 0.16s;
    }
  }
</style>
