---
/**
 * The 21-ray sun of the Kurdish flag, in the colour of the text, drawn from
 * its geometry (src/lib/sun.ts), so it is sharp at any size. Decorative, so it
 * is hidden from screen readers.
 */
import { sunPath } from '../lib/sun';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={['sun', className]} viewBox="-100 -100 200 200" aria-hidden="true" focusable="false">
  <path d={sunPath}></path>
</svg>

<style>
  .sun {
    display: block;
    flex: none;
    width: 1em;
    height: 1em;
    fill: currentColor;
  }
</style>
