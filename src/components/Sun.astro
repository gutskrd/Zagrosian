---
/**
 * The 21-ray sun, from the original artwork: black in the light theme, white in
 * the dark one. Both are tiny, so both are in the page and CSS shows the right
 * one. Decorative, so it has no alternative text.
 */
import sunBlack from '../assets/brand/sun-black-64.png';
import sunWhite from '../assets/brand/sun-white-64.png';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['sun', className]}>
  <img class="sun__light" src={sunBlack.src} width={sunBlack.width} height={sunBlack.height} alt="" loading="lazy" decoding="async" />
  <img class="sun__dark" src={sunWhite.src} width={sunWhite.width} height={sunWhite.height} alt="" loading="lazy" decoding="async" />
</span>

<style>
  .sun {
    display: block;
    flex: none;
    width: 1em;
    height: 1em;
  }

  .sun img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .sun__dark,
  :global(:root[data-theme='dark']) .sun__light {
    display: none;
  }

  :global(:root[data-theme='dark']) .sun__dark {
    display: block;
  }
</style>
