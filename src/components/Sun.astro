---
/**
 * The 21-ray sun, from the original artwork: black on light surfaces, white on
 * dark ones. Decorative, so it has no alternative text.
 */
import sunBlack from '../assets/brand/sun-black-64.png';
import sunWhite from '../assets/brand/sun-white-64.png';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<picture class:list={['sun', className]}>
  <source srcset={sunWhite.src} media="(prefers-color-scheme: dark)" />
  <img src={sunBlack.src} width={sunBlack.width} height={sunBlack.height} alt="" loading="lazy" decoding="async" />
</picture>

<style>
  .sun {
    display: block;
    flex: none;
    width: 1em;
    height: 1em;
  }

  .sun img {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
