---
/**
 * The 21-ray sun. Drawn as a vector so it stays sharp at any size and takes
 * the colour of the surrounding text.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const RAYS = 21;
const OUTER = 48;
const INNER = 24.37;

const points = Array.from({ length: RAYS * 2 }, (_, i) => {
  const radius = i % 2 === 0 ? OUTER : INNER;
  const angle = -Math.PI / 2 + (i * Math.PI) / RAYS;
  return `${(50 + radius * Math.cos(angle)).toFixed(2)} ${(50 + radius * Math.sin(angle)).toFixed(2)}`;
});
---

<svg
  class:list={['sun', className]}
  viewBox="0 0 100 100"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d={`M${points.join('L')}Z`}></path>
</svg>

<style>
  .sun {
    flex: none;
    width: 1em;
    height: 1em;
  }
</style>
