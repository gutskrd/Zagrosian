---
/**
 * Book contents, each entry linking to its starting page: the front matter (passport, alphabet,
 * people of the road, as in the book's own contents page), every chapter (number, Kurmanji title,
 * localized name, CEFR level and its four parts), then the answers, glossary and author's note.
 *
 * As a page section ("Inside the book") it serves everyone, including without JS, where each link
 * opens the page in the column layout. As a menu (the reader's Contents) it's the same list,
 * compact; the reader marks the current chapter (`aria-current`) and turns to the selected one.
 */
import { i18n, format } from '../i18n';
import { chapterName, chapters, formatNumber, sections, type SectionKey } from '../lib/book';

interface Props {
  variant: 'section' | 'menu';
}

const { variant } = Astro.props;
const { locale, t } = i18n(Astro.url);

const matter = (keys: SectionKey[]) =>
  keys.map((key) => sections.find((section) => section.key === key)!).filter(Boolean);
const front = matter(['passport', 'alphabet', 'people']);
const back = matter(['answers', 'words', 'author']);
const pageNumber = (n: number) => format(t.book.pageLabel, { n: formatNumber(locale, n) });
// In Kurmanji the chapter name is the title, already shown.
const named = (name: string, titleKu: string) => name !== titleKu;
const Title = variant === 'section' ? 'h3' : 'span';
---

<ol class:list={['contents', `contents--${variant}`]} data-book-contents={variant}>
  {
    front.map((section) => (
      <li class="contents__matter">
        <a class="contents__link" href={`#page-${section.start}`} data-book-jump={section.start}>
          <span class="contents__name">{t.book.sections[section.key]}</span>
          <span class="contents__page" aria-hidden="true">{formatNumber(locale, section.start)}</span>
          <span class="visually-hidden">{pageNumber(section.start)}</span>
        </a>
      </li>
    ))
  }
  {
    chapters.map((chapter) => {
      const name = chapterName(locale, chapter);
      return (
        <li class="contents__chapter">
          <Title class="contents__title">
            <a
              class="contents__link contents__link--chapter"
              href={`#page-${chapter.start}`}
              data-book-jump={chapter.start}
              data-book-chapter={chapter.number}
              data-start={chapter.start}
              data-end={chapter.end}
            >
              <span class="contents__number" aria-hidden="true">
                {formatNumber(locale, chapter.number)}
              </span>
              <span class="visually-hidden">{format(t.book.chapterLabel, { n: formatNumber(locale, chapter.number), name: '' }).replace(/[\s:：]+$/, '')}</span>
              <span class="contents__titles">
                <span class="contents__ku kurdish" lang="ku" dir="ltr">
                  {chapter.titleKu}
                </span>
                {named(name, chapter.titleKu) && <span class="contents__translation">{name}</span>}
              </span>
              <span class="contents__level" lang="en" dir="ltr">
                {chapter.cefr}
              </span>
              <span class="contents__page" aria-hidden="true">
                {formatNumber(locale, chapter.start)}
              </span>
              <span class="visually-hidden">{pageNumber(chapter.start)}</span>
            </a>
          </Title>
          {variant === 'section' && (
            <p class="contents__parts" lang="ku" dir="ltr">
              {chapter.parts.map((part, i) => (
                <>
                  {i > 0 && <span aria-hidden="true"> · </span>}
                  <span>{part.titleKu}</span>
                </>
              ))}
            </p>
          )}
        </li>
      );
    })
  }
  {
    back.map((section) => (
      <li class="contents__matter">
        <a class="contents__link" href={`#page-${section.start}`} data-book-jump={section.start}>
          <span class="contents__name">{t.book.sections[section.key]}</span>
          <span class="contents__page" aria-hidden="true">{formatNumber(locale, section.start)}</span>
          <span class="visually-hidden">{pageNumber(section.start)}</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .contents {
    display: grid;
    counter-reset: none;
  }

  .contents__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: baseline;
    column-gap: 0.875rem;
    min-height: 2.75rem;
    padding-block: 0.625rem;
    color: inherit;
    text-decoration: none;
  }

  .contents__matter .contents__link {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .contents__number {
    min-width: 1.5rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }

  .contents__titles {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.625rem;
    min-width: 0;
  }

  .contents__ku {
    font-size: 1.125em;
  }

  .contents__translation,
  .contents__level,
  .contents__page {
    color: var(--color-muted);
  }

  .contents__level {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  .contents__page {
    min-width: 2ch;
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  .contents__title {
    font: inherit;
  }

  /* Section variant: generous spacing, hairlines between chapters, parts listed under each. */
  .contents--section {
    border-top: 1px solid var(--color-line);
  }

  .contents--section > li {
    border-bottom: 1px solid var(--color-line);
  }

  .contents--section .contents__link {
    padding-block: 0.875rem;
  }

  .contents--section .contents__ku {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
  }

  .contents__parts {
    margin: -0.375rem 0 0.875rem;
    padding-inline-start: 2.375rem;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  :global([dir='rtl']) .contents__parts {
    text-align: right;
  }

  /* Menu variant: compact rows. */
  .contents--menu .contents__link {
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.625rem;
  }

  .contents--menu .contents__link[aria-current] {
    background: var(--color-surface);
  }

  @media (hover: hover) {
    .contents__link:hover .contents__ku,
    .contents__link:hover .contents__name {
      text-decoration: underline;
      text-decoration-color: var(--color-underline);
      text-underline-offset: 0.2em;
    }
  }

  .contents__link[aria-current] .contents__number {
    color: var(--color-ink);
  }
</style>
