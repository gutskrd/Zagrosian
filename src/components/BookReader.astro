---
/**
 * Hevalo's book to read on the page, as a book: the cover alone, then two
 * pages side by side where the screen is wide enough and one at a time where
 * it is not, turned like paper (src/scripts/book.ts, book-turn.ts and
 * book-zoom.ts).
 *
 * Everything is in the HTML from the start, in order: each of the book's
 * pages is an article with its number as a heading, its picture (alt="",
 * because its words follow it) and its words as text (BookPageText), Kurmanji
 * marked as such. Without JavaScript that is what the page shows: a column of
 * pages, loaded as they come into view. With it (the theme script marks the
 * page before the first paint, so the layout is final from the start), only
 * the pages open in front of the reader are displayed, so a screen reader
 * meets them and no others, and their pictures alone are downloaded.
 *
 * The stage describes the physical book and runs left to right in every
 * language: page 1 is on the right, the next page is to the right, and the
 * arrows and the slider under it point the way the pages go. The rest of the
 * controls follow the page's own direction.
 *
 * Styles are global (`is:global`): the reader builds the copies of pages it
 * turns with the DOM API, and they must be styled as the pages are.
 */
import { format, i18n } from '../i18n';
import { book, chapterName, chapters, formatNumber, pageSizes, pages, type BookPage } from '../lib/book';
import { hevalo, kurdish } from '../site';
import Arrow from './Arrow.astro';
import BookContents from './BookContents.astro';
import BookDownload from './BookDownload.astro';
import BookLeaf from './BookLeaf.astro';
import BookPageText from './BookPageText.astro';

const { locale, t } = i18n(Astro.url);

// The page's own digits, as the build writes numbers: the reader writes the numbers it changes with them.
const digits = Array.from({ length: 10 }, (_, d) => formatNumber(locale, d)).join('');

const label = (page: BookPage) => {
  if (page.chapter) return format(t.book.chapterLabel, { n: formatNumber(locale, page.chapter.number), name: chapterName(locale, page.chapter) });
  return page.section ? t.book.sections[page.section.key] : '';
};
const short = (page: BookPage) => (page.chapter ? `${formatNumber(locale, page.chapter.number)} · ${page.chapter.titleKu}` : label(page));
const heading = (page: BookPage) => {
  const number = format(t.book.pageLabel, { n: formatNumber(locale, page.n) });
  return page.opens ? `${number}. ${label(page)}` : number;
};
// The slider's chapter marks, by where each chapter begins along the book.
const marks = chapters.map((chapter) => ({ n: chapter.number, x: `${(((chapter.start - 1) / (book.pageCount - 1)) * 100).toFixed(2)}%` }));
---

<section
  class="book"
  id="reader"
  aria-labelledby="book-reader-title"
  data-book
  data-closed
  data-digits={digits}
  data-page-count={book.pageCount}
  data-counter-spread={t.book.counterSpread}
  data-counter-page={t.book.counterPage}
  data-counter-short={t.book.counterShort}
  data-status={t.book.status}
  data-end-title={t.book.endTitle}
  data-cover-label={t.book.sections.cover}
>
  <h2 id="book-reader-title" class="visually-hidden">{t.book.readerTitle}</h2>

  <div class="book__body">
  <div class="book__bar book__bar--start">
    <button class="book__button book__where" type="button" popovertarget="book-contents">
      <svg class="book__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3.5 5h13M3.5 10h13M3.5 15h8"></path></svg>
      <span class="visually-hidden">{t.book.contents}:</span>
      <span class="book__where-text" data-book-where>{t.book.sections.cover}</span>
      <svg class="book__chevron" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M3 4.5 6 7.5l3-3"></path></svg>
    </button>
  </div>

  <div class="book__bar book__bar--end">
    <button class="book__button book__button--round book__wide" type="button" data-book-zoom="out" aria-disabled="true">
      <svg class="book__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="8.5" cy="8.5" r="5.25"></circle><path d="M12.5 12.5l4 4M6 8.5h5"></path></svg>
      <span class="visually-hidden">{t.book.zoomOut}</span>
    </button>
    <button class="book__button book__button--round book__wide" type="button" data-book-zoom="in">
      <svg class="book__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="8.5" cy="8.5" r="5.25"></circle><path d="M12.5 12.5l4 4M6 8.5h5M8.5 6v5"></path></svg>
      <span class="visually-hidden">{t.book.zoomIn}</span>
    </button>
    <button class="book__button book__button--round book__wide" type="button" data-book-zoom="fit" aria-disabled="true">
      <svg class="book__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M7.5 3.5v4h-4M12.5 3.5v4h4M16.5 12.5h-4v4M3.5 12.5h4v4"></path></svg>
      <span class="visually-hidden">{t.book.fit}</span>
    </button>
    <button class="book__button book__text-toggle" type="button" aria-pressed="false" data-book-text-toggle>
      {/* a page of text, so it does not look like the contents' list */}
      <svg class="book__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M5.5 2.75h6.25l3 3v11.5H5.5zM11.75 2.75v3h3M8 9.5h4.5M8 12.25h4.5M8 15h2.75"></path></svg>
      <span class="book__label-text" aria-hidden="true">{t.book.textView}</span>
      <span class="visually-hidden">{t.book.textView}</span>
    </button>
    <button class="book__button book__full-toggle" type="button" aria-pressed="false" data-book-full-toggle>
      <svg class="book__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3.5 7.5v-4h4M12.5 3.5h4v4M16.5 12.5v4h-4M7.5 16.5h-4v-4"></path></svg>
      <span class="book__label-text" aria-hidden="true">{t.book.fullView}</span>
      <span class="visually-hidden">{t.book.fullView}</span>
    </button>
    <BookDownload variant="small" class="book__wide" />
    <BookDownload variant="icon" class="book__narrow" />
  </div>

  <div class="book__frame">
    <div class="book__stage" tabindex="0" role="group" aria-label={kurdish.book} aria-describedby="book-keys" dir="ltr" data-book-stage>
      <div class="book__spread" data-book-spread>
        <div class="book__edges" aria-hidden="true">
          <span class="book__edge book__edge--left"></span>
          <span class="book__edge book__edge--right"></span>
        </div>
        <ol class="book__pages" data-book-pages>
          {
            pages.map((page) => (
              <li
                id={`page-${page.n}`}
                class="book__page"
                data-n={page.n}
                data-side={page.side}
                data-chapter={page.chapter?.number}
                data-label={label(page)}
                data-short={short(page)}
                data-shown={page.n === 1 ? '' : undefined}
              >
                <article class="book__sheet" aria-labelledby={`page-${page.n}-title`}>
                  <h3 id={`page-${page.n}-title`} class="visually-hidden book__page-title">
                    {heading(page)}
                  </h3>
                  {page.opens && <span id={`chapter-${page.opens.number}`} class="book__anchor" />}
                  <div class="book__paper">
                    <img
                      src={page.images[720].src}
                      srcset={`${page.images[720].src} 720w, ${page.images[1440].src} 1440w`}
                      sizes={pageSizes}
                      width="720"
                      height={page.images[720].height}
                      alt=""
                      loading={page.n === 1 ? 'eager' : 'lazy'}
                      fetchpriority={page.n === 1 ? 'high' : undefined}
                      decoding="async"
                      draggable="false"
                    />
                  </div>
                  <div class="book__text visually-hidden" dir="ltr" lang="en">
                    <BookPageText blocks={page.blocks} />
                  </div>
                </article>
              </li>
            ))
          }
        </ol>
        <div class="book__end" data-book-end>
          <p class="book__end-title">{t.book.endTitle}</p>
          <BookDownload />
          <a class="book__end-link" href={hevalo.url}>
            {t.book.endLearn}
            <Arrow direction="up-right" />
          </a>
          <a class="book__end-link" href="#page-1" data-book-jump="1">
            {t.book.backToStart}
          </a>
        </div>
        <div class="book__leaves" aria-hidden="true" inert data-book-leaves>
          <div class="book__hold" data-hold="left"></div>
          <div class="book__hold" data-hold="right"></div>
          <div class="book__cast" data-book-cast></div>
          <BookLeaf />
          <BookLeaf />
          <BookLeaf />
        </div>
      </div>
      <div class="book__notice" role="alert" data-book-notice hidden>
        <p>{t.book.loadFailed}</p>
        <button class="book__button book__button--solid" type="button" data-book-reload>{t.book.reload}</button>
      </div>
    </div>
    <p id="book-keys" class="book__keys">{t.book.keysHint}</p>
  </div>

  <div class="book__bar book__bar--nav" dir="ltr">
    <button class="book__button book__button--round" type="button" data-book-prev aria-disabled="true">
      <Arrow direction="left" />
      <span class="visually-hidden">{t.book.previous}</span>
    </button>
    <div class="book__scrub" data-book-scrub>
      <svg class="book__marks" aria-hidden="true" focusable="false">
        {marks.map((mark) => <rect x={mark.x} y="0" width="1" height="100%" data-mark={mark.n} />)}
      </svg>
      <input
        class="book__range"
        type="range"
        dir="ltr"
        min="0"
        max={Math.ceil(book.pageCount / 2)}
        step="1"
        value="0"
        aria-label={t.book.slider}
        aria-valuetext={format(t.book.counterPage, { a: formatNumber(locale, 1), total: formatNumber(locale, book.pageCount) })}
        data-book-range
      />
      <span class="book__bubble" aria-hidden="true" data-book-bubble></span>
    </div>
    <p class="book__counter" aria-hidden="true" data-book-counter>
      <bdi class="book__counter-short" data-book-counter-short>{format(t.book.counterShort, { a: formatNumber(locale, 1), total: formatNumber(locale, book.pageCount) })}</bdi>
      <bdi class="book__counter-long" data-book-counter-long>{format(t.book.counterPage, { a: formatNumber(locale, 1), total: formatNumber(locale, book.pageCount) })}</bdi>
    </p>
    <button class="book__button book__button--round" type="button" data-book-next>
      <Arrow direction="right" />
      <span class="visually-hidden">{t.book.next}</span>
    </button>
    {/* For a moment on a touch screen, over the bar under the book: how to turn and zoom. */}
    <p class="book__hint" dir="auto" data-book-hint hidden>
      <span>{t.book.swipeHint}</span>
      <span>{t.book.zoomHint}</span>
    </p>
  </div>
  </div>

  <p class="visually-hidden" role="status" data-book-status></p>

  <nav id="book-contents" class="book__menu" popover aria-label={t.book.contents}>
    <div class="book__menu-head">
      <p class="book__menu-title">{t.book.contents}</p>
      <button class="book__button book__button--round" type="button" popovertarget="book-contents" popovertargetaction="hide">
        <svg class="book__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M5 5l10 10M15 5 5 15"></path></svg>
        <span class="visually-hidden">{t.common.close}</span>
      </button>
    </div>
    <BookContents variant="menu" />
    <div class="book__menu-foot">
      <BookDownload variant="small" />
    </div>
  </nav>
</section>

<script>
  import { initBook } from '../scripts/book';

  initBook();
</script>

<style is:global>
  /* ==========================================================================
     The reader (BookReader.astro)
     ========================================================================== */

  .book {
    /* A page is 419.53 by 595.28 points (A5): its width over its height. */
    --page-ratio: 0.70476;
    /* The book's own paper, under the pictures while they load. */
    --paper: #fbf6ec;
    /* What the bars outside the stage take of the screen's height. */
    --book-bars: 4.25rem;
    /* Room above and below the pages, for a leaf that grows as it comes nearer mid-turn. */
    --room-y: 1.75rem;
    /* The least the stage is tall, whatever the screen. */
    --stage-min: 360px;
    position: relative;
    container: reader / inline-size;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  /* ---- Without JavaScript: the pages in a column ---- */

  .book__stage {
    position: relative;
  }

  .book__stage:focus-visible {
    outline-offset: -2px;
  }

  .book__pages {
    display: grid;
    gap: 1.5rem;
    width: min(100% - 2rem, 45rem);
    margin-inline: auto;
  }

  .book__paper {
    position: relative;
    overflow: hidden;
    background: var(--paper);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.08),
      0 18px 40px -22px rgb(0 0 0 / 0.45);
  }

  .book__paper img {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* The paper in the dark theme: dimmed a little, never inverted. */
  :root[data-theme='dark'] .book__paper::after,
  :root[data-theme='dark'] .leaf__page::after,
  :root[data-theme='dark'] .book__hold-page::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0.12;
    pointer-events: none;
  }

  .book__end {
    display: grid;
    justify-items: start;
    align-content: center;
    gap: 1.25rem;
    width: min(100% - 2rem, 45rem);
    margin: 2.5rem auto 0;
  }

  .book__end-title {
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.875rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .book__end-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-weight: 500;
    text-decoration: none;
  }

  @media (hover: hover) {
    .book__end-link:hover {
      text-decoration: underline;
      text-decoration-color: var(--color-underline);
    }
  }

  .book__anchor {
    position: absolute;
  }

  .book__bar,
  .book__leaves,
  .book__edges,
  .book__keys {
    display: none;
  }

  /* ---- The book, paged (when the reader's script can run) ---- */

  :root[data-theme] .book:not([data-book='off']) {
    --book-bars: 6.5rem;
  }

  :root[data-theme] .book:not([data-book='off']) .book__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'start end'
      'stage stage'
      'nav nav';
    /* The keyboard goes through the bars and the book in the order they stand, in every layout below. */
    reading-flow: grid-rows;
  }

  :root[data-theme] .book:not([data-book='off']) .book__bar {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    min-width: 0;
    padding-inline: 1rem;
  }

  :root[data-theme] .book:not([data-book='off']) .book__bar--start {
    grid-area: start;
    height: 3.25rem;
  }

  :root[data-theme] .book:not([data-book='off']) .book__bar--end {
    grid-area: end;
    justify-content: flex-end;
    height: 3.25rem;
  }

  :root[data-theme] .book:not([data-book='off']) .book__bar--nav {
    position: relative;
    grid-area: nav;
    height: 3.25rem;
    gap: 0.5rem;
  }

  :root[data-theme] .book:not([data-book='off']) .book__frame {
    grid-area: stage;
    position: relative;
  }

  /* The stage: as tall as the screen leaves under the header and the bars,
     and a container, so the book is sized to it and two pages lie open
     where there is room for them. */
  :root[data-theme] .book:not([data-book='off']) .book__stage {
    display: flex;
    height: max(var(--stage-min), calc(100svh - var(--header-height) - var(--book-bars)));
    /* A turning leaf may reach a little past the stage, rather than be cut off flat. */
    overflow: clip;
    overflow-clip-margin: 1.5rem;
    container: book / size;
    touch-action: pan-y pinch-zoom;
    /* A sideways swipe on a trackpad turns a page (book.ts), never the browser's history. */
    overscroll-behavior-x: none;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }

  /* The focus is drawn round the pages open, not round the whole stage. */
  :root[data-theme] .book:not([data-book='off']) .book__stage:focus-visible {
    outline: none;
  }

  :root[data-theme] .book:not([data-book='off']) .book__spread::after {
    content: '';
    position: absolute;
    z-index: 3;
    inset: -0.5rem;
    /* closed, only the cover is there to be drawn round */
    inset-inline-start: calc(var(--page-w) * var(--book-spread) * var(--closed, 0) - 0.5rem);
    border-radius: 0.375rem;
    pointer-events: none;
    visibility: hidden;
  }

  :root[data-theme] .book[data-closed]:not([data-book='off']) {
    --closed: 1;
  }

  :root[data-theme] .book:not([data-book='off']) .book__stage:focus-visible .book__spread::after {
    outline: 2px solid var(--focus-ring);
    visibility: visible;
  }

  /* On a phone the stage hugs the page, so the bars sit close to it. */
  @container reader (max-width: 599.98px) {
    :root[data-theme] .book:not([data-book='off']) .book__stage {
      height: max(
        var(--stage-min),
        min(calc(100svh - var(--header-height) - var(--book-bars)), calc((100cqw - 2rem) / var(--page-ratio) + 2 * var(--room-y)))
      );
    }
  }

  :root[data-theme] .book:not([data-book='off']) .book__spread {
    --book-spread: 0;
    --page-h: calc(min(calc(100cqh - 2 * var(--room-y)), calc((100cqw - 2rem) / var(--page-ratio))) * var(--zoom, 1));
    --page-w: calc(var(--page-h) * var(--page-ratio));
    position: relative;
    flex: none;
    width: calc(var(--page-w) * (1 + var(--book-spread)));
    height: var(--page-h);
    margin: auto;
    transition: none;
  }

  /* A mouse can click a page to turn it. */
  @media (hover: hover) and (pointer: fine) {
    :root[data-theme] .book:not([data-book='off'], [data-zoom], [data-text]) .book__spread {
      cursor: pointer;
    }
  }

  /* Two pages side by side: where the stage is at least 600 pixels wide and wider than it is tall (on a phone on
     its side too, where it is not tall: each page is as tall as one alone would be). */
  @container book (min-width: 600px) and (min-aspect-ratio: 5/4) {
    :root[data-theme] .book:not([data-book='off']) .book__spread {
      --book-spread: 1;
      --page-h: calc(min(calc(100cqh - 2 * var(--room-y)), calc((100cqw - 4rem) / 2 / var(--page-ratio))) * var(--zoom, 1));
    }
  }

  /* The closed book: the cover alone, in the middle (it glides across as it opens). */
  :root[data-theme] .book[data-closed]:not([data-book='off']) .book__spread {
    transform: translateX(calc(var(--page-w) * var(--book-spread) * -0.5));
  }

  :root[data-theme] .book:not([data-book='off']) .book__pages {
    display: block;
    width: auto;
    margin: 0;
  }

  :root[data-theme] .book:not([data-book='off']) .book__page,
  :root[data-theme] .book:not([data-book='off']) .book__end {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--page-w);
    height: var(--page-h);
    margin: 0;
  }

  :root[data-theme] .book:not([data-book='off']) :is(.book__page[data-side='right'], .book__end) {
    left: calc(var(--page-w) * var(--book-spread));
  }

  :root[data-theme] .book:not([data-book='off']) :is(.book__page, .book__end):not([data-shown]) {
    display: none;
  }

  /* While a page turns, what is seen is drawn by the leaves and the copies under them; the pages stay readable to assistive technology. */
  :root[data-theme] .book[data-turning]:not([data-book='off']) :is(.book__page, .book__end) {
    opacity: 0;
  }

  :root[data-theme] .book:not([data-book='off']) .book__sheet,
  :root[data-theme] .book:not([data-book='off']) .book__paper {
    height: 100%;
  }

  :root[data-theme] .book:not([data-book='off']) .book__paper img {
    height: 100%;
    object-fit: cover;
  }

  /* The fold in the middle: each page darkens a little towards the spine. */
  :root[data-theme] .book:not([data-book='off']) .book__paper::before {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
  }

  :root[data-theme] .book:not([data-book='off']) .book__page[data-side='left'] .book__paper::before {
    background: linear-gradient(to left, rgb(0 0 0 / 0.16), rgb(0 0 0 / 0.04) 4%, transparent 9%);
  }

  :root[data-theme] .book:not([data-book='off']) .book__page[data-side='right'] .book__paper::before,
  .book__end::before {
    background: linear-gradient(to right, rgb(0 0 0 / 0.14), rgb(0 0 0 / 0.03) 4%, transparent 9%);
  }

  /* The closing card is a page of the book: its paper and its dark ink, in either theme (and dimmed like the pages in
     the dark one). */
  :root[data-theme] .book:not([data-book='off']) .book__end,
  .leaf__page .book__end,
  .book__hold-page .book__end {
    --color-ink: #1f1c17;
    --color-ink-soft: #3e3a33;
    --color-muted: #5f594f;
    --color-paper: var(--paper);
    --color-line: #e6dcc8;
    --color-line-strong: #d3c7af;
    --color-underline: #b2a68f;
    --color-surface: #f1e8d6;
    --color-solid-hover: #3b372f;
    --focus-ring: #1f1c17;
    background: var(--paper);
    color: var(--color-ink);
  }

  :root[data-theme] .book:not([data-book='off']) .book__end {
    align-content: center;
    padding: clamp(1.5rem, 8%, 3rem);
    box-shadow: 0 18px 40px -22px rgb(0 0 0 / 0.45);
  }

  :root[data-theme='dark'] .book:not([data-book='off']) .book__end::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0.12;
    pointer-events: none;
  }

  :root[data-theme] .book:not([data-book='off']) .book__end::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* The edges of the pages read and still to read, at the book's outer sides. */
  :root[data-theme] .book:not([data-book='off']) .book__edges {
    display: block;
  }

  .book__edge {
    position: absolute;
    top: 0.25rem;
    bottom: 0.25rem;
    width: 0.375rem;
    background: repeating-linear-gradient(90deg, #e9e1d0 0 1px, #f7f1e4 1px 2px);
    box-shadow: 0 10px 24px -14px rgb(0 0 0 / 0.5);
  }

  /* dimmed in the dark theme, as the pages are */
