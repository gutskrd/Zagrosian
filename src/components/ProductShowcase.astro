---
import SplitText from './SplitText.astro';
import Cta from './Cta.astro';
import HevaloIcon from './HevaloIcon.astro';
import type { Product } from '../site';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const id = product.name.toLowerCase();
const domain = new URL(product.url).hostname;
---

<section id={id} class="showcase inverse" aria-labelledby={`${id}-title`}>
  <div class="container">
    <p class="eyebrow" data-reveal>Products</p>

    <div class="showcase__body">
      <div class="showcase__identity">
        <div class="showcase__icon" data-reveal>
          <HevaloIcon sizes="(min-width: 64rem) 96px, 72px" />
        </div>
        <SplitText id={`${id}-title`} class="showcase__name" text={product.name} />
        <p class="showcase__byline" data-reveal>{product.category}</p>
      </div>

      <div class="showcase__details" data-reveal>
        <p class="showcase__description">{product.description}</p>
        <Cta href={product.url} variant="inverse">Visit {domain}</Cta>
      </div>
    </div>

    <div class="showcase__soon rule" data-reveal>
      <div class="showcase__soon-heading">
        <p class="showcase__status"><span class="status-dot" aria-hidden="true"></span>Coming soon</p>
        <h3 class="showcase__soon-title">{product.name} for {product.availability.comingSoon.join(' and ')}.</h3>
      </div>
      <p class="showcase__soon-text">{product.availability.comingSoonNote}</p>
    </div>
  </div>
</section>

<style>
  .showcase {
    padding-block: var(--section-space) clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  .showcase__body {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 4.5rem);
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
  }

  /* The app icon, with a soft glow in its own colour. */
  .showcase__icon {
    width: clamp(4.5rem, 3.5rem + 2.5vw, 6rem);
    margin-bottom: clamp(1.75rem, 1rem + 2vw, 2.75rem);
  }

  .showcase__icon :global(.hevalo-icon) {
    display: block;
    width: 100%;
    filter: drop-shadow(0 0.75rem 2rem rgb(118 104 230 / 0.35));
  }

  .showcase__name {
    font-size: clamp(4.5rem, 1.75rem + 13vw, 13.5rem);
    font-weight: 600;
    line-height: 0.86;
    letter-spacing: -0.055em;
    /* Optical alignment: the H's stem sits slightly inside the text box. */
    margin-left: -0.05em;
  }

  .showcase__byline {
    margin-top: 1.5rem;
    font-size: var(--text-lead);
    letter-spacing: -0.011em;
    color: var(--color-night-muted);
  }

  .showcase__details {
    display: grid;
    justify-items: start;
    gap: 2rem;
  }

  .showcase__description {
    max-width: 28rem;
    font-size: var(--text-lead);
    line-height: 1.45;
    letter-spacing: -0.011em;
  }

  .showcase__soon {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(5rem, 3rem + 7vw, 9rem);
    padding-top: clamp(2rem, 1.5rem + 1.5vw, 3rem);
    --rule-color: var(--color-night-line);
  }

  .showcase__status {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-night-muted);
  }

  .showcase__soon-title {
    margin-top: 0.875rem;
    font-size: clamp(1.875rem, 1.3rem + 2.4vw, 3.5rem);
    font-weight: 560;
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .showcase__soon-text {
    max-width: 28rem;
    color: var(--color-night-muted);
  }

  @media (min-width: 64rem) {
    .showcase__body {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
      column-gap: 2rem;
    }

    .showcase__identity {
      grid-column: 1 / span 7;
    }

    .showcase__details {
      --reveal-delay: 0.12s;
      grid-column: 8 / -1;
      padding-bottom: 0.25rem;
    }

    .showcase__soon {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      align-items: end;
    }

    .showcase__soon-heading {
      grid-column: 1 / span 7;
    }

    .showcase__soon-text {
      grid-column: 8 / -1;
    }
  }
</style>
