---
import Arrow from './Arrow.astro';
import SplitText from './SplitText.astro';
import Cta from './Cta.astro';
import { site, type Product } from '../site';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const id = product.name.toLowerCase();
const domain = new URL(product.url).hostname;
---

<section id={id} class="showcase inverse" aria-labelledby={`${id}-title`}>
  <div class="container">
    <p class="eyebrow" data-reveal>Products</p>

    <div class="showcase__body">
      <div class="showcase__identity">
        <SplitText id={`${id}-title`} class="showcase__name" text={product.name} />
        <p class="showcase__byline" data-reveal>A product by {site.name}</p>
      </div>

      <div class="showcase__details" data-reveal>
        <p class="showcase__description">{product.description}</p>
        <Cta href={product.url} variant="inverse">Visit {product.name}</Cta>
      </div>
    </div>

    <dl class="showcase__facts rule" data-reveal>
      <div>
        <dt>Category</dt>
        <dd>{product.category}</dd>
      </div>
      <div>
        <dt>Company</dt>
        <dd>{site.name}</dd>
      </div>
      <div>
        <dt>Website</dt>
        <dd>
          <a class="showcase__link" href={product.url}>
            {domain}
            <Arrow direction="up-right" />
          </a>
        </dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .showcase {
    padding-block: var(--section-space) clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  .showcase__body {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 4.5rem);
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .showcase__name {
    font-size: clamp(4.5rem, 1.75rem + 13vw, 13.5rem);
    font-weight: 600;
    line-height: 0.86;
    letter-spacing: -0.055em;
    /* Optical alignment: the H's stem sits slightly inside the text box. */
    margin-left: -0.05em;
  }

  .showcase__byline {
    margin-top: 1.5rem;
    font-size: var(--text-lead);
    letter-spacing: -0.011em;
    color: var(--color-night-muted);
  }

  .showcase__details {
    display: grid;
    justify-items: start;
    gap: 2rem;
  }

  .showcase__description {
    max-width: 28rem;
    font-size: var(--text-lead);
    line-height: 1.45;
    letter-spacing: -0.011em;
  }

  .showcase__facts {
    display: grid;
    gap: 1.25rem;
    margin: clamp(5rem, 3rem + 7vw, 9rem) 0 0;
    padding-top: 1.5rem;
    --rule-color: var(--color-night-line);
    font-size: var(--text-sm);
  }

  .showcase__facts dt {
    color: var(--color-night-muted);
  }

  .showcase__facts dd {
    margin: 0.25rem 0 0;
  }

  .showcase__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    text-decoration: none;
  }

  .showcase__link:hover {
    text-decoration: underline;
  }

  @media (min-width: 48rem) {
    .showcase__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }

  @media (min-width: 64rem) {
    .showcase__body {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
      column-gap: 2rem;
    }

    .showcase__identity {
      grid-column: 1 / span 7;
    }

    .showcase__details {
      --reveal-delay: 0.12s;
      grid-column: 8 / -1;
      padding-bottom: 0.25rem;
    }

    .showcase__facts {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .showcase__facts > div {
      grid-column: span 3;
    }

    .showcase__facts > div:last-child {
      grid-column: 8 / span 5;
    }
  }
</style>
