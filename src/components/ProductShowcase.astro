---
import { i18n } from '../i18n';
import { hevalo, kurdish } from '../site';
import Cta from './Cta.astro';
import HevaloIcon from './HevaloIcon.astro';
import SplitText from './SplitText.astro';

const { t } = i18n(Astro.url);

// The tile's edge: ten thin layers through its depth.
const slices = Array.from({ length: 10 }, (_, index) => index + 1);
---

<section id="hevalo" class="showcase" aria-labelledby="hevalo-title" data-spotlight>
  <div class="container">
    <p class="eyebrow" data-reveal>{t.hevalo.eyebrow}</p>

    <div class="showcase__body">
      {/* Hevalo's app icon as a real object: a tile with depth, which turns to
          face the reader as the section scrolls into view. Decoration: the
          name beside it says what it is. */}
      <div class="showcase__art" aria-hidden="true" data-reveal>
        <span class="showcase__glow"></span>
        <span class="showcase__shadow"></span>
        <div class="showcase__turn">
          <span class="showcase__tilt" data-tilt>
            {slices.map((depth) => <span class="showcase__slice" data-depth={depth} />)}
            <HevaloIcon class="showcase__face" sizes="(min-width: 64rem) 19rem, 11rem" />
          </span>
        </div>
      </div>

      <div class="showcase__text">
        <SplitText id="hevalo-title" class="showcase__name" lang="en" text={hevalo.name} />
        <p class="showcase__byline" data-reveal>{t.hevalo.category}</p>
        <div class="showcase__details" data-reveal>
          <p class="showcase__description" data-lines>{t.hevalo.description}</p>
          <Cta href={hevalo.url} arrow="up-right" label={t.hevalo.visit} />
        </div>
      </div>
    </div>

    {/* Why Hevalo exists, in a Kurdish proverb, credited as one ("gotina pêşiyan"). */}
    <figure class="showcase__proverb" data-reveal>
      <blockquote class="showcase__proverb-text kurdish" lang="ku" dir="ltr">
        <p>{kurdish.proverb}</p>
      </blockquote>
      {t.hevalo.proverb && <p class="showcase__proverb-translation">{t.hevalo.proverb}</p>}
      <figcaption class="showcase__proverb-source">
        <span lang="ku" dir="ltr">{kurdish.proverbSource}</span>
        {t.hevalo.proverbSource && <span>{t.hevalo.proverbSource}</span>}
      </figcaption>
    </figure>

    <div class="showcase__soon rule" data-reveal>
      <div class="showcase__soon-heading">
        <p class="showcase__status"><span class="status-dot" aria-hidden="true"></span>{t.hevalo.comingSoon}</p>
        <h3 class="showcase__soon-title">{t.hevalo.comingSoonTitle}</h3>
      </div>
      <p class="showcase__soon-text" data-lines>{t.hevalo.comingSoonNote}</p>
    </div>
  </div>
</section>

<style>
  /* A tinted band that sets the products apart. Like the rest of the page, it
     follows the light or dark theme. */
  .showcase {
    position: relative;
    isolation: isolate;
    padding-block: var(--section-space) clamp(3rem, 2rem + 3vw, 4.5rem);
    background: var(--color-surface);
  }

  /* Under a mouse pointer, a soft light follows it across the band, as if the
     product were lit from where you look (motion.ts sets --spot-x/--spot-y). */
  .showcase::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      40rem circle at var(--spot-x, 50%) var(--spot-y, 50%),
      var(--color-spot),
      transparent 70%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease;
  }

  .showcase[data-spot]::before {
    opacity: 1;
  }

  .showcase__body {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 4.5rem);
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
  }

  /* ---- The tile ----
     The app icon's purple square (the deer's ears reach a little past its
     sides: 3.9% each side of the 360-unit image, corners 76 units) with a
     depth of 9% of its width, in ten layers that darken towards the back,
     as the edge of a lit object does. */
  .showcase__art {
    /* In units of the tile's own width (cqi), so it keeps its proportions. */
    --depth: 9cqi;

    position: relative;
    justify-self: center;
    width: 11rem;
    aspect-ratio: 1;
    container-type: inline-size;
    perspective: 60rem;
  }

  .showcase__turn,
  .showcase__tilt {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  /* At rest the tile is turned a little, so its depth shows. */
  .showcase__turn {
    transform: rotateX(8deg) rotateY(-18deg);
    transform-origin: 50% 50% calc(var(--depth) * -0.5);
  }

  /* Under a mouse it also tilts towards the pointer (motion.ts sets the
     custom properties), with a soft highlight where the light would catch it. */
  .showcase__tilt {
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transform-origin: 50% 50% calc(var(--depth) * -0.5);
    transition: transform 0.7s var(--ease-out);
  }

  .showcase__tilt[data-tilting] {
    transition-duration: 0.15s;
  }

  .showcase__slice {
    position: absolute;
    inset: 0 3.9%;
    border-radius: 23% / 21%;
    transform: translateZ(calc(var(--depth) * var(--z) * -1));
  }

  .showcase__slice[data-depth='1'] {
    --z: 0.1;
    background: #a865ea;
  }

  .showcase__slice[data-depth='2'] {
    --z: 0.2;
    background: #a160e3;
  }

  .showcase__slice[data-depth='3'] {
    --z: 0.3;
    background: #995adb;
  }

  .showcase__slice[data-depth='4'] {
    --z: 0.4;
    background: #9154d3;
  }

  .showcase__slice[data-depth='5'] {
    --z: 0.5;
    background: #894ecb;
  }

  .showcase__slice[data-depth='6'] {
    --z: 0.6;
    background: #8148c2;
  }

  .showcase__slice[data-depth='7'] {
    --z: 0.7;
    background: #7942b9;
  }

  .showcase__slice[data-depth='8'] {
    --z: 0.8;
    background: #703cb0;
  }

  .showcase__slice[data-depth='9'] {
    --z: 0.9;
    background: #6836a6;
  }

  .showcase__slice[data-depth='10'] {
    --z: 1.0;
    background: #5f309c;
  }

  .showcase__art :global(.showcase__face) {
    position: absolute;
    inset: 0;
    width: 100%;
  }

  /* The highlight covers the purple square, with its corners. */
  .showcase__tilt::after {
    content: '';
    position: absolute;
    inset: 0 3.9%;
    border-radius: 23% / 21%;
    background: radial-gradient(
      circle at var(--glare-x, 30%) var(--glare-y, 10%),
      rgb(255 255 255 / 0.45),
      rgb(255 255 255 / 0) 60%
    );
    opacity: 0;
    pointer-events: none;
    transform: translateZ(1px);
    transition: opacity 0.5s ease;
  }

  .showcase__tilt[data-tilting]::after {
    opacity: 1;
  }

  /* Under the tile, a soft shadow on the floor; behind it, a glow in the
     icon's purple. Neither turns with it. */
  .showcase__shadow {
    position: absolute;
    inset: auto 8% -18% 8%;
    height: 16%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(30 10 60 / 0.32), rgb(30 10 60 / 0));
  }

  .showcase__glow {
    position: absolute;
    inset: -30%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(176 112 242 / 0.28), rgb(176 112 242 / 0) 70%);
  }

  :global(:root[data-theme='dark']) .showcase__shadow {
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.6), rgb(0 0 0 / 0));
  }

  :global(:root[data-theme='dark']) .showcase__glow {
    background: radial-gradient(closest-side, rgb(176 112 242 / 0.3), rgb(176 112 242 / 0) 70%);
  }

  /* As the section scrolls into view, the tile turns from the side to face
     the reader, still a little turned. The browser runs it on the graphics
     card, in step with the scroll (no script); where it cannot, the tile
     simply rests turned. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Separate properties, so the minifier cannot fold the timeline into
         the `animation` shorthand (which browsers do not accept). */
      .showcase__turn {
        animation-name: showcase-turn;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 10% cover 50%;
      }
    }
  }

  @keyframes showcase-turn {
    from {
      transform: rotateX(22deg) rotateY(-48deg) rotateZ(5deg) translateY(10%);
    }

    to {
      transform: rotateX(8deg) rotateY(-18deg);
    }
  }

  @media (forced-colors: active) {
    .showcase__slice,
    .showcase__glow,
    .showcase__shadow {
      display: none;
    }
  }

  /* ---- The name and the text ---- */
  .showcase__name {
    font-size: clamp(4.5rem, 1.75rem + 13vw, 9.5rem);
    font-weight: 600;
    line-height: 0.86;
    letter-spacing: -0.055em;
    /* Optical alignment: the H's stem sits slightly inside the text box. */
    margin-inline-start: -0.05em;
  }

  /* Right to left, the word ends at the edge instead: the tight letter-spacing
     leaves the last letter's ink about 0.03em outside its box, so it moves in. */
  :global([dir='rtl']) .showcase__name {
    margin-inline-start: 0.03em;
  }

  .showcase__byline {
    margin-top: 1.5rem;
    font-size: var(--text-lead);
    letter-spacing: -0.011em;
    color: var(--color-muted);
  }

  .showcase__details {
    display: grid;
    justify-items: start;
    gap: 2rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .showcase__description {
    max-width: 30rem;
    font-size: var(--text-lead);
    line-height: 1.45;
    letter-spacing: -0.011em;
  }

  /* The proverb: large, in the serif italic of the site's Kurdish, with its
     translation and its credit under it. */
  .showcase__proverb {
    display: grid;
    gap: 1.25rem;
    margin: clamp(4.5rem, 3rem + 5vw, 8rem) 0 0;
  }

  .showcase__proverb-text {
    max-width: 19em;
    margin: 0;
    font-size: clamp(1.875rem, 1.2rem + 2.8vw, 3.5rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  /* Kurmanji runs left to right, but lines up with the page's own side. */
  :global(:root[dir='rtl']) .showcase__proverb-text {
    text-align: right;
  }

  .showcase__proverb-translation {
    max-width: 32rem;
    font-size: var(--text-lead);
    line-height: 1.45;
    color: var(--color-muted);
  }

  .showcase__proverb-source {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* A short rule before the credit, and a dot between its two names. */
  .showcase__proverb-source::before {
    content: '';
    align-self: center;
    width: 1.5rem;
    height: 1px;
    background: currentColor;
  }

  .showcase__proverb-source span + span::before {
    content: '·';
    margin-inline-end: 0.75rem;
  }

  .showcase__soon {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(5rem, 3rem + 7vw, 9rem);
    padding-top: clamp(2rem, 1.5rem + 1.5vw, 3rem);
    --rule-color: var(--color-line-strong);
  }

  .showcase__status {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-muted);
  }

  .showcase__soon-title {
    margin-top: 0.875rem;
    font-size: clamp(1.875rem, 1.3rem + 2.4vw, 3.5rem);
    font-weight: 560;
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .showcase__soon-text {
    max-width: 28rem;
    color: var(--color-muted);
  }

  @media (min-width: 64rem) {
    .showcase__body {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
      column-gap: 2rem;
    }

    .showcase__text {
      grid-column: 1 / span 7;
      grid-row: 1;
    }

    .showcase__art {
      grid-column: 8 / -1;
      grid-row: 1;
      width: 19rem;
    }

    .showcase__details {
      --reveal-delay: 0.12s;
    }

    .showcase__soon {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      align-items: end;
    }

    .showcase__soon-heading {
      grid-column: 1 / span 7;
    }

    .showcase__soon-text {
      grid-column: 8 / -1;
    }
  }
</style>
