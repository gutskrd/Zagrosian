---
import { i18n } from '../i18n';
import { hevalo, kurdish } from '../site';
import Cta from './Cta.astro';
import HevaloDeer from './HevaloDeer.astro';
import SplitText from './SplitText.astro';

const { t } = i18n(Astro.url);
---

<section id="hevalo" class="showcase" aria-labelledby="hevalo-title">
  <div class="container">
    <p class="eyebrow" data-reveal>{t.hevalo.eyebrow}</p>

    <div class="showcase__body">
      {/* Hevalo's app icon as a hole in the page, the deer climbing out of
          it from behind the page (HevaloDeer.astro). Decoration: the name
          beside it says what it is. */}
      <div class="showcase__art" aria-hidden="true" data-reveal>
        <HevaloDeer
          widths={[
            ['(min-width: 64rem)', 21],
            ['(min-width: 40rem)', 17],
            [null, 14],
          ]}
        />
      </div>

      <div class="showcase__text">
        <SplitText id="hevalo-title" class="showcase__name" lang="en" text={hevalo.name} />
        <p class="showcase__byline" data-reveal>{t.hevalo.category}</p>
        <div class="showcase__details" data-reveal>
          <p class="showcase__description" data-lines>{t.hevalo.description}</p>
          <Cta href={hevalo.url} arrow="up-right" label={t.hevalo.visit} />
        </div>
        {/* The facts at a glance, as the FAQ and the hero's notice give them. */}
        <dl class="showcase__facts rule" data-reveal>
          <div>
            <dt>{t.hevalo.dialectsLabel}</dt>
            <dd>{t.hevalo.dialects}</dd>
          </div>
          <div>
            <dt>{t.hevalo.website}</dt>
            <dd><a href={hevalo.url} dir="ltr">{hevalo.domain}</a></dd>
          </div>
          <div>
            <dt>{t.hevalo.platformsLabel}</dt>
            <dd class="showcase__status"><span class="status-dot" aria-hidden="true"></span>{t.hevalo.comingSoon}</dd>
          </div>
        </dl>
      </div>
    </div>

    {/* Why Hevalo exists, in a Kurdish proverb, credited as one ("gotina pêşiyan"). */}
    <figure class="showcase__proverb" data-reveal>
      <blockquote class="showcase__proverb-text kurdish" lang="ku" dir="ltr">
        <p>{kurdish.proverb}</p>
      </blockquote>
      {t.hevalo.proverb && <p class="showcase__proverb-translation">{t.hevalo.proverb}</p>}
      <figcaption class="showcase__proverb-source">
        <span lang="ku" dir="ltr">{kurdish.proverbSource}</span>
        {t.hevalo.proverbSource && <span>{t.hevalo.proverbSource}</span>}
      </figcaption>
    </figure>

  </div>
</section>

<style>
  /* A tinted band that sets the products apart. Like the rest of the page, it
     follows the light or dark theme. */
  .showcase {
    position: relative;
    isolation: isolate;
    /* The page drawn round the hole may reach past the band's edges. */
    overflow: clip;
    padding-block: var(--section-space) clamp(3rem, 2rem + 3vw, 4.5rem);
    background: var(--color-surface);
  }

  .showcase__body {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 4.5rem);
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
  }

  /* ---- The icon ----
     A hole in the page in the shape of the app icon, with the deer climbing
     out of it (HevaloDeer.astro). It is painted under the text beside it,
     since the page round the hole is drawn with it. */
  .showcase__art {
    position: relative;
    z-index: -1;
    justify-self: center;
    width: 14rem;
    aspect-ratio: 1;
    /* In units of the icon's own width (cqi), so it keeps its proportions. */
    container-type: inline-size;
  }

  /* ---- The name and the text ---- */
  .showcase__name {
    font-size: clamp(4.5rem, 1.75rem + 13vw, 9.5rem);
    font-weight: 600;
    line-height: 0.86;
    letter-spacing: -0.055em;
    /* Optical alignment: the H's stem sits slightly inside the text box. */
    margin-inline-start: -0.05em;
  }

  /* Right to left, the word ends at the edge instead: the tight letter-spacing
     leaves the last letter's ink about 0.03em outside its box, so it moves in. */
  :global([dir='rtl']) .showcase__name {
    margin-inline-start: 0.03em;
  }

  .showcase__byline {
    margin-top: 1.5rem;
    font-size: var(--text-lead);
    letter-spacing: -0.011em;
    color: var(--color-muted);
  }

  .showcase__details {
    display: grid;
    justify-items: start;
    gap: 2rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .showcase__description {
    max-width: 30rem;
    font-size: var(--text-lead);
    line-height: 1.45;
    letter-spacing: -0.011em;
  }

  /* The proverb: large, in the serif italic of the site's Kurdish, with its
     translation and its credit under it. */
  .showcase__proverb {
    display: grid;
    gap: 1.25rem;
    margin: clamp(4.5rem, 3rem + 5vw, 8rem) 0 0;
  }

  .showcase__proverb-text {
    max-width: 19em;
    margin: 0;
    font-size: clamp(1.875rem, 1.2rem + 2.8vw, 3.5rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  /* Kurmanji runs left to right, but lines up with the page's own side. */
  :global(:root[dir='rtl']) .showcase__proverb-text {
    text-align: right;
  }

  .showcase__proverb-translation {
    max-width: 32rem;
    font-size: var(--text-lead);
    line-height: 1.45;
    color: var(--color-muted);
  }

  .showcase__proverb-source {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* A short rule before the credit, and a dot between its two names. */
  .showcase__proverb-source::before {
    content: '';
    align-self: center;
    width: 1.5rem;
    height: 1px;
    background: currentColor;
  }

  .showcase__proverb-source span + span::before {
    content: '·';
    margin-inline-end: 0.75rem;
  }

  /* The facts: small, in three columns under a hairline, as in About. */
  .showcase__facts {
    display: grid;
    gap: 1.25rem;
    margin: clamp(2.5rem, 2rem + 2vw, 3.5rem) 0 0;
    padding-top: 1.5rem;
    --rule-color: var(--color-line-strong);
    font-size: var(--text-sm);
  }

  .showcase__facts dt {
    color: var(--color-muted);
  }

  .showcase__facts dd {
    margin: 0.25rem 0 0;
  }

  .showcase__facts a {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    text-decoration-color: var(--color-underline);
    transition: text-decoration-color 0.2s ease;
  }

  .showcase__facts a:hover {
    text-decoration-color: currentColor;
  }

  .showcase__status {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  @media (min-width: 40rem) {
    .showcase__art {
      width: 17rem;
    }

    .showcase__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }

  @media (min-width: 64rem) {
    .showcase__body {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
      column-gap: 2rem;
    }

    .showcase__text {
      grid-column: 1 / span 7;
      grid-row: 1;
    }

    .showcase__art {
      grid-column: 8 / -1;
      grid-row: 1;
      width: 21rem;
    }

    .showcase__details {
      --reveal-delay: 0.12s;
    }

    .showcase__facts {
      --reveal-delay: 0.2s;
    }

  }
</style>
