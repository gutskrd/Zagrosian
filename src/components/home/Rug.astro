---
/**
 * A pile rug lying on the floor in late sun, after the weaving of Bijar and Senneh, Kurdish towns
 * in the Zagros (texture generated by scripts/rug.mjs). It rests with its nearest corner turned up
 * and can be picked up, folded, dragged and rotated (rug/scene.ts, WebGL 2, loaded on approach).
 *
 * The paper plane underneath (Proverb.astro, plane.ts) positions itself from the rug geometry
 * defined here: `--rug-share` (rug width as a fraction of the stage) and `--rug-angle` (radians).
 * The 3D scene reads the same properties and the flat image is placed by them, so all three stay
 * aligned. Until the scene is ready, or without WebGL, the flat image is shown.
 */
import rugPicture from '../../assets/rug/rug.webp?url';
import rugSmall from '../../assets/rug/rug-small.webp?url';

// The rug is just under a quarter of the stage width on desktop, just over a third on tablets and
// half on phones (--rug-share below); the browser picks a fine-enough image and the 3D scene reuses
// it.
const sizes = '(max-width: 39.99rem) 50vw, (max-width: 63.99rem) 36vw, 25vw';
---

<div class="rug" data-rug>
  {/* Resting paper plane (plane.ts): under the rug, part of the floor layer, so it scrolls with it
     natively. */}
  <canvas class="rug__plane" aria-hidden="true" data-plane-rest hidden></canvas>
  <div class="rug__flat" aria-hidden="true">
    {/* Far down the page: lazy-loaded. */}
    <img
      src={rugPicture}
      srcset={`${rugSmall} 606w, ${rugPicture} 1010w`}
      sizes={sizes}
      alt=""
      width="1010"
      height="1730"
      loading="lazy"
      decoding="async"
    />
  </div>
  <canvas class="rug__canvas" aria-hidden="true"></canvas>
</div>

<style>
  /* Floor with room around the rug for the light and for moving and folding it. On desktop it's
     short enough that the rug, hint and button fit one screen. Rotated, the rug (fringe and shadow
     included) never exceeds 90% of the floor height, which would clip it at the canvas edge. */
  .rug {
    --rug-share: 0.235;
    --rug-angle: -0.5;
    --rug-width: calc(var(--rug-share) * 100cqw);
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 1;
    container-type: inline-size;
    /* Vertical swipes still scroll and pinch still zooms; the rug is grabbed by pressing on it (on
       touch: long press or horizontal start, see rug/scene.ts). */
    touch-action: pan-y pinch-zoom;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }

  @media (max-width: 63.99rem) {
    .rug {
      --rug-share: 0.36;
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 39.99rem) {
    .rug {
      --rug-share: 0.5;
      aspect-ratio: 4 / 5;
    }
  }

  /* Short desktop screens (1280x720, 1366x768): a lower floor and slightly smaller rug so the rug
     and its button still fit one screen; smaller again on even shorter screens. */
  @media (min-width: 64rem) and (max-height: 56.24rem) {
    .rug {
      --rug-share: 0.2;
      aspect-ratio: 2.3 / 1;
    }
  }

  @media (min-width: 64rem) and (max-height: 40rem) {
    .rug {
      --rug-share: 0.168;
      aspect-ratio: 2.8 / 1;
    }
  }

  /* Landscape phones: a long, low floor so the whole rug is visible. */
  @media (max-width: 63.99rem) and (orientation: landscape) and (max-height: 32rem) {
    .rug {
      --rug-share: 0.17;
      aspect-ratio: 2.6 / 1;
    }
  }

  .rug[data-over] {
    cursor: grab;
  }

  .rug[data-holding] {
    cursor: grabbing;
  }

  /* Positioned and sized around the plane by plane.ts. First in the stage, so the image, the 3D rug
     and its shadow render on top. */
  .rug__plane {
    position: absolute;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.6s var(--ease-out);
  }

  /* Drawn once the rug covers it (rug/index.ts); the visible sliver fades in as if it had always
     been there. */
  .rug:not([data-covered]) .rug__plane {
    opacity: 0;
  }

  /* The flat image hangs from the rug's center, rotated to its resting angle: 101 x 161 pile cells
     plus six fringe rows at each end. */
  .rug__flat {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--rug-width);
    aspect-ratio: 101 / 173;
    transform: translate(-50%, -50%) rotate(calc(var(--rug-angle) * 1rad));
    filter: drop-shadow(0 0.6rem 0.9rem rgb(0 0 0 / 0.3));
    transition:
      transform 0.9s var(--ease-in-out),
      visibility 0s;
  }

  .rug__flat img {
    display: block;
    width: 100%;
    height: 100%;
    transition: opacity 0.45s var(--ease-out);
  }

  /* With JS (theme-init.js has run) the image stays hidden until fully decoded (rug/index.ts), so
     slow connections never show it loading progressively. Without JS it shows as it loads. */
  :global(:root[data-theme]) .rug:not([data-pictured]) .rug__flat img {
    opacity: 0;
  }

  /* Lifted without the 3D scene: fold the image back along its length. */
  .rug[data-lifted] .rug__flat {
    transform: translate(-50%, -50%) rotate(calc(var(--rug-angle) * 1rad)) translateY(-58%);
  }

  @media (prefers-reduced-motion: reduce) {
    .rug__flat {
      transition: visibility 0s;
    }
  }

  .rug__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.7s var(--ease-out);
    /* Anything reaching the bottom of the floor (shadow tail, or the rug dragged there) fades out
       rather than clipping in a hard line. */
    mask-image: linear-gradient(to bottom, #000 calc(100% - 0.75rem), transparent);
  }

  /* Once ready, the 3D rug fades in over the image as the light settles on it, and the image is
     removed only when the canvas is fully opaque, so the floor never shows between them. */
  .rug[data-live] .rug__canvas {
    opacity: 1;
  }

  .rug[data-live] .rug__flat {
    visibility: hidden;
    transition:
      transform 0.9s var(--ease-in-out),
      visibility 0s 0.7s;
  }

  /* Reduced motion: the rug appears instantly (global.css), so the image goes instantly too. */
  @media (prefers-reduced-motion: reduce) {
    .rug[data-live] .rug__flat {
      transition-delay: 0s;
    }
  }

  /* Forced colors (Windows High Contrast): keep the image, as an outline. */
  @media (forced-colors: active) {
    .rug__flat {
      filter: none;
      outline: 2px solid CanvasText;
    }

    .rug__canvas,
    .rug__plane {
      display: none;
    }

    .rug[data-live] .rug__flat {
      visibility: visible;
    }
  }

  @media print {
    .rug__plane {
      display: none;
    }
  }
</style>
