---
/**
 * The lifted Zagrosian logo: the two hands set in a block of clear glass, in 3D, for the homepage
 * hero (and from there into the story below it).
 *
 * The logo is vector, so it stays sharp at any size. The shapes are traced from the lifted logo
 * (src/assets/brand/zagrosian-logo-lifted-source.png) and float inside the block between its back
 * and front faces; the edge is a stack of thin slices, so the block has real thickness when it
 * rotates. The back face tints the glass and casts the shadow; the front face only catches light
 * (bevel, glare and a streak), keeping the logo crisp. There's deliberately no backdrop blur: it's
 * expensive to repaint as the block rotates, and the background is already soft.
 *
 * Soft elements (the shadow and the inner shading of the front face) are pre-rendered images
 * (scripts/logo-shadows.mjs generates them from the box-shadows they replaced), each on its own
 * layer. Scaled, they look identical at any size and rasterize instantly, whereas a box-shadow blur
 * is recomputed whenever the logo re-rasterizes at a new size, as during the story's fly-in. (As a
 * background on a face rotating in 3D, an image would repaint every frame, hence the separate
 * layers.)
 *
 * Light theme: the logo's dark parts are smoked glass and the rest is clear. Dark theme: the light
 * parts are frosted and the rest is clear.
 *
 * On the homepage it travels into the story as the page scrolls (src/scripts/motion/story.ts),
 * which drives its pose through custom properties on an ancestor; without them it renders at rest.
 */
import type { HTMLAttributes } from 'astro/types';
import source from '../../assets/brand/zagrosian-logo-lifted.svg?raw';

interface Props extends HTMLAttributes<'span'> {
  /** Empty when the logo is decorative. */
  alt?: string;
}

const { alt = '', class: className, ...attributes } = Astro.props;
const label = alt ? { role: 'img' as const, 'aria-label': alt } : { 'aria-hidden': 'true' as const };

// Traced light shapes; the dark shapes are the tile minus these.
const light = source.match(/ d="([^"]+)"/)?.[1] ?? '';
const dark = `M0 0H1290V1290H0Z${light}`;

const slices = Array.from({ length: 10 }, (_, index) => index + 1);
---

<span class:list={['lifted-logo', className]} {...label} {...attributes}>
  <span class="lifted-logo__body">
    <span class="lifted-logo__back"></span>
    {slices.map((depth) => (
      <span class="lifted-logo__slice" data-depth={depth} />
    ))}
    <span class="lifted-logo__frame"></span>
    <span class="lifted-logo__inner">
      <svg viewBox="0 0 1290 1290" aria-hidden="true" focusable="false">
        <path class="lifted-logo__dark" fill-rule="evenodd" d={dark}></path>
        <path class="lifted-logo__light" fill-rule="evenodd" d={light}></path>
      </svg>
    </span>
    <span class="lifted-logo__front"></span>
  </span>
</span>

<style>
  .lifted-logo {
    /* Container units, so the block keeps its proportions at any size. */
    --thickness: 7cqi;
    --radius: 23%;
    --body: rgb(255 255 255 / 0.08);
    --haze: rgb(255 255 255 / 0);
    --edge: rgb(0 0 0 / 0.1);
    --dark: rgb(10 10 12 / 0.72);
    --light: rgb(255 255 255 / 0.3);
    --rim: rgb(0 0 0 / 0.16);
    --seam: rgb(0 0 0 / 0.3);

    position: relative;
    display: block;
    aspect-ratio: 1;
    container-type: inline-size;
    transform-style: preserve-3d;
    user-select: none;
  }

  :global(:root[data-theme='dark']) .lifted-logo {
    --body: rgb(255 255 255 / 0.05);
    --haze: rgb(255 255 255 / 0.15);
    --edge: rgb(255 255 255 / 0.11);
    --dark: rgb(255 255 255 / 0.04);
    --light: rgb(255 255 255 / 0.8);
    --rim: rgb(255 255 255 / 0.22);
    --seam: rgb(255 255 255 / 0.1);
  }

  /* Rotated slightly at rest so the glass shows its depth. It rotates about its own center, halfway
     through its thickness, as one rigid block.

     Pose comes from src/scripts/motion/story.ts: rotation (--turn), lean (--tilt) and how much of
     the front pane remains (--front, as the camera passes through it). */
  .lifted-logo__body {
    position: absolute;
    inset: 0;
    transform: rotateX(calc(12deg + var(--tilt, 0deg))) rotateY(calc(-18deg + var(--turn, 0deg)));
    transform-origin: 50% 50% calc(var(--thickness) * -0.5);
    transform-style: preserve-3d;
  }

  /* Each layer sits at depth `--f` through the block, from the front (0) to the back (1). */
  .lifted-logo__back,
  .lifted-logo__slice,
  .lifted-logo__frame,
  .lifted-logo__inner,
  .lifted-logo__front {
    --f: 0;

    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    transform: translateZ(calc(var(--thickness) * var(--f) * -1));
  }

  /* The glass body and its shadow. */
  .lifted-logo__back {
    --f: 1;

    background: var(--body);
  }

  /* Dark theme: backlit, so the lights show through. */
  :global(:root[data-theme='dark']) .lifted-logo__back {
    background:
      radial-gradient(circle at 76% 24%, var(--haze), rgb(255 255 255 / 0) 66%),
      radial-gradient(circle at 18% 84%, var(--haze), rgb(255 255 255 / 0) 42%), var(--body);
  }

  /* Drop shadow below the block (the image is transparent where the block is): 132% of the block
     width, offset 16% left and 5% up. Laid out from the block's corner and translated into place,
     so when story.ts lays the block out larger the shadow grows from that corner like everything
     else, with no shift. */
  .lifted-logo__back::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 132%;
    height: 132%;
    translate: -12.1212% -3.7879%;
    background: url('../../assets/brand/lifted-logo-shadow-light.webp') 0 0 / 100% 100% no-repeat;
    pointer-events: none;
  }

  :global(:root[data-theme='dark']) .lifted-logo__back::before {
    background-image: url('../../assets/brand/lifted-logo-shadow-dark.webp');
  }

  /* Edge: ten thin slices through the block's thickness, visible from both sides. */
  /* (1.5px at display size: when facing the viewer, story.ts lays the traveling copy out larger and
     scales it down by --grow.) */
  .lifted-logo__slice {
    border: calc(1.5px * var(--grow, 1)) solid var(--edge);
    opacity: 0.6;
  }

  .lifted-logo__slice[data-depth='1'] {
    --f: 0.0909;
  }

  .lifted-logo__slice[data-depth='2'] {
    --f: 0.1818;
  }

  .lifted-logo__slice[data-depth='3'] {
    --f: 0.2727;
  }

  .lifted-logo__slice[data-depth='4'] {
    --f: 0.3636;
  }

  .lifted-logo__slice[data-depth='5'] {
    --f: 0.4545;
  }

  .lifted-logo__slice[data-depth='6'] {
    --f: 0.5455;
  }

  .lifted-logo__slice[data-depth='7'] {
    --f: 0.6364;
  }

  .lifted-logo__slice[data-depth='8'] {
    --f: 0.7273;
  }

  .lifted-logo__slice[data-depth='9'] {
    --f: 0.8182;
  }

  .lifted-logo__slice[data-depth='10'] {
    --f: 0.9091;
  }

  /* The logo inside the glass, in a thin frame as in the original (10 of its 215px), in the same
     tone as its dark parts so they merge. The artwork spans the whole tile, so it's aligned to it;
     a fine seam marks the frame's inner edge. */
  .lifted-logo__frame,
  .lifted-logo__inner {
    --f: 0.45;
  }

  .lifted-logo__frame {
    border: 4.65cqi solid var(--dark);
  }

  /* Rounded corners use border-radius + overflow instead of clip-path: on a 3D-transformed layer,
     the compositor applies clip-path as a separate mask that can desync for a frame when the layer
     is re-laid out larger (story.ts). Inset 4.65% on every side, laid out from the block's corner
     and translated into place, like the artwork inside, so re-layout at a larger size grows
     everything from that corner without shift. */
  .lifted-logo__inner {
    inset: 0 auto auto 0;
    width: 90.7%;
    height: 90.7%;
    translate: 5.1268% 5.1268%;
    border-radius: 20.2%;
    overflow: hidden;
  }

  .lifted-logo__inner::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20.2%;
    box-shadow: inset 0 0 0 max(1px, 0.3cqi) var(--seam);
  }

  .lifted-logo__inner svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 110.26%;
    max-width: none;
    height: 110.26%;
    translate: -4.6526% -4.6526%;
  }

  .lifted-logo__dark {
    fill: var(--dark);
  }

  .lifted-logo__light {
    fill: var(--light);
  }

  /* The front face catches the light: a bright bevel along the top and left, a darker one below, a
     glare at the top left and a diagonal streak. */
  .lifted-logo__front {
    /* Sized relative to the block (1cqi = 1% of its width; at the usual 352px, 0.43cqi is 1.5px),
       so the bevel and glow keep their proportions at any rendered size. */
    border: max(1px, 0.28cqi) solid var(--rim);
    overflow: hidden;
    opacity: var(--front, 1);
    background: linear-gradient(140deg, rgb(255 255 255 / 0.5), rgb(255 255 255 / 0.1) 24%, rgb(255 255 255 / 0) 42%);
    box-shadow:
      inset 0 max(1px, 0.43cqi) 0 rgb(255 255 255 / 0.85),
      inset max(1px, 0.43cqi) 0 0 rgb(255 255 255 / 0.4);
  }

  /* Soft inner shading: darker along the bottom and right, with a faint inner glow (an image); then
     the streak. */
  .lifted-logo__front::before,
  .lifted-logo__front::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .lifted-logo__front::before {
    background: url('../../assets/brand/lifted-logo-shading.webp') 0 0 / 100% 100% no-repeat;
  }

  .lifted-logo__front::after {
    background: linear-gradient(118deg, rgb(255 255 255 / 0) 47%, rgb(255 255 255 / 0.22) 53%, rgb(255 255 255 / 0) 60%);
  }

  @media (forced-colors: active) {
    .lifted-logo__back::before {
      display: none;
    }

    .lifted-logo__front {
      border-color: CanvasText;
      background: none;
    }

    .lifted-logo__front::before,
    .lifted-logo__front::after {
      display: none;
    }

    .lifted-logo__light {
      fill: Canvas;
    }

    .lifted-logo__dark {
      fill: CanvasText;
    }
  }

  /* Print: always at rest. */
  @media print {
    .lifted-logo__body {
      transform: rotateX(12deg) rotateY(-18deg);
    }
  }
</style>
