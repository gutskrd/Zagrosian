---
/**
 * The story below the hero: Zagrosian's three values, then the Kurdish sun and the motto.
 *
 * Without JS, with reduced motion and in print it's a static section: the values as a heading, with
 * the sun and motto below.
 *
 * With motion it becomes a pinned, scroll-driven sequence (src/scripts/motion/story.ts). Four acts:
 *
 * 1. Values: the glass logo arrives from the hero and settles beside them; each value flips in and
 *    the logo rotates a step with each.
 * 2. Dive: the logo centers and faces the viewer, and the camera dollies through the front pane
 *    into the logo's ink, the block's layers spreading apart in perspective.
 * 3. Sun: inside the ink, an inverted-theme scene (`.story__scene`) where the Kurdish sun rises as
 *    a thick piece of glass (GlassSun.astro), tumbling and catching the light, then settles facing
 *    the viewer while the motto reveals word by word.
 * 4. Iris: the scene closes around the sun like an iris, leaving the sun and motto in the page
 *    theme as the section scrolls on.
 *
 * theme-init.js reserves space before first paint (`data-story`), so nothing shifts when the script
 * starts.
 */
import { i18n } from '../../i18n';
import { kurdish } from '../../site';
import GlassSun from './GlassSun.astro';
import Sun from './Sun.astro';

const { t } = i18n(Astro.url);

// Values scale with their column; each must fit on one line.
const longest = Math.max(...t.story.values.map((value) => [...value].length));
const fit = longest <= 10 ? undefined : longest <= 13 ? 'md' : longest <= 16 ? 'sm' : 'xs';

const words = kurdish.motto.split(' ');
---

<section id="story" class="story" aria-labelledby="story-title" data-story-section>
  <div class="story__stage">
    <div class="container story__grid">
      <h2 id="story-title" class:list={['story__values', fit && `story__values--${fit}`]}>
        {
          t.story.values.map((value, index) => (
            <>
              {index > 0 && ' '}
              <span class="story__value" data-story-value>
                <span class="story__value-text">{value}</span>
              </span>
            </>
          ))
        }
      </h2>
      <div class="story__slot" aria-hidden="true" data-story-slot></div>
    </div>

    <div class="story__motto" data-story-motto>
      <div class="story__sun" data-story-sun><Sun /></div>
      <p class="story__kurdish kurdish" lang="ku" dir="ltr">{kurdish.motto}</p>
      {t.motto && <p class="story__translation lead">{t.motto}</p>}
    </div>

    <div class="story__scene" aria-hidden="true" data-story-scene>
      <div class="story__motto">
        <div class="story__sun">
          <span class="story__glow" data-story-glow></span>
          <span class="story__glass-sun" data-story-sunrise><GlassSun /></span>
        </div>
        <p class="story__kurdish kurdish" lang="ku" dir="ltr">
          {
            words.map((word, index) => (
              <>
                {index > 0 && ' '}
                <span class="story__word">
                  <span data-story-word>{word}</span>
                </span>
              </>
            ))
          }
        </p>
        {t.motto && <p class="story__translation lead" data-story-translation>{t.motto}</p>}
      </div>
    </div>

    <div class="story__progress" aria-hidden="true"><span data-story-progress></span></div>
  </div>
</section>

<style>
  /* --- Static section: the values, then the sun and motto --- */
  .story {
    padding-block: var(--section-space);
  }

  .story__grid {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
  }

  /* Values scale with their column (see `fit` above). With no container around them, their `cqi`
     resolves against the viewport, so each is preceded by the same size in `vw` for browsers
     without container query units (Safari < 16). */
  .story__values {
    container-type: inline-size;
    margin: 0;
    font-size: min(var(--text-display), 17vw);
    font-size: min(var(--text-display), 17cqi);
    line-height: 1;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .story__values--md {
    font-size: min(var(--text-display), 13vw);
    font-size: min(var(--text-display), 13cqi);
  }

  .story__values--sm {
    font-size: min(var(--text-display), 10.5vw);
    font-size: min(var(--text-display), 10.5cqi);
  }

  .story__values--xs {
    font-size: min(var(--text-display), 9vw);
    font-size: min(var(--text-display), 9cqi);
  }

  /* Each value on its own line, behind a mask it flips in from. */
  .story__value {
    display: block;
    overflow: clip;
    padding-block-end: 0.1em;
    margin-block-end: -0.06em;
    perspective: 8em;
  }

  .story__value-text {
    display: block;
    transform-origin: 50% 100%;
  }

  .story__motto {
    display: grid;
    justify-items: center;
    margin-top: var(--section-space);
    text-align: center;
  }

  .story__sun {
    font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  /* The motto uses system serifs, whose metrics vary by device. Sizes allow for the widest likely
     fallback (DejaVu Serif): "kurdî xweştire." is at most 7.5em wide and the full line 11.5em. Two
     lines on phones, one on wider screens. */
  .story__kurdish {
    margin: 0;
    font-size: calc((100vw - 2 * var(--gutter)) / 7.8);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }

  @media (min-width: 48rem) {
    .story__kurdish {
      font-size: min(var(--text-display), calc((min(100vw, var(--container)) - 2 * var(--gutter)) / 11.8));
    }
  }

  .story__translation {
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    color: var(--color-muted);
  }

  .story__slot,
  .story__scene,
  .story__progress {
    display: none;
  }

  /* --- Scroll sequence ---

     The stage is pinned to the viewport while the section (5.5 screens tall) scrolls past. On
     mobile, browser chrome collapses on scroll down and expands on scroll up: the stage uses the
     large viewport height (100lvh) so its background always reaches the bottom edge, while its
     content stays within the small viewport (100svh), so nothing moves as the chrome toggles.
     Elsewhere both are the same. */
  :global(:root[data-story]) .story {
    height: 560svh;
    padding: 0;
  }

  :global(:root[data-story]) .story__stage {
    --bar: calc(100lvh - 100svh);

    position: sticky;
    top: 0;
    display: grid;
    align-content: center;
    height: 100lvh;
    padding-bottom: var(--bar);
    overflow: clip;
  }

  /* Values above the logo's slot on phones, beside it on wide screens, as in the hero. */
  :global(:root[data-story='on']) .story__grid {
    height: 100%;
    grid-template-rows: auto minmax(0, 1fr);
    align-content: center;
    padding-block: calc(var(--header-height) + 1.5rem) 2rem;
  }

  :global(:root[data-story='on']) .story__slot {
    display: block;
    align-self: center;
    justify-self: center;
    width: min(100%, 22rem, 34svh);
    aspect-ratio: 1;
  }

  @media (min-width: 64rem) {
    :global(:root[data-story='on']) .story__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: none;
      column-gap: 2rem;
      align-items: center;
    }

    :global(:root[data-story]) .story__values {
      grid-column: 1 / span 7;
      font-size: min(var(--text-display), 17vw, 15svh);
      font-size: min(var(--text-display), 17cqi, 15svh);
    }

    :global(:root[data-story]) .story__values--md {
      font-size: min(var(--text-display), 13vw, 13svh);
      font-size: min(var(--text-display), 13cqi, 13svh);
    }

    :global(:root[data-story]) .story__values--sm {
      font-size: min(var(--text-display), 10.5vw, 11svh);
      font-size: min(var(--text-display), 10.5cqi, 11svh);
    }

    :global(:root[data-story]) .story__values--xs {
      font-size: min(var(--text-display), 9vw, 10svh);
      font-size: min(var(--text-display), 9cqi, 10svh);
    }

    :global(:root[data-story='on']) .story__slot {
      grid-column: 8 / span 5;
      width: min(100%, 22rem);
    }
  }

  /* Before the script runs (or if it can't), the motto sits below the values; once active, it's
     centered on the stage and waits for its act. */
  :global(:root[data-story]) .story__motto {
    margin-top: clamp(2rem, 1rem + 4vw, 4rem);
  }

  :global(:root[data-story='on']) .story__motto {
    position: absolute;
    inset: 0 0 var(--bar);
    align-content: center;
    padding-inline: var(--gutter);
  }

  :global(:root[data-story='on']) .story__motto[data-story-motto] {
    visibility: hidden;
  }

  /* Sun act: an inverted-theme scene, revealed and closed by the script with a circular `clip-path`
     around the sun. */
  :global(:root[data-story='on']) .story__scene {
    position: absolute;
    inset: 0;
    /* Above the traveling glass logo (Hero.astro), which dives into it. */
    z-index: 2;
    display: block;
    background: var(--color-ink);
    color: var(--color-paper);
    visibility: hidden;
  }

  .story__scene .story__translation {
    color: inherit;
    opacity: 0.62;
  }

  /* The glass sun takes the flat sun's slot in the layout and is sized by the script; a soft glow
     sits behind it. */
  .story__scene .story__sun {
    position: relative;
    width: 1em;
    height: 1em;
  }

  .story__glass-sun,
  .story__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1em;
    translate: -50% -50%;
    perspective: 60rem;
  }

  .story__glass-sun > :global(.glass-sun) {
    width: 100%;
  }

  /* Laid out once at its largest (story.ts sets the width), then only translated and scaled on the
     compositor, which re-rasterizes it sharp whenever the scale crosses a sqrt(2) step. */
  .story__glass-sun {
    will-change: transform;
  }

  /* Soft enough that the compositor can scale the cached raster as the sun settles, without
     re-rasterizing. */
  .story__glow {
    width: 6em;
    aspect-ratio: 1;
    border-radius: 50%;
    will-change: transform;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, currentColor 22%, transparent),
      color-mix(in srgb, currentColor 6%, transparent) 55%,
      transparent
    );
    opacity: 0;
  }

  .story__word {
    display: inline-block;
    overflow: clip;
    padding-block-end: 0.12em;
    margin-block-end: -0.12em;
  }

  .story__word > span {
    display: inline-block;
  }

  /* Sequence progress, along the bottom of the stage. */
  :global(:root[data-story='on']) .story__progress {
    position: absolute;
    inset-inline: var(--gutter);
    bottom: calc(var(--bar) + 1.25rem);
    display: block;
    height: 1px;
    color: var(--color-ink);
    background: color-mix(in srgb, currentColor 14%, transparent);
    pointer-events: none;
  }

  .story__progress > span {
    display: block;
    height: 100%;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
  }

  :global([dir='rtl']) .story__progress > span {
    transform-origin: right;
  }

  @media print {
    :global(:root[data-story]) .story {
      height: auto;
      padding-block: var(--section-space);
    }

    :global(:root[data-story]) .story__stage {
      position: static;
      height: auto;
    }

    :global(:root[data-story='on']) .story__motto[data-story-motto] {
      position: static;
      visibility: visible;
      margin-top: var(--section-space);
    }

    :global(:root[data-story='on']) :is(.story__scene, .story__progress) {
      display: none;
    }
  }
</style>
