---
/** Text with inline links, as produced by src/lib/faq.ts (FAQ answers). */
import type { FaqPart } from '../../lib/faq';

interface Props {
  parts: FaqPart[];
}

const { parts } = Astro.props;
---

{
  parts.map((part) =>
    typeof part === 'string' ? (
      part
    ) : (
      <a href={part.href} dir={part.ltr ? 'ltr' : undefined}>
        {part.text}
      </a>
    ),
  )
}
