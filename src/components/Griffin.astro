---
/**
 * The Zagrosian griffin, the company's emblem. Served as 16-colour PNGs at
 * several widths (smaller than AVIF or WebP for black line art), so each
 * screen downloads only the size it needs. Inverted on dark surfaces.
 */
import griffin96 from '../assets/brand/griffin-96.png';
import griffin240 from '../assets/brand/griffin-240.png';
import griffin480 from '../assets/brand/griffin-480.png';
import griffin720 from '../assets/brand/griffin-720.png';
import griffin960 from '../assets/brand/griffin-960.png';

interface Props {
  /** Rendered width, as a `sizes` value, e.g. "40px" or "(min-width: 64rem) 30vw, 60vw". */
  sizes: string;
  /** Leave empty when the griffin sits next to the Zagrosian name. */
  alt?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { sizes, alt = '', class: className, loading = 'lazy' } = Astro.props;

const variants = [griffin96, griffin240, griffin480, griffin720, griffin960];
const srcset = variants.map((image) => `${image.src} ${image.width}w`).join(', ');
---

<img
  class:list={['griffin', className]}
  src={griffin480.src}
  srcset={srcset}
  sizes={sizes}
  width={griffin480.width}
  height={griffin480.height}
  alt={alt}
  loading={loading}
  decoding="async"
  draggable="false"
/>

<style>
  .griffin {
    height: auto;
    filter: var(--art-filter);
    user-select: none;
  }
</style>
