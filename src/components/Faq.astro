---
/**
 * Questions and answers, before Contact: a list of questions, each opening to
 * its answer (native `details`, so it works with the keyboard and without
 * JavaScript, and browsers' find-in-page opens the answer it finds). The
 * answers are in the page either way, for search engines and AI assistants,
 * and the same list is in the Markdown version of the page and in its
 * structured data (src/lib/faq.ts). A line after the list says where to ask
 * anything else.
 */
import { i18n } from '../i18n';
import { faq, faqMore } from '../lib/faq';
import LinkedText from './LinkedText.astro';
import SplitText from './SplitText.astro';

const { locale, t } = i18n(Astro.url);
const items = faq(locale);
const more = faqMore(locale);
---

<section id="faq" class="faq section" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="faq__intro">
      <p class="eyebrow" data-reveal>{t.faq.eyebrow}</p>
      <SplitText id="faq-title" class="heading-2 faq__title" text={t.faq.title} />
    </div>

    <div class="faq__body">
      <div class="faq__list">
        {
          items.map((item) => (
            <details class="faq__item" data-reveal>
              <summary class="faq__summary">
                <h3 class="faq__question">{item.question}</h3>
                <span class="faq__icon" aria-hidden="true" />
              </summary>
              <p class="faq__answer">
                <LinkedText parts={item.answer} />
              </p>
            </details>
          ))
        }
      </div>
      <p class="faq__more" data-reveal><LinkedText parts={more} /></p>
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .faq__title {
    margin-top: 1.25rem;
  }

  .faq__list {
    border-bottom: 1px solid var(--color-line);
  }

  .faq__item {
    border-top: 1px solid var(--color-line);
  }

  /* The question: the whole row opens it, with a plus that turns into a minus. */
  .faq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.375rem;
    cursor: pointer;
    list-style: none;
    border-radius: 0.25rem;
    -webkit-tap-highlight-color: transparent;
  }

  .faq__summary::-webkit-details-marker {
    display: none;
  }

  .faq__summary:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
  }

  .faq__question {
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.015em;
    text-wrap: balance;
    transition: color 0.2s ease;
  }

  .faq__icon {
    position: relative;
    flex: none;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0.75rem;
    height: 1.5px;
    margin: -0.75px 0 0 -0.375rem;
    border-radius: 1px;
    background: currentColor;
    transition: rotate 0.4s var(--ease-out);
  }

  .faq__icon::after {
    rotate: 90deg;
  }

  .faq__item[open] .faq__icon::after {
    rotate: 0deg;
  }

  @media (hover: hover) {
    .faq__summary:hover .faq__icon {
      border-color: var(--color-ink);
    }
  }

  .faq__item[open] .faq__icon {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .faq__answer {
    max-width: 38rem;
    padding-bottom: 1.75rem;
    padding-inline-end: 3.5rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    text-wrap: pretty;
  }

  /* Opening and closing slide the answer open and shut, where the browser
     can animate to a natural height (elsewhere it simply appears). */
  @media (prefers-reduced-motion: no-preference) {
    .faq__item::details-content {
      block-size: 0;
      overflow-y: clip;
      transition:
        block-size 0.45s var(--ease-out),
        content-visibility 0.45s allow-discrete;
    }

    .faq__item[open]::details-content {
      block-size: auto;
    }

    .faq__answer {
      opacity: 0;
      translate: 0 -0.375rem;
      transition:
        opacity 0.3s ease,
        translate 0.45s var(--ease-out);
    }

    .faq__item[open] .faq__answer {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* The padding enlarges the tap area to 24px without moving the text. */
  .faq :global(a) {
    padding-block: 0.125rem;
    color: var(--color-ink);
    text-decoration-color: var(--color-underline);
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
    transition: text-decoration-color 0.2s ease;
  }

  .faq :global(a:hover) {
    text-decoration-color: currentColor;
  }

  .faq__more {
    margin-top: 1.75rem;
    color: var(--color-muted);
  }

  @media (forced-colors: active) {
    .faq__item[open] .faq__icon {
      background: CanvasText;
      color: Canvas;
    }
  }

  /* Wide screens: the heading stays in view beside the questions. */
  @media (min-width: 64rem) {
    .faq__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      align-items: start;
    }

    .faq__intro {
      grid-column: 1 / span 4;
      position: sticky;
      top: calc(var(--header-height) + 2rem);
    }

    .faq__body {
      grid-column: 5 / -1;
    }
  }
</style>
