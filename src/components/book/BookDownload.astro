---
/**
 * Download link for Hevalo's book (the PDF, saved under its own filename). As the primary action: a
 * pill with facts below it ("PDF · 2.6 MB · 192 pages") and, in in-app browsers, a hint on how to
 * open it there (`inApp`). In the reader's toolbar and contents menu: a small button, round and
 * icon-only in the phone toolbar.
 *
 * A plain link with `download`, so it works without JS. The server also sends the file as an
 * attachment for browsers that ignore the attribute, with a generic binary type so browsers with a
 * built-in PDF viewer save it instead of opening it (public/_headers).
 */
import { format, i18n } from '../../i18n';
import { pageCountText, pdfSize } from '../../lib/book';
import { book } from '../../site';
import Cta from '../ui/Cta.astro';

interface Props {
  variant?: 'pill' | 'small' | 'icon';
  /**
   * Hint below the pill for in-app browsers, which often can't download files (shown by
   * book/index.ts).
   */
  inApp?: boolean;
  class?: string;
}

const { variant = 'pill', inApp = false, class: className } = Astro.props;
const { locale, t } = i18n(Astro.url);
const facts = format(t.book.facts, { size: pdfSize(locale), pages: pageCountText(locale) });
---

{
  variant === 'pill' ? (
    <div class:list={['book-download', className]}>
      <Cta href={book.pdf} download={book.fileName} type="application/pdf" arrow="down" label={t.book.download} data-book-download />
      <p class="book-download__facts">{facts}</p>
      {inApp && (
        <p class="book-download__inapp" data-book-inapp hidden>
          {t.book.inAppHint}
        </p>
      )}
    </div>
  ) : variant === 'icon' ? (
    <a class:list={['book-download__icon', className]} href={book.pdf} download={book.fileName} type="application/pdf" data-book-download>
      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path d="M10 3v10M5.5 8.75 10 13.25l4.5-4.5M4 16.5h12" />
      </svg>
      <span class="visually-hidden">
        {t.book.download} ({facts})
      </span>
    </a>
  ) : (
    <a class:list={['book-download__small', className]} href={book.pdf} download={book.fileName} type="application/pdf" data-book-download>
      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path d="M10 3v10M5.5 8.75 10 13.25l4.5-4.5M4 16.5h12" />
      </svg>
      <span>{t.book.downloadShort}</span>
      <span class="visually-hidden">({facts})</span>
    </a>
  )
}

<style>
  .book-download {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }

  .book-download__facts {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .book-download__small {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.2s ease;
  }

  @media (hover: hover) {
    .book-download__small:hover {
      border-color: var(--color-ink);
    }
  }

  .book-download__inapp {
    max-width: 22rem;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .book-download__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    color: var(--color-ink);
    transition: border-color 0.2s ease;
  }

  @media (hover: hover) {
    .book-download__icon:hover {
      border-color: var(--color-ink);
    }
  }

  .book-download__icon svg,
  .book-download__small svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
