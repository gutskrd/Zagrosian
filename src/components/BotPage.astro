---
/**
 * The Hevalo Discord bot's page (/hevalo-bot): what it does, the links that
 * add it to a server or to your own account, the permissions it asks for and
 * why, and its terms and privacy policy. All text is in `bot` in the message
 * files; the invite links and languages are in `hevaloBot` in src/site.ts.
 */
import { i18n } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { hevalo, hevaloBot, site } from '../site';
import Cta from './Cta.astro';
import HevaloIcon from './HevaloIcon.astro';

const { t, localize } = i18n(Astro.url);
const { bot } = t;
---

<BaseLayout title={`${bot.title} — ${site.name}`} description={bot.description} breadcrumb={bot.title}>
  <article class="bot" aria-labelledby="bot-title">
    <header class="container bot__hero">
      <p class="eyebrow">{bot.eyebrow}</p>
      <div class="bot__intro">
        <HevaloIcon class="bot__icon" sizes="(min-width: 40rem) 6rem, 4.5rem" />
        <h1 id="bot-title" class="bot__title">
          {
            bot.headline.map((line, index) => (
              <>
                {index > 0 && ' '}
                <span class="bot__line">{line}</span>
              </>
            ))
          }
        </h1>
      </div>
      <p class="lead bot__lead">{bot.lead}</p>
      <div class="bot__actions">
        <Cta href={hevaloBot.inviteUrl} arrow="up-right" label={bot.add} />
        <Cta href={hevaloBot.userInstallUrl} variant="outline" arrow="up-right" label={bot.addApp} />
      </div>
      <p class="bot__note">{bot.addAppNote}</p>
      <p class="bot__free">{bot.free}</p>
    </header>

    <section class="container bot__section" aria-labelledby="bot-features">
      <h2 id="bot-features" class="bot__heading">{bot.featuresTitle}</h2>
      <ul class="bot__features" role="list">
        {
          bot.features.map((feature) => (
            <li class="bot__feature rule">
              <h3 class="bot__feature-title">{feature.title}</h3>
              <p>{feature.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="container bot__section" aria-labelledby="bot-languages">
      <h2 id="bot-languages" class="bot__heading">{bot.languagesTitle}</h2>
      <p class="bot__text">{bot.languages}</p>
      <ul class="bot__languages" role="list">
        {
          hevaloBot.languages.map((language) => (
            <li lang={language.lang} dir={language.dir}>
              {language.name}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="container bot__section" aria-labelledby="bot-start">
      <h2 id="bot-start" class="bot__heading">{bot.startTitle}</h2>
      <ol class="bot__steps">
        {
          bot.steps.map((step) => (
            <li>
              <span>{step.text}</span>
              {step.command && (
                <code dir="ltr" translate="no">
                  {step.command}
                </code>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="container bot__section" aria-labelledby="bot-permissions">
      <h2 id="bot-permissions" class="bot__heading">{bot.permissionsTitle}</h2>
      <p class="bot__text">{bot.permissionsLead}</p>
      <dl class="bot__permissions">
        {
          bot.permissions.map((item) => (
            <div class="rule">
              <dt>{item.name}</dt>
              <dd>{item.why}</dd>
            </div>
          ))
        }
      </dl>
      <p class="bot__text bot__text--strong">{bot.noReading}</p>
    </section>

    <section class="container bot__section" aria-labelledby="bot-legal">
      <h2 id="bot-legal" class="bot__heading">{bot.legalTitle}</h2>
      <p class="bot__text">{bot.legalLead}</p>
      <div class="bot__legal-links">
        <Cta href={localize('/hevalo-bot-terms')} variant="link" label={bot.terms} />
        <Cta href={localize('/hevalo-bot-privacy')} variant="link" label={bot.privacy} />
      </div>
      <p class="bot__app">
        {bot.app} <a href={hevalo.url} dir="ltr">{hevalo.domain}</a>
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .bot {
    padding-block: calc(var(--header-height) + clamp(3rem, 2rem + 5vw, 7rem)) var(--section-space);
  }

  .bot__hero {
    display: grid;
    gap: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    /* One column no wider than the page: an auto column would grow to fit the
       heading and the buttons, and push a narrow phone's page sideways. */
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
  }

  /* The icon beside the heading; on a phone, above it. */
  .bot__intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1rem, 0.5rem + 2vw, 2rem);
  }

  .bot__icon {
    flex: none;
    width: clamp(4.5rem, 3rem + 4vw, 6rem);
  }

  .bot__title {
    flex: 1 1 18rem;
    min-width: 0;
    font-size: clamp(2.5rem, 1rem + 5.2vw, 6rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .bot__line {
    display: block;
  }

  .bot__lead {
    max-width: 44rem;
    color: var(--color-ink-soft);
  }

  .bot__actions,
  .bot__legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
  }

  /* Some languages' button labels ("Zum Discord-Server hinzufügen") are longer
     than a phone is wide. The rolling label (RollText) wraps between words,
     so here the button may wrap too, instead of running off the screen. */
  .bot__actions :global(.cta) {
    max-width: 100%;
    padding-block: 0.875rem;
    line-height: 1.2;
    white-space: normal;
  }

  .bot__note {
    max-width: 36rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* The studio-index small print the site uses for labels. */
  .bot__free {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  :root:is([lang='ar'], [lang='ckb'], [lang='fa']) .bot__free {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .bot__section {
    margin-top: clamp(4.5rem, 3rem + 6vw, 8rem);
  }

  .bot__heading {
    margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    font-size: clamp(1.875rem, 1.2rem + 2.4vw, 3.25rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .bot__text {
    max-width: 44rem;
    color: var(--color-ink-soft);
  }

  .bot__text--strong {
    margin-top: 2rem;
    color: var(--color-ink);
    font-weight: 500;
  }

  .bot__features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 0 clamp(1.5rem, 1rem + 2vw, 3rem);
    padding: 0;
    list-style: none;
  }

  .bot__feature {
    padding-block: 1.5rem 2.25rem;
  }

  .bot__feature-title {
    margin-bottom: 0.5rem;
    font-size: 1.1875rem;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .bot__feature p {
    color: var(--color-ink-soft);
  }

  .bot__languages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.75rem;
    padding: 0;
    list-style: none;
  }

  .bot__languages li {
    padding: 0.5rem 1rem;
    border: 0.8px solid var(--color-line-strong);
    border-radius: 999px;
    font-size: var(--text-sm);
  }

  .bot__steps {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
    padding-inline-start: 1.5rem;
  }

  .bot__steps li {
    padding-inline-start: 0.5rem;
  }

  .bot__steps li::marker {
    font-family: var(--font-mono);
    color: var(--color-muted);
  }

  .bot__steps code {
    display: inline-block;
    margin-inline-start: 0.5rem;
    padding: 0.125rem 0.5rem;
    border: 0.8px solid var(--color-line-strong);
    border-radius: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.875em;
    white-space: nowrap;
  }

  .bot__permissions {
    display: grid;
    max-width: 56rem;
    margin-top: 2rem;
  }

  .bot__permissions > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.25rem 2rem;
    padding-block: 1rem;
  }

  @media (min-width: 48rem) {
    .bot__permissions > div {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    }
  }

  .bot__permissions dt {
    font-weight: 500;
  }

  .bot__permissions dd {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .bot__app {
    margin-top: 2.5rem;
    color: var(--color-muted);
  }

  .bot__app a {
    /* At least 24px tall, so it is easy to tap (WCAG 2.5.8). */
    display: inline-block;
    padding-block: 0.25rem;
    color: var(--color-ink);
    text-decoration-color: var(--color-underline);
    text-underline-offset: 0.2em;
  }
</style>
