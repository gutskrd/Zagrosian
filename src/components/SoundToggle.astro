---
/**
 * Header button that switches sound on and off (src/scripts/sound.ts). Four
 * bars move like a level meter while sound is on; while it is off they dim and
 * a line crosses them.
 * The state is announced as pressed or not.
 */
import { i18n } from '../i18n';

interface Props {
  /** Show the word "Sound" beside the bars (in the mobile menu). */
  labelled?: boolean;
  class?: string;
}

const { labelled = false, class: className } = Astro.props;
const { t } = i18n(Astro.url);
---

<button
  class:list={['sound-toggle', labelled && 'sound-toggle--labelled', className]}
  type="button"
  aria-pressed="false"
  data-sound-toggle
  data-magnetic
>
  <span class:list={[!labelled && 'visually-hidden']}>{t.sound.label}</span>
  <span class="sound-toggle__bars" aria-hidden="true">
    <span></span><span></span><span></span><span></span>
  </span>
</button>

<style>
  /* Shown once theme-init.js has run; without JavaScript it could not work. */
  .sound-toggle {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 50%;
    background: none;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  :global(:root[data-theme]) .sound-toggle {
    display: inline-grid;
  }

  /* With its name: a pill, bars after the word. */
  .sound-toggle--labelled {
    grid-auto-flow: column;
    gap: 0.75rem;
    width: auto;
    height: 2.75rem;
    padding: 0 1.125rem;
    border-color: var(--color-line-strong);
    border-radius: 999px;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  @media (hover: hover) {
    .sound-toggle:hover {
      border-color: var(--color-line-strong);
      color: var(--color-ink);
    }
  }

  .sound-toggle[aria-pressed='true'] {
    color: var(--color-ink);
  }

  .sound-toggle__bars {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
    height: 1rem;
  }

  .sound-toggle__bars span {
    width: 2px;
    height: 100%;
    border-radius: 1px;
    background: currentColor;
    transform: scaleY(0.55);
    transition:
      transform 0.4s var(--ease-out),
      opacity 0.3s ease;
  }

  .sound-toggle__bars span:nth-child(2) {
    transform: scaleY(0.9);
  }

  .sound-toggle__bars span:nth-child(3) {
    transform: scaleY(0.4);
  }

  .sound-toggle__bars span:nth-child(4) {
    transform: scaleY(0.7);
  }

  /* Off: the bars dim and a line crosses them. */
  .sound-toggle[aria-pressed='false'] .sound-toggle__bars span {
    opacity: 0.45;
  }

  .sound-toggle__bars::after {
    content: '';
    position: absolute;
    top: 50%;
    left: -3px;
    right: -3px;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    rotate: -45deg;
    transition: scale 0.3s var(--ease-out);
  }

  .sound-toggle[aria-pressed='true'] .sound-toggle__bars::after {
    scale: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sound-toggle[aria-pressed='true'] .sound-toggle__bars span {
      animation: sound-level 1.1s ease-in-out infinite alternate;
    }

    .sound-toggle[aria-pressed='true'] .sound-toggle__bars span:nth-child(2) {
      animation-duration: 0.8s;
      animation-delay: -0.3s;
    }

    .sound-toggle[aria-pressed='true'] .sound-toggle__bars span:nth-child(3) {
      animation-duration: 1.3s;
      animation-delay: -0.7s;
    }

    .sound-toggle[aria-pressed='true'] .sound-toggle__bars span:nth-child(4) {
      animation-duration: 0.95s;
      animation-delay: -0.2s;
    }
  }

  @keyframes sound-level {
    from {
      transform: scaleY(0.2);
    }

    to {
      transform: scaleY(1);
    }
  }
</style>
