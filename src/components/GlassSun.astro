      10.91% 18.83%,
      32.59% 31.23%,
      21.83% 8.69%,
      38.89% 26.94%,
      35.26% 2.22%,
      46.18% 24.69%,
      50% 0%,
      50% 6%,
      46.64% 27.72%,
      37.03% 7.95%,
      40.23% 29.7%,
      25.21% 13.65%,
      34.68% 33.49%,
      15.6% 22.57%,
