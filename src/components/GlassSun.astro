      67.61% 64.05%,
      88.11% 72%,
      70.97% 58.23%,
      92.9% 59.79%,
      72.47% 51.68%,
      93.88% 46.71%,
      71.96% 44.99%,
      90.96% 33.92%,
      69.51% 38.74%,
      84.4% 22.57%,
      65.32% 33.49%,
      74.79% 13.65%,
      59.77% 29.7%,
      62.97% 7.95%,
      53.36% 27.72%,
      50% 6%
    );
    --face: polygon(
      50% 6%,
      53.36% 27.72%,
      62.97% 7.95%,
      59.77% 29.7%,
      74.79% 13.65%,
      65.32% 33.49%,
