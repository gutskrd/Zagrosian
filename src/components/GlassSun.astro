      9.04% 33.92%,
      28.04% 44.99%,
      6.12% 46.71%,
      27.53% 51.68%,
      7.1% 59.79%,
      29.03% 58.23%,
      11.89% 72%,
      32.39% 64.05%,
      20.07% 82.25%,
      37.31% 68.61%,
      30.91% 89.64%,
      43.36% 71.53%,
      43.44% 93.51%,
      50% 72.53%,
      56.56% 93.51%,
