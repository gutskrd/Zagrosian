      64.42% 71.15%,
      71.69% 95.05%,
      57.55% 74.46%,
      57.45% 99.44%,
      50% 75.6%,
      42.55% 99.44%,
      42.45% 74.46%,
      28.31% 95.05%,
      35.58% 71.15%,
      15.99% 86.65%,
      29.99% 65.96%,
      6.7% 75%,
      26.17% 59.35%,
      1.25% 61.13%,
      24.47% 51.91%,
      0.14% 46.26%,
      25.04% 44.3%,
      3.46% 31.73%,
      27.83% 37.2%,
      10.91% 18.83%,
      32.59% 31.23%,
      21.83% 8.69%,
      38.89% 26.94%,
      35.26% 2.22%,
      46.18% 24.69%
    );
    /* The rim: the outline less the same outline 88% as large, round the
       same middle; and that smaller outline, the face inside the rim. */
    --rim: polygon(
      evenodd,
      50% 0%,
      53.82% 24.69%,
      64.74% 2.22%,
      61.11% 26.94%,
      78.17% 8.69%,
      67.41% 31.23%,
      89.09% 18.83%,
      72.17% 37.2%,
      96.54% 31.73%,
      74.96% 44.3%,
      99.86% 46.26%,
      75.53% 51.91%,
      98.75% 61.13%,
      73.83% 59.35%,
      93.3% 75%,
      70.01% 65.96%,
      84.01% 86.65%,
      64.42% 71.15%,
      71.69% 95.05%,
      57.55% 74.46%,
      57.45% 99.44%,
      50% 75.6%,
      42.55% 99.44%,
