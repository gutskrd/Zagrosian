    /* The sun's outline: the rays' tips on a circle filling the box, the gaps
       between them on one 51.2% as large. */
    --shape: polygon(
      50% 0%,
      53.82% 24.69%,
      64.74% 2.22%,
      61.11% 26.94%,
      78.17% 8.69%,
      67.41% 31.23%,
      89.09% 18.83%,
