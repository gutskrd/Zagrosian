---
/**
 * The Kurdish sun as a thick piece of glass, in 3D, for the homepage story
 * (Story.astro, src/scripts/story.ts).
 *
 * Every layer is cut to the sun's outline (21 rays, the gaps between them at
 * 51.2% of the rays' length, as in src/lib/sun.ts) with `clip-path`, so the
 * edges are drawn as vectors at any size. A faint back face, set back by
 * the glass's thickness, makes the body, clear but for its depth, which
 * shows as it turns. At the front, a bright bevel runs round the edge of a
 * clear face, which catches the light at its top left, and a glint slides
 * across it as it turns. (There are no layers in between: each would be cut
 * to the outline and redrawn as the sun tumbles, and a dozen of them made
 * the page stutter.)
 *
 * It takes its colour from the text colour around it, so it is clear glass
 * in whatever colours it is set in. Its pose comes from custom properties
 * (--sun-pitch, --sun-yaw, --sun-roll, --sun-glint); without them it faces
 * forward. Decorative, so it is hidden from screen readers.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['glass-sun', className]} aria-hidden="true">
  <span class="glass-sun__body">
    <span class="glass-sun__layer glass-sun__back"></span>
    <span class="glass-sun__layer glass-sun__bevel"></span>
    <span class="glass-sun__layer glass-sun__face"></span>
    <span class="glass-sun__layer glass-sun__glint"></span>
  </span>
</span>

<style>
