      62.69% 68.61%,
      69.09% 89.64%,
      56.64% 71.53%,
      56.56% 93.51%,
      50% 72.53%,
      43.44% 93.51%,
      43.36% 71.53%,
      30.91% 89.64%,
      37.31% 68.61%,
      20.07% 82.25%,
      32.39% 64.05%,
      11.89% 72%,
      29.03% 58.23%,
      7.1% 59.79%,
      27.53% 51.68%,
      6.12% 46.71%,
      28.04% 44.99%,
      9.04% 33.92%,
      30.49% 38.74%,
      15.6% 22.57%,
      34.68% 33.49%,
      25.21% 13.65%,
      40.23% 29.7%,
      37.03% 7.95%,
      46.64% 27.72%
    );
    --thickness: 10cqi;

    position: relative;
    display: block;
    aspect-ratio: 1;
    container-type: inline-size;
    transform-style: preserve-3d;
  }

  .glass-sun__body {
    position: absolute;
    inset: 0;
    transform: rotateX(var(--sun-pitch, 0deg)) rotateY(var(--sun-yaw, 0deg)) rotateZ(var(--sun-roll, 0deg));
    transform-origin: 50% 50% calc(var(--thickness) * -0.5);
    transform-style: preserve-3d;
  }

  .glass-sun__layer {
    --f: 0;

    position: absolute;
    inset: 0;
    clip-path: var(--shape);
    transform: translateZ(calc(var(--thickness) * var(--f) * -1));
  }

  /* The back face, faint: clear glass, which shows its depth as it turns. */
  .glass-sun__back {
    --f: 1;

    background: color-mix(in srgb, currentColor 16%, transparent);
  }

  /* The front: a bright bevel round the edge, lit from the top left, round
     a clear face with a highlight at its top left. */
  .glass-sun__bevel {
    clip-path: var(--rim);
    background: linear-gradient(
      150deg,
      currentColor,
      color-mix(in srgb, currentColor 40%, transparent) 55%,
      color-mix(in srgb, currentColor 80%, transparent)
    );
  }

  .glass-sun__face,
  .glass-sun__glint {
    clip-path: var(--face);
    transform: translateZ(0.5px);
  }

  .glass-sun__face {
    background:
      radial-gradient(circle at 34% 28%, color-mix(in srgb, currentColor 46%, transparent), transparent 42%),
      linear-gradient(
        150deg,
        color-mix(in srgb, currentColor 24%, transparent),
        color-mix(in srgb, currentColor 6%, transparent) 55%,
        color-mix(in srgb, currentColor 16%, transparent)
      );
  }

  /* A band of light across the face, which slides as the sun turns. */
  .glass-sun__glint {
    background: linear-gradient(
      118deg,
      transparent 42%,
      color-mix(in srgb, currentColor 65%, transparent) 50%,
      transparent 58%
    );
    background-size: 300% 100%;
    background-position: var(--sun-glint, 50%) 0;
  }

  @media (forced-colors: active) {
    .glass-sun__layer:not(.glass-sun__bevel) {
      display: none;
    }

    .glass-sun__bevel {
      background: CanvasText;
    }
  }
</style>
