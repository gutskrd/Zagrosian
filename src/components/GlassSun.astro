---
/**
 * The Kurdish sun as a thick piece of glass, in 3D, for the homepage story
 * (Story.astro, src/scripts/story.ts).
 *
 * Every layer is drawn in the sun's outline (21 rays, the gaps between them at
 * 51.2% of the rays' length, from src/lib/sun.ts), as vector shapes, sharp at
 * any size. A faint back face, set back by the glass's thickness, makes the
 * body, clear but for its depth, which shows as it turns. At the front, a
 * bright bevel runs round the edge of a clear face, which catches the light at
 * its top left, and a glint slides across it as it turns. (There are no layers
 * in between: a dozen of them made the page stutter.) The layers are drawn as
 * shapes rather than cut out with `clip-path`: a cut-out layer that turns in
 * 3D is cut out anew on every frame.
 *
 * It takes its colour from the text colour around it, so it is clear glass
 * in whatever colours it is set in. story.ts turns it by setting the
 * transform of its body (`.glass-sun__body`) and slides the glint by setting
 * that of its band (`.glass-sun__band`), directly: custom properties set round
 * it would be inherited by the vector layers, which the browser then draws
 * again on every frame. Without them it faces forward, the glint in the
 * middle. Decorative, so it is hidden from screen readers.
 */
import { sunOutline } from '../lib/sun';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// The outline, and the face inside the rim: the same outline 88% as large.
const outline = sunOutline();
const face = sunOutline(0.88);
// Gradients are named per page; there is one sun.
const id = 'glass-sun';
---

<span class:list={['glass-sun', className]} aria-hidden="true">
  <span class="glass-sun__body">
    <svg class="glass-sun__layer glass-sun__back" viewBox="-100 -100 200 200" focusable="false">
      <path d={outline} fill="currentColor" fill-opacity="0.16"></path>
    </svg>
    <svg class="glass-sun__layer glass-sun__bevel" viewBox="-100 -100 200 200" focusable="false">
      <defs>
        {/* As linear-gradient(150deg, …) across the box. */}
        <linearGradient id={`${id}-bevel`} gradientUnits="userSpaceOnUse" x1="-68.3" y1="-118.3" x2="68.3" y2="118.3">
          <stop offset="0" stop-color="currentColor"></stop>
          <stop offset="0.55" stop-color="currentColor" stop-opacity="0.4"></stop>
          <stop offset="1" stop-color="currentColor" stop-opacity="0.8"></stop>
        </linearGradient>
      </defs>
      <path d={`${outline}${face}`} fill-rule="evenodd" fill={`url(#${id}-bevel)`}></path>
    </svg>
    <svg class="glass-sun__layer glass-sun__face" viewBox="-100 -100 200 200" focusable="false">
      <defs>
        <linearGradient id={`${id}-face`} gradientUnits="userSpaceOnUse" x1="-68.3" y1="-118.3" x2="68.3" y2="118.3">
          <stop offset="0" stop-color="currentColor" stop-opacity="0.24"></stop>
          <stop offset="0.55" stop-color="currentColor" stop-opacity="0.06"></stop>
          <stop offset="1" stop-color="currentColor" stop-opacity="0.16"></stop>
        </linearGradient>
        {/* As radial-gradient(circle at 34% 28%, …): to the farthest corner. */}
        <radialGradient id={`${id}-light`} gradientUnits="userSpaceOnUse" cx="-32" cy="-44" r="195.34">
          <stop offset="0" stop-color="currentColor" stop-opacity="0.46"></stop>
          <stop offset="0.42" stop-color="currentColor" stop-opacity="0"></stop>
        </radialGradient>
      </defs>
      <path d={face} fill={`url(#${id}-face)`}></path>
      <path d={face} fill={`url(#${id}-light)`}></path>
    </svg>
    <svg class="glass-sun__layer glass-sun__glint" viewBox="-100 -100 200 200" focusable="false">
      <defs>
        <clipPath id={`${id}-face-clip`}>
          <path d={face}></path>
        </clipPath>
        {/* A band at 118deg across a strip three times as wide as the sun. */}
        <linearGradient id={`${id}-glint`} gradientUnits="userSpaceOnUse" x1="-75.3" y1="-146.4" x2="475.3" y2="146.4">
          <stop offset="0.42" stop-color="currentColor" stop-opacity="0"></stop>
          <stop offset="0.5" stop-color="currentColor" stop-opacity="0.65"></stop>
          <stop offset="0.58" stop-color="currentColor" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <g clip-path={`url(#${id}-face-clip)`}>
        <rect class="glass-sun__band" x="-100" y="-100" width="600" height="200" fill={`url(#${id}-glint)`}></rect>
      </g>
    </svg>
  </span>
</span>

<style>
  .glass-sun {
    --thickness: 10cqi;

    position: relative;
    display: block;
    aspect-ratio: 1;
    container-type: inline-size;
    transform-style: preserve-3d;
  }

  .glass-sun__body {
    position: absolute;
    inset: 0;
    transform-origin: 50% 50% calc(var(--thickness) * -0.5);
    transform-style: preserve-3d;
  }

  .glass-sun__layer {
    --f: 0;

    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform: translateZ(calc(var(--thickness) * var(--f) * -1));
  }

  /* The back face, set back by the glass's thickness. */
  .glass-sun__back {
    --f: 1;
  }

  /* The face and its glint, just in front of the bevel round them. */
  .glass-sun__face,
  .glass-sun__glint {
    transform: translateZ(0.5px);
  }

  /* The band of light across the face: the strip it lies on is three times
     as wide as the sun, here with its middle over the sun's middle. */
  .glass-sun__band {
    transform: translateX(-200px);
  }

  @media (forced-colors: active) {
    .glass-sun__layer:not(.glass-sun__bevel) {
      display: none;
    }

    .glass-sun__bevel path {
      fill: CanvasText;
    }
  }
</style>
