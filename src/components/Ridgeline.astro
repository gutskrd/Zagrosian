---
/**
 * Two hairline ridges: an abstract nod to the Zagros range the company is
 * named after, which also reads as a signal line. The shapes are generated
 * deterministically at build time, so the output is static SVG.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const WIDTH = 1440;
const HEIGHT = 160;
const STEPS = 120;

/** mulberry32: a tiny seeded PRNG, so every build draws the same ridge. */
function random(seed: number) {
  let state = seed >>> 0;
  return () => {
    state = (state + 0x6d2b79f5) >>> 0;
    let t = state;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/** Folded ridges (sharp crests, soft valleys) under a gentle envelope. */
function ridge(seed: number, lift = 0) {
  const rand = random(seed);
  const phases = Array.from({ length: 3 }, () => rand() * Math.PI * 2);
  const points: string[] = [];

  for (let i = 0; i <= STEPS; i++) {
    const t = i / STEPS;
    const envelope = 0.3 + 0.7 * Math.pow(Math.sin(Math.PI * (0.15 + t * 0.8)), 1.5);
    const folds =
      0.55 * (1 - Math.abs(Math.sin(t * Math.PI * 3.1 + phases[0]))) +
      0.3 * (1 - Math.abs(Math.sin(t * Math.PI * 7.3 + phases[1]))) +
      0.15 * (1 - Math.abs(Math.sin(t * Math.PI * 17.9 + phases[2])));
    const jitter = (rand() - 0.5) * 0.05;
    const elevation = envelope * (0.35 + 0.65 * folds) + jitter + lift;
    const y = HEIGHT - 8 - elevation * (HEIGHT - 24);
    points.push(`${(t * WIDTH).toFixed(1)},${y.toFixed(1)}`);
  }

  return points.join(' ');
}

const back = ridge(23, 0.12);
const front = ridge(42);
---

<div class:list={['ridgeline', className]} aria-hidden="true">
  <svg viewBox={`0 0 ${WIDTH} ${HEIGHT}`} preserveAspectRatio="none" focusable="false">
    <polyline class="ridgeline__back" points={back} vector-effect="non-scaling-stroke"></polyline>
    <polyline class="ridgeline__front" points={front} vector-effect="non-scaling-stroke"></polyline>
  </svg>
</div>

<style>
  .ridgeline {
    overflow: hidden;
    pointer-events: none;
  }

  svg {
    /* Wider than small screens, so the ridge keeps its proportions instead of compressing. */
    width: max(100%, 60rem);
    height: clamp(4.5rem, 2.5rem + 9vw, 11rem);
    margin-left: 50%;
    transform: translateX(-50%);
    overflow: visible;
  }

  polyline {
    fill: none;
    stroke-width: 1;
    stroke-linejoin: round;
  }

  .ridgeline__back {
    stroke: #cfcfcf;
  }

  .ridgeline__front {
    stroke: var(--color-ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .ridgeline__front {
      animation: ridge-draw 2.4s var(--ease-out) 0.35s both;
    }

    .ridgeline__back {
      animation: ridge-draw 2.8s var(--ease-out) 0.6s both;
    }
  }

  @keyframes ridge-draw {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
</style>
