---
const principles = [
  {
    title: 'Community',
    text: 'Social products that help people connect and stay in touch, wherever they live.',
  },
  {
    title: 'Language',
    text: 'Making Kurdish a first-class language in the software people use every day.',
  },
  {
    title: 'Quality',
    text: 'Fast, reliable and carefully made, to the same standard as the best software anywhere.',
  },
];
---

<section class="principles section" aria-labelledby="principles-title">
  <div class="container">
    <div class="principles__intro" data-reveal>
      <p class="eyebrow">What we do</p>
      <h2 id="principles-title" class="heading-2">We build for the Kurdish language and the people who speak&nbsp;it.</h2>
    </div>

    <ol class="principles__list">
      {
        principles.map((principle, index) => (
          <li class="principles__item" data-reveal>
            <span class="principles__index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="principles__title">{principle.title}</h3>
            <p class="principles__text">{principle.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .principles__intro .heading-2 {
    max-width: 18ch;
    margin-top: 1.25rem;
  }

  .principles__list {
    display: grid;
    margin-top: clamp(4rem, 2.5rem + 5vw, 7.5rem);
  }

  .principles__item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    align-content: start;
    column-gap: 1rem;
    padding-block: 2rem 2.5rem;
    border-top: 1px solid var(--color-line);
  }

  .principles__index {
    grid-row: span 2;
    padding-top: 0.3rem;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }

  .principles__title {
    font-size: var(--text-h3);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .principles__text {
    max-width: 26rem;
    margin-top: 0.75rem;
    color: var(--color-ink-soft);
  }

  @media (min-width: 48rem) {
    .principles__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }

    .principles__item {
      grid-template-columns: 1fr;
      padding-block: 1.75rem 0;
    }

    .principles__index {
      grid-row: auto;
      padding-top: 0;
    }

    .principles__title {
      margin-top: clamp(3rem, 2rem + 3vw, 5rem);
    }

    .principles__item:nth-child(2) {
      --reveal-delay: 0.1s;
    }

    .principles__item:nth-child(3) {
      --reveal-delay: 0.2s;
    }
  }
</style>
