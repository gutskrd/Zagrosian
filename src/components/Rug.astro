---
/**
 * A kilim of wool beside the About text (drawn by scripts/kilim.mjs, after
 * the motifs of Kurdish kilims from the Zagros: hooked diamonds, ram's horns
 * and eyes).
 *
 * In 3D where the browser has WebGL 2 (rug-scene.ts, loaded as the rug comes
 * near): it hangs in the light and unrolls as it scrolls into view, leans
 * towards the pointer with a glare under it, as Apple TV's posters do (on a
 * touch screen, towards the finger), and its fringe swings when it moves.
 * Until then, and without WebGL, it is a flat picture of the same rug.
 * Decorative: it is hidden from assistive technology.
 */
---

<div class="rug" data-rug aria-hidden="true">
  <div class="rug__flat"><div class="rug__ink"></div></div>
  <canvas class="rug__canvas"></canvas>
</div>

<style>
  /* The stage: the rug and the room it needs to lean and cast its shadow. */
  .rug {
    position: relative;
    width: min(100%, 30rem);
    aspect-ratio: 3 / 5;
    margin-inline: auto;
    /* A sideways drag leans the rug; scrolling stays the page's. */
    touch-action: pan-y;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* The flat picture, where the 3D rug will hang. */
  .rug__flat {
    position: absolute;
    top: 9%;
    left: 12%;
    width: 76%;
    aspect-ratio: 47 / 77;
    background: #e2ded4;
    box-shadow: 0 1.5rem 3rem -1rem rgb(0 0 0 / 0.3);
  }

  /* Its fringe. */
  .rug__flat::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 1%;
    right: 1%;
    height: 9%;
    background: repeating-linear-gradient(to right, #d6d1c5 0 2px, transparent 2px 5px);
  }

  .rug__ink {
    position: absolute;
    inset: 0;
    background: #171615;
    mask: url('../assets/kilim/rug.svg') 0 0 / 100% 100% no-repeat;
  }

  .rug__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .rug[data-live] .rug__canvas {
    opacity: 1;
  }

  /* Once the 3D rug is drawn the picture goes at once, so the two never
     show together. */
  .rug[data-live] .rug__flat {
    opacity: 0;
    transition: none;
  }

  /* In forced colours (Windows High Contrast), in the visitor's own colours. */
  @media (forced-colors: active) {
    .rug__flat {
      forced-color-adjust: none;
      background: Canvas;
      box-shadow: none;
    }

    .rug__ink {
      forced-color-adjust: none;
      background: CanvasText;
    }

    .rug__canvas {
      display: none;
    }

    .rug[data-live] .rug__flat {
      opacity: 1;
    }
  }
</style>
