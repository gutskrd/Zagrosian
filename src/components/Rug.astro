---
/**
 * A rug lying on the floor in late sun: a pile rug after those of Bijar and
 * Senneh, Kurdish weaving towns in the Zagros (drawn by scripts/rug.mjs). It
 * is simply there, its nearest corner turned up, and it can be picked up:
 * lift the corner and fold it over, drag it, twist it round (rug-scene.ts,
 * loaded as it comes near; WebGL 2).
 *
 * Under it lies a paper plane (Proverb.astro, plane.ts), which takes its place
 * from the size and lie of the rug set here: `--rug-share` (its width, as a
 * share of the stage's) and `--rug-angle` (radians). The scene reads them too,
 * and the flat picture is placed by them, so all agree. Until the scene is
 * ready, and without WebGL, the flat picture lies there.
 */
import rugPicture from '../assets/rug/rug.webp?url';
import rugSmall from '../assets/rug/rug-small.webp?url';

// The rug is a little under a quarter of the stage wide on a computer, a little more than a
// third on a tablet and half on a phone (--rug-share below): the browser picks
// the picture that is fine enough, and the 3D scene uses the same one.
const sizes = '(max-width: 39.99rem) 50vw, (max-width: 63.99rem) 36vw, 25vw';
---

<div class="rug" data-rug>
  {/* The paper plane, while it lies here (plane.ts): under the rug, and part of the floor, so it scrolls with it exactly. */}
  <canvas class="rug__plane" aria-hidden="true" data-plane-rest hidden></canvas>
  <div class="rug__flat" aria-hidden="true">
    {/* The first thing on the homepage: fetched at once. */}
    <img
      src={rugPicture}
      srcset={`${rugSmall} 606w, ${rugPicture} 1010w`}
      sizes={sizes}
      alt=""
      width="1010"
      height="1730"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <canvas class="rug__canvas" aria-hidden="true"></canvas>
</div>

<style>
  /* The floor, with room around the rug for the light, and to move and fold
     it; on a computer low enough that the hint and the button below it are
     on the first screen too. Lying turned, the rug (fringe and shadow
     included) is never more than nine tenths of the floor's height: its
     canvas would cut them off in a straight line. */
  .rug {
    --rug-share: 0.235;
    --rug-angle: -0.5;
    --rug-width: calc(var(--rug-share) * 100cqw);
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 1;
    container-type: inline-size;
    /* A swipe up or down still scrolls the page, and two fingers still zoom
       it; the rug is picked up by pressing on it (on a touch screen, by
       pressing and holding, or by setting off sideways: rug-scene.ts). */
    touch-action: pan-y pinch-zoom;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }

  @media (max-width: 63.99rem) {
    .rug {
      --rug-share: 0.36;
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 39.99rem) {
    .rug {
      --rug-share: 0.5;
      aspect-ratio: 4 / 5;
    }
  }

  /* On a computer whose screen is short (1280 by 720, 1366 by 768), the
     floor is lower and the rug a little smaller, so the rug and its button
     still fit the first screen; shorter still, smaller again. */
  @media (min-width: 64rem) and (max-height: 56.24rem) {
    .rug {
      --rug-share: 0.2;
      aspect-ratio: 2.3 / 1;
    }
  }

  @media (min-width: 64rem) and (max-height: 40rem) {
    .rug {
      --rug-share: 0.168;
      aspect-ratio: 2.8 / 1;
    }
  }

  /* A phone held sideways: a long, low floor, so the whole rug is in sight. */
  @media (max-width: 63.99rem) and (orientation: landscape) and (max-height: 32rem) {
    .rug {
      --rug-share: 0.17;
      aspect-ratio: 2.6 / 1;
    }
  }

  .rug[data-over] {
    cursor: grab;
  }

  .rug[data-holding] {
    cursor: grabbing;
  }

  /* Placed and sized by plane.ts round the plane; first in the stage, so the
     picture and the 3D rug, and the rug's shadow, lie over it. */
  .rug__plane {
    position: absolute;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.6s var(--ease-out);
  }

  /* It is drawn once the rug covers it (rug.ts), and the bit of it that
     shows comes up softly, as if it had been there all along. */
  .rug:not([data-covered]) .rug__plane {
    opacity: 0;
  }

  /* The flat picture hangs from the rug's centre, turned as it lies: 101 by
     161 cells of pile and six of fringe at either end. */
  .rug__flat {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--rug-width);
    aspect-ratio: 101 / 173;
    transform: translate(-50%, -50%) rotate(calc(var(--rug-angle) * 1rad));
    filter: drop-shadow(0 0.6rem 0.9rem rgb(0 0 0 / 0.3));
    transition:
      transform 0.9s var(--ease-in-out),
      visibility 0s;
  }

  .rug__flat img {
    display: block;
    width: 100%;
    height: 100%;
    transition: opacity 0.45s var(--ease-out);
  }

  /* With the script (theme-init.js has run), the picture waits until it is
     whole (rug.ts), then comes up: a slow connection never shows it arriving
     row by row. Without it, the picture shows as it loads. */
  :global(:root[data-theme]) .rug:not([data-pictured]) .rug__flat img {
    opacity: 0;
  }

  /* Lifted without the 3D scene: the picture is drawn back along its length. */
  .rug[data-lifted] .rug__flat {
    transform: translate(-50%, -50%) rotate(calc(var(--rug-angle) * 1rad)) translateY(-58%);
  }

  @media (prefers-reduced-motion: reduce) {
    .rug__flat {
      transition: visibility 0s;
    }
  }

  .rug__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.7s var(--ease-out);
    /* Whatever reaches the floor's foot (the last of the rug's shadow, or the
       rug carried there) fades out, never cut off in a line. */
    mask-image: linear-gradient(to bottom, #000 calc(100% - 0.75rem), transparent);
  }

  /* Once the 3D rug is ready it comes up over the picture, as the light
     settles on it, and the picture goes only when it is fully there: the
     floor never shows between them. */
  .rug[data-live] .rug__canvas {
    opacity: 1;
  }

  .rug[data-live] .rug__flat {
    visibility: hidden;
    transition:
      transform 0.9s var(--ease-in-out),
      visibility 0s 0.7s;
  }

  /* With reduced motion the rug comes at once (global.css), and so the picture goes at once. */
  @media (prefers-reduced-motion: reduce) {
    .rug[data-live] .rug__flat {
      transition-delay: 0s;
    }
  }

  /* In forced colours (Windows High Contrast) the picture stays, as an outline. */
  @media (forced-colors: active) {
    .rug__flat {
      filter: none;
      outline: 2px solid CanvasText;
    }

    .rug__canvas,
    .rug__plane {
      display: none;
    }

    .rug[data-live] .rug__flat {
      visibility: visible;
    }
  }

  @media print {
    .rug__plane {
      display: none;
    }
  }
</style>
