---
/**
 * A small kilim beside the About text: three hooked medallions, ram's horns
 * and eyes, in the page's own ink (drawn by scripts/kilim.mjs; the drawing
 * is our own, after the motifs of Kurdish kilims from the Zagros).
 *
 * It lies on its warp threads, which hang out at both ends as the fringe.
 * Where the browser runs scroll-linked animations itself, it is woven as it
 * comes into view: row by row from the bottom up, as on a loom, over the warp
 * (and unpicked again when scrolled back). Elsewhere, and for visitors who
 * prefer reduced motion, it is simply there.
 *
 * Each cell of the weave is a whole number of pixels, as large as the column
 * allows (up to 6), so its edges stay sharp.
 */
import { i18n } from '../i18n';

const { t } = i18n(Astro.url);
---

<figure class="rug">
  <div class="rug__loom" aria-hidden="true">
    <div class="rug__weave"><div class="rug__ink"></div></div>
  </div>
  <figcaption class="rug__caption">{t.about.rug}</figcaption>
</figure>

<style>
  .rug {
    container-type: inline-size;
    margin: 0;
  }

  /* 47 by 77 cells, as in rug.svg, with five cells of fringe at either end. */
  .rug__loom {
    --cell: 5px;
    position: relative;
    width: calc(47 * var(--cell));
    height: calc(77 * var(--cell));
    margin-block: calc(5 * var(--cell));
  }

  @supports (width: round(down, 10px, 1px)) {
    .rug__loom {
      --cell: clamp(3px, round(down, 100cqi / 47, 1px), 6px);
    }
  }

  /* The warp: a thread in every other column, from fringe to fringe. */
  .rug__loom::before {
    content: '';
    position: absolute;
    inset: calc(-5 * var(--cell)) var(--cell);
    background: repeating-linear-gradient(
      to right,
      var(--color-line-strong) 0 1px,
      transparent 1px calc(2 * var(--cell))
    );
  }

  /* The weft, which covers the warp: the rug's ground, with the pattern in
     the page's ink on it. */
  .rug__weave {
    position: absolute;
    inset: 0;
    background: var(--color-paper);
  }

  .rug__ink {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    mask: url('../assets/kilim/rug.svg') 0 0 / 100% 100% no-repeat;
  }

  /* In forced colours (Windows High Contrast), in the visitor's own text and
     background colours, which would otherwise replace the ink and the ground. */
  @media (forced-colors: active) {
    .rug__loom {
      forced-color-adjust: none;
    }

    .rug__loom::before {
      display: none;
    }

    .rug__weave {
      background: Canvas;
    }

    .rug__ink {
      background: CanvasText;
    }
  }

  .rug__caption {
    max-width: 22rem;
    margin-top: 1rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .rug__loom {
    view-timeline-name: --rug;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Separate properties, so the minifier cannot fold the timeline into
         the `animation` shorthand (which browsers do not accept). */
      .rug__weave {
        animation-name: rug-weave;
        animation-timing-function: steps(77, end);
        animation-fill-mode: both;
        animation-timeline: --rug;
        animation-range: entry 0% cover 45%;
      }
    }
  }

  /* From nothing to the top row, a row at a time. */
  @keyframes rug-weave {
    from {
      clip-path: inset(100% 0 0 0);
    }

    to {
      clip-path: inset(0 0 0 0);
    }
  }
</style>
