---
/**
 * Site header, identical at every size: logo and wordmark, a few controls, and the menu button that
 * opens the full-screen menu (SiteMenu.astro) where navigation lives.
 *
 * Left to right, as space allows: Visit Hevalo (from 768px), the command menu (from 1024px, JS
 * only), the language picker, and the menu button. The bar is deliberately sparse; sound and theme
 * are settings, so they live in the menu and the command menu, as do languages on the narrowest
 * phones.
 */
import Arrow from '../ui/Arrow.astro';
import LanguagePicker from './LanguagePicker.astro';
import Logo from '../ui/Logo.astro';
import MenuButton from './MenuButton.astro';
import RollText from '../ui/RollText.astro';
import SiteMenu from './SiteMenu.astro';
import Wordmark from '../ui/Wordmark.astro';
import { i18n } from '../../i18n';
import { hevalo } from '../../site';

const { t, localize } = i18n(Astro.url);
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="site-header__home" href={localize('/')} aria-label={t.common.homeLink}>
      <Logo class="site-header__mark" />
      <Wordmark class="site-header__wordmark" />
    </a>

    <div class="site-header__end">
      <a class="site-header__cta" href={hevalo.url}>
        <span class="site-header__cta-pour" aria-hidden="true"></span>
        <span class="site-header__cta-content">
          <RollText text={t.nav.visitHevalo} />
          <Arrow direction="up-right" />
        </span>
      </a>

      <button class="command-trigger" type="button" aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K" data-command-open>
        <svg class="command-trigger__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <circle cx="8.75" cy="8.75" r="5.75"></circle>
          <path d="M13 13l4.25 4.25"></path>
        </svg>
        <span class="visually-hidden">{t.command.open}</span>
      </button>

      <div class="site-header__language">
        <LanguagePicker />
      </div>

      <MenuButton />
    </div>
  </div>

  <SiteMenu />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
    box-shadow: 0 1px 0 transparent;
    color: var(--color-ink);
    transition:
      box-shadow 0.3s ease,
      background-color 0.3s ease,
      color 0.3s ease;
    view-transition-name: site-header;
  }

  .site-header[data-scrolled] {
    box-shadow: 0 1px 0 var(--color-line);
  }

  /* Reduced transparency: solid header. */
  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--color-paper);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--header-height);
  }

  .site-header__home {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    text-decoration: none;
  }

  .site-header__home :global(.site-header__mark) {
    width: 1.75rem;
  }

  /* The footer's large wordmark already names the site: while it's on screen, the header keeps
     only the logo mark (navigation.ts). Only after scrolling, so a short page never changes on
     load; the link keeps its accessible name either way. */
  .site-header__home :global(.site-header__wordmark) {
    transition:
      opacity 0.35s ease,
      translate 0.35s var(--ease-out);
  }

  .site-header[data-scrolled][data-footer-visible] .site-header__home :global(.site-header__wordmark) {
    opacity: 0;
    translate: -0.375rem 0;
  }

  :global(:root[dir='rtl']) .site-header[data-scrolled][data-footer-visible] .site-header__home :global(.site-header__wordmark) {
    translate: 0.375rem 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__home :global(.site-header__wordmark) {
      transition: none;
    }
  }

  .site-header__end {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* Header labels never wrap; the breakpoints below leave room for the longest locale. */
  .site-header__cta {
    flex: none;
    white-space: nowrap;
  }

  /* Visit Hevalo, styled like the page buttons (Cta.astro): the paper color fills in from the
     center and the label rolls. */
  .site-header__cta {
    position: relative;
    isolation: isolate;
    display: none;
    align-items: center;
    min-height: 2.5rem;
    margin-inline-end: 0.5rem;
    padding: 0 1rem;
    overflow: hidden;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    /* Fill and border transition with the header when it inverts over the story's scene. */
    transition:
      color 0.5s var(--ease-out),
      background-color 0.3s ease,
      border-color 0.3s ease,
      scale 0.2s var(--ease-out);
  }

  .site-header__cta:active {
    scale: 0.97;
  }

  .site-header__cta-content {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .site-header__cta-pour {
    position: absolute;
    z-index: -1;
    top: 50%;
    left: 50%;
    width: 260%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-paper);
    translate: -50% -50%;
    scale: 0;
    transition: scale 0.7s var(--ease-out);
  }

  @media (hover: hover) {
    .site-header__cta:hover {
      color: var(--color-ink);
    }

    .site-header__cta:hover .site-header__cta-pour {
      scale: 1;
    }
  }

  /* Narrowest phones: languages are only in the menu. */
  @media (max-width: 23.99rem) {
    .site-header__language {
      display: none !important;
    }
  }

  /* Extra spacing before the menu button. */
  .site-header__end :global(.menu-button) {
    margin-inline-start: 0.5rem;
  }

  /* Command menu trigger (CommandMenu.astro): a round icon button; Ctrl+K / Cmd+K also opens it.
     Requires JS, so it appears once theme-init.js has run, and only on wider screens (phones use
     the menu). */
  .command-trigger {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 50%;
    background: none;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  @media (hover: hover) {
    .command-trigger:hover {
      border-color: var(--color-line-strong);
      color: var(--color-ink);
    }
  }

  .command-trigger__icon {
    width: 1.0625rem;
    height: 1.0625rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  @media (min-width: 48rem) {
    .site-header__cta {
      display: inline-flex;
    }
  }

  @media (min-width: 64rem) {
    :global(:root[data-theme]) .command-trigger {
      display: inline-grid;
    }
  }
</style>
