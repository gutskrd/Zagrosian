---
/**
 * Menu button: two dots next to a label, no chrome.
 *
 * - Hover: the dots swap sides and the label rolls with them.
 * - Open: the dots stretch into an X. The menu (SiteMenu.astro) has its own close button in the
 *   same position, showing the X, which receives focus on open. Closing morphs the X back into
 *   dots.
 *
 * Built on the Popover API, so it works without JS. On narrow phones only the dots show; the label
 * remains the accessible name.
 */
import { i18n } from '../../i18n';
import RollText from '../ui/RollText.astro';

interface Props {
  /** `open` in the header, `close` inside the menu. */
  action?: 'open' | 'close';
}

const { action = 'open' } = Astro.props;
const { t } = i18n(Astro.url);
---

<button
  class:list={['menu-button', `menu-button--${action}`]}
  type="button"
  popovertarget="site-menu"
  popovertargetaction={action === 'close' ? 'hide' : 'show'}
  aria-controls="site-menu"
  autofocus={action === 'close'}
>
  <span class="menu-button__label"><RollText text={action === 'close' ? t.common.close : t.common.menu} /></span>
  <span class="menu-button__icon" aria-hidden="true">
    <span class="menu-button__dot"></span>
    <span class="menu-button__dot"></span>
  </span>
</button>

<style>
  .menu-button {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
  }

  /* Two dots side by side, in a small square they rotate within. */
  .menu-button__icon {
    position: relative;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    transition: rotate 0.7s var(--ease-spring);
  }

  .menu-button__dot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: currentColor;
    translate: calc(-50% - 5px) -50%;
    transition:
      width 0.45s var(--ease-out),
      height 0.45s var(--ease-out),
      translate 0.45s var(--ease-out),
      rotate 0.6s var(--ease-spring);
  }

  .menu-button__dot + .menu-button__dot {
    translate: calc(-50% + 5px) -50%;
  }

  /* Hover: rotate the pair 180 degrees so the dots swap sides. */
  @media (hover: hover) {
    .menu-button:hover .menu-button__icon {
      rotate: 180deg;
    }
  }

  .menu-button:focus-visible .menu-button__icon {
    rotate: 180deg;
  }

  /* Open: the dots meet in the middle and stretch into an X. Applies to the menu's own button and
     to the header button beneath it, which morphs back into dots as the menu closes. */
  .menu-button--close .menu-button__dot,
  :global(.site-header:has(.site-menu:popover-open)) .menu-button--open .menu-button__dot {
    width: 20px;
    height: 2px;
    border-radius: 1px;
    translate: -50% -50%;
    rotate: 45deg;
  }

  .menu-button--close .menu-button__dot + .menu-button__dot,
  :global(.site-header:has(.site-menu:popover-open)) .menu-button--open .menu-button__dot + .menu-button__dot {
    rotate: -45deg;
  }

  /* The X rotates 90 degrees on hover. */
  @media (hover: hover) {
    .menu-button--close:hover .menu-button__icon {
      rotate: 90deg;
    }
  }

  .menu-button--close:focus-visible .menu-button__icon {
    rotate: 90deg;
  }

  /* The menu's button arrives as two dots, then morphs into the X shortly after the menu starts
     dropping. */
  .menu-button--close .menu-button__dot {
    transition-delay: 0.2s;
  }

  @starting-style {
    .menu-button--close .menu-button__dot {
      width: 6px;
      height: 6px;
      border-radius: 3px;
      translate: calc(-50% - 5px) -50%;
      rotate: 0deg;
    }

    .menu-button--close .menu-button__dot + .menu-button__dot {
      translate: calc(-50% + 5px) -50%;
    }
  }

  /* The header button morphs back into dots as the menu lifts away. */
  .menu-button--open .menu-button__dot {
    transition-delay: 0.25s;
  }

  .menu-button:active .menu-button__icon {
    scale: 0.85;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-button__icon,
    .menu-button__dot {
      transition: none;
    }
  }

  /* Narrow phones: dots only. */
  @media (max-width: 29.99rem) {
    .menu-button__label :global(.roll__track) {
      display: none;
    }

    .menu-button {
      gap: 0;
    }
  }
</style>
