---
import { i18n, navigation } from '../../i18n';
import { hevalo, kurdish, registration, site, socialProfiles } from '../../site';
import Arrow from '../ui/Arrow.astro';
import SocialIcon from '../ui/SocialIcon.astro';
import ThemeSwitch from './ThemeSwitch.astro';

const { locale, t } = i18n(Astro.url);
const nav = navigation(locale);
const footerLinks = [{ label: t.nav.hevalo, href: hevalo.url, external: true }, nav.book, ...nav.sections.slice(1)];
const year = new Date().getFullYear();
// Registration details (src/site.ts): address, KvK number and phone, alongside the email, as Dutch
// law requires. They're visible to visitors but kept out of search, so they aren't rendered into
// the HTML: src/scripts/registration.ts injects them from /registration.json (disallowed in
// robots.txt), and the line is marked data-nosnippet. The email is public and stays in the markup.
const { address, kvk, vat, phone } = registration;
const registered = !!(address || kvk || vat || phone);
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__about">
        {/* Closing line: "thank you" in Kurmanji. */}
        <p class="site-footer__motto kurdish" lang="ku" dir="ltr">
          {kurdish.thanks}
        </p>
        {t.footer.thanks && <p class="site-footer__gloss">{t.footer.thanks}</p>}
        <p class="site-footer__company">
          {t.footer.about[0]}
          <br />
          {t.footer.about[1]}
        </p>
      </div>

      <div class="site-footer__navs">
        <nav aria-label={t.common.footerNav}>
          <ul class="site-footer__links">
            {footerLinks.map((link) => (
              <li>
                <a class="site-footer__link" href={link.href}>
                  {link.label}
                  {'external' in link && <Arrow direction="up-right" class="site-footer__external" />}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <nav aria-label={t.common.socialNav}>
          <ul class="site-footer__social">
            {socialProfiles.map((profile) => (
              <li>
                <a class="site-footer__link" href={profile.url} rel="me">
                  <SocialIcon name={profile.icon} class="site-footer__social-icon" />
                  {profile.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    <div class="site-footer__mark" aria-hidden="true" data-rise dir="ltr">
      <span>
        <span>{site.name}</span>
        {/* Late sunlight through a window, falling across the letters. */}
        <span class="site-footer__sun">{site.name}</span>
      </span>
    </div>

    <div class="site-footer__bottom">
      <div class="site-footer__meta">
        <p>
          <small>
            &copy; {year} {site.legalName}
          </small>
        </p>
        <ThemeSwitch />
      </div>
      <nav aria-label={t.common.legalNav}>
        <ul class="site-footer__legal">
          {nav.legal.map((link) => (
            <li>
              <a class="site-footer__link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <a class="site-footer__link" href="#top">
              {t.common.backToTop}
              <Arrow direction="up" />
            </a>
          </li>
        </ul>
      </nav>
    </div>

    {registered && (
      <div data-nosnippet>
        <address class="site-footer__registration" data-registration data-kvk={t.footer.kvk} data-vat={t.footer.vat}>
          <span>{site.legalName}</span>
          <span class="site-footer__details" data-registration-details />
          <span class="site-footer__dot" aria-hidden="true">
            ·
          </span>
          <bdi>
            <a class="site-footer__contact site-footer__whole" href={`mailto:${site.emails.contact}`} dir="ltr">
              {site.emails.contact}
            </a>
          </bdi>
        </address>
      </div>
    )}
  </div>
</footer>

<style>
  /* A hairline closes the page; the wordmark below is the footer's only flourish. */
  .site-footer {
    padding-block: 4rem 2rem;
    border-top: 1px solid var(--color-line);
    font-size: var(--text-sm);
  }

  .site-footer__top {
    display: grid;
    gap: 2.5rem;
  }

  .site-footer__about {
    color: var(--color-muted);
  }

  .site-footer__motto {
    font-size: 1.0625rem;
    color: var(--color-ink);
  }

  /* Kurmanji is LTR but aligns with the page's start side. */
  :global(:root[dir='rtl']) .site-footer__motto {
    text-align: right;
  }

  .site-footer__gloss {
    font-size: var(--text-xs);
  }

  .site-footer__company {
    margin-top: 1rem;
  }

  .site-footer__navs {
    display: grid;
    gap: 0.5rem;
  }

  .site-footer__links,
  .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
  }

  .site-footer__social .site-footer__link {
    gap: 0.5rem;
    color: var(--color-muted);
  }

  .site-footer__social .site-footer__link:hover {
    color: var(--color-ink);
  }

  :global(.site-footer__social-icon) {
    font-size: 1rem;
  }

  .site-footer__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-footer__link:hover {
    color: var(--color-ink);
  }

  :global(.site-footer__external) {
    width: 0.8125rem;
    height: 0.8125rem;
    color: var(--color-muted);
  }

  /* The wordmark spans the full content width at every breakpoint. */
  .site-footer__mark {
    container-type: inline-size;
    overflow: hidden;
    margin-top: clamp(3.5rem, 2rem + 5vw, 7rem);
    user-select: none;
  }

  .site-footer__mark > span {
    display: grid;
    /* `--cq` first, for browsers without container query units (global.css). */
    font-size: calc(24.2 * var(--cq));
    font-size: 24.2cqi;
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.05em;
    white-space: nowrap;
    /* Optical alignment with the text column. */
    margin-left: -0.04em;
    padding-bottom: 0.2em;
    /* Stands up from its baseline as the footer scrolls in (motion/index.ts). */
    transform-origin: 50% 100%;
  }

  .site-footer__mark > span > span {
    grid-area: 1 / 1;
  }

  /* Window light as on the floor under the rug (rug/scene.ts): a copy of the word in the light's
     colors, in broad soft beams within the window's soft-edged patch. It sweeps in from the right
     as the wordmark rises (`--sun-at` positions the patch). */
  .site-footer__sun {
    --sun-at: 66%;
    /* Light letters: warm white where the light falls, slightly dimmer between the beams. */
    --mark-lit: color-mix(in oklab, rgb(var(--sun)) 42%, #fff);
    --mark-shade: color-mix(in oklab, var(--color-ink) 80%, #000);
    color: transparent;
    background: linear-gradient(
      40deg,
      var(--mark-shade) 18%,
      var(--mark-lit) 32% 44%,
      var(--mark-shade) 55% 59%,
      var(--mark-lit) 66% 72%,
      var(--mark-shade) 82%
    );
    -webkit-background-clip: text;
    background-clip: text;
    mask-image: linear-gradient(
      102deg,
      transparent calc(var(--sun-at) - 30%),
      #000 calc(var(--sun-at) - 14%),
      #000 calc(var(--sun-at) + 6%),
      transparent calc(var(--sun-at) + 24%)
    );
  }

  /* Dark letters: the light is only a faint warmth on them, with the shade between the beams as
     dark as the rest. */
  :global(:root:not([data-theme='dark'])) .site-footer__sun {
    --mark-lit: color-mix(in oklab, rgb(var(--sun)) 27%, var(--color-ink));
    --mark-shade: var(--color-ink);
  }

  @media (forced-colors: active) {
    .site-footer__sun {
      display: none;
    }
  }

  @media print {
    .site-footer__sun {
      display: none;
    }
  }

  /* Where CSS scroll-driven animations are supported, the compositor stands the wordmark up in sync
     with scroll; elsewhere motion/index.ts does it in JS. It goes from lying back on its baseline
     to upright as it enters view (ease-out). */
  .site-footer__mark {
    view-timeline-name: --wordmark;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Longhand properties, so the minifier can't fold the timeline into the `animation` shorthand
         (which browsers reject). */
      .site-footer__mark > span {
        animation-name: wordmark-rise;
        animation-timing-function: cubic-bezier(0.33, 1, 0.68, 1);
        animation-fill-mode: both;
        animation-timeline: --wordmark;
        animation-range: entry 0% entry 100%;
      }

      .site-footer__sun {
        animation-name: sun-across;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --wordmark;
        animation-range: entry 0% entry 100%;
      }
    }
  }

  @keyframes sun-across {
    from {
      --sun-at: 118%;
    }

    to {
      --sun-at: 66%;
    }
  }

  @keyframes wordmark-rise {
    from {
      transform: perspective(max(600px, 90cqi)) rotateX(70deg) translate3d(0, 40%, 0);
    }

    to {
      transform: perspective(max(600px, 90cqi)) rotateX(0deg) translate3d(0, 0, 0);
    }
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
  }

  .site-footer__meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 2.75rem;
  }

  .site-footer__bottom small {
    font-size: inherit;
  }

  /* Registration line: each detail kept whole and separated by spacing; separator dots appear only
     where everything fits on one line, so wrapped lines never start or end with a dot. */
  .site-footer__registration {
    display: flex;
    flex-wrap: wrap;
    gap: 0.125rem 0.875rem;
    padding-top: 0.5rem;
    color: var(--color-muted);
    font-style: normal;
  }

  /* `:global` because the details are injected by src/scripts/registration.ts and lack Astro's
     scope attribute. */
  .site-footer__registration :global(.site-footer__details) {
    display: contents;
  }

  .site-footer__registration :global(.site-footer__dot) {
    display: none;
  }

  .site-footer__registration :global(.site-footer__whole) {
    white-space: nowrap;
  }

  /* Phone and email links: muted like the line, with a comfortable tap height, highlighted on
     hover. */
  .site-footer__registration :global(.site-footer__contact) {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-footer__registration :global(.site-footer__contact:hover) {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }

  .site-footer__legal .site-footer__link {
    color: var(--color-muted);
  }

  .site-footer__legal .site-footer__link:hover {
    color: var(--color-ink);
  }

  @media (min-width: 64rem) {
    .site-footer__registration {
      column-gap: 0.5rem;
    }

    .site-footer__registration :global(.site-footer__dot) {
      display: inline;
    }
  }

  @media (min-width: 48rem) {
    .site-footer {
      padding-top: 5rem;
    }

    .site-footer__top {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .site-footer__navs {
      justify-items: end;
      gap: 1rem;
    }

    .site-footer__links,
    .site-footer__social {
      justify-content: flex-end;
      gap: 0 2.25rem;
    }

    .site-footer__links .site-footer__link,
    .site-footer__social .site-footer__link {
      min-height: 1.5rem;
    }
  }
</style>
