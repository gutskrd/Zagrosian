---
/**
 * The opening screen, on the first homepage visit of a session: a dark
 * curtain that welcomes the visitor in Kurdish, "Bi xêr hatin.", then slides
 * away as the hero enters (src/scripts/intro.ts).
 *
 * The greeting's letters rise into place one by one, in 3D, over a faint copy
 * of the greeting, and ink fills them from left to right as the page loads,
 * led by a soft band of light, as the glass logo above fills from the bottom.
 * Under it, "welcome" rolls through the site's languages like a counter and
 * comes to rest in the page's own. When the page is ready, the light passes
 * over the greeting once more.
 *
 * Then the visitor comes in, by raising the sun. The loading line becomes a
 * horizon, and over it, in a small round window, the Kurdish sun stands half
 * risen, turning slowly, over "Enter" (`intro.enter`). Every few seconds,
 * "welcome" and "Enter" turn together to the next language, so the visitor
 * is welcomed and invited in each of the site's languages in turn; how to
 * come in stays in the page's own. Scrolling, swiping up or dragging lifts
 * the whole curtain
 * under the hand, against a growing resistance, as the sun climbs, a ring
 * around it fills, dawn spreads along the horizon and the light crosses the
 * greeting; let go early and it all settles back, go far enough and the
 * curtain flies up. A click, a tap or any key comes straight in. Left alone,
 * the curtain lifts a little now and then, to show that it can.
 *
 * theme-init.js decides before the first paint (`data-intro` on <html>), and
 * only when motion is welcome. It is decoration, hidden from screen readers,
 * which read the page underneath. Without JavaScript it never appears, and
 * should the script not start, it lifts by itself after four seconds. Its
 * words are drawn by CSS from attributes, so the page's text (what search
 * engines and AI crawlers read) starts with the real headline; the script
 * removes it from the page once it has lifted.
 */
import { i18n, localeInfo, locales, messages } from '../i18n';
import { kurdish } from '../site';
import LiftedLogo from './LiftedLogo.astro';
import Sun from './Sun.astro';

const { locale, t } = i18n(Astro.url);

// The counter starts at 0, in the page's own digits (intro.ts counts on).
const zero = new Intl.NumberFormat(localeInfo(locale).intl).format(0);

// The greeting, letter by letter; `data-i` staggers them (see the CSS).
let count = 0;
const words = kurdish.welcome.split(' ').map((word) => [...word].map((char) => ({ char, index: count++ })));
const layers = ['ghost', 'fill', 'glow'] as const;

// "Welcome" and "Enter" in every language, in the same order, ending with the
// page's own (where the first roll comes to rest; Kurmanji welcomes with the
// greeting itself). The first language comes again at the end, so that the
// reels can turn on for ever (intro.ts).
const own = locales.findIndex((info) => info.code === locale);
const turns = [...locales.slice(own + 1), ...locales.slice(0, own + 1)].map((info) => ({
  lang: info.code,
  dir: info.dir,
  welcome: messages(info.code).intro.welcome || kurdish.welcome,
  enter: messages(info.code).intro.enter,
}));
const reel = [...turns, turns[0]];
---

<div class="intro-screen" aria-hidden="true" data-intro-screen>
  <div class="intro-screen__top">
    <span class="wordmark intro-screen__wordmark" data-label="Zagrosian"></span>
    <span class="intro-screen__label" data-label={t.common.loading}></span>
  </div>

  <div class="intro-screen__stage">
    <div class="intro-screen__mark">
      <LiftedLogo class="intro-screen__logo intro-screen__logo--ghost" tone="dark" />
      <LiftedLogo class="intro-screen__logo intro-screen__logo--fill" tone="dark" data-intro-logo />
    </div>

    <div class="intro-screen__greeting kurdish" lang="ku" dir="ltr" data-intro-greeting>
      {
        layers.map((layer) => (
          <span class={`intro-screen__window intro-screen__window--${layer}`}>
            <span class="intro-screen__line">
              {words.map((word, w) => (
                <>
                  {w > 0 && ' '}
                  <span class="intro-screen__word">
                    {word.map(({ char, index }) => (
                      <span class="intro-screen__char" data-i={index} data-label={char} />
                    ))}
                  </span>
                </>
              ))}
            </span>
          </span>
        ))
      }
    </div>

    <div class="intro-screen__reel intro-screen__reel--welcome">
      <span class="intro-screen__track" data-intro-track>
        {reel.map((turn) => <span lang={turn.lang} dir={turn.dir} data-label={turn.welcome} />)}
      </span>
    </div>
  </div>

  <div class="intro-screen__bottom">
    <span class="intro-screen__count" data-intro-count data-label={zero}></span>
    <div class="intro-screen__enter">
      <span class="intro-screen__orb">
        <span class="intro-screen__disc">
          <span class="intro-screen__sky"><span class="intro-screen__sun"><Sun /></span></span>
        </span>
      </span>
      <span class="intro-screen__reel intro-screen__reel--enter">
        <span class="intro-screen__track" data-intro-track>
          {reel.map((turn) => <span lang={turn.lang} dir={turn.dir} data-label={turn.enter} />)}
        </span>
      </span>
      <span class="intro-screen__hint intro-screen__hint--pointer" data-label={t.intro.hintPointer}></span>
      <span class="intro-screen__hint intro-screen__hint--touch" data-label={t.intro.hintTouch}></span>
    </div>
    <span class="intro-screen__bar"><span data-intro-bar></span></span>
  </div>

  <span class="intro-screen__dawn"></span>
</div>

<style>
  /* Always near-black, in both themes: a stage curtain. While the visitor
     lifts it, intro.ts sets how far it has risen (`--lift`, in pixels) and
     how far there is still to go (`--pull`, from 0 to 1). */
  .intro-screen {
    --intro-ink: #f2f2f2;
    --lift: 0;
    --pull: 0;

    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
    grid-template-rows: auto 1fr auto;
    overflow: clip;
    padding: max(1.5rem, env(safe-area-inset-top)) var(--gutter) max(1.5rem, env(safe-area-inset-bottom));
    background: #0a0a0a;
    color: var(--intro-ink);
    user-select: none;
    /* Scrolling and swiping lift the curtain instead of moving the page. */
    touch-action: none;
    translate: 0 calc(var(--lift) * -1px);
  }

  .intro-screen[data-state='ready'] {
    cursor: pointer;
  }

  .intro-screen[data-dragging] {
    cursor: grabbing;
  }

  /* Shown from before the first paint, and through its rise until intro.ts
     removes it. */
  :global(:root[data-intro]) .intro-screen,
  .intro-screen[data-state] {
    display: grid;
  }

  /* Should the script never start, the curtain lifts by itself. */
  :global(:root[data-intro='loading']) .intro-screen {
    animation: intro-fallback 0.6s ease 4s forwards;
  }

  @keyframes intro-fallback {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  .intro-screen__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .intro-screen [data-label]::before {
    content: attr(data-label);
  }

  /* The wordmark, as in the header (Wordmark.astro). */
  .intro-screen__wordmark {
    font-size: 1.1875rem;
    font-weight: 620;
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
  }

  .intro-screen__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
    transition: opacity 0.6s ease;
  }

  /* The greeting rises a little faster than the curtain, for depth. */
  .intro-screen__stage {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: clamp(1.25rem, 0.75rem + 2vw, 2.25rem);
    container-type: inline-size;
    translate: 0 calc(var(--lift) * -0.4px);
  }

  /* The glass logo fills up from the bottom as the page loads, over a faint
     copy of itself (intro.ts sets the clip). It is drawn (LiftedLogo.astro),
     so there is nothing to download. */
  .intro-screen__mark {
    display: grid;
    width: clamp(3.25rem, 2.75rem + 2.5vw, 5.25rem);
  }

  .intro-screen__mark :global(.intro-screen__logo) {
    grid-area: 1 / 1;
    width: 100%;
    perspective: 40rem;
  }

  .intro-screen__mark :global(.intro-screen__logo--ghost) {
    opacity: 0.18;
  }

  .intro-screen__mark :global(.intro-screen__logo--fill) {
    clip-path: inset(100% 0 0 0);
  }

  /* The greeting: three copies of it, one on another, each seen through a
     window as wide as the greeting whose letters rise from its foot. A faint
     copy; the ink, whose window slides in from the left with the page's
     loading (`--fill`, from 0 to 1) and has a soft leading edge, so the ink
     seems to flow in; and a band of light just behind that edge (`--light`),
     which leads the ink and passes over the whole greeting at the end (both
     set by intro.ts). As a window slides one way, the letters in it slide
     back the other, so they stay put: only the windows move, and nothing
     has to be drawn again as they do. */
  .intro-screen__greeting {
    --fill: 0;
    --light: 0;
    --edge: 0.5em;

    display: grid;
    font-size: min(15cqi, 19svh, 10rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    /* Centres the letters, not the windows, which are wider (below). */
    translate: calc(var(--edge) / 2) 0;
  }

  /* Each window is wider than the greeting by its soft edge, so that at the
     end the edge lies past the last letter. */
  .intro-screen__window {
    grid-area: 1 / 1;
    padding-inline-end: var(--edge);
    /* Clips the letters, as they rise, to the window (see the masks). */
    mask-image: linear-gradient(#000, #000);
  }

  .intro-screen__line {
    display: block;
    padding: 0.1em 0.12em 0.18em;
  }

  .intro-screen__window--ghost {
    opacity: 0.16;
  }

  /* At 0 the window lies wholly before the greeting, at 1 wholly over it. */
  .intro-screen__window--fill,
  .intro-screen__window--glow {
    translate: calc((var(--at) - 1) * 100%) 0;
    will-change: translate;
  }

  .intro-screen__window--fill > .intro-screen__line,
  .intro-screen__window--glow > .intro-screen__line {
    translate: calc((1 - var(--at)) * (100% + var(--edge))) 0;
    will-change: translate;
  }

  .intro-screen__window--fill {
    --at: var(--fill);

    mask-image: linear-gradient(90deg, #000 calc(100% - var(--edge)), transparent);
  }

  .intro-screen__window--glow {
    --at: var(--light);

    color: #fff;
    text-shadow:
      0 0 0.1em rgb(255 255 255 / 0.9),
      0 0 0.45em rgb(255 255 255 / 0.5);
    mask-image: linear-gradient(90deg, transparent calc(100% - 1.8em), #000 calc(100% - var(--edge)), transparent);
  }

  /* Each letter stands up into place, in turn, from the window's foot. */
  .intro-screen__word {
    display: inline-block;
    perspective: 4em;
  }

  .intro-screen__char {
    --i: 0;

    display: inline-block;
    transform-origin: 50% 85%;
    animation: intro-char 1.1s var(--ease-out) calc(0.12s + var(--i) * 0.055s) both;
  }

  @keyframes intro-char {
    from {
      opacity: 0;
      transform: translateY(0.7em) rotateX(-85deg);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  .intro-screen__char[data-i='1'] {
    --i: 1;
  }

  .intro-screen__char[data-i='2'] {
    --i: 2;
  }

  .intro-screen__char[data-i='3'] {
    --i: 3;
  }

  .intro-screen__char[data-i='4'] {
    --i: 4;
  }

  .intro-screen__char[data-i='5'] {
    --i: 5;
  }

  .intro-screen__char[data-i='6'] {
    --i: 6;
  }

  .intro-screen__char[data-i='7'] {
    --i: 7;
  }

  .intro-screen__char[data-i='8'] {
    --i: 8;
  }

  .intro-screen__char[data-i='9'] {
    --i: 9;
  }

  .intro-screen__char[data-i='10'] {
    --i: 10;
  }

  .intro-screen__char[data-i='11'] {
    --i: 11;
  }

  .intro-screen__char[data-i='12'] {
    --i: 12;
  }

  .intro-screen__char[data-i='13'] {
    --i: 13;
  }

  .intro-screen__char[data-i='14'] {
    --i: 14;
  }

  .intro-screen__char[data-i='15'] {
    --i: 15;
  }

  /* "Welcome" and "Enter", one language at a time, each in a window one line
     high whose top and bottom fade out. The script moves the tracks up a line
     at a time (`--step`): quickly at first, as the page loads, coming to rest
     on the page's language, then a line every few seconds. */
  .intro-screen__reel {
    --line: 1.5em;

    display: block;
    height: var(--line);
    overflow: clip;
    mask-image: linear-gradient(transparent, #000 32%, #000 68%, transparent);
  }

  .intro-screen__reel--welcome {
    font-size: clamp(1.125rem, 0.9rem + 0.9vw, 1.75rem);
    letter-spacing: -0.01em;
    opacity: 0.62;
    animation: intro-reel 0.9s var(--ease-out) 0.5s both;
    transition: opacity 0.6s ease;
  }

  @keyframes intro-reel {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }
  }

  .intro-screen__track {
    display: grid;
    justify-items: center;
    transform: translateY(calc(var(--step, 0) * var(--line) * -1));
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .intro-screen__track > span {
    height: var(--line);
    line-height: var(--line);
    white-space: nowrap;
  }

  /* Back to the first language, which is also the last, without a jump. */
  .intro-screen__track[data-snap] {
    transition: none;
  }

  .intro-screen:is([data-state='done'], [data-state='ready']) .intro-screen__reel--welcome {
    opacity: 1;
  }

  /* The counter, and in its place once the page has loaded, the way in. */
  .intro-screen__bottom {
    display: grid;
    gap: 1rem;
  }

  .intro-screen__count {
    grid-area: 1 / 1;
    align-self: end;
    font-size: clamp(2.75rem, 1.5rem + 5vw, 6rem);
    font-weight: 300;
    line-height: 0.8;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    transition:
      opacity 0.5s ease,
      translate 0.7s var(--ease-out);
  }

  .intro-screen[data-state='ready'] :is(.intro-screen__count, .intro-screen__label) {
    opacity: 0;
  }

  .intro-screen[data-state='ready'] .intro-screen__count {
    translate: 0 -0.4em;
  }

  .intro-screen__enter {
    grid-area: 1 / 1;
    justify-self: center;
    display: grid;
    justify-items: center;
    text-align: center;
    opacity: 0;
    translate: 0 1rem;
    transition:
      opacity 0.9s ease 0.15s,
      translate 1.1s var(--ease-out) 0.15s;
  }

  .intro-screen[data-state='ready'] .intro-screen__enter {
    opacity: 1;
    translate: none;
  }

  /* A small round window on a sunrise: the sun stands half over a horizon,
     turning slowly, and climbs as the curtain is lifted; a ring around the
     window fills on the way. */
  .intro-screen__orb {
    --orb: clamp(3.5rem, 2.75rem + 1.6vw, 4.75rem);

    position: relative;
    width: var(--orb);
    aspect-ratio: 1;
    margin-bottom: 0.875rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22);
  }

  .intro-screen__orb::before {
    content: '';
    position: absolute;
    inset: -0.3125rem;
    border-radius: 50%;
    background: conic-gradient(var(--intro-ink) calc(var(--pull) * 1turn), transparent 0);
    mask-image: radial-gradient(closest-side, transparent calc(100% - 1.5px), #000 calc(100% - 1px));
  }

  .intro-screen__disc {
    position: absolute;
    inset: 0;
    overflow: clip;
    border-radius: 50%;
  }

  /* The horizon, a little below the middle; the sun sets behind it. */
  .intro-screen__disc::after {
    content: '';
    position: absolute;
    inset: 62% 16% auto;
    height: 1px;
    background: rgb(255 255 255 / 0.5);
  }

  .intro-screen__sky {
    position: absolute;
    inset: 0 0 38%;
    overflow: clip;
  }

  .intro-screen__sun {
    position: absolute;
    bottom: 0;
    left: 50%;
    font-size: calc(var(--orb) * 0.43);
    translate: -50% calc(55% - var(--pull) * 95%);
    rotate: calc(var(--pull) * 140deg);
  }

  .intro-screen__sun :global(.sun) {
    animation: intro-sun 48s linear infinite;
  }

  @keyframes intro-sun {
    to {
      rotate: 1turn;
    }
  }

  .intro-screen__reel--enter {
    font-size: clamp(0.9375rem, 0.85rem + 0.3vw, 1.125rem);
    font-weight: 560;
    letter-spacing: -0.005em;
  }

  .intro-screen__hint {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.5;
  }

  .intro-screen__hint--touch {
    display: none;
  }

  @media (pointer: coarse) {
    .intro-screen__hint--pointer {
      display: none;
    }

    .intro-screen__hint--touch {
      display: block;
    }
  }

  /* Dawn: once the page has loaded, a faint light along the foot of the
     curtain, which grows as it is lifted. */
  .intro-screen__dawn {
    position: absolute;
    bottom: 0;
    left: 50%;
    z-index: -1;
    width: max(48rem, 130vw);
    aspect-ratio: 2.4;
    translate: -50% 55%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 1.8s ease;
  }

  .intro-screen[data-state='ready'] .intro-screen__dawn {
    opacity: 1;
  }

  .intro-screen__dawn::before,
  .intro-screen__dawn::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }

  .intro-screen__dawn::before {
    background: radial-gradient(closest-side, rgb(255 255 255 / 0.07), transparent);
  }

  .intro-screen__dawn::after {
    background: radial-gradient(closest-side, rgb(255 255 255 / 0.2), rgb(255 255 255 / 0.05) 55%, transparent);
    opacity: var(--pull);
  }

  .intro-screen__bar {
    display: block;
    height: 1px;
    background: rgb(255 255 255 / 0.18);
  }

  .intro-screen__bar span {
    display: block;
    height: 100%;
    background: var(--intro-ink);
    transform: scaleX(0);
    transform-origin: var(--start);
  }

  /* Leaving: the curtain rises, its contents a little ahead of it. */
  .intro-screen[data-state='leaving'] {
    transform: translateY(-100%);
    transition: transform 1.05s cubic-bezier(0.76, 0, 0.24, 1);
  }

  .intro-screen[data-state='leaving'] > * {
    opacity: 0;
    transform: translateY(-3rem);
    transition:
      opacity 0.45s ease,
      transform 0.8s cubic-bezier(0.76, 0, 0.24, 1);
  }

  @media print {
    .intro-screen {
      display: none !important;
    }
  }
</style>
