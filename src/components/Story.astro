---
/**
 * The story under the hero: Zagrosian's three values, then the Kurdish sun
 * and motto.
 *
 * Without JavaScript, with reduced motion and in print, it is a plain section:
 * the values as a heading, and the sun and the motto below them.
 *
 * With motion, it is a walkthrough pinned to the screen (src/scripts/story.ts),
 * in four chapters, in glass and in 3D:
 *
 * 1. The values. The glass logo comes down from the hero and settles beside
 *    them; each value flips up into place, and the logo turns a notch with
 *    each.
 * 2. The dive. The logo comes to the middle, faces the reader, and the camera
 *    flies into the glass: through the front pane and into the logo's ink,
 *    the block's layers spreading apart in perspective as it comes closer.
 * 3. The sun. In the ink, the page in the other theme's colours
 *    (`.story__scene`), the Kurdish sun rises as a thick piece of glass
 *    (GlassSun.astro), tumbling and catching the light, and comes to rest
 *    facing the reader; the motto rises under it, word by word.
 * 4. The iris. The scene closes into the sun, like an iris, and leaves the
 *    sun and the motto in the page's own colours, which then scroll on.
 *
 * theme-init.js makes room for it before the first paint (`data-story`), so
 * nothing shifts when the script starts.
 */
import { i18n } from '../i18n';
import { kurdish } from '../site';
import GlassSun from './GlassSun.astro';
import Sun from './Sun.astro';

const { t } = i18n(Astro.url);

// The values are sized to their column: each must fit on a line.
const longest = Math.max(...t.story.values.map((value) => [...value].length));
const fit = longest <= 10 ? undefined : longest <= 13 ? 'md' : longest <= 16 ? 'sm' : 'xs';

const words = kurdish.motto.split(' ');
---

<section id="story" class="story" aria-labelledby="story-title" data-story-section>
  <div class="story__stage">
    <div class="container story__grid">
      <h2 id="story-title" class:list={['story__values', fit && `story__values--${fit}`]}>
        {
          t.story.values.map((value, index) => (
            <>
              {index > 0 && ' '}
              <span class="story__value" data-story-value>
                <span class="story__value-text">{value}</span>
              </span>
            </>
          ))
        }
      </h2>
      <div class="story__slot" aria-hidden="true" data-story-slot></div>
    </div>

    <div class="story__motto" data-story-motto>
      <div class="story__sun" data-story-sun><Sun /></div>
      <p class="story__kurdish kurdish" lang="ku" dir="ltr">{kurdish.motto}</p>
      {t.motto && <p class="story__translation lead">{t.motto}</p>}
    </div>

    <div class="story__scene" aria-hidden="true" data-story-scene>
      <div class="story__motto">
        <div class="story__sun">
          <span class="story__glow" data-story-glow></span>
          <span class="story__glass-sun" data-story-sunrise><GlassSun /></span>
        </div>
        <p class="story__kurdish kurdish" lang="ku" dir="ltr">
          {
            words.map((word, index) => (
              <>
                {index > 0 && ' '}
                <span class="story__word">
                  <span data-story-word>{word}</span>
                </span>
              </>
            ))
          }
        </p>
        {t.motto && <p class="story__translation lead" data-story-translation>{t.motto}</p>}
      </div>
    </div>

    <div class="story__progress" aria-hidden="true"><span data-story-progress></span></div>
  </div>
</section>

<style>
  /* ----------------------------------------------------------------------
     The plain section: the values, then the sun and the motto.
     ---------------------------------------------------------------------- */
  .story {
    padding-block: var(--section-space);
  }

  .story__grid {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
  }

  /* The values are sized to their column (see `fit` above). */
  .story__values {
    container-type: inline-size;
    margin: 0;
    font-size: min(var(--text-display), 17cqi);
    line-height: 1;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .story__values--md {
    font-size: min(var(--text-display), 13cqi);
  }

  .story__values--sm {
    font-size: min(var(--text-display), 10.5cqi);
  }

  .story__values--xs {
    font-size: min(var(--text-display), 9cqi);
  }

  /* Each value on a line of its own, behind a mask it can flip up from. */
  .story__value {
    display: block;
    overflow: clip;
    padding-block-end: 0.1em;
    margin-block-end: -0.06em;
    perspective: 8em;
  }

  .story__value-text {
    display: block;
    transform-origin: 50% 100%;
  }

  .story__motto {
    display: grid;
    justify-items: center;
    margin-top: var(--section-space);
    text-align: center;
  }

  .story__sun {
    font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  /* The motto is set in system serifs, whose widths vary by device. Sizes allow
     for the widest likely fallback (DejaVu Serif): "kurdî xweştire." is at most
     7.5em wide, the whole line at most 11.5em. Phones get two lines, wider
     screens one. */
  .story__kurdish {
    margin: 0;
    font-size: calc((100vw - 2 * var(--gutter)) / 7.8);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }

  @media (min-width: 48rem) {
    .story__kurdish {
      font-size: min(var(--text-display), calc((min(100vw, var(--container)) - 2 * var(--gutter)) / 11.8));
    }
  }

  .story__translation {
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    color: var(--color-muted);
  }

  .story__slot,
  .story__scene,
  .story__progress {
    display: none;
  }

  /* ----------------------------------------------------------------------
     The walkthrough: a stage pinned to the screen while the section, five
     and a half screens tall, scrolls past it.

     On a phone the address bar slides away as the page scrolls down and back
     as it scrolls up. The stage is as tall as the screen without the bar
     (100lvh), so its colours always reach the bottom edge, and its content
     keeps to the part the bar never covers (100svh), so nothing moves when
     the bar comes and goes. On other screens the two are the same.
     ---------------------------------------------------------------------- */
  :global(:root[data-story]) .story {
    height: 560svh;
    padding: 0;
  }

  :global(:root[data-story]) .story__stage {
    --bar: calc(100lvh - 100svh);

    position: sticky;
    top: 0;
    display: grid;
    align-content: center;
    height: 100lvh;
    padding-bottom: var(--bar);
    overflow: clip;
  }

  /* The values above the logo's place on phones, beside it on wide screens,
     as in the hero. */
  :global(:root[data-story='on']) .story__grid {
    height: 100%;
    grid-template-rows: auto minmax(0, 1fr);
    align-content: center;
    padding-block: calc(var(--header-height) + 1.5rem) 2rem;
  }

  :global(:root[data-story='on']) .story__slot {
    display: block;
    align-self: center;
    justify-self: center;
    width: min(100%, 22rem, 34svh);
    aspect-ratio: 1;
  }

  @media (min-width: 64rem) {
    :global(:root[data-story='on']) .story__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: none;
      column-gap: 2rem;
      align-items: center;
    }

    :global(:root[data-story]) .story__values {
      grid-column: 1 / span 7;
      font-size: min(var(--text-display), 17cqi, 15svh);
    }

    :global(:root[data-story]) .story__values--md {
      font-size: min(var(--text-display), 13cqi, 13svh);
    }

    :global(:root[data-story]) .story__values--sm {
      font-size: min(var(--text-display), 10.5cqi, 11svh);
    }

    :global(:root[data-story]) .story__values--xs {
      font-size: min(var(--text-display), 9cqi, 10svh);
    }

    :global(:root[data-story='on']) .story__slot {
      grid-column: 8 / span 5;
      width: min(100%, 22rem);
    }
  }

  /* Before the script starts (or if it cannot), the motto sits under the
     values; once it runs, the motto is centred on the stage and waits for its
     chapter. */
  :global(:root[data-story]) .story__motto {
    margin-top: clamp(2rem, 1rem + 4vw, 4rem);
  }

  :global(:root[data-story='on']) .story__motto {
    position: absolute;
    inset: 0 0 var(--bar);
    align-content: center;
    padding-inline: var(--gutter);
  }

  :global(:root[data-story='on']) .story__motto[data-story-motto] {
    visibility: hidden;
  }

  /* The sun's chapter: the page in the other theme's colours, opened and
     closed by the script with a circle around the sun (`clip-path`). */
  :global(:root[data-story='on']) .story__scene {
    position: absolute;
    inset: 0;
    /* Above the travelling glass logo (Hero.astro), which dives into it. */
    z-index: 2;
    display: block;
    background: var(--color-ink);
    color: var(--color-paper);
    visibility: hidden;
  }

  .story__scene .story__translation {
    color: inherit;
    opacity: 0.62;
  }

  /* The glass sun keeps the flat sun's place in the layout, and is sized
     by the script; a soft light glows behind it. */
  .story__scene .story__sun {
    position: relative;
    width: 1em;
    height: 1em;
  }

  .story__glass-sun,
  .story__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1em;
    translate: -50% -50%;
    perspective: 60rem;
  }

  .story__glass-sun > :global(.glass-sun) {
    width: 100%;
  }

  /* Drawn at sizes that halve as it settles (story.ts sets the width), and
     moved and scaled between them by the graphics card. */
  .story__glass-sun {
    will-change: transform;
  }

  .story__glow {
    width: 6em;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, currentColor 22%, transparent),
      color-mix(in srgb, currentColor 6%, transparent) 55%,
      transparent
    );
    opacity: 0;
  }

  .story__word {
    display: inline-block;
    overflow: clip;
    padding-block-end: 0.12em;
    margin-block-end: -0.12em;
  }

  .story__word > span {
    display: inline-block;
  }

  /* How far the walkthrough has come, along the foot of the stage. */
  :global(:root[data-story='on']) .story__progress {
    position: absolute;
    inset-inline: var(--gutter);
    bottom: calc(var(--bar) + 1.25rem);
    display: block;
    height: 1px;
    color: var(--color-ink);
    background: color-mix(in srgb, currentColor 14%, transparent);
    pointer-events: none;
  }

  .story__progress > span {
    display: block;
    height: 100%;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
  }

  :global([dir='rtl']) .story__progress > span {
    transform-origin: right;
  }

  @media print {
    :global(:root[data-story]) .story {
      height: auto;
      padding-block: var(--section-space);
    }

    :global(:root[data-story]) .story__stage {
      position: static;
      height: auto;
    }

    :global(:root[data-story='on']) .story__motto[data-story-motto] {
      position: static;
      visibility: visible;
      margin-top: var(--section-space);
    }

    :global(:root[data-story='on']) :is(.story__scene, .story__progress) {
      display: none;
    }
  }
</style>
