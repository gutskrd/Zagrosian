---
/**
 * The site header, the same at every size, as on a studio's site: the
 * logo and wordmark, then a few controls, and the menu button (two dots)
 * that opens the full-screen menu (SiteMenu.astro), where the pages are.
 *
 * From left to right, as room allows: Visit Hevalo (from 768px), quick
 * navigation (from 1024px, with JavaScript), the world icon for languages,
 * sound, theme, and the menu. On the narrowest phones the language and sound
 * controls live in the menu instead.
 */
import Arrow from './Arrow.astro';
import LanguagePicker from './LanguagePicker.astro';
import Logo from './Logo.astro';
import MenuButton from './MenuButton.astro';
import RollText from './RollText.astro';
import SiteMenu from './SiteMenu.astro';
import SoundToggle from './SoundToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import Wordmark from './Wordmark.astro';
import { i18n } from '../i18n';
import { hevalo } from '../site';

const { t, localize } = i18n(Astro.url);
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="site-header__home" href={localize('/')} aria-label={t.common.homeLink}>
      <Logo class="site-header__mark" size="mark" loading="eager" />
      <Wordmark />
    </a>

    <div class="site-header__end">
      <a class="site-header__cta" href={hevalo.url} data-magnetic data-pour>
        <span class="site-header__cta-pour" aria-hidden="true"></span>
        <span class="site-header__cta-content" data-magnetic-inner>
          <RollText text={t.nav.visitHevalo} />
          <Arrow direction="up-right" />
        </span>
      </a>

      <button
        class="command-trigger"
        data-magnetic
        type="button"
        aria-haspopup="dialog"
        aria-keyshortcuts="Control+K Meta+K"
        data-command-open
      >
        <svg class="command-trigger__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <circle cx="8.75" cy="8.75" r="5.75"></circle>
          <path d="M13 13l4.25 4.25"></path>
        </svg>
        <span class="visually-hidden">{t.command.open}</span>
        {/* Part of the button's name, so the name includes what is shown. */}
        <kbd class="command-trigger__keys" data-command-shortcut></kbd>
      </button>

      <div class="site-header__language">
        <LanguagePicker />
      </div>

      <SoundToggle class="site-header__sound" />
      <ThemeToggle />
      <MenuButton />
    </div>
  </div>

  <SiteMenu />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
    box-shadow: 0 1px 0 transparent;
    color: var(--color-ink);
    transition:
      box-shadow 0.3s ease,
      background-color 0.3s ease,
      color 0.3s ease;
    view-transition-name: site-header;
  }

  .site-header[data-scrolled] {
    box-shadow: 0 1px 0 var(--color-line);
  }

  /* For visitors who ask for less transparency, the header is solid. */
  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--color-paper);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--header-height);
  }

  .site-header__home {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    text-decoration: none;
  }

  .site-header__home :global(.site-header__mark) {
    width: 1.875rem;
  }

  .site-header__end {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* Labels in the bar never wrap; the breakpoints below leave room for the
     longest language. */
  .site-header__cta,
  .command-trigger {
    flex: none;
    white-space: nowrap;
  }

  /* Visit Hevalo, like the page's buttons (Cta.astro): magnetic, with the
     paper colour pouring in from the pointer and the label rolling. */
  .site-header__cta {
    position: relative;
    isolation: isolate;
    display: none;
    align-items: center;
    min-height: 2.5rem;
    margin-inline-end: 0.5rem;
    padding: 0 1rem;
    overflow: hidden;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition:
      color 0.5s var(--ease-out),
      scale 0.2s var(--ease-out);
  }

  .site-header__cta:active {
    scale: 0.97;
  }

  .site-header__cta-content {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .site-header__cta-pour {
    position: absolute;
    z-index: -1;
    top: var(--pour-y, 50%);
    left: var(--pour-x, 50%);
    width: 260%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-paper);
    translate: -50% -50%;
    scale: 0;
    transition: scale 0.7s var(--ease-out);
  }

  @media (hover: hover) {
    .site-header__cta:hover {
      color: var(--color-ink);
    }

    .site-header__cta:hover .site-header__cta-pour {
      scale: 1;
    }
  }

  /* On the narrowest phones, languages and sound move into the menu. */
  @media (max-width: 23.99rem) {
    .site-header__language,
    .site-header__end :global(.site-header__sound) {
      display: none !important;
    }
  }

  /* The menu button stands a little apart from the other controls. */
  .site-header__end :global(.menu-button) {
    margin-inline-start: 0.5rem;
  }

  /* Quick navigation (CommandMenu). It needs JavaScript, so it appears once the
     theme script has run, and only on wider screens; phones have the menu. */
  .command-trigger {
    display: none;
    align-items: center;
    gap: 0.5rem;
    height: 2.5rem;
    margin-inline-end: 0.25rem;
    padding: 0 0.5rem 0 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: none;
    color: var(--color-ink-soft);
    font: inherit;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  @media (hover: hover) {
    .command-trigger:hover {
      border-color: var(--color-line-strong);
      color: var(--color-ink);
    }
  }

  .command-trigger__icon {
    width: 1.0625rem;
    height: 1.0625rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .command-trigger__keys {
    display: inline-grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.375rem;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-muted);
    font: 500 0.6875rem/1 var(--font-sans);
    letter-spacing: 0.02em;
  }

  @media (min-width: 48rem) {
    .site-header__cta {
      display: inline-flex;
    }
  }

  @media (min-width: 64rem) {
    :global(:root[data-theme]) .command-trigger {
      display: inline-flex;
    }
  }
</style>
