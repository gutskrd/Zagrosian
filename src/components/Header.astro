---
import Arrow from './Arrow.astro';
import LanguagePicker from './LanguagePicker.astro';
import ThemeToggle from './ThemeToggle.astro';
import Wordmark from './Wordmark.astro';
import { i18n, localizePath, locales, navigation } from '../i18n';
import { hevalo } from '../site';
import EmblemMark from '../assets/brand/emblem-mark.svg';

const { locale, t, base, localize } = i18n(Astro.url);
const nav = navigation(locale);
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="site-header__home" href={localize('/')} aria-label={t.common.homeLink}>
      <EmblemMark class="site-header__mark" aria-hidden="true" focusable="false" />
      <Wordmark />
    </a>

    <div class="site-header__end">
      <nav class="site-nav" aria-label={t.common.primaryNav}>
        <ul class="site-nav__list">
          {
            nav.sections.map((link) => (
              <li>
                <a class="site-nav__link" href={link.href} data-nav-section={link.href.split('#')[1]}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="site-nav__cta" href={hevalo.url}>
          {t.nav.visitHevalo}
          <Arrow direction="up-right" />
        </a>
      </nav>

      <button
        class="command-trigger"
        type="button"
        aria-label={t.command.open}
        aria-haspopup="dialog"
        aria-keyshortcuts="Control+K Meta+K"
        data-command-open
      >
        <svg class="command-trigger__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <circle cx="8.75" cy="8.75" r="5.75"></circle>
          <path d="M13 13l4.25 4.25"></path>
        </svg>
        <kbd class="command-trigger__keys" aria-hidden="true" data-command-shortcut></kbd>
      </button>

      <div class="site-header__language">
        <LanguagePicker />
      </div>

      <ThemeToggle />

      <button class="menu-toggle" type="button" popovertarget="mobile-menu" aria-controls="mobile-menu">
        <span class="menu-toggle__label menu-toggle__label--open">{t.common.menu}</span>
        <span class="menu-toggle__label menu-toggle__label--close" aria-hidden="true">{t.common.close}</span>
        <span class="menu-toggle__icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="mobile-menu" popover aria-label={t.common.menu} data-mobile-menu>
    <div class="container mobile-menu__inner">
      <ul class="mobile-menu__list">
        {
          nav.sections.map((link) => (
            <li>
              <a class="mobile-menu__link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a class="mobile-menu__cta" href={hevalo.url}>
        {t.nav.visitHevalo}
        <Arrow direction="up-right" />
      </a>

      <ul class="mobile-menu__languages" aria-label={t.language.label}>
        {
          locales.map(({ code, name, dir }) => (
            <li>
              <a
                class="language__link"
                href={localizePath(code, base)}
                hreflang={code}
                lang={code}
                aria-current={code === locale ? 'true' : undefined}
              >
                <span dir={dir}>{name}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mobile-menu__meta">
        <ul>
          {
            nav.legal.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
    box-shadow: 0 1px 0 transparent;
    color: var(--color-ink);
    transition:
      box-shadow 0.3s ease,
      background-color 0.3s ease,
      color 0.3s ease;
    view-transition-name: site-header;
  }

  .site-header[data-scrolled] {
    box-shadow: 0 1px 0 var(--color-line);
  }

  /* For visitors who ask for less transparency, the header is solid. */
  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--color-paper);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-height);
  }

  .site-header__home {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    text-decoration: none;
  }

  /* The emblem's silhouette, which reads at this size; drawn in the text
     colour, so it follows the theme. */
  .site-header__home :global(.site-header__mark) {
    flex: none;
    width: auto;
    height: 1.875rem;
  }

  .site-header__end {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* Desktop navigation */

  .site-nav {
    display: none;
    align-items: center;
    gap: 1.5rem;
  }

  .site-nav__list {
    display: flex;
    gap: 1.5rem;
  }

  /* Labels in the bar never wrap; the breakpoints below leave room for the
     longest language. */
  .site-nav__link,
  .site-nav__cta,
  .command-trigger {
    flex: none;
    white-space: nowrap;
  }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-sm);
    font-weight: 450;
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0.55rem;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: var(--start);
    transition: transform 0.35s var(--ease-out);
  }

  .site-nav__link:hover,
  .site-nav__link[aria-current] {
    color: var(--color-ink);
  }

  .site-nav__link[aria-current]::after {
    transform: scaleX(1);
  }

  .site-nav__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.5rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      transform 0.2s var(--ease-out);
  }

  .site-nav__cta:hover {
    background: var(--color-solid-hover);
  }

  .site-nav__cta:active,
  .mobile-menu__cta:active {
    transform: scale(0.97);
  }

  /* Mobile menu */

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    margin-inline-end: -0.5rem;
    padding: 0 0.5rem;
    border: 0;
    background: none;
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
  }

  /* Two lines that become a cross when the menu is open. */
  .menu-toggle__icon {
    position: relative;
    width: 1rem;
    height: 0.625rem;
  }

  .menu-toggle__icon::before,
  .menu-toggle__icon::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    transition:
      transform 0.35s var(--ease-out),
      top 0.35s var(--ease-out);
  }

  .menu-toggle__icon::before {
    top: 0;
  }

  .menu-toggle__icon::after {
    top: calc(100% - 1.5px);
  }

  .site-header:has(.mobile-menu:popover-open) .menu-toggle__icon::before,
  .site-header:has(.mobile-menu:popover-open) .menu-toggle__icon::after {
    top: calc(50% - 0.75px);
  }

  .site-header:has(.mobile-menu:popover-open) .menu-toggle__icon::before {
    transform: rotate(45deg);
  }

  .site-header:has(.mobile-menu:popover-open) .menu-toggle__icon::after {
    transform: rotate(-45deg);
  }

  .menu-toggle__label--close,
  .site-header:has(.mobile-menu:popover-open) .menu-toggle__label--open {
    display: none;
  }

  .site-header:has(.mobile-menu:popover-open) .menu-toggle__label--close {
    display: inline;
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-height) 0 0;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transition:
      opacity 0.3s var(--ease-out),
      overlay 0.3s allow-discrete,
      display 0.3s allow-discrete;
  }

  .mobile-menu:popover-open {
    opacity: 1;
  }

  @starting-style {
    .mobile-menu:popover-open {
      opacity: 0;
    }
  }

  .mobile-menu::backdrop {
    background: transparent;
  }

  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-block: 1.5rem max(2rem, env(safe-area-inset-bottom));
  }

  .mobile-menu__list {
    border-top: 1px solid var(--color-line);
  }

  .mobile-menu__list li {
    border-bottom: 1px solid var(--color-line);
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    min-height: 4.5rem;
    font-size: 2rem;
    font-weight: 560;
    letter-spacing: -0.035em;
    text-decoration: none;
  }

  /* Links rise in one after another when the menu opens. */
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu__list li,
    .mobile-menu__cta {
      transition:
        opacity 0.5s var(--ease-out),
        transform 0.5s var(--ease-out);
    }

    .mobile-menu:not(:popover-open) .mobile-menu__list li,
    .mobile-menu:not(:popover-open) .mobile-menu__cta {
      opacity: 0;
      transform: translateY(0.75rem);
    }

    @starting-style {
      .mobile-menu:popover-open .mobile-menu__list li,
      .mobile-menu:popover-open .mobile-menu__cta {
        opacity: 0;
        transform: translateY(0.75rem);
      }
    }

    .mobile-menu__list li:nth-child(2) {
      transition-delay: 0.04s;
    }

    .mobile-menu__list li:nth-child(3) {
      transition-delay: 0.08s;
    }

    .mobile-menu__cta {
      transition-delay: 0.12s;
    }
  }

  .mobile-menu__cta {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.5rem;
    min-height: 3.25rem;
    margin-top: 2rem;
    padding: 0 1.5rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-weight: 500;
    text-decoration: none;
  }

  .mobile-menu__languages {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 0.25rem 1rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  .mobile-menu__languages a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    text-decoration: none;
  }

  .mobile-menu__languages a[aria-current] {
    color: var(--color-ink);
    font-weight: 600;
  }

  /* The header menu is for wider screens; phones use the list in the menu. */
  .site-header__language {
    display: none;
  }

  .mobile-menu__meta {
    display: grid;
    gap: 0.25rem;
    margin-top: auto;
    padding-top: 3rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .mobile-menu__meta ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }

  .mobile-menu__meta a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
  }

  @media (max-width: 59.99rem) {
    :global(html:has(.mobile-menu:popover-open)) {
      overflow: hidden;
    }
  }

  /* Quick navigation (CommandMenu). It needs JavaScript, so it appears once the
     theme script has run, and only on screens with the full navigation bar;
     phones have the menu instead. */
  .command-trigger {
    display: none;
    align-items: center;
    gap: 0.5rem;
    height: 2.5rem;
    padding: 0 0.5rem 0 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: none;
    color: var(--color-ink-soft);
    font: inherit;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  @media (hover: hover) {
    .command-trigger:hover {
      border-color: var(--color-line-strong);
      color: var(--color-ink);
    }
  }

  .command-trigger__icon {
    width: 1.0625rem;
    height: 1.0625rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .command-trigger__keys {
    display: inline-grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.375rem;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-muted);
    font: 500 0.6875rem/1 var(--font-sans);
    letter-spacing: 0.02em;
  }

  /* Tablets keep the menu button, with the language and theme controls
     beside it. The full navigation bar needs about 850px in its longest
     language (Kurmanji), so it starts at 960px, and the quick navigation
     button joins it from 1024px. */
  @media (min-width: 48rem) {
    .site-header__end {
      gap: 0.75rem;
    }

    .site-header__language {
      display: block;
    }
  }

  @media (min-width: 60rem) {
    .site-nav {
      display: flex;
    }

    .menu-toggle,
    .mobile-menu {
      display: none;
    }
  }

  @media (min-width: 64rem) {
    :global(:root[data-theme]) .command-trigger {
      display: inline-flex;
    }
  }

  @media (min-width: 80rem) {
    .site-nav,
    .site-nav__list {
      gap: 2rem;
    }
  }
</style>
