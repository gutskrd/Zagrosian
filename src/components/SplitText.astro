---
/**
 * A heading split into words at build time, for word-by-word animation.
 *
 * - `rise`: words slide up from behind a mask as the heading scrolls into view.
 * - `highlight`: words brighten one after another as the reader scrolls past.
 *
 * Inter's circumflex on î is wider than the letter, so at tight display
 * tracking it touches a preceding ascender (the d in "kurdî"). Such an î is
 * wrapped in `split__kern`, which adds a little space before it.
 *
 * The heading keeps its full text as its accessible name; the split copy is
 * hidden from assistive technology. Nothing is generated in the browser, so
 * this works under the site's Trusted Types policy, and without JavaScript the
 * heading simply shows as normal text.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'h2'> {
  text: string;
  as?: 'h1' | 'h2' | 'h3';
  effect?: 'rise' | 'highlight';
  id?: string;
  class?: string;
}

// Remaining attributes include the parent component's style scope, so its
// scoped styles still apply to the heading.
const { text, as: Tag = 'h2', effect = 'rise', id, class: className, ...attributes } = Astro.props;

// A newline in `text` starts a new line, e.g. one sentence per line.
const lines = text.split('\n').map((line) => line.split(' '));
// Keep the last two words together, so the heading never ends on a lone short
// word. Longer pairs are left to wrap, or they could overflow narrow screens.
const lastLine = lines[lines.length - 1];
if (lastLine.length > 2 && lastLine.slice(-2).join(' ').length <= 16) {
  const last = lastLine.pop();
  lastLine[lastLine.length - 1] += `\u00a0${last}`;
}

/** Splits a word so that the odd-indexed parts are an î after an ascender. */
const kernParts = (word: string) => word.split(/(?<=[bdfhklt])(î)/);
---

<Tag
  {...attributes}
  id={id}
  class:list={['split', className]}
  aria-label={text.replaceAll('\n', ' ')}
  data-split={effect === 'rise' ? '' : undefined}
  data-highlight={effect === 'highlight' ? '' : undefined}
>
  {
    lines.map((words, line) => (
      <>
        {line > 0 && <br />}
        {words.map((word, index) => (
          <>
            {index > 0 && ' '}
            <span class="split__word" aria-hidden="true">
              <span class="split__inner">{kernParts(word).map((part, i) => (i % 2 ? <span class="split__kern">{part}</span> : part))}</span>
            </span>
          </>
        ))}
      </>
    ))
  }
</Tag>
