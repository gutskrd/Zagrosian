---
/**
 * Quick navigation: one searchable list of every page, section, language and
 * theme, plus a few actions. Opens with Ctrl K or ⌘K, with "/", or from the
 * search button in the header (src/scripts/command.ts).
 *
 * A native modal <dialog>, so focus stays inside and Escape closes it. The
 * search field and list follow the ARIA combobox pattern: the field keeps
 * focus and the highlighted option is announced. Every entry is written here
 * at build time; the script only shows, hides and highlights them, so no HTML
 * is generated in the browser. Entries match both their label in this
 * language and in English, so "privacy" also finds "Datenschutz".
 */
import { i18n, localizePath, locales, messages, navigation } from '../i18n';
import { hevalo, site } from '../site';

const { locale, t, base } = i18n(Astro.url);
const en = messages('en');
const nav = navigation(locale);

type Icon = 'page' | 'section' | 'external' | 'copy' | 'light' | 'dark' | 'system' | 'language';

interface Entry {
  label: string;
  /** Extra words that find this entry, besides its label. */
  keywords: string[];
  icon: Icon;
  href?: string;
  action?: 'copy' | 'theme';
  value?: string;
  /** For language names: written in, and shown in the direction of, that language. */
  lang?: string;
  dir?: string;
  code?: string;
  current?: boolean;
}

const [home, ...legal] = [nav.home, ...nav.legal];
const currentPath = localizePath(locale, base);
const legalKeys = ['privacy', 'terms', 'security'] as const;
const sectionKeys = ['hevalo', 'about', 'contact'] as const;

const groups: { id: string; label: string; entries: Entry[] }[] = [
  {
    id: 'pages',
    label: t.command.pages,
    entries: [
      { label: home.label, keywords: [en.nav.home, 'zagrosian'], icon: 'page', href: home.href, current: home.href === currentPath },
      ...legal.map((link, index) => ({
        label: link.label,
        keywords: [en.nav[legalKeys[index]], { privacy: 'policy gdpr cookies data', terms: 'terms of use conditions legal', security: 'vulnerability disclosure report' }[legalKeys[index]]],
        icon: 'page' as const,
        href: link.href,
        current: link.href === currentPath,
      })),
    ],
  },
  {
    id: 'sections',
    label: t.command.sections,
    entries: nav.sections.map((link, index) => ({
      label: link.label,
      keywords: [en.nav[sectionKeys[index]], index === 0 ? 'app product kurdish' : index === 2 ? 'email press' : 'company mission'],
      icon: 'section' as const,
      href: link.href,
    })),
  },
  {
    id: 'actions',
    label: t.command.actions,
    entries: [
      { label: t.hevalo.visit, keywords: [en.hevalo.visit, 'hevalo app website'], icon: 'external', href: hevalo.url },
      { label: t.command.copyEmail, keywords: [en.command.copyEmail, site.emails.contact], icon: 'copy', action: 'copy', value: site.emails.contact },
    ],
  },
  {
    id: 'theme',
    label: t.theme.legend,
    entries: (['light', 'dark', 'system'] as const).map((preference) => ({
      label: t.theme[preference],
      keywords: [en.theme[preference], en.theme.legend, 'theme mode appearance'],
      icon: preference,
      action: 'theme' as const,
      value: preference,
    })),
  },
  {
    id: 'language',
    label: t.language.label,
    entries: locales.map(({ code, name, englishName, dir }) => ({
      label: name,
      keywords: [englishName, code, 'language'],
      icon: 'language' as const,
      href: localizePath(code, base),
      lang: code,
      dir,
      code: code.toUpperCase(),
      current: code === locale,
    })),
  },
];

let counter = 0;
const withIds = groups.map((group) => ({
  ...group,
  entries: group.entries.map((entry) => ({ ...entry, id: `command-option-${counter++}` })),
}));

// Everything an entry can be found by, in one lowercase string without accents.
const searchText = (entry: Entry) =>
  [entry.label, ...entry.keywords]
    .join(' ')
    .normalize('NFKD')
    .replace(/\p{M}/gu, '')
    .toLowerCase();
---

<dialog class="command" aria-label={t.command.title} data-command-menu>
  <div class="command__search">
    <svg class="command__search-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <circle cx="8.75" cy="8.75" r="5.75"></circle>
      <path d="M13 13l4.25 4.25"></path>
    </svg>
    <input
      class="command__input"
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="command-list"
      aria-autocomplete="list"
      aria-label={t.command.title}
      placeholder={t.command.placeholder}
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="go"
      data-command-input
    />
    <kbd class="command__esc" aria-hidden="true">esc</kbd>
  </div>

  <div class="command__list" id="command-list" role="listbox" aria-label={t.command.title} data-command-list>
    {
      withIds.map((group) => (
        <div class="command__group" role="group" aria-label={group.label} data-command-group>
          <span class="command__group-label" aria-hidden="true">
            {group.label}
          </span>
          {group.entries.map((entry) => {
            const Tag = entry.href ? 'a' : 'div';
            return (
              <Tag
                class="command__option"
                id={entry.id}
                role="option"
                aria-selected="false"
                aria-current={entry.current ? 'true' : undefined}
                tabindex="-1"
                href={entry.href}
                hreflang={entry.lang}
                data-command-option
                data-search={searchText(entry)}
                data-action={entry.action}
                data-value={entry.value}
                data-language-link={entry.lang ? '' : undefined}
              >
                <span class="command__icon" aria-hidden="true">
                  {entry.icon === 'language' ? (
                    <span class="command__code">{entry.code}</span>
                  ) : (
                    <svg viewBox="0 0 20 20" focusable="false">
                      {entry.icon === 'page' && <path d="M5.5 2.75h6l3 3v11.5h-9zM11.5 2.75v3h3M8 10h4.5M8 13h4.5" />}
                      {entry.icon === 'section' && <path d="M7.75 3.5l-1.5 13M13.75 3.5l-1.5 13M4 7.5h13M3 12.5h13" />}
                      {entry.icon === 'external' && <path d="M7 13l6.5-6.5M8 6.5h5.5V12M15 11v5H4.5V5.5h5" />}
                      {entry.icon === 'copy' && <path d="M7.5 7.5h8.25v8.75H7.5zM12.5 7.5V3.75H4.25v8.75H7.5" />}
                      {entry.icon === 'light' && (
                        <>
                          <circle cx="10" cy="10" r="3.25" />
                          <path d="M10 2.5v1.75M10 15.75v1.75M2.5 10h1.75M15.75 10h1.75M4.7 4.7l1.24 1.24M14.06 14.06l1.24 1.24M4.7 15.3l1.24-1.24M14.06 5.94l1.24-1.24" />
                        </>
                      )}
                      {entry.icon === 'dark' && <path d="M15.75 12.25A6.5 6.5 0 0 1 7.75 4.25a6.5 6.5 0 1 0 8 8z" />}
                      {entry.icon === 'system' && <path d="M3.25 4.5h13.5v9H3.25zM7.5 16.5h5M10 13.5v3" />}
                    </svg>
                  )}
                </span>
                <span class="command__label" lang={entry.lang} dir={entry.dir}>
                  {entry.label}
                </span>
                <svg class="command__check" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <path d="M3.5 8.5l3 3 6-7" />
                </svg>
              </Tag>
            );
          })}
        </div>
      ))
    }
    <p class="command__empty" hidden data-command-empty>{t.command.empty}</p>
  </div>

  <div class="command__footer" aria-hidden="true">
    <span><kbd>↑</kbd><kbd>↓</kbd> {t.command.hintMove}</span>
    <span><kbd>↵</kbd> {t.command.hintOpen}</span>
    <span><kbd>esc</kbd> {t.command.hintClose}</span>
  </div>
</dialog>

<p class="visually-hidden" role="status" data-command-status data-copied={t.contact.copiedStatus}></p>

<style>
  .command {
    width: min(38rem, 100% - 2 * var(--gutter));
    max-height: min(34rem, 100svh - 6rem);
    margin: max(4rem, 12svh) auto auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-line-strong);
    border-radius: 1.25rem;
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 24px 64px rgb(0 0 0 / 0.22);
  }

  .command[open] {
    display: flex;
    flex-direction: column;
  }

  .command::backdrop {
    background: rgb(10 10 10 / 0.32);
    backdrop-filter: blur(3px);
  }

  :global([data-theme='dark']) .command {
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.02),
      0 24px 64px rgb(0 0 0 / 0.6);
  }

  :global([data-theme='dark']) .command::backdrop {
    background: rgb(0 0 0 / 0.55);
  }

  @media (prefers-reduced-motion: no-preference) {
    .command,
    .command::backdrop {
      transition:
        opacity 0.2s ease,
        transform 0.3s var(--ease-out),
        overlay 0.2s allow-discrete,
        display 0.2s allow-discrete;
    }

    .command:not([open]) {
      opacity: 0;
      transform: translateY(-0.5rem) scale(0.98);
    }

    .command:not([open])::backdrop {
      opacity: 0;
    }

    @starting-style {
      .command[open] {
        opacity: 0;
        transform: translateY(-0.5rem) scale(0.98);
      }

      .command[open]::backdrop {
        opacity: 0;
      }
    }
  }

  .command__search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1.25rem;
    border-bottom: 1px solid var(--color-line);
  }

  .command__search-icon {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .command__input {
    flex: 1;
    min-width: 0;
    height: 3.75rem;
    border: 0;
    background: none;
    color: var(--color-ink);
    font: inherit;
    font-size: 1.0625rem;
    letter-spacing: -0.011em;
    outline: none;
  }

  .command__input::placeholder {
    color: var(--color-muted);
    opacity: 1;
  }

  kbd {
    display: inline-grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.375rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 0.375rem;
    color: var(--color-muted);
    font: 500 0.75rem/1 var(--font-sans);
  }

  .command__list {
    flex: 1;
    min-height: 0;
    padding: 0.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-padding-block: 2.25rem 0.5rem;
  }

  .command__group + .command__group {
    margin-top: 0.25rem;
  }

  .command__group-label {
    display: block;
    padding: 0.75rem 0.75rem 0.375rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .command__option {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border-radius: 0.75rem;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    text-decoration: none;
    cursor: pointer;
    user-select: none;
  }

  .command__option[aria-selected='true'] {
    background: var(--color-surface);
    color: var(--color-ink);
  }

  :global([data-theme='dark']) .command__option[aria-selected='true'] {
    background: #1c1c1c;
  }

  .command__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    color: var(--color-muted);
  }

  .command__icon svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .command__code {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .command__option[aria-selected='true'] .command__icon {
    border-color: var(--color-line-strong);
    color: var(--color-ink);
  }

  .command__label {
    flex: 1;
    min-width: 0;
  }

  .command__check {
    flex: none;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    visibility: hidden;
  }

  .command__option[aria-current='true'] .command__check {
    visibility: visible;
  }

  .command__empty {
    padding: 2.5rem 1rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-align: center;
  }

  .command__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .command__footer span {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .command__footer kbd {
    min-width: 1.25rem;
    height: 1.25rem;
    font-size: 0.6875rem;
  }

  /* Touch screens have no arrow keys or Escape key. */
  @media (hover: none) {
    .command__footer,
    .command__esc {
      display: none;
    }
  }

  @media (forced-colors: active) {
    .command__option[aria-selected='true'] {
      outline: 2px solid Highlight;
      outline-offset: -2px;
    }
  }
</style>
