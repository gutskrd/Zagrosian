---
import { i18n } from '../i18n';
import Arrow from './Arrow.astro';
import Cta from './Cta.astro';
import HevaloIcon from './HevaloIcon.astro';
import LiftedLogo from './LiftedLogo.astro';

const { t } = i18n(Astro.url);

// Size the headline so its longest line fits the column. Most locales fit the default; longer lines
// step down (see .hero__title--*).
const longest = Math.max(...t.hero.headline.map((line) => [...line].length));
const fit = longest <= 14 ? undefined : longest <= 16 ? 'md' : longest <= 18 ? 'sm' : 'xs';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__sun" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__text">
      <a class="hero__notice intro" href="#hevalo">
        <HevaloIcon class="hero__notice-icon" sizes="20px" />
        <span>{t.hero.notice}</span>
        <Arrow direction="down" class="hero__notice-arrow" />
      </a>

      <h1 id="hero-title" class:list={['hero__title', fit && `hero__title--${fit}`]}>
        {
          t.hero.headline.map((line, index) => (
            <>
              {/* A real space between lines for unstyled consumers (search engines, crawlers). */}
              {index > 0 && ' '}
              <span class="hero__line">
                <span>{line}</span>
              </span>
            </>
          ))
        }
      </h1>

      <p class="hero__lead lead intro">{t.hero.lead}</p>

      <div class="hero__actions intro">
        <Cta href="#hevalo" arrow="down" label={t.hero.products} />
        <Cta href="#about" variant="link" label={t.hero.about} />
      </div>
    </div>

    <figure class="hero__mark intro" data-journey-from>
      <div class="hero__art">
        <LiftedLogo class="hero__logo" alt={t.hero.logoAlt} />
      </div>
    </figure>
  </div>
</section>

{
  /* The layer the logo travels in on its way into the story below
     (Story.astro, src/scripts/story.ts), fixed to the screen. The script
     copies the logo into it; it is unused without JavaScript or with reduced
     motion. */
}
<div class="journey" aria-hidden="true" data-journey-layer>
  <div class="journey__art" data-lean>
    <div class="journey__tilt"></div>
  </div>
</div>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 1.5rem + 8vw, 8rem) clamp(4rem, 2rem + 6vw, 7rem);
    /* The logo's shadow may extend past the viewport edges without causing horizontal scroll. */
    overflow-x: clip;
  }

  /* Short laptop screens (1280x720, 1366x768): less top space, so the headline, copy and both
     buttons fit above the fold. */
  @media (min-width: 64rem) and (max-height: 50rem) {
    .hero {
      padding-top: max(2rem, 12vh - 1rem);
    }
  }

  /* Window light on the wall behind the logo: two broad soft beams and a narrow one, the same light
     the rug lies in further down and that crosses the footer wordmark. Static, so it costs nothing
     while scrolling. */
  .hero__sun {
    --sun-a: 0.085;
    position: absolute;
    inset: 0 -8% 0 30%;
    pointer-events: none;
    background: linear-gradient(
      40deg,
      transparent 14%,
      rgb(var(--sun) / var(--sun-a)) 30% 38%,
      transparent 52%,
      rgb(var(--sun) / calc(var(--sun-a) * 0.8)) 60% 64%,
      transparent 76%
    );
    /* Fade the light patch out well within the hero. */
    mask-image: radial-gradient(54% 44% at 64% 50%, #000 15%, transparent 100%);
  }

  :global(:root[data-theme='dark']) .hero__sun {
    --sun-a: 0.07;
  }

  @media (forced-colors: active) {
    .hero__sun {
      display: none;
    }
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 4rem);
  }

  /* Announcement above the headline, linking to the Hevalo section. */
  .hero__notice {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.25rem;
    margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    padding: 0.25rem 0.875rem 0.25rem 0.75rem;
    border: 1px solid var(--color-line-strong);
    /* Half its height: a pill on one line, a rounded box when wrapped. */
    border-radius: 1.125rem;
    font-size: clamp(0.8125rem, 0.75rem + 0.3vw, 0.9375rem);
    font-weight: 450;
    color: var(--color-ink-soft);
    text-decoration: none;
    text-wrap: balance;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .hero__notice :global(.hero__notice-icon) {
    width: 1.25rem;
    margin-inline-start: -0.25rem;
  }

  .hero__notice :global(.hero__notice-arrow) {
    width: 0.875rem;
    height: 0.875rem;
    color: var(--color-muted);
    transition: transform 0.3s var(--ease-out);
  }

  /* Narrowest phones: drop the arrow to give the text more room. */
  @media (max-width: 22.49rem) {
    .hero__notice :global(.hero__notice-arrow) {
      display: none;
    }
  }

  @media (hover: hover) {
    .hero__notice:hover {
      border-color: var(--color-ink);
      color: var(--color-ink);
    }

    .hero__notice:hover :global(.hero__notice-arrow) {
      transform: translateY(2px);
    }
  }

  /* The headline scales with its column ("Technology for" is about 6.1em wide) and stays above the
     traveling logo, which may pass behind it. Each `cqi` size is preceded by a `--cq` equivalent
     (global.css) for browsers without container query units. */
  .hero__text {
    position: relative;
    z-index: 2;
    container-type: inline-size;
  }

  .hero__title {
    /* Never wider than the column, nor too tall on short landscape screens. */
    font-size: min(var(--text-display), calc(16 * var(--cq)), 18svh);
    font-size: min(var(--text-display), 16cqi, 18svh);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .hero__title--md {
    font-size: min(var(--text-display), calc(14 * var(--cq)), 18svh);
    font-size: min(var(--text-display), 14cqi, 18svh);
  }

  .hero__title--sm {
    font-size: min(var(--text-display), calc(12.5 * var(--cq)), 18svh);
    font-size: min(var(--text-display), 12.5cqi, 18svh);
  }

  .hero__title--xs {
    font-size: min(var(--text-display), calc(11 * var(--cq)), 18svh);
    font-size: min(var(--text-display), 11cqi, 18svh);
  }

  /* Each line rises from its own mask on load. */
  .hero__line {
    display: block;
    overflow: hidden;
    padding: 0 0.06em 0.14em;
    margin: 0 -0.06em -0.14em;
  }

  .hero__line > span {
    display: block;
  }

  .hero__lead {
    max-width: 34rem;
    margin-top: clamp(1.75rem, 1rem + 2vw, 2.5rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: clamp(2rem, 1.5rem + 1.5vw, 2.75rem);
  }

  /* Glass logo in 3D over two soft lights that show through the glass. The lights are radial
     gradients shaped like a disc blurred by 1.75rem rather than actual blurs: a large blur behind
     3D glass is expensive to repaint while the logo moves. (No filter or opacity may be set on the
     logo's ancestors once it's in place; they would flatten the 3D.) */
  .hero__mark,
  .journey {
    --glow: 0 0 0;
    --glow-a: 0.09;
    --glow-b: 0.05;
  }

  :global(:root[data-theme='dark']) .hero__mark,
  :global(:root[data-theme='dark']) .journey {
    --glow: 255 255 255;
    --glow-a: 0.22;
    --glow-b: 0.11;
  }

  .hero__mark {
    position: relative;
    justify-self: center;
    width: min(64vw, 18rem);
    margin: 0;
    perspective: 80rem;
  }

  .hero__mark::before,
  .hero__mark::after,
  .journey__art::before,
  .journey__art::after {
    content: '';
    position: absolute;
    aspect-ratio: 1;
    pointer-events: none;
  }

  /* Disc 64% of the logo width, centered near its top-right corner. */
  .hero__mark::before,
  .journey__art::before {
    top: -26.5%;
    right: -28.5%;
    width: 105%;
    background: radial-gradient(
      closest-side,
      rgb(var(--glow) / var(--glow-a)) 29%,
      rgb(var(--glow) / calc(var(--glow-a) * 0.84)) 45%,
      rgb(var(--glow) / calc(var(--glow-a) * 0.5)) 60%,
      rgb(var(--glow) / calc(var(--glow-a) * 0.16)) 76%,
      rgb(var(--glow) / calc(var(--glow-a) * 0.02)) 92%,
      rgb(var(--glow) / 0)
    );
  }

  /* Disc 52% of the logo width, centered near its bottom-left corner. */
  .hero__mark::after,
  .journey__art::after {
    bottom: -26.75%;
    left: -28.75%;
    width: 93.5%;
    background: radial-gradient(
      closest-side,
      rgb(var(--glow) / var(--glow-b)) 20%,
      rgb(var(--glow) / calc(var(--glow-b) * 0.84)) 38%,
      rgb(var(--glow) / calc(var(--glow-b) * 0.5)) 55%,
      rgb(var(--glow) / calc(var(--glow-b) * 0.16)) 73%,
      rgb(var(--glow) / calc(var(--glow-b) * 0.02)) 91%,
      rgb(var(--glow) / 0)
    );
  }

  .hero__art {
    position: relative;
    z-index: 1;
    transform-style: preserve-3d;
  }

  /* Transition into the story. theme-init.js reserves the story's space before first paint
     (`data-story`), and story.ts activates it once the logo is cloned into this layer
     (`data-story='on'`). The hero logo then stays in place, invisible, for screen readers while the
     clone travels: fixed to the viewport below the hero text, it settles beside the story's values
     and the camera dollies into it (`data-hidden` once the scene takes over). With a mouse it still
     leans toward the pointer (motion.ts). */
  .journey {
    display: none;
    /* Always LTR: while rotating, the logo is laid out at its on-screen size, growing from its
       top-left corner. In RTL the browser would anchor it at the top-right corner, which moves, and
       count that as layout shift. It's artwork positioned from the left by story.ts. */
    direction: ltr;
  }

  :global(:root[data-story='on']) .journey {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1;
    width: 100%;
    height: 0;
    pointer-events: none;
  }

  .journey[data-hidden] {
    visibility: hidden;
  }

  /* Face-on, the block edge is invisible, so skip drawing it (story.ts). */
  .journey[data-flat] :global(.lifted-logo__slice) {
    visibility: hidden;
  }

  /* Once the camera passes the front pane, skip drawing it. */
  .journey[data-through] :global(.lifted-logo__front) {
    visibility: hidden;
  }

  /* Facing the viewer: laid out once and only translated and scaled on the compositor; story.ts
     triggers a sharp re-raster whenever the scale crosses a sqrt(2) step. */
  .journey[data-facing] .journey__art {
    will-change: transform;
  }

  .journey__art {
    position: absolute;
    top: 0;
    left: 0;
    perspective: 80rem;
    transform-origin: 50% 50%;
  }

  /* Pointer lean (motion.ts sets --lean-x and --lean-y from -1 to 1, plus the angle), which the
     story fades out (--lean, 1 to 0) as the logo faces the viewer. */
  .journey__tilt {
    --lean-x: 0;
    --lean-y: 0;
    --lean-angle: 0deg;

    position: relative;
    z-index: 1;
    transform-style: preserve-3d;
    rotate: calc(var(--lean-y) * -1) var(--lean-x) 0 calc(var(--lean, 1) * var(--lean-angle));
    translate: calc(var(--lean, 1) * var(--lean-x) * 12px * var(--grow, 1)) calc(var(--lean, 1) * var(--lean-y) * 8px * var(--grow, 1));
  }

  :global(:root[data-story='on']) .hero__art,
  :global(:root[data-story='on']) .hero__mark::before,
  :global(:root[data-story='on']) .hero__mark::after {
    opacity: 0;
  }

  /* Print: the logo stays in the hero. */
  @media print {
    :global(:root[data-story='on']) .journey {
      display: none;
    }

    :global(:root[data-story='on']) .hero__art,
    :global(:root[data-story='on']) .hero__mark::before,
    :global(:root[data-story='on']) .hero__mark::after {
      opacity: 1;
    }
  }

  .hero__mark :global(.hero__logo) {
    width: 100%;
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      align-items: end;
    }

    .hero__text {
      grid-column: 1 / span 7;
      /* 1% of 7 of 12 columns with 2rem gaps, for the declaration before each `cqi` value. */
      --cq: calc((min(100vw - 2 * var(--gutter), var(--container)) - 22rem) * 7 / 1200 + 0.12rem);
    }

    .hero__mark {
      grid-column: 8 / span 5;
      align-self: center;
      width: 100%;
      max-width: 22rem;
    }
  }

  /* Entrance. Each animation fills `backwards` (holds its first frame through the delay) and
     releases when done, so nothing stays animated: a finished animation holding its last frame
     would keep the glass logo on its own compositor layer, repainted on every frame of the scroll
     story below. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__line > span {
      animation: line-rise 1.1s var(--ease-out) backwards;
    }

    .hero__line:nth-child(2) > span {
      animation-delay: 0.08s;
    }

    .hero__line:nth-child(3) > span {
      animation-delay: 0.16s;
    }

    .intro {
      animation: intro 1.1s var(--ease-out) backwards;
    }

    .hero__lead {
      animation-delay: 0.3s;
    }

    .hero__actions {
      animation-delay: 0.4s;
    }

    .hero__mark,
    .journey__tilt {
      animation: logo-in 1.4s var(--ease-out) 0.3s backwards;
    }

    /* The two soft lights travel with the logo. */
    .journey__art::before,
    .journey__art::after {
      animation: glow-in 1.4s var(--ease-out) 0.3s backwards;
    }

    /* On the homepage the header enters with everything else, so nothing is ever shown in the
       fallback font. */
    :global(:root:has(.hero) .site-header__inner) {
      animation: glow-in 0.9s var(--ease-out) backwards;
    }
  }

  /* Held on its first frame while the font and logo images load (theme-init.js), so the entrance
     plays once, complete. */
  :global(:root[data-entrance='waiting']) .hero__line > span,
  :global(:root[data-entrance='waiting']) .intro,
  :global(:root[data-entrance='waiting']) .hero__mark,
  :global(:root[data-entrance='waiting']) .journey__tilt,
  :global(:root[data-entrance='waiting']) .journey__art::before,
  :global(:root[data-entrance='waiting']) .journey__art::after,
  :global(:root[data-entrance='waiting'] .site-header__inner) {
    animation-play-state: paused;
  }

  /* Arriving from another page of the site, the whole page slides in (global.css) and that serves
     as the entrance (flag set by theme-init.js). */
  :global(:root[data-arrival='slide']) .hero__line > span,
  :global(:root[data-arrival='slide']) .intro,
  :global(:root[data-arrival='slide']) .hero__mark,
  :global(:root[data-arrival='slide']) .journey__tilt,
  :global(:root[data-arrival='slide']) .journey__art::before,
  :global(:root[data-arrival='slide']) .journey__art::after,
  :global(:root[data-arrival='slide'] .site-header__inner) {
    animation: none;
  }

  /* Far enough below the mask that no ascender peeks over its edge. */
  @keyframes line-rise {
    from {
      transform: translateY(130%);
    }
  }

  @keyframes glow-in {
    from {
      opacity: 0;
    }
  }

  /* Fades start at 1% opacity rather than 0: visually identical, but the browser then records
     Largest Contentful Paint when the hero starts appearing, not when the fade ends. */
  @keyframes intro {
    from {
      opacity: 0.01;
      transform: translateY(1rem);
    }
  }

  /* The logo rises into place as it comes into focus. */
  @keyframes logo-in {
    from {
      opacity: 0.01;
      transform: translateY(2.5rem) scale(0.92);
      filter: blur(0.5rem);
    }
  }
</style>
