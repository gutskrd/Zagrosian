---
import { i18n } from '../i18n';
import Arrow from './Arrow.astro';
import Cta from './Cta.astro';
import Emblem from './Emblem.astro';
import HevaloIcon from './HevaloIcon.astro';

const { t } = i18n(Astro.url);

// The headline is sized so its longest line fits the column. Most languages
// fit the default; longer lines step the size down (see .hero__title--*).
const longest = Math.max(...t.hero.headline.map((line) => [...line].length));
const fit = longest <= 14 ? undefined : longest <= 16 ? 'md' : longest <= 18 ? 'sm' : 'xs';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__text">
      <a class="hero__notice intro" href="#hevalo">
        <HevaloIcon class="hero__notice-icon" sizes="20px" loading="eager" />
        <span>{t.hero.notice}</span>
        <Arrow direction="down" class="hero__notice-arrow" />
      </a>

      <h1 id="hero-title" class:list={['hero__title', fit && `hero__title--${fit}`]}>
        {
          t.hero.headline.map((line, index) => (
            <>
              {/* A real space between the lines, for anything that reads the
                  text without the styles (search engines, AI crawlers). */}
              {index > 0 && ' '}
              <span class="hero__line">
                <span>{line}</span>
              </span>
            </>
          ))
        }
      </h1>

      <p class="hero__lead lead intro">{t.hero.lead}</p>

      <div class="hero__actions intro">
        <Cta href="#hevalo" arrow="down" label={t.hero.products} />
        <Cta href="#about" variant="outline" label={t.hero.about} />
      </div>
    </div>

    <figure class="hero__emblem intro" data-parallax="0.08" data-depth data-cursor="wind">
      <div class="hero__art">
        <Emblem alt={t.hero.emblemAlt} loading="eager" />
        <canvas class="hero__ink" aria-hidden="true" data-ink-canvas></canvas>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 1.5rem + 8vw, 8rem) clamp(4rem, 2rem + 6vw, 7rem);
    /* The ink may drift past the sides of the screen, but never scrolls it. */
    overflow-x: clip;
  }

  .hero__grid {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 4rem);
  }

  /* Announcement above the headline, linking to the Hevalo section. */
  .hero__notice {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.25rem;
    margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    padding: 0.25rem 0.875rem 0.25rem 0.75rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    font-size: clamp(0.8125rem, 0.75rem + 0.3vw, 0.9375rem);
    font-weight: 450;
    color: var(--color-ink-soft);
    text-decoration: none;
    text-wrap: balance;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .hero__notice :global(.hero__notice-icon) {
    width: 1.25rem;
    margin-inline-start: -0.25rem;
  }

  .hero__notice :global(.hero__notice-arrow) {
    width: 0.875rem;
    height: 0.875rem;
    color: var(--color-muted);
    transition: transform 0.3s var(--ease-out);
  }

  /* On the narrowest phones the arrow gives way, so the text stays on one line. */
  @media (max-width: 22.49rem) {
    .hero__notice :global(.hero__notice-arrow) {
      display: none;
    }
  }

  @media (hover: hover) {
    .hero__notice:hover {
      border-color: var(--color-ink);
      color: var(--color-ink);
    }

    .hero__notice:hover :global(.hero__notice-arrow) {
      transform: translateY(2px);
    }
  }

  /* The headline is sized to its column: "Technology for" is about 6.1em wide. */
  .hero__text {
    container-type: inline-size;
  }

  .hero__title {
    /* Never wider than the column, nor too tall for short landscape screens. */
    font-size: min(var(--text-display), 16cqi, 18svh);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .hero__title--md {
    font-size: min(var(--text-display), 14cqi, 18svh);
  }

  .hero__title--sm {
    font-size: min(var(--text-display), 12.5cqi, 18svh);
  }

  .hero__title--xs {
    font-size: min(var(--text-display), 11cqi, 18svh);
  }

  /* Each line rises from behind its own mask on load. */
  .hero__line {
    display: block;
    overflow: hidden;
    padding: 0 0.06em 0.14em;
    margin: 0 -0.06em -0.14em;
  }

  .hero__line > span {
    display: block;
  }

  .hero__lead {
    max-width: 34rem;
    margin-top: clamp(1.75rem, 1rem + 2vw, 2.5rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: clamp(2rem, 1.5rem + 1.5vw, 2.75rem);
  }

  .hero__emblem {
    justify-self: center;
    width: min(80vw, 26rem);
    margin: 0;
  }

  .hero__emblem :global(.emblem) {
    display: block;
    width: 100%;
  }

  /* Room for the horseman to lean towards the pointer in 3D (motion.ts). */
  .hero__emblem {
    perspective: 80rem;
  }

  .hero__art {
    position: relative;
  }

  /* The horseman in ink particles (src/scripts/ink.ts). The canvas reaches past
     the drawing, so the ink has room to move; ink.ts sizes and places it in
     whole device pixels. It is hidden until the first particles are drawn. */
  .hero__ink {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
  }

  :global(:root[data-ink='ready']) .hero__ink {
    opacity: 1;
  }

  /* With the ink, the image keeps its place (for the layout, screen readers
     and printing) but is not shown, and the ink gives the entrance instead. */
  :global(:root[data-ink]) .hero__emblem {
    animation: none;
  }

  :global(:root:is([data-ink='pending'], [data-ink='loading'], [data-ink='ready'])) .hero__art :global(.emblem) {
    opacity: 0;
  }

  /* Should the ink stop (a device that cannot keep up, or the graphics
     processor dropping it), the image fades back in its place. */
  :global(:root[data-ink='off']) .hero__ink,
  :global(:root[data-ink='off']) .hero__art :global(.emblem) {
    transition: opacity 0.5s ease;
  }

  /* Should the script never start, the image appears after a moment anyway. */
  :global(:root[data-ink='pending']) .hero__art :global(.emblem) {
    animation: ink-fallback 0.8s ease 3s both;
  }

  @keyframes ink-fallback {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @media print, (forced-colors: active) {
    .hero__ink {
      display: none;
    }

    .hero__art :global(.emblem) {
      opacity: 1 !important;
      animation: none !important;
    }
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      align-items: end;
    }

    .hero__text {
      grid-column: 1 / span 7;
    }

    .hero__emblem {
      grid-column: 8 / span 5;
      align-self: center;
      justify-self: end;
      width: 100%;
      max-width: 34rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__line > span {
      animation: line-rise 1.1s var(--ease-out) both;
    }

    .hero__line:nth-child(2) > span {
      animation-delay: 0.08s;
    }

    .hero__line:nth-child(3) > span {
      animation-delay: 0.16s;
    }

    .intro {
      animation: intro 1.1s var(--ease-out) both;
    }

    .hero__lead {
      animation-delay: 0.3s;
    }

    .hero__actions {
      animation-delay: 0.4s;
    }

    .hero__emblem {
      animation: emblem 1.6s var(--ease-out) 0.3s both;
    }
  }

  @keyframes line-rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes intro {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  /* The horseman rides in: revealed from the tail forwards as he moves into
     place. The drawing faces right in every language, so this is not mirrored.
     The negative insets leave room for the pointer tilt, so nothing is clipped
     once he has arrived. */
  @keyframes emblem {
    from {
      opacity: 0;
      transform: translateX(-3rem);
      clip-path: inset(-20% 100% -20% -20%);
    }

    40% {
      opacity: 1;
    }

    to {
      clip-path: inset(-20% -20% -20% -20%);
    }
  }
</style>
