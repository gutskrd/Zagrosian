---
import { i18n } from '../i18n';
import Arrow from './Arrow.astro';
import Cta from './Cta.astro';
import HevaloIcon from './HevaloIcon.astro';
import LiftedLogo from './LiftedLogo.astro';

const { t } = i18n(Astro.url);

// The headline is sized so its longest line fits the column. Most languages
// fit the default; longer lines step the size down (see .hero__title--*).
const longest = Math.max(...t.hero.headline.map((line) => [...line].length));
const fit = longest <= 14 ? undefined : longest <= 16 ? 'md' : longest <= 18 ? 'sm' : 'xs';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__text">
      <a class="hero__notice intro" href="#hevalo">
        <HevaloIcon class="hero__notice-icon" sizes="20px" />
        <span>{t.hero.notice}</span>
        <Arrow direction="down" class="hero__notice-arrow" />
      </a>

      <h1 id="hero-title" class:list={['hero__title', fit && `hero__title--${fit}`]}>
        {
          t.hero.headline.map((line, index) => (
            <>
              {/* A real space between the lines, for anything that reads the
                  text without the styles (search engines, AI crawlers). */}
              {index > 0 && ' '}
              <span class="hero__line">
                <span>{line}</span>
              </span>
            </>
          ))
        }
      </h1>

      <p class="hero__lead lead intro">{t.hero.lead}</p>

      <div class="hero__actions intro">
        <Cta href="#hevalo" arrow="down" label={t.hero.products} />
        <Cta href="#about" variant="outline" label={t.hero.about} />
      </div>
    </div>

    <figure class="hero__mark intro" data-parallax="0.08" data-depth data-logo-turn>
      <div class="hero__art">
        <LiftedLogo class="hero__logo" alt={t.hero.logoAlt} />
      </div>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 1.5rem + 8vw, 8rem) clamp(4rem, 2rem + 6vw, 7rem);
    /* The logo's shadow may reach past the sides of the screen, but never scrolls it. */
    overflow-x: clip;
  }

  .hero__grid {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 4rem);
  }

  /* Announcement above the headline, linking to the Hevalo section. */
  .hero__notice {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.25rem;
    margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    padding: 0.25rem 0.875rem 0.25rem 0.75rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    font-size: clamp(0.8125rem, 0.75rem + 0.3vw, 0.9375rem);
    font-weight: 450;
    color: var(--color-ink-soft);
    text-decoration: none;
    text-wrap: balance;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .hero__notice :global(.hero__notice-icon) {
    width: 1.25rem;
    margin-inline-start: -0.25rem;
  }

  .hero__notice :global(.hero__notice-arrow) {
    width: 0.875rem;
    height: 0.875rem;
    color: var(--color-muted);
    transition: transform 0.3s var(--ease-out);
  }

  /* On the narrowest phones the arrow gives way, so the text stays on one line. */
  @media (max-width: 22.49rem) {
    .hero__notice :global(.hero__notice-arrow) {
      display: none;
    }
  }

  @media (hover: hover) {
    .hero__notice:hover {
      border-color: var(--color-ink);
      color: var(--color-ink);
    }

    .hero__notice:hover :global(.hero__notice-arrow) {
      transform: translateY(2px);
    }
  }

  /* The headline is sized to its column: "Technology for" is about 6.1em wide. */
  .hero__text {
    container-type: inline-size;
  }

  .hero__title {
    /* Never wider than the column, nor too tall for short landscape screens. */
    font-size: min(var(--text-display), 16cqi, 18svh);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .hero__title--md {
    font-size: min(var(--text-display), 14cqi, 18svh);
  }

  .hero__title--sm {
    font-size: min(var(--text-display), 12.5cqi, 18svh);
  }

  .hero__title--xs {
    font-size: min(var(--text-display), 11cqi, 18svh);
  }

  /* Each line rises from behind its own mask on load. */
  .hero__line {
    display: block;
    overflow: hidden;
    padding: 0 0.06em 0.14em;
    margin: 0 -0.06em -0.14em;
  }

  .hero__line > span {
    display: block;
  }

  .hero__lead {
    max-width: 34rem;
    margin-top: clamp(1.75rem, 1rem + 2vw, 2.5rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: clamp(2rem, 1.5rem + 1.5vw, 2.75rem);
  }

  /* The glass logo, in 3D. With a mouse it leans towards the pointer
     (motion.ts) and moves over two soft lights behind it, which show through
     the glass. As the page scrolls it turns over to the sun (logo-turn.ts),
     and the lights trade places behind it (--turned, 0 to 1).

     The lights are gradients that fall off as a disc blurred by 1.75rem
     would, rather than blurred discs: a large blur behind 3D glass is costly
     to redraw while the logo turns. (No filter or opacity may sit on the
     logo's ancestors once it is in place: they would flatten it.) */
  .hero__mark {
    --glow: 0 0 0;
    --glow-a: 0.09;
    --glow-b: 0.05;

    position: relative;
    justify-self: center;
    width: min(64vw, 18rem);
    margin: 0;
    perspective: 80rem;
  }

  :global(:root[data-theme='dark']) .hero__mark {
    --glow: 255 255 255;
    --glow-a: 0.22;
    --glow-b: 0.11;
  }

  .hero__mark::before,
  .hero__mark::after {
    content: '';
    position: absolute;
    aspect-ratio: 1;
    pointer-events: none;
  }

  /* A disc 64% of the logo wide, centred near its top right corner. */
  .hero__mark::before {
    top: -26.5%;
    right: -28.5%;
    width: 105%;
    background: radial-gradient(
      closest-side,
      rgb(var(--glow) / var(--glow-a)) 29%,
      rgb(var(--glow) / calc(var(--glow-a) * 0.84)) 45%,
      rgb(var(--glow) / calc(var(--glow-a) * 0.5)) 60%,
      rgb(var(--glow) / calc(var(--glow-a) * 0.16)) 76%,
      rgb(var(--glow) / calc(var(--glow-a) * 0.02)) 92%,
      rgb(var(--glow) / 0)
    );
    transform: translate(calc(var(--turned, 0) * -47.5%), calc(var(--turned, 0) * 9.75%));
  }

  /* A disc 52% of the logo wide, centred near its bottom left corner. */
  .hero__mark::after {
    bottom: -26.75%;
    left: -28.75%;
    width: 93.5%;
    background: radial-gradient(
      closest-side,
      rgb(var(--glow) / var(--glow-b)) 20%,
      rgb(var(--glow) / calc(var(--glow-b) * 0.84)) 38%,
      rgb(var(--glow) / calc(var(--glow-b) * 0.5)) 55%,
      rgb(var(--glow) / calc(var(--glow-b) * 0.16)) 73%,
      rgb(var(--glow) / calc(var(--glow-b) * 0.02)) 91%,
      rgb(var(--glow) / 0)
    );
    transform: translate(calc(var(--turned, 0) * 51%), calc(var(--turned, 0) * -7.8%));
  }

  .hero__art {
    position: relative;
    z-index: 1;
    transform-style: preserve-3d;
  }

  .hero__mark :global(.hero__logo) {
    width: 100%;
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      align-items: end;
    }

    .hero__text {
      grid-column: 1 / span 7;
    }

    .hero__mark {
      grid-column: 8 / span 5;
      align-self: center;
      width: 100%;
      max-width: 22rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__line > span {
      animation: line-rise 1.1s var(--ease-out) both;
    }

    .hero__line:nth-child(2) > span {
      animation-delay: 0.08s;
    }

    .hero__line:nth-child(3) > span {
      animation-delay: 0.16s;
    }

    .intro {
      animation: intro 1.1s var(--ease-out) both;
    }

    .hero__lead {
      animation-delay: 0.3s;
    }

    .hero__actions {
      animation-delay: 0.4s;
    }

    .hero__mark {
      animation: logo-in 1.4s var(--ease-out) 0.3s both;
    }
  }

  @keyframes line-rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes intro {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  /* The logo rises into place as it comes into focus. */
  @keyframes logo-in {
    from {
      opacity: 0;
      transform: translateY(2.5rem) scale(0.92);
      filter: blur(0.5rem);
    }
  }
</style>
