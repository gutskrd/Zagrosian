---
import { hevalo, home, site } from '../site';
import Arrow from './Arrow.astro';
import Cta from './Cta.astro';
import Griffin from './Griffin.astro';
import HevaloIcon from './HevaloIcon.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__text">
      <a class="hero__notice intro" href="#hevalo">
        <HevaloIcon class="hero__notice-icon" sizes="20px" loading="eager" />
        <span>{hevalo.name} is coming to {hevalo.availability.comingSoon.join(' and ')}</span>
        <Arrow direction="down" class="hero__notice-arrow" />
      </a>

      <h1 id="hero-title" class="hero__title">
        {
          home.headline.map((line) => (
            <span class="hero__line">
              <span>{line}</span>
            </span>
          ))
        }
      </h1>

      <p class="hero__lead lead intro">{home.lead}</p>

      <div class="hero__actions intro">
        <Cta href="#hevalo" arrow="down">Our products</Cta>
        <Cta href="#about" variant="text">About {site.name}</Cta>
      </div>
    </div>

    <figure class="hero__emblem intro" data-parallax="0.08">
      <Griffin alt="The Zagrosian griffin" sizes="(min-width: 64rem) 34vw, min(64vw, 22rem)" loading="eager" />
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 1.5rem + 8vw, 8rem) clamp(4rem, 2rem + 6vw, 7rem);
  }

  .hero__grid {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 4rem);
  }

  /* Announcement above the headline, linking to the Hevalo section. */
  .hero__notice {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.25rem;
    margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    padding: 0.25rem 0.875rem 0.25rem 0.75rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    font-size: clamp(0.8125rem, 0.75rem + 0.3vw, 0.9375rem);
    font-weight: 450;
    color: var(--color-ink-soft);
    text-decoration: none;
    text-wrap: balance;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .hero__notice :global(.hero__notice-icon) {
    width: 1.25rem;
    margin-left: -0.25rem;
  }

  .hero__notice :global(.hero__notice-arrow) {
    width: 0.875rem;
    height: 0.875rem;
    color: var(--color-muted);
    transition: transform 0.3s var(--ease-out);
  }

  /* On the narrowest phones the arrow gives way, so the text stays on one line. */
  @media (max-width: 22.49rem) {
    .hero__notice :global(.hero__notice-arrow) {
      display: none;
    }
  }

  @media (hover: hover) {
    .hero__notice:hover {
      border-color: var(--color-ink);
      color: var(--color-ink);
    }

    .hero__notice:hover :global(.hero__notice-arrow) {
      transform: translateY(2px);
    }
  }

  /* The headline is sized to its column: "Technology for" is about 6.1em wide. */
  .hero__text {
    container-type: inline-size;
  }

  .hero__title {
    /* Never wider than the column, nor too tall for short landscape screens. */
    font-size: min(var(--text-display), 16cqi, 18svh);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  /* Each line rises from behind its own mask on load. */
  .hero__line {
    display: block;
    overflow: hidden;
    padding: 0 0.06em 0.14em;
    margin: 0 -0.06em -0.14em;
  }

  .hero__line > span {
    display: block;
  }

  .hero__lead {
    max-width: 34rem;
    margin-top: clamp(1.75rem, 1rem + 2vw, 2.5rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: clamp(2rem, 1.5rem + 1.5vw, 2.75rem);
  }

  .hero__emblem {
    justify-self: center;
    width: min(64vw, 22rem);
    margin: 0;
  }

  .hero__emblem :global(.griffin) {
    display: block;
    width: 100%;
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      align-items: end;
    }

    .hero__text {
      grid-column: 1 / span 7;
    }

    .hero__emblem {
      grid-column: 8 / span 5;
      justify-self: end;
      width: 100%;
      max-width: 32rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__line > span {
      animation: line-rise 1.1s var(--ease-out) both;
    }

    .hero__line:nth-child(2) > span {
      animation-delay: 0.08s;
    }

    .hero__line:nth-child(3) > span {
      animation-delay: 0.16s;
    }

    .intro {
      animation: intro 1.1s var(--ease-out) both;
    }

    .hero__lead {
      animation-delay: 0.3s;
    }

    .hero__actions {
      animation-delay: 0.4s;
    }

    .hero__emblem {
      animation: emblem 1.8s var(--ease-out) 0.35s both;
    }
  }

  @keyframes line-rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes intro {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  @keyframes emblem {
    from {
      opacity: 0;
      transform: translateY(1.5rem) scale(0.97);
    }
  }
</style>
