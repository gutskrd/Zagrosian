---
import { site } from '../site';
import Cta from './Cta.astro';
import Griffin from './Griffin.astro';
import Ridgeline from './Ridgeline.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title intro">
        <span>Software</span>
        <span>for Kurdish</span>
        <span>communities.</span>
      </h1>

      <p class="hero__lead lead intro">
        {site.name} is an independent technology company based in {site.country}. We build products for Kurdish
        communities around the world, starting with Hevalo.
      </p>

      <div class="hero__actions intro">
        <Cta href="#hevalo" arrow="down">Explore Hevalo</Cta>
        <Cta href="#about" variant="text">About the company</Cta>
      </div>
    </div>

    <figure class="hero__emblem intro">
      <Griffin alt="The Zagrosian griffin" sizes="(min-width: 64rem) 34vw, min(64vw, 22rem)" loading="eager" />
    </figure>
  </div>

  <Ridgeline class="hero__ridge" />
</section>

<style>
  .hero {
    padding-top: clamp(3.5rem, 1.5rem + 8vw, 8rem);
  }

  .hero__grid {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 4rem);
  }

  .hero__title {
    /* Never wider than the column ("communities." is about 5.6em wide), nor too
       tall for short landscape screens. */
    font-size: min(var(--text-display), calc((100vw - 2 * var(--gutter)) / 5.8), 18svh);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .hero__title span {
    display: block;
  }

  .hero__lead {
    max-width: 34rem;
    margin-top: clamp(1.75rem, 1rem + 2vw, 2.5rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: clamp(2rem, 1.5rem + 1.5vw, 2.75rem);
  }

  .hero__emblem {
    justify-self: center;
    width: min(64vw, 22rem);
    margin: 0;
  }

  .hero__emblem :global(.griffin) {
    display: block;
    width: 100%;
  }

  .hero__ridge {
    margin-top: clamp(1rem, 0.5rem + 2vw, 2rem);
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      align-items: end;
    }

    .hero__text {
      grid-column: 1 / span 7;
    }

    .hero__title {
      font-size: min(var(--text-display), 18svh);
    }

    .hero__emblem {
      grid-column: 8 / span 5;
      justify-self: end;
      width: 100%;
      max-width: 32rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .intro {
      animation: intro 1.1s var(--ease-out) both;
    }

    .hero__lead {
      animation-delay: 0.12s;
    }

    .hero__actions {
      animation-delay: 0.22s;
    }

    .hero__emblem {
      animation-duration: 1.6s;
      animation-delay: 0.3s;
    }
  }

  @keyframes intro {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }
</style>
