---
/**
 * The Zagrosian emblem: a horseman on a galloping horse, drawn as a woodcut.
 * A vector traced from the original artwork
 * (src/assets/brand/zagros-logo-source.png), so it stays sharp at any size.
 * It is black; on dark surfaces `--art-filter` turns it white.
 *
 * This is the detailed drawing, for large sizes. At small sizes (the header,
 * favicons) the site uses the simplified silhouette, emblem-mark.svg.
 */
import emblem from '../assets/brand/emblem.svg';

interface Props {
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { alt, class: className, loading = 'lazy' } = Astro.props;
---

<img
  class:list={['emblem', className]}
  src={emblem.src}
  width={emblem.width}
  height={emblem.height}
  alt={alt}
  loading={loading}
  fetchpriority={loading === 'eager' ? 'high' : undefined}
  decoding="async"
  draggable="false"
/>

<style>
  .emblem {
    height: auto;
    filter: var(--art-filter);
    user-select: none;
  }
</style>
