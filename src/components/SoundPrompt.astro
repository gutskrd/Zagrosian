---
/**
 * A small card, offered once, inviting the visitor to turn sound on
 * (src/scripts/sound.ts). It appears in the corner a moment after the page has
 * settled (after the language note, which uses the same corner), and either
 * answer is remembered. After that, sound is switched from the header or quick
 * navigation.
 */
import { i18n } from '../i18n';

const { t } = i18n(Astro.url);
---

<aside class="sound-prompt" aria-label={t.sound.label} data-sound-prompt hidden>
  <span class="sound-prompt__wave" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span>
  </span>
  <p class="sound-prompt__text">{t.sound.prompt}</p>
  <div class="sound-prompt__actions">
    <button class="sound-prompt__on" type="button" data-sound-choice="on">{t.sound.on}</button>
    <button class="sound-prompt__off" type="button" data-sound-choice="off">{t.sound.dismiss}</button>
  </div>
</aside>

<style>
  .sound-prompt {
    position: fixed;
    inset-block-end: max(var(--gutter), env(safe-area-inset-bottom));
    inset-inline-end: var(--gutter);
    z-index: 60;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.875rem 1rem;
    width: min(22rem, calc(100vw - 2 * var(--gutter)));
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 16px 40px rgb(0 0 0 / 0.14);
    /* It slides up from below the edge of the screen rather than fading in,
       so its text is never shown at reduced contrast. */
    transform: translateY(calc(100% + 2 * var(--gutter)));
    transition: transform 0.7s var(--ease-out);
  }

  .sound-prompt[data-visible] {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .sound-prompt {
      transition: none;
    }
  }

  :global([data-theme='dark']) .sound-prompt {
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.5);
  }

  /* A small waveform that breathes. */
  .sound-prompt__wave {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 1.25rem;
  }

  .sound-prompt__wave span {
    width: 2px;
    height: 100%;
    border-radius: 1px;
    background: currentColor;
    transform: scaleY(0.4);
  }

  .sound-prompt__wave span:nth-child(2),
  .sound-prompt__wave span:nth-child(4) {
    transform: scaleY(0.7);
  }

  .sound-prompt__wave span:nth-child(3) {
    transform: scaleY(1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .sound-prompt__wave span {
      animation: sound-wave 1.4s ease-in-out infinite alternate;
    }

    .sound-prompt__wave span:nth-child(2) {
      animation-delay: -0.2s;
    }

    .sound-prompt__wave span:nth-child(3) {
      animation-delay: -0.4s;
    }

    .sound-prompt__wave span:nth-child(4) {
      animation-delay: -0.6s;
    }

    .sound-prompt__wave span:nth-child(5) {
      animation-delay: -0.8s;
    }
  }

  @keyframes sound-wave {
    from {
      transform: scaleY(0.25);
    }

    to {
      transform: scaleY(1);
    }
  }

  .sound-prompt__text {
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-ink-soft);
  }

  .sound-prompt__actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .sound-prompt__on {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
  }

  .sound-prompt__off {
    min-height: 2.5rem;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    color: var(--color-muted);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .sound-prompt__off:hover {
    color: var(--color-ink);
  }

  @media print {
    .sound-prompt {
      display: none !important;
    }
  }
</style>
