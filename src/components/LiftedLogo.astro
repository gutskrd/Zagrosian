---
/**
 * The lifted Zagrosian logo: the two hands set in a block of clear glass, in
 * 3D, for the homepage hero (and, from there, the story under it).
 *
 * It is drawn, not an image, so it is sharp at any size. The shapes are
 * traced from the lifted logo (src/assets/brand/zagrosian-logo-lifted-source.png)
 * and float inside the block, between its back and front faces; the block's
 * edge is a stack of thin layers, so it has real thickness when it turns.
 * The back face tints the glass and casts its shadow; the front face only
 * catches the light (a bevel, a glare and a streak), so the logo stays crisp.
 * (The glass does not blur what is behind it: a backdrop blur is costly to
 * redraw as the block turns, and what is behind it is soft already.)
 *
 * On the light page the dark parts of the logo are smoked glass and the rest
 * is clear; on the dark page the light parts are frosted and the rest is
 * clear.
 *
 * On the homepage it travels into the story under the hero as the page
 * scrolls (src/scripts/story.ts), which sets its pose in custom properties on
 * an ancestor; without them it rests as drawn.
 */
import type { HTMLAttributes } from 'astro/types';
import source from '../assets/brand/zagrosian-logo-lifted.svg?raw';

interface Props extends HTMLAttributes<'span'> {
  /** Leave empty when the logo is decoration. */
  alt?: string;
}

const { alt = '', class: className, ...attributes } = Astro.props;
const label = alt ? { role: 'img' as const, 'aria-label': alt } : { 'aria-hidden': 'true' as const };

// The traced light shapes; the dark ones are the tile less those.
const light = source.match(/ d="([^"]+)"/)?.[1] ?? '';
const dark = `M0 0H1290V1290H0Z${light}`;

const slices = Array.from({ length: 10 }, (_, index) => index + 1);
---

<span class:list={['lifted-logo', className]} {...label} {...attributes}>
  <span class="lifted-logo__body">
    <span class="lifted-logo__back"></span>
    {slices.map((depth) => <span class="lifted-logo__slice" data-depth={depth} />)}
    <span class="lifted-logo__frame"></span>
    <span class="lifted-logo__inner">
      <svg viewBox="0 0 1290 1290" aria-hidden="true" focusable="false">
        <path class="lifted-logo__dark" fill-rule="evenodd" d={dark}></path>
        <path class="lifted-logo__light" fill-rule="evenodd" d={light}></path>
      </svg>
    </span>
    <span class="lifted-logo__front"></span>
  </span>
</span>

<style>
  .lifted-logo {
    /* In container units, so the block keeps its proportions at any size. */
    --thickness: 7cqi;
    --radius: 23%;
    --body: rgb(255 255 255 / 0.08);
    --haze: rgb(255 255 255 / 0);
    --edge: rgb(0 0 0 / 0.1);
    --dark: rgb(10 10 12 / 0.72);
    --light: rgb(255 255 255 / 0.3);
    --rim: rgb(0 0 0 / 0.16);
    --seam: rgb(0 0 0 / 0.3);
    /* In container units too, so the shadow keeps its size against the
       block however large the block is drawn (story.ts lays it out at
       different sizes as it flies in). */
    --shadow: 0 10cqi 15.9cqi -5.45cqi rgb(0 0 0 / 0.36), 0 2.7cqi 5.45cqi -2.7cqi rgb(0 0 0 / 0.22);

    position: relative;
    display: block;
    aspect-ratio: 1;
    container-type: inline-size;
    transform-style: preserve-3d;
    user-select: none;
  }

  :global(:root[data-theme='dark']) .lifted-logo {
    --body: rgb(255 255 255 / 0.05);
    --haze: rgb(255 255 255 / 0.15);
    --edge: rgb(255 255 255 / 0.11);
    --dark: rgb(255 255 255 / 0.04);
    --light: rgb(255 255 255 / 0.8);
    --rim: rgb(255 255 255 / 0.22);
    --seam: rgb(255 255 255 / 0.1);
    --shadow: 0 10.9cqi 18.2cqi -5.45cqi rgb(0 0 0 / 0.9);
  }

  /* Turned a little, so the glass shows its depth even at rest. It turns
     about its own middle, halfway through its thickness, as one solid block.

     Its pose comes from src/scripts/story.ts: how far it has turned (--turn)
     and leaned (--tilt), and how much of the front pane is left (--front,
     as the camera flies through it). */
  .lifted-logo__body {
    position: absolute;
    inset: 0;
    transform: rotateX(calc(12deg + var(--tilt, 0deg))) rotateY(calc(-18deg + var(--turn, 0deg)));
    transform-origin: 50% 50% calc(var(--thickness) * -0.5);
    transform-style: preserve-3d;
  }

  /* Every layer sits at a fraction `--f` of the way through the block, from
     the front (0) to the back (1). */
  .lifted-logo__back,
  .lifted-logo__slice,
  .lifted-logo__frame,
  .lifted-logo__inner,
  .lifted-logo__front {
    --f: 0;

    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    transform: translateZ(calc(var(--thickness) * var(--f) * -1));
  }

  /* The glass itself, with its shadow. On the dark page it is lit from
     behind, where the lights shine through. */
  .lifted-logo__back {
    --f: 1;

    background:
      radial-gradient(circle at 76% 24%, var(--haze), rgb(255 255 255 / 0) 66%),
      radial-gradient(circle at 18% 84%, var(--haze), rgb(255 255 255 / 0) 42%),
      var(--body);
    box-shadow: var(--shadow);
  }

  /* The edge: ten thin layers through the thickness of the block, seen from
     both sides. */
  .lifted-logo__slice {
    border: 1.5px solid var(--edge);
    opacity: 0.6;
  }

  .lifted-logo__slice[data-depth='1'] {
    --f: 0.0909;
  }

  .lifted-logo__slice[data-depth='2'] {
    --f: 0.1818;
  }

  .lifted-logo__slice[data-depth='3'] {
    --f: 0.2727;
  }

  .lifted-logo__slice[data-depth='4'] {
    --f: 0.3636;
  }

  .lifted-logo__slice[data-depth='5'] {
    --f: 0.4545;
  }

  .lifted-logo__slice[data-depth='6'] {
    --f: 0.5455;
  }

  .lifted-logo__slice[data-depth='7'] {
    --f: 0.6364;
  }

  .lifted-logo__slice[data-depth='8'] {
    --f: 0.7273;
  }

  .lifted-logo__slice[data-depth='9'] {
    --f: 0.8182;
  }

  .lifted-logo__slice[data-depth='10'] {
    --f: 0.9091;
  }

  /* The logo, inside the glass, within a thin frame as in the original (10
     of its 215 pixels), in the same tone as the logo's dark parts, so they
     run into it. The drawing spans the whole tile, so it is placed to line
     up with it; a fine seam marks the frame's inner edge. */
  .lifted-logo__frame,
  .lifted-logo__inner {
    --f: 0.45;
  }

  .lifted-logo__frame {
    border: 4.65cqi solid var(--dark);
  }

  /* Rounded corners clip with border-radius and overflow rather than a clip
     path: on a layer turned in 3D, a clip path is applied by the graphics
     card as a separate mask, which can come loose for a frame when the layer
     is laid out anew at a larger size (story.ts). */
  .lifted-logo__inner {
    inset: 4.65%;
    border-radius: 20.2%;
    overflow: hidden;
  }

  .lifted-logo__inner::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20.2%;
    box-shadow: inset 0 0 0 max(1px, 0.3cqi) var(--seam);
  }

  .lifted-logo__inner svg {
    position: absolute;
    top: -5.13%;
    left: -5.13%;
    width: 110.26%;
    max-width: none;
    height: 110.26%;
  }

  .lifted-logo__dark {
    fill: var(--dark);
  }

  .lifted-logo__light {
    fill: var(--light);
  }

  /* The front face catches the light: a bright bevel along the top and left,
     a darker one below, a glare at the top left and a streak across. */
  .lifted-logo__front {
    /* Sized against the block (1cqi is 1% of its width; at its usual 352px,
       0.43cqi is 1.5px), so the bevel and glow keep their proportions however
       large the block is drawn. */
    border: max(1px, 0.28cqi) solid var(--rim);
    overflow: hidden;
    opacity: var(--front, 1);
    background: linear-gradient(140deg, rgb(255 255 255 / 0.5), rgb(255 255 255 / 0.1) 24%, rgb(255 255 255 / 0) 42%);
    box-shadow:
      inset 0 max(1px, 0.43cqi) 0 rgb(255 255 255 / 0.85),
      inset max(1px, 0.43cqi) 0 0 rgb(255 255 255 / 0.4),
      inset 0 -0.57cqi 0.85cqi rgb(0 0 0 / 0.18),
      inset -0.57cqi 0 0.85cqi rgb(0 0 0 / 0.08),
      inset 0 0 6.8cqi rgb(255 255 255 / 0.12);
  }

  .lifted-logo__front::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(118deg, rgb(255 255 255 / 0) 47%, rgb(255 255 255 / 0.22) 53%, rgb(255 255 255 / 0) 60%);
  }

  @media (forced-colors: active) {
    .lifted-logo__front {
      border-color: CanvasText;
      background: none;
    }

    .lifted-logo__front::before {
      display: none;
    }

    .lifted-logo__light {
      fill: Canvas;
    }

    .lifted-logo__dark {
      fill: CanvasText;
    }
  }

  /* Printed, the logo is always at rest. */
  @media print {
    .lifted-logo__body {
      transform: rotateX(12deg) rotateY(-18deg);
    }
  }
</style>
