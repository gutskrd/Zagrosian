---
/**
 * The lifted Zagrosian logo: the two hands set in a block of clear glass, in
 * 3D, for the homepage hero and the opening screen.
 *
 * It is drawn, not an image, so it is sharp at any size. The shapes are
 * traced from the lifted logo (src/assets/brand/zagrosian-logo-lifted-source.png)
 * and float inside the block, between its back and front faces; the block's
 * edge is a stack of thin layers, so it has real thickness when it turns.
 * The back face blurs whatever is behind the glass; the front face only
 * catches the light (a bevel, a glare and a streak), so the logo stays crisp.
 *
 * On the light page the dark parts of the logo are smoked glass and the rest
 * is clear; on the dark page (and the opening screen) the light parts are
 * frosted and the rest is clear.
 */
import type { HTMLAttributes } from 'astro/types';
import source from '../assets/brand/zagrosian-logo-lifted.svg?raw';

interface Props extends HTMLAttributes<'span'> {
  /** Leave empty when the logo is decoration. */
  alt?: string;
  /** `dark` for surfaces that are dark in both themes (the opening screen). */
  tone?: 'auto' | 'dark';
}

const { alt = '', tone = 'auto', class: className, ...attributes } = Astro.props;
const label = alt ? { role: 'img' as const, 'aria-label': alt } : { 'aria-hidden': 'true' as const };

// The traced light shapes; the dark ones are the tile less those.
const light = source.match(/ d="([^"]+)"/)?.[1] ?? '';
const dark = `M0 0H1290V1290H0Z${light}`;
---

<span class:list={['lifted-logo', `lifted-logo--${tone}`, className]} {...label} {...attributes}>
  <span class="lifted-logo__body">
    <span class="lifted-logo__back"></span>
    <span class="lifted-logo__slice" data-depth="1"></span>
    <span class="lifted-logo__slice" data-depth="2"></span>
    <span class="lifted-logo__slice" data-depth="3"></span>
    <span class="lifted-logo__slice" data-depth="4"></span>
    <span class="lifted-logo__slice" data-depth="5"></span>
    <span class="lifted-logo__slice" data-depth="6"></span>
    <span class="lifted-logo__slice" data-depth="7"></span>
    <span class="lifted-logo__slice" data-depth="8"></span>
    <span class="lifted-logo__slice" data-depth="9"></span>
    <span class="lifted-logo__slice" data-depth="10"></span>
    <span class="lifted-logo__slice" data-depth="11"></span>
    <span class="lifted-logo__slice" data-depth="12"></span>
    <span class="lifted-logo__slice" data-depth="13"></span>
    <span class="lifted-logo__slice" data-depth="14"></span>
    <span class="lifted-logo__slice" data-depth="15"></span>
    <span class="lifted-logo__slice" data-depth="16"></span>
    <span class="lifted-logo__slice" data-depth="17"></span>
    <span class="lifted-logo__slice" data-depth="18"></span>
    <span class="lifted-logo__slice" data-depth="19"></span>
    <span class="lifted-logo__slice" data-depth="20"></span>
    <span class="lifted-logo__frame"></span>
    <span class="lifted-logo__inner">
      <svg viewBox="0 0 1290 1290" aria-hidden="true" focusable="false">
        <path class="lifted-logo__dark" fill-rule="evenodd" d={dark}></path>
        <path class="lifted-logo__light" fill-rule="evenodd" d={light}></path>
      </svg>
    </span>
    <span class="lifted-logo__front"></span>
  </span>
</span>

<style>
  .lifted-logo {
    /* In container units, so the block keeps its proportions at any size. */
    --thickness: 7cqi;
    --radius: 23%;
    --body: rgb(255 255 255 / 0.08);
    --edge: rgb(0 0 0 / 0.05);
    --dark: rgb(10 10 12 / 0.72);
    --light: rgb(255 255 255 / 0.3);
    --rim: rgb(0 0 0 / 0.16);
    --seam: rgb(0 0 0 / 0.3);
    --shadow: 0 2.2rem 3.5rem -1.2rem rgb(0 0 0 / 0.36), 0 0.6rem 1.2rem -0.6rem rgb(0 0 0 / 0.22);

    position: relative;
    display: block;
    aspect-ratio: 1;
    container-type: inline-size;
    transform-style: preserve-3d;
    user-select: none;
  }

  :global(:root[data-theme='dark']) .lifted-logo--auto,
  .lifted-logo--dark {
    --body: rgb(255 255 255 / 0.05);
    --edge: rgb(255 255 255 / 0.055);
    --dark: rgb(255 255 255 / 0.04);
    --light: rgb(255 255 255 / 0.8);
    --rim: rgb(255 255 255 / 0.22);
    --seam: rgb(255 255 255 / 0.1);
    --shadow: 0 2.4rem 4rem -1.2rem rgb(0 0 0 / 0.9);
  }

  /* Turned a little, so the glass shows its depth even at rest. */
  .lifted-logo__body {
    position: absolute;
    inset: 0;
    transform: rotateX(12deg) rotateY(-18deg);
    transform-style: preserve-3d;
  }

  .lifted-logo__back,
  .lifted-logo__slice,
  .lifted-logo__front {
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  /* The back face: the glass itself, blurring what is behind it. */
  .lifted-logo__back {
    transform: translateZ(calc(var(--thickness) * -1));
    background: var(--body);
    box-shadow: var(--shadow);
    -webkit-backdrop-filter: blur(16px) saturate(1.25);
    backdrop-filter: blur(16px) saturate(1.25);
  }

  /* The edge: thin layers through the thickness of the block. */
  .lifted-logo__slice {
    border: 1.5px solid var(--edge);
  }

  .lifted-logo__slice[data-depth='1'] {
    transform: translateZ(calc(var(--thickness) * -0.0476));
  }

  .lifted-logo__slice[data-depth='2'] {
    transform: translateZ(calc(var(--thickness) * -0.0952));
  }

  .lifted-logo__slice[data-depth='3'] {
    transform: translateZ(calc(var(--thickness) * -0.1429));
  }

  .lifted-logo__slice[data-depth='4'] {
    transform: translateZ(calc(var(--thickness) * -0.1905));
  }

  .lifted-logo__slice[data-depth='5'] {
    transform: translateZ(calc(var(--thickness) * -0.2381));
  }

  .lifted-logo__slice[data-depth='6'] {
    transform: translateZ(calc(var(--thickness) * -0.2857));
  }

  .lifted-logo__slice[data-depth='7'] {
    transform: translateZ(calc(var(--thickness) * -0.3333));
  }

  .lifted-logo__slice[data-depth='8'] {
    transform: translateZ(calc(var(--thickness) * -0.3810));
  }

  .lifted-logo__slice[data-depth='9'] {
    transform: translateZ(calc(var(--thickness) * -0.4286));
  }

  .lifted-logo__slice[data-depth='10'] {
    transform: translateZ(calc(var(--thickness) * -0.4762));
  }

  .lifted-logo__slice[data-depth='11'] {
    transform: translateZ(calc(var(--thickness) * -0.5238));
  }

  .lifted-logo__slice[data-depth='12'] {
    transform: translateZ(calc(var(--thickness) * -0.5714));
  }

  .lifted-logo__slice[data-depth='13'] {
    transform: translateZ(calc(var(--thickness) * -0.6190));
  }

  .lifted-logo__slice[data-depth='14'] {
    transform: translateZ(calc(var(--thickness) * -0.6667));
  }

  .lifted-logo__slice[data-depth='15'] {
    transform: translateZ(calc(var(--thickness) * -0.7143));
  }

  .lifted-logo__slice[data-depth='16'] {
    transform: translateZ(calc(var(--thickness) * -0.7619));
  }

  .lifted-logo__slice[data-depth='17'] {
    transform: translateZ(calc(var(--thickness) * -0.8095));
  }

  .lifted-logo__slice[data-depth='18'] {
    transform: translateZ(calc(var(--thickness) * -0.8571));
  }

  .lifted-logo__slice[data-depth='19'] {
    transform: translateZ(calc(var(--thickness) * -0.9048));
  }

  .lifted-logo__slice[data-depth='20'] {
    transform: translateZ(calc(var(--thickness) * -0.9524));
  }

  /* The logo, inside the glass, within a thin frame as in the original (10
     of its 215 pixels), in the same tone as the logo's dark parts, so they
     run into it. The drawing spans the whole tile, so it is placed to line
     up with it; a fine seam marks the frame's inner edge. */
  .lifted-logo__frame,
  .lifted-logo__inner {
    position: absolute;
    transform: translateZ(calc(var(--thickness) * -0.45));
  }

  .lifted-logo__frame {
    inset: 0;
    border: 4.65cqi solid var(--dark);
    border-radius: var(--radius);
  }

  .lifted-logo__inner {
    inset: 4.65%;
    clip-path: inset(0 round 20.2%);
  }

  .lifted-logo__inner::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20.2%;
    box-shadow: inset 0 0 0 1px var(--seam);
  }

  .lifted-logo__inner svg {
    position: absolute;
    top: -5.13%;
    left: -5.13%;
    width: 110.26%;
    max-width: none;
    height: 110.26%;
  }

  .lifted-logo__dark {
    fill: var(--dark);
  }

  .lifted-logo__light {
    fill: var(--light);
  }

  /* The front face catches the light: a bright bevel along the top and left,
     a darker one below, a glare at the top left and a streak across. */
  .lifted-logo__front {
    border: 1px solid var(--rim);
    background:
      linear-gradient(118deg, rgb(255 255 255 / 0) 47%, rgb(255 255 255 / 0.22) 53%, rgb(255 255 255 / 0) 60%),
      linear-gradient(140deg, rgb(255 255 255 / 0.5), rgb(255 255 255 / 0.1) 24%, rgb(255 255 255 / 0) 42%);
    box-shadow:
      inset 0 1.5px 0 rgb(255 255 255 / 0.85),
      inset 1.5px 0 0 rgb(255 255 255 / 0.4),
      inset 0 -2px 3px rgb(0 0 0 / 0.18),
      inset -2px 0 3px rgb(0 0 0 / 0.08),
      inset 0 0 1.5rem rgb(255 255 255 / 0.12);
  }

  @media (forced-colors: active) {
    .lifted-logo__front {
      border-color: CanvasText;
      background: none;
    }

    .lifted-logo__light {
      fill: Canvas;
    }

    .lifted-logo__dark {
      fill: CanvasText;
    }
  }
</style>
