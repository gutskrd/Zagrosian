---
/**
 * The lifted Zagrosian logo: the two hands set in a block of clear glass, in
 * 3D, for the homepage hero and the opening screen.
 *
 * It is drawn, not an image, so it is sharp at any size. The shapes are
 * traced from the lifted logo (src/assets/brand/zagrosian-logo-lifted-source.png)
 * and float inside the block, between its back and front faces; the block's
 * edge is a stack of thin layers, so it has real thickness when it turns.
 * The back face tints the glass and casts its shadow; the front face only
 * catches the light (a bevel, a glare and a streak), so the logo stays crisp.
 * (The glass does not blur what is behind it: a backdrop blur is costly to
 * redraw as the block turns, and what is behind it is soft already.)
 *
 * On the light page the dark parts of the logo are smoked glass and the rest
 * is clear; on the dark page (and the opening screen) the light parts are
 * frosted and the rest is clear.
 *
 * The block has two sides. Turned over, it shows the Kurdish sun of 21 rays,
 * in the same glass. In the hero it turns over as the page scrolls
 * (src/scripts/logo-turn.ts), which sets its pose in custom properties on
 * an ancestor; without them it rests, logo side up.
 */
import type { HTMLAttributes } from 'astro/types';
import source from '../assets/brand/zagrosian-logo-lifted.svg?raw';

interface Props extends HTMLAttributes<'span'> {
  /** Leave empty when the logo is decoration. */
  alt?: string;
  /** `dark` for surfaces that are dark in both themes (the opening screen). */
  tone?: 'auto' | 'dark';
}

const { alt = '', tone = 'auto', class: className, ...attributes } = Astro.props;
const label = alt ? { role: 'img' as const, 'aria-label': alt } : { 'aria-hidden': 'true' as const };

// The traced light shapes; the dark ones are the tile less those.
const light = source.match(/ d="([^"]+)"/)?.[1] ?? '';
const dark = `M0 0H1290V1290H0Z${light}`;

// The sun of the Kurdish flag, as in src/assets/brand/sun-black-source.png:
// 21 straight rays, one pointing up, the gaps between them at 51.2% of the
// rays' length (measured on the artwork). Drawn from that geometry rather
// than traced, so its points are exact.
const sun = `M${Array.from({ length: 42 }, (_, index) => {
  const angle = (index * Math.PI) / 21;
  const radius = index % 2 ? 51.2 : 100;
  return `${(Math.sin(angle) * radius).toFixed(2)} ${(-Math.cos(angle) * radius).toFixed(2)}`;
}).join('L')}Z`;

const slices = Array.from({ length: 20 }, (_, index) => index + 1);
---

<span class:list={['lifted-logo', `lifted-logo--${tone}`, className]} {...label} {...attributes}>
  <span class="lifted-logo__body">
    <span class="lifted-logo__back"></span>
    <span class="lifted-logo__back lifted-logo__back--sun"></span>
    {slices.map((depth) => <span class="lifted-logo__slice" data-depth={depth} />)}
    <span class="lifted-logo__frame"></span>
    <span class="lifted-logo__inner">
      <svg viewBox="0 0 1290 1290" aria-hidden="true" focusable="false">
        <path class="lifted-logo__dark" fill-rule="evenodd" d={dark}></path>
        <path class="lifted-logo__light" fill-rule="evenodd" d={light}></path>
      </svg>
    </span>
    <span class="lifted-logo__sun">
      <svg viewBox="-100 -100 200 200" aria-hidden="true" focusable="false">
        <path d={sun}></path>
      </svg>
    </span>
    <span class="lifted-logo__front"></span>
    <span class="lifted-logo__front lifted-logo__front--sun"></span>
  </span>
</span>

<style>
  .lifted-logo {
    /* In container units, so the block keeps its proportions at any size. */
    --thickness: 7cqi;
    --radius: 23%;
    --body: rgb(255 255 255 / 0.08);
    --haze: rgb(255 255 255 / 0);
    --edge: rgb(0 0 0 / 0.1);
    --dark: rgb(10 10 12 / 0.72);
    --light: rgb(255 255 255 / 0.3);
    --sun: rgb(10 10 12 / 0.74);
    --rim: rgb(0 0 0 / 0.16);
    --seam: rgb(0 0 0 / 0.3);
    --shadow: 0 2.2rem 3.5rem -1.2rem rgb(0 0 0 / 0.36), 0 0.6rem 1.2rem -0.6rem rgb(0 0 0 / 0.22);

    position: relative;
    display: block;
    aspect-ratio: 1;
    container-type: inline-size;
    transform-style: preserve-3d;
    user-select: none;
  }

  :global(:root[data-theme='dark']) .lifted-logo--auto,
  .lifted-logo--dark {
    --body: rgb(255 255 255 / 0.05);
    --haze: rgb(255 255 255 / 0.15);
    --edge: rgb(255 255 255 / 0.11);
    --dark: rgb(255 255 255 / 0.04);
    --light: rgb(255 255 255 / 0.8);
    --sun: rgb(255 255 255 / 0.82);
    --rim: rgb(255 255 255 / 0.22);
    --seam: rgb(255 255 255 / 0.1);
    --shadow: 0 2.4rem 4rem -1.2rem rgb(0 0 0 / 0.9);
  }

  /* Turned a little, so the glass shows its depth even at rest. It turns
     about its own middle, halfway through its thickness.

     Its pose comes from src/scripts/logo-turn.ts: how far it has turned over
     (--turn), leaned (--tilt), rolled (--roll) and grown (--lift); how far
     its layers have moved apart (--spread, 1 at rest), how much they twist
     against each other (--twist) and how far the edge has faded (--fan);
     the turn and size of the sun (--sun-turn, --sun-size); and where the
     streak of light is on each face (--glint, --glint-sun). */
  .lifted-logo__body {
    --depth: calc(var(--thickness) * var(--spread, 1));

    position: absolute;
    inset: 0;
    transform: rotateX(calc(12deg + var(--tilt, 0deg))) rotateY(calc(-18deg + var(--turn, 0deg))) rotateZ(var(--roll, 0deg))
      scale3d(var(--lift, 1), var(--lift, 1), var(--lift, 1));
    transform-origin: 50% 50% calc(var(--depth) * -0.5);
    transform-style: preserve-3d;
  }

  /* Every layer sits at a fraction `--f` of the way through the block, from
     the front (0) to the back (1). When the layers fan out, each also turns
     a little against the next, so the block twists about its middle. Each
     side's faces and contents show only from that side. */
  .lifted-logo__back,
  .lifted-logo__slice,
  .lifted-logo__frame,
  .lifted-logo__inner,
  .lifted-logo__sun,
  .lifted-logo__front {
    --f: 0;
    --side: 0deg;

    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    transform: translateZ(calc(var(--depth) * var(--f) * -1)) rotateZ(calc(var(--twist, 0deg) * (var(--f) - 0.5)))
      rotateY(var(--side));
    backface-visibility: hidden;
  }

  /* The glass itself, with its shadow: the back face, and on the sun's side
     the face that is the back once the block has turned over. On the dark
     page it is lit from behind, where the lights shine through. */
  .lifted-logo__back {
    --f: 1;

    background:
      radial-gradient(circle at 76% 24%, var(--haze), rgb(255 255 255 / 0) 66%),
      radial-gradient(circle at 18% 84%, var(--haze), rgb(255 255 255 / 0) 42%),
      var(--body);
    box-shadow: var(--shadow);
  }

  .lifted-logo__back--sun {
    --f: 0;
    --side: 180deg;
  }

  /* The edge: thin layers through the thickness of the block, seen from both
     sides. They fade as the block opens up, leaving its faces and contents
     as separate planes of glass. */
  .lifted-logo__slice {
    border: 1.5px solid var(--edge);
    backface-visibility: visible;
    opacity: calc(0.5 - var(--fan, 0) * 0.5);
  }

  .lifted-logo__slice[data-depth='1'] {
    --f: 0.0476;
  }

  .lifted-logo__slice[data-depth='2'] {
    --f: 0.0952;
  }

  .lifted-logo__slice[data-depth='3'] {
    --f: 0.1429;
  }

  .lifted-logo__slice[data-depth='4'] {
    --f: 0.1905;
  }

  .lifted-logo__slice[data-depth='5'] {
    --f: 0.2381;
  }

  .lifted-logo__slice[data-depth='6'] {
    --f: 0.2857;
  }

  .lifted-logo__slice[data-depth='7'] {
    --f: 0.3333;
  }

  .lifted-logo__slice[data-depth='8'] {
    --f: 0.381;
  }

  .lifted-logo__slice[data-depth='9'] {
    --f: 0.4286;
  }

  .lifted-logo__slice[data-depth='10'] {
    --f: 0.4762;
  }

  .lifted-logo__slice[data-depth='11'] {
    --f: 0.5238;
  }

  .lifted-logo__slice[data-depth='12'] {
    --f: 0.5714;
  }

  .lifted-logo__slice[data-depth='13'] {
    --f: 0.619;
  }

  .lifted-logo__slice[data-depth='14'] {
    --f: 0.6667;
  }

  .lifted-logo__slice[data-depth='15'] {
    --f: 0.7143;
  }

  .lifted-logo__slice[data-depth='16'] {
    --f: 0.7619;
  }

  .lifted-logo__slice[data-depth='17'] {
    --f: 0.8095;
  }

  .lifted-logo__slice[data-depth='18'] {
    --f: 0.8571;
  }

  .lifted-logo__slice[data-depth='19'] {
    --f: 0.9048;
  }

  .lifted-logo__slice[data-depth='20'] {
    --f: 0.9524;
  }

  /* The logo, inside the glass, within a thin frame as in the original (10
     of its 215 pixels), in the same tone as the logo's dark parts, so they
     run into it. The drawing spans the whole tile, so it is placed to line
     up with it; a fine seam marks the frame's inner edge. */
  .lifted-logo__frame,
  .lifted-logo__inner {
    --f: 0.45;
  }

  .lifted-logo__frame {
    border: 4.65cqi solid var(--dark);
  }

  .lifted-logo__inner {
    inset: 4.65%;
    border-radius: 0;
    clip-path: inset(0 round 20.2%);
  }

  .lifted-logo__inner::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20.2%;
    box-shadow: inset 0 0 0 1px var(--seam);
  }

  .lifted-logo__inner svg {
    position: absolute;
    top: -5.13%;
    left: -5.13%;
    width: 110.26%;
    max-width: none;
    height: 110.26%;
  }

  .lifted-logo__dark {
    fill: var(--dark);
  }

  .lifted-logo__light {
    fill: var(--light);
  }

  /* The sun, on the other side, in clear glass: smoked on the light page,
     frosted on the dark one. It turns, and grows into place, by itself. */
  .lifted-logo__sun {
    --f: 0.55;
    --side: 180deg;

    inset: 16%;
    border-radius: 0;
  }

  .lifted-logo__sun svg {
    display: block;
    width: 100%;
    height: 100%;
    transform: rotate(var(--sun-turn, 0deg)) scale(var(--sun-size, 1));
  }

  .lifted-logo__sun path {
    fill: var(--sun);
  }

  /* The front faces catch the light: a bright bevel along the top and left,
     a darker one below, a glare at the top left and a streak across, which
     slides over the face as the block turns. */
  .lifted-logo__front {
    border: 1px solid var(--rim);
    clip-path: inset(0 round var(--radius));
    background: linear-gradient(140deg, rgb(255 255 255 / 0.5), rgb(255 255 255 / 0.1) 24%, rgb(255 255 255 / 0) 42%);
    box-shadow:
      inset 0 1.5px 0 rgb(255 255 255 / 0.85),
      inset 1.5px 0 0 rgb(255 255 255 / 0.4),
      inset 0 -2px 3px rgb(0 0 0 / 0.18),
      inset -2px 0 3px rgb(0 0 0 / 0.08),
      inset 0 0 1.5rem rgb(255 255 255 / 0.12);
  }

  .lifted-logo__front::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(118deg, rgb(255 255 255 / 0) 47%, rgb(255 255 255 / 0.22) 53%, rgb(255 255 255 / 0) 60%);
    transform: translateX(var(--glint, 0%));
  }

  .lifted-logo__front--sun {
    --f: 1;
    --side: 180deg;
  }

  .lifted-logo__front--sun::before {
    transform: translateX(var(--glint-sun, 100%));
  }

  @media (forced-colors: active) {
    .lifted-logo__front {
      border-color: CanvasText;
      background: none;
    }

    .lifted-logo__front::before {
      display: none;
    }

    .lifted-logo__light {
      fill: Canvas;
    }

    .lifted-logo__dark,
    .lifted-logo__sun path {
      fill: CanvasText;
    }
  }

  /* Printed, the logo is always at rest. */
  @media print {
    .lifted-logo__body {
      --depth: var(--thickness);
      --twist: 0deg;
      --fan: 0;
      --glint: 0%;

      transform: rotateX(12deg) rotateY(-18deg);
    }

    .lifted-logo__back--sun,
    .lifted-logo__sun,
    .lifted-logo__front--sun {
      display: none;
    }
  }
</style>
