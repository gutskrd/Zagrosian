---
/**
 * The lifted Zagrosian logo: the two hands on a tile of glass, for the
 * homepage hero and the opening screen.
 *
 * It is drawn, not an image, so it is sharp at any size: the light shapes are
 * traced from the lifted logo (src/assets/brand/zagrosian-logo-lifted-source.png)
 * and set on a glass tile made in CSS. On the light page the glass is smoked
 * and the shapes frosted; on the dark page it is clear. Whatever is behind it
 * shows through, blurred, and a sheen and a bright rim catch the light.
 */
import type { HTMLAttributes } from 'astro/types';
import Shapes from '../assets/brand/zagrosian-logo-lifted.svg';

interface Props extends HTMLAttributes<'span'> {
  /** Leave empty when the logo is decoration. */
  alt?: string;
  /** `dark` for surfaces that are dark in both themes (the opening screen). */
  tone?: 'auto' | 'dark';
}

const { alt = '', tone = 'auto', class: className, ...attributes } = Astro.props;
const label = alt ? { role: 'img' as const, 'aria-label': alt } : { 'aria-hidden': 'true' as const };
---

<span class:list={['lifted-logo', `lifted-logo--${tone}`, className]} {...label} {...attributes}>
  <span class="lifted-logo__face">
    <Shapes class="lifted-logo__shapes" aria-hidden="true" focusable="false" />
  </span>
</span>

<style>
  .lifted-logo {
    --glass: linear-gradient(160deg, rgb(40 40 44 / 0.74), rgb(8 8 10 / 0.82));
    --frost: rgb(255 255 255 / 0.9);
    --edge: rgb(0 0 0 / 0.22);
    --seam: rgb(14 14 16 / 0.6);
    --lift: 0 1.75rem 3.5rem -1rem rgb(0 0 0 / 0.4), 0 0.5rem 1.25rem -0.6rem rgb(0 0 0 / 0.3);

    position: relative;
    display: block;
    aspect-ratio: 1;
    border-radius: 23%;
    background: var(--glass);
    box-shadow:
      0 0 0 1px var(--edge),
      var(--lift);
    -webkit-backdrop-filter: blur(22px) saturate(1.3);
    backdrop-filter: blur(22px) saturate(1.3);
    isolation: isolate;
    user-select: none;
  }

  /* Clear glass on dark surfaces. */
  :global(:root[data-theme='dark']) .lifted-logo--auto,
  .lifted-logo--dark {
    --glass: linear-gradient(160deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.03));
    --frost: rgb(255 255 255 / 0.86);
    --edge: rgb(255 255 255 / 0.1);
    --seam: rgb(0 0 0 / 0.55);
    --lift: 0 2rem 4.5rem -1.25rem rgb(0 0 0 / 0.9);
  }

  /* The shapes sit inside a thin frame of the glass, as in the original (10
     of its 215 pixels). The drawing spans the whole tile, so it is placed to
     line up with it. */
  .lifted-logo__face {
    position: absolute;
    inset: 4.65%;
    border-radius: 20.2%;
    clip-path: inset(0 round 20.2%);
  }

  /* A fine dark seam between the shapes and the frame, as in the original. */
  .lifted-logo__face::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 0.14rem var(--seam);
    pointer-events: none;
  }

  .lifted-logo__face :global(.lifted-logo__shapes) {
    position: absolute;
    top: -5.13%;
    left: -5.13%;
    width: 110.26%;
    max-width: none;
    height: 110.26%;
    color: var(--frost);
  }

  /* The sheen, brightest at the top left, and the rim. */
  .lifted-logo::before,
  .lifted-logo::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
  }

  .lifted-logo::before {
    z-index: 1;
    background:
      linear-gradient(155deg, rgb(255 255 255 / 0.38), rgb(255 255 255 / 0.08) 34%, rgb(255 255 255 / 0) 52%),
      radial-gradient(120% 70% at 50% 115%, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0) 60%);
  }

  .lifted-logo::after {
    z-index: 2;
    box-shadow:
      inset 0 1.5px 0 rgb(255 255 255 / 0.55),
      inset 0 0 0 1px rgb(255 255 255 / 0.16),
      inset 0 -0.6rem 1.5rem rgb(255 255 255 / 0.06);
  }

  /* Forced colours: the shapes in the text colour, on the page's own. */
  @media (forced-colors: active) {
    .lifted-logo {
      border: 1px solid CanvasText;
    }

    .lifted-logo::before,
    .lifted-logo::after {
      display: none;
    }
  }
</style>
