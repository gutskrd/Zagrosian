---
/**
 * The Zagrosian logo: a Z formed by two hands reaching toward each other. Traced from the black and
 * white masters (src/assets/brand/zagrosian-logo-*-source.png) and inlined, so it's sharp at any
 * size and costs no request. Both versions use currentColor.
 *
 * The black version shows in the light theme and the white one in the dark theme; the white one is
 * drawn slightly lighter, since white on black reads heavier.
 *
 * Decorative next to the name, so it's aria-hidden; other attributes (such as `data-*`) go on the
 * wrapper.
 */
import type { HTMLAttributes } from 'astro/types';
import DarkLogo from '../../assets/brand/zagrosian-logo-dark.svg';
import LightLogo from '../../assets/brand/zagrosian-logo-light.svg';

type Props = HTMLAttributes<'span'>;

const { class: className, ...attributes } = Astro.props;
---

<span class:list={['logo', className]} aria-hidden="true" {...attributes}>
  <DarkLogo class="logo__shape logo__shape--dark" focusable="false" />
  <LightLogo class="logo__shape logo__shape--light" focusable="false" />
</span>

<style>
  .logo {
    display: inline-grid;
    flex: none;
    user-select: none;
  }

  .logo :global(.logo__shape) {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: auto;
  }

  .logo :global(.logo__shape--light),
  :global(:root[data-theme='dark']) .logo :global(.logo__shape--dark) {
    display: none;
  }

  :global(:root[data-theme='dark']) .logo :global(.logo__shape--light) {
    display: block;
  }

  /* Inside an inverted-theme region (`data-inverse`, global.css), show the other version. */
  :global(:root:not([data-theme='dark']) [data-inverse]:not(:has(:popover-open))) .logo :global(.logo__shape--dark),
  :global(:root[data-theme='dark'] [data-inverse]:not(:has(:popover-open))) .logo :global(.logo__shape--light) {
    display: none;
  }

  :global(:root:not([data-theme='dark']) [data-inverse]:not(:has(:popover-open))) .logo :global(.logo__shape--light),
  :global(:root[data-theme='dark'] [data-inverse]:not(:has(:popover-open))) .logo :global(.logo__shape--dark) {
    display: block;
  }

  /* Print is always light. */
  @media print {
    :global(:root[data-theme='dark']) .logo :global(.logo__shape--dark) {
      display: block;
    }

    :global(:root[data-theme='dark']) .logo :global(.logo__shape--light) {
      display: none;
    }
  }
</style>
