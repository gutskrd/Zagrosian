---
/**
 * The Zagrosian logo: a Z whose two halves are hands reaching towards each
 * other. Traced from Zagrosian's black and white logos
 * (src/assets/brand/zagrosian-logo-*-source.png) and inlined, so it is sharp
 * at any size and costs no download. Both are filled with the text colour.
 *
 * The black logo is shown in the light theme and the white one in the dark
 * theme: they are drawn to match, the white one a touch finer, as white on
 * black reads heavier. `tone="light"` always shows the white one, for surfaces
 * that are dark in both themes (the site menu, the opening screen).
 *
 * It is decoration beside the Zagrosian name, so it is hidden from screen
 * readers; other attributes (such as `data-*`) go on the wrapper.
 */
import type { HTMLAttributes } from 'astro/types';
import DarkLogo from '../assets/brand/zagrosian-logo-dark.svg';
import LightLogo from '../assets/brand/zagrosian-logo-light.svg';

interface Props extends HTMLAttributes<'span'> {
  tone?: 'auto' | 'light';
}

const { tone = 'auto', class: className, ...attributes } = Astro.props;
---

<span class:list={['logo', `logo--${tone}`, className]} aria-hidden="true" {...attributes}>
  {tone === 'auto' && <DarkLogo class="logo__shape logo__shape--dark" focusable="false" />}
  <LightLogo class="logo__shape logo__shape--light" focusable="false" />
</span>

<style>
  .logo {
    display: inline-grid;
    flex: none;
    user-select: none;
  }

  .logo :global(.logo__shape) {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: auto;
  }

  .logo--auto :global(.logo__shape--light),
  :global(:root[data-theme='dark']) .logo--auto :global(.logo__shape--dark) {
    display: none;
  }

  :global(:root[data-theme='dark']) .logo--auto :global(.logo__shape--light) {
    display: block;
  }

  /* In a part of the page drawn in the other theme's colours (`data-inverse`,
     global.css), the other version shows. */
  :global(:root:not([data-theme='dark']) [data-inverse]) .logo--auto :global(.logo__shape--dark),
  :global(:root[data-theme='dark'] [data-inverse]) .logo--auto :global(.logo__shape--light) {
    display: none;
  }

  :global(:root:not([data-theme='dark']) [data-inverse]) .logo--auto :global(.logo__shape--light),
  :global(:root[data-theme='dark'] [data-inverse]) .logo--auto :global(.logo__shape--dark) {
    display: block;
  }

  /* Printed pages are always light. */
  @media print {
    :global(:root[data-theme='dark']) .logo--auto :global(.logo__shape--dark) {
      display: block;
    }

    :global(:root[data-theme='dark']) .logo--auto :global(.logo__shape--light) {
      display: none;
    }
  }
</style>
