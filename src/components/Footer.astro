---
import Arrow from './Arrow.astro';
import Wordmark from './Wordmark.astro';
import { footerNav, site } from '../site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a class="site-footer__home" href="/">
          <Wordmark />
        </a>
        <p class="site-footer__tagline">{site.tagline}</p>
      </div>

      <nav aria-label="Footer">
        <ul class="site-footer__links">
          {
            footerNav.map((link) => (
              <li>
                <a class="site-footer__link" href={link.href}>
                  {link.label}
                  {link.external && <Arrow direction="up-right" class="site-footer__external" />}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p class="site-footer__legal">
      <small>&copy; {year} {site.name}</small>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 4rem 2.5rem;
    border-top: 1px solid var(--color-line);
    font-size: var(--text-sm);
  }

  .site-footer__top {
    display: grid;
    gap: 3rem;
  }

  .site-footer__home {
    display: inline-flex;
    text-decoration: none;
  }

  .site-footer__tagline {
    margin-top: 1rem;
    color: var(--color-muted);
  }

  .site-footer__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem 2rem;
  }

  .site-footer__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-footer__link:hover {
    color: var(--color-ink);
  }

  :global(.site-footer__external) {
    width: 0.8125rem;
    height: 0.8125rem;
    color: var(--color-muted);
  }

  .site-footer__legal {
    margin-top: 4rem;
    color: var(--color-muted);
  }

  .site-footer__legal small {
    font-size: inherit;
  }

  @media (min-width: 48rem) {
    .site-footer {
      padding-block: 5rem 3rem;
    }

    .site-footer__top {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .site-footer__links {
      display: flex;
      flex-wrap: wrap;
      gap: 0 2.25rem;
    }

    .site-footer__link {
      min-height: auto;
    }

    .site-footer__legal {
      margin-top: 6rem;
    }
  }
</style>
