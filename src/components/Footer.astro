---
import Arrow from './Arrow.astro';
import SocialIcon from './SocialIcon.astro';
import { footerNav, legalNav, site, socialProfiles } from '../site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__about">
        <p class="site-footer__motto kurdish" lang="ku">Ji Kurdan, ji bo Kurdan.</p>
        <p>
          Independent technology company<br />
          based in {site.country}.
        </p>
      </div>

      <div class="site-footer__navs">
        <nav aria-label="Footer">
          <ul class="site-footer__links">
            {
              footerNav.map((link) => (
                <li>
                  <a class="site-footer__link" href={link.href}>
                    {link.label}
                    {link.external && <Arrow direction="up-right" class="site-footer__external" />}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-label="Social media">
          <ul class="site-footer__social">
            {
              socialProfiles.map((profile) => (
                <li>
                  <a class="site-footer__link" href={profile.url} rel="me">
                    <SocialIcon name={profile.icon} class="site-footer__social-icon" />
                    {profile.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>

    <div class="site-footer__mark" aria-hidden="true" data-rise>
      <span>{site.name}</span>
    </div>

    <div class="site-footer__bottom">
      <p><small>&copy; {year} {site.legalName}</small></p>
      <nav aria-label="Legal">
        <ul class="site-footer__legal">
          {
            legalNav.map((link) => (
              <li>
                <a class="site-footer__link" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a class="site-footer__link" href="#top">
              Back to top
              <Arrow direction="up" />
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 4rem 2rem;
    border-top: 1px solid var(--color-line);
    font-size: var(--text-sm);
  }

  .site-footer__top {
    display: grid;
    gap: 2.5rem;
  }

  .site-footer__about {
    color: var(--color-muted);
  }

  .site-footer__motto {
    margin-bottom: 0.375rem;
    font-size: 1.0625rem;
    color: var(--color-ink);
  }

  .site-footer__navs {
    display: grid;
    gap: 0.5rem;
  }

  .site-footer__links,
  .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
  }

  .site-footer__social .site-footer__link {
    gap: 0.5rem;
    color: var(--color-muted);
  }

  .site-footer__social .site-footer__link:hover {
    color: var(--color-ink);
  }

  :global(.site-footer__social-icon) {
    font-size: 1rem;
  }

  .site-footer__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-footer__link:hover {
    color: var(--color-ink);
  }

  :global(.site-footer__external) {
    width: 0.8125rem;
    height: 0.8125rem;
    color: var(--color-muted);
  }

  /* The wordmark spans the full content width at every screen size. */
  .site-footer__mark {
    container-type: inline-size;
    overflow: hidden;
    margin-top: clamp(3.5rem, 2rem + 5vw, 7rem);
    user-select: none;
  }

  .site-footer__mark span {
    display: block;
    font-size: 24.2cqi;
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.05em;
    white-space: nowrap;
    /* Optical alignment with the text column. */
    margin-left: -0.04em;
    padding-bottom: 0.2em;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
  }

  .site-footer__bottom small {
    font-size: inherit;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }

  .site-footer__legal .site-footer__link {
    color: var(--color-muted);
  }

  .site-footer__legal .site-footer__link:hover {
    color: var(--color-ink);
  }

  @media (min-width: 48rem) {
    .site-footer {
      padding-block: 5rem 2rem;
    }

    .site-footer__top {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .site-footer__navs {
      justify-items: end;
      gap: 1rem;
    }

    .site-footer__links,
    .site-footer__social {
      justify-content: flex-end;
      gap: 0 2.25rem;
    }

    .site-footer__links .site-footer__link,
    .site-footer__social .site-footer__link {
      min-height: 1.5rem;
    }
  }
</style>
