---
import { i18n, navigation } from '../i18n';
import { hevalo, kurdish, site, socialProfiles } from '../site';
import Arrow from './Arrow.astro';
import SocialIcon from './SocialIcon.astro';
import ThemeSwitch from './ThemeSwitch.astro';

const { locale, t } = i18n(Astro.url);
const nav = navigation(locale);
const footerLinks = [{ label: t.nav.hevalo, href: hevalo.url, external: true }, ...nav.sections.slice(1)];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__about">
        {/* The site's last word: "thank you". */}
        <p class="site-footer__motto kurdish" lang="ku" dir="ltr">{kurdish.thanks}</p>
        {t.footer.thanks && <p class="site-footer__gloss">{t.footer.thanks}</p>}
        <p class="site-footer__company">
          {t.footer.about[0]}<br />
          {t.footer.about[1]}
        </p>
      </div>

      <div class="site-footer__navs">
        <nav aria-label={t.common.footerNav}>
          <ul class="site-footer__links">
            {
              footerLinks.map((link) => (
                <li>
                  <a class="site-footer__link" href={link.href}>
                    {link.label}
                    {'external' in link && <Arrow direction="up-right" class="site-footer__external" />}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-label={t.common.socialNav}>
          <ul class="site-footer__social">
            {
              socialProfiles.map((profile) => (
                <li>
                  <a class="site-footer__link" href={profile.url} rel="me">
                    <SocialIcon name={profile.icon} class="site-footer__social-icon" />
                    {profile.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>

    <div class="site-footer__mark" aria-hidden="true" data-rise dir="ltr">
      <span>{site.name}</span>
    </div>

    <div class="site-footer__bottom">
      <div class="site-footer__meta">
        <p><small>&copy; {year} {site.legalName}</small></p>
        <ThemeSwitch />
      </div>
      <nav aria-label={t.common.legalNav}>
        <ul class="site-footer__legal">
          {
            nav.legal.map((link) => (
              <li>
                <a class="site-footer__link" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a class="site-footer__link" href="#top">
              {t.common.backToTop}
              <Arrow direction="up" />
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 4rem 2rem;
    border-top: 1px solid var(--color-line);
    font-size: var(--text-sm);
  }

  .site-footer__top {
    display: grid;
    gap: 2.5rem;
  }

  .site-footer__about {
    color: var(--color-muted);
  }

  .site-footer__motto {
    font-size: 1.0625rem;
    color: var(--color-ink);
  }

  /* Kurmanji runs left to right, but lines up with the page's own side. */
  :global(:root[dir='rtl']) .site-footer__motto {
    text-align: right;
  }

  .site-footer__gloss {
    font-size: var(--text-xs);
  }

  .site-footer__company {
    margin-top: 1rem;
  }

  .site-footer__navs {
    display: grid;
    gap: 0.5rem;
  }

  .site-footer__links,
  .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
  }

  .site-footer__social .site-footer__link {
    gap: 0.5rem;
    color: var(--color-muted);
  }

  .site-footer__social .site-footer__link:hover {
    color: var(--color-ink);
  }

  :global(.site-footer__social-icon) {
    font-size: 1rem;
  }

  .site-footer__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-footer__link:hover {
    color: var(--color-ink);
  }

  :global(.site-footer__external) {
    width: 0.8125rem;
    height: 0.8125rem;
    color: var(--color-muted);
  }

  /* The wordmark spans the full content width at every screen size. */
  .site-footer__mark {
    container-type: inline-size;
    overflow: hidden;
    margin-top: clamp(3.5rem, 2rem + 5vw, 7rem);
    user-select: none;
  }

  .site-footer__mark span {
    display: block;
    font-size: 24.2cqi;
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.05em;
    white-space: nowrap;
    /* Optical alignment with the text column. */
    margin-left: -0.04em;
    padding-bottom: 0.2em;
    /* It stands up from its baseline as the footer scrolls in (motion.ts). */
    transform-origin: 50% 100%;
  }

  /* Where the browser runs scroll-linked animations itself, it stands the
     wordmark up on the graphics card, in step with the scroll; elsewhere
     motion.ts does the same with a script. From lying back on its baseline
     to upright, while the wordmark comes into view (as it enters, easing out). */
  .site-footer__mark {
    view-timeline-name: --wordmark;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Separate properties, so the minifier cannot fold the timeline into
         the `animation` shorthand (which browsers do not accept). */
      .site-footer__mark span {
        animation-name: wordmark-rise;
        animation-timing-function: cubic-bezier(0.33, 1, 0.68, 1);
        animation-fill-mode: both;
        animation-timeline: --wordmark;
        animation-range: entry 0% entry 100%;
      }
    }
  }

  @keyframes wordmark-rise {
    from {
      transform: perspective(max(600px, 90cqi)) rotateX(70deg) translate3d(0, 40%, 0);
    }

    to {
      transform: perspective(max(600px, 90cqi)) rotateX(0deg) translate3d(0, 0, 0);
    }
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
  }

  .site-footer__meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 2.75rem;
  }

  .site-footer__bottom small {
    font-size: inherit;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }

  .site-footer__legal .site-footer__link {
    color: var(--color-muted);
  }

  .site-footer__legal .site-footer__link:hover {
    color: var(--color-ink);
  }

  @media (min-width: 48rem) {
    .site-footer {
      padding-block: 5rem 2rem;
    }

    .site-footer__top {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .site-footer__navs {
      justify-items: end;
      gap: 1rem;
    }

    .site-footer__links,
    .site-footer__social {
      justify-content: flex-end;
      gap: 0 2.25rem;
    }

    .site-footer__links .site-footer__link,
    .site-footer__social .site-footer__link {
      min-height: 1.5rem;
    }
  }
</style>
