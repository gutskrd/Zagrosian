---
/**
 * A Kurdish proverb written on a sheet of paper: the sheet the paper plane from under the rug
 * (Underneath.astro) unfolds into when it lands here (src/scripts/plane.ts). The sheet shows the
 * plane's creases, computed from the same folds (plane-folds.ts) for both orientations: portrait on
 * phones (landing nose down) and landscape on larger screens (landing nose first from the left).
 *
 * The sheet never exceeds the viewport height below the header, so it's always fully readable where
 * the plane opens it, and its text scales with it. The proverb is plain text in the document,
 * available to screen readers and search engines regardless of the animation. Without JS or with
 * reduced motion the sheet is simply static. The plane's canvas stays hidden until the script draws
 * on it.
 */
import { i18n } from '../i18n';
import { foldSheet, LENGTH } from '../scripts/plane-folds';
import { kurdish } from '../site';

const { t } = i18n(Astro.url);
const { creases } = foldSheet();
const round = (value: number) => +value.toFixed(4);
// Portrait: nose at the bottom (rotated 180 degrees); landscape: nose to the right.
const tall = creases.map(({ from, to }) => [0.5 - from[0], LENGTH - from[1], 0.5 - to[0], LENGTH - to[1]].map(round));
const wide = creases.map(({ from, to }) => [LENGTH - from[1], 0.5 + from[0], LENGTH - to[1], 0.5 + to[0]].map(round));
---

<div class="proverb section" data-proverb>
  <div class="container">
    <figure class="proverb__sheet" data-sheet>
      <svg class="proverb__creases proverb__creases--tall" viewBox={`0 0 1 ${round(LENGTH)}`} aria-hidden="true" focusable="false">
        {tall.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} vector-effect="non-scaling-stroke" />)}
      </svg>
      <svg class="proverb__creases proverb__creases--wide" viewBox={`0 0 ${round(LENGTH)} 1`} aria-hidden="true" focusable="false">
        {wide.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} vector-effect="non-scaling-stroke" />)}
      </svg>
      <div class="proverb__writing">
        <blockquote class="proverb__text kurdish" lang="ku" dir="ltr">
          <p>{kurdish.proverb}</p>
        </blockquote>
        {t.hevalo.proverb && <p class="proverb__translation">{t.hevalo.proverb}</p>}
        <figcaption class="proverb__source">
          <span lang="ku" dir="ltr">{kurdish.proverbSource}</span>
          {t.hevalo.proverbSource && <span>{t.hevalo.proverbSource}</span>}
        </figcaption>
      </div>
    </figure>
  </div>

  <canvas class="flight" aria-hidden="true" data-plane hidden></canvas>
</div>

<style>
  /* Wherever the plane flies, the page never scrolls horizontally. */
  .proverb {
    position: relative;
    overflow-x: clip;
  }

  /* A4-proportioned sheet, the same paper in both themes like a real sheet: warm white, with the
     creases of having been a plane. */
  .proverb__sheet {
    --paper: rgb(243 239 230);
    --paper-ink: #1f1c17;
    --paper-muted: #645e54;
    /* Available height below the header, minus a margin. */
    --room: calc(100vh - var(--header-height) - 3.5rem);
    position: relative;
    width: min(100%, 22rem, var(--room) / 1.41421);
    aspect-ratio: 1 / 1.41421;
    margin-inline: auto;
    background: var(--paper);
    color: var(--paper-ink);
    text-align: center;
    container-type: inline-size;
  }

  @supports (height: 100svh) {
    .proverb__sheet {
      --room: calc(100svh - var(--header-height) - 3.5rem);
    }
  }

  /* Drop shadow as a separate layer, so it can fade in and out. */
  .proverb__sheet::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.1),
      0 1.5rem 3rem -1.25rem rgb(0 0 0 / 0.4);
    transition: opacity 0.8s var(--ease-out);
  }

  @media (min-width: 40rem) {
    .proverb__sheet {
      width: min(100%, 38rem, var(--room) * 1.41421);
      aspect-ratio: 1.41421 / 1;
    }
  }

  .proverb__creases {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    stroke: rgb(70 56 40 / 0.09);
    stroke-width: 1;
    pointer-events: none;
  }

  .proverb__creases--wide {
    display: none;
  }

  @media (min-width: 40rem) {
    .proverb__creases--tall {
      display: none;
    }

    .proverb__creases--wide {
      display: block;
    }
  }

  /* Text sized by the sheet (container units), so it reads the same at any size. */
  .proverb__writing {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5cqi;
    height: 100%;
    padding: 8cqi;
  }

  .proverb__text,
  .proverb__translation,
  .proverb__source {
    margin: 0;
  }

  .proverb__text {
    font-size: max(1.0625rem, 6.6cqi);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .proverb__translation {
    font-size: max(0.875rem, 4.4cqi);
    line-height: 1.45;
    color: var(--paper-muted);
    text-wrap: balance;
  }

  @media (min-width: 40rem) {
    .proverb__writing {
      gap: 3.4cqi;
      padding: 6cqi 10cqi;
    }

    .proverb__text {
      font-size: 5cqi;
    }

    .proverb__translation {
      font-size: 3cqi;
    }

    /* (Placed after the source's own rule so this one takes precedence.) */
    .proverb__writing .proverb__source {
      font-size: max(0.75rem, 2.2cqi);
    }
  }

  .proverb__source {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.75rem;
    font-family: var(--font-mono);
    font-size: max(0.75rem, 3.7cqi);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper-muted);
  }

  .proverb__source span + span::before {
    content: '·';
    margin-inline-end: 0.75rem;
  }

  :root:is([lang='ar'], [lang='ckb'], [lang='fa']) .proverb__source {
    font-family: var(--font-sans);
  }

  /* While the plane carries it (plane.ts) the sheet is hidden; on landing the paper appears where
     the plane opened, and the text fades in on it. */
  .proverb[data-flight]:not([data-landed]) .proverb__sheet {
    opacity: 0;
  }

  .proverb[data-flight]:not([data-landed]) .proverb__sheet::after {
    opacity: 0;
  }

  .proverb[data-flight] .proverb__sheet > :not(svg) {
    transition:
      opacity 0.7s var(--ease-out) 0.1s,
      translate 0.7s var(--ease-out) 0.1s;
  }

  .proverb[data-flight]:not([data-landed]) .proverb__sheet > :not(svg) {
    opacity: 0;
    translate: 0 0.35rem;
  }

  /* Plane canvas fixed over the viewport for the flight: below the rug canvas (so the rug covers
     it) while sliding out, then above the page and below the header. At rest under the rug it's
     drawn on the rug's floor canvas instead (Rug.astro). plane.ts only draws while the plane is
     visible. */
  .flight {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .flight[data-aloft] {
    z-index: 3;
  }

  @media (forced-colors: active) {
    .flight {
      display: none;
    }

    .proverb__sheet {
      opacity: 1 !important;
      border: 1px solid CanvasText;
    }
  }

  @media print {
    .flight {
      display: none;
    }

    .proverb__sheet,
    .proverb__sheet > * {
      opacity: 1 !important;
    }
  }
</style>
