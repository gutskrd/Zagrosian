---
/**
 * Hevalo's logo: the H with antlers, traced from Hevalo's black and white
 * logos (src/assets/brand/hevalo-*-source.png). Inlined and filled with the
 * text colour, so it is black in the light theme and white in the dark one,
 * as sharp at 20 px as at 200, with nothing extra to download.
 */
import HevaloMark from '../assets/brand/hevalo-mark.svg';

interface Props {
  /** Leave empty when the logo sits next to the Hevalo name. */
  alt?: string;
  class?: string;
}

const { alt = '', class: className } = Astro.props;
const label = alt ? { role: 'img' as const, 'aria-label': alt } : { 'aria-hidden': 'true' as const };
---

<HevaloMark class:list={['hevalo-icon', className]} focusable="false" {...label} />

<style>
  /* The mark is a component, so this reaches it as a global class. Callers set
     its width or height; the other follows its proportions. */
  :global(.hevalo-icon) {
    flex: none;
  }
</style>
