---
/**
 * Hevalo's app icon as a hole in the page, for the products section
 * (ProductShowcase.astro): the page itself is cut in the icon's shape, and
 * through it you look into the purple space behind the page, from which the
 * deer climbs out towards the reader. Nothing here stands on the page: the cut
 * stays flat in it, and what is behind moves as things behind a window do when
 * you walk past it (the view follows where the reader's eye is: the middle of
 * the screen as the page scrolls, and with a mouse, the pointer).
 *
 * The deer is taken apart into its layers (scripts/deer-layers.cjs): its neck
 * in copies through the depth, then the antlers, the ears, the head with its
 * eyes and the nose, each at its own depth. As the section scrolls into view
 * it comes forward from deep behind the page, through the hole, until its head
 * is out in front of the page, ears over the edge, casting a soft shadow on
 * the page around the hole.
 *
 * It is alive, never busy: it blinks, now and then twitches an ear or sniffs,
 * and answers a tap or click with all three (src/scripts/deer.ts). Its eyes
 * follow the pointer (src/scripts/eyes.ts). None of this moves when the
 * visitor prefers reduced motion: the deer is simply out, seen from just above.
 *
 * Like the flat icon (HevaloIcon.astro), it comes in two seasons, and only the
 * one in season is downloaded (the images are lazy). Depths are in `cqi`, so
 * it must sit in an inline-size container (the showcase's art), painted under
 * the text beside it: the page round the hole is drawn here, in the colour of
 * the section behind it.
 */
import type { ImageMetadata } from 'astro';
import HevaloEyes from './HevaloEyes.astro';

interface Props {
  /** The icon's rendered width, widest screens first, e.g. [['(min-width: 64rem)', 21], [null, 14]] (rem). */
  widths: [string | null, number][];
}

const { widths } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/brand/deer/*.webp', { eager: true });
const image = (name: string) => {
  const file = files[`../assets/brand/deer/${name}.webp`];
  if (!file) throw new Error(`Missing deer layer ${name}`);
  return file.default;
};

/** Each layer's width, as a fraction of the icon's (from its box in deer-layers.cjs). */
const layers = {
  snow: { width: 330 / 360, frames: [288, 576], seasons: ['christmas'] },
  neck: { width: 150 / 360, frames: [288, 576], seasons: ['shared'] },
  'neck-core': { width: 140 / 360, frames: [288, 576], seasons: ['shared'] },
  'neck-back': { width: 140 / 360, frames: [288, 576], seasons: ['shared'] },
  antlers: { width: 300 / 360, frames: [288, 576], seasons: ['everyday', 'christmas'] },
  'ear-left': { width: 110 / 360, frames: [288, 576], seasons: ['everyday', 'christmas'] },
  'ear-right': { width: 110 / 360, frames: [288, 576], seasons: ['everyday', 'christmas'] },
  head: { width: 230 / 360, frames: [288, 576], seasons: ['everyday', 'christmas'] },
  nose: { width: 70 / 360, frames: [288, 576], seasons: ['everyday', 'christmas'] },
} as const;

type Layer = keyof typeof layers;

const prefixes: Record<string, string> = { everyday: 'hevalo', christmas: 'hevalo-christmas', shared: 'hevalo' };

/** A layer's images: one per season (the neck serves both). */
const images = (layer: Layer) => {
  const { width, frames, seasons } = layers[layer];
  const sizes = widths.map(([query, rem]) => `${query ? `${query} ` : ''}${(rem * width).toFixed(2)}rem`).join(', ');
  return seasons.map((season) => {
    const set = frames.map((frame) => image(`${prefixes[season]}-${layer}-${frame}`));
    const fallback = set[set.length - 1];
    return {
      season: season === 'shared' ? undefined : season,
      attributes: {
        src: fallback.src,
        srcset: set.map((file) => `${file.src} ${file.width}w`).join(', '),
        sizes,
        width: fallback.width,
        height: fallback.height,
      },
    };
  });
};

/** The purple haze behind the page: three veils, so the deeper, the fainter. */
const hazes = [1, 2, 3];

/** The cut edge of the page round the hole: four rings through its thickness. */
const cuts = [1, 2, 3, 4];

/**
 * The neck, in copies from deep behind the page to just behind the head
 * (depths in cqi, once the deer is out): behind the page it goes on down out
 * of sight; in front of it, it stops just above the hole's edge; the copy
 * nearest the head keeps the soft edge.
 */
const neck: { z: number; layer: Layer }[] = [
  ...[-8.6, -7.6, -6.6, -5.6, -4.6, -3.6, -2.6, -1.6, -0.6].map((z) => ({ z, layer: 'neck-back' as const })),
  ...[0.4, 1.2, 1.8].map((z) => ({ z, layer: 'neck-core' as const })),
  { z: 2.4, layer: 'neck' },
];
---

<span class="deer" data-deer data-hevalo-eyes>
  {/* Behind the page: the purple space, and at Christmas its snow. */}
  <span class="deer__back">
    {
      images('snow').map((img) => (
        <img class="deer__image deer__snow" data-season={img.season} {...img.attributes} alt="" loading="lazy" decoding="async" draggable="false" />
      ))
    }
  </span>
  {hazes.map((depth) => <span class="deer__haze" data-depth={depth} />)}
  <span class="deer__inside"></span>
  {cuts.map((depth) => <span class="deer__cut" data-depth={depth} />)}

  {/* The page round the hole, and the deer's shade on it. */}
  <span class="deer__page"></span>
  <span class="deer__shade"></span>

  {/* The deer. */}
  {
    neck.map(({ z, layer }) => (
      <span class:list={['deer__layer', 'deer__neck-copy', `deer__${layer}`]} data-z={z}>
        {images(layer).map((img) => (
          <img class="deer__image" {...img.attributes} alt="" loading="lazy" decoding="async" draggable="false" />
        ))}
      </span>
    ))
  }
  {
    (['antlers', 'ear-left', 'ear-right', 'head', 'nose'] as const).map((layer) => (
      <span class:list={['deer__layer', `deer__${layer}`]}>
        <span class="deer__part">
          {images(layer).map((img) => (
            <img class="deer__image" data-season={img.season} {...img.attributes} alt="" loading="lazy" decoding="async" draggable="false" />
          ))}
          {layer === 'head' && <HevaloEyes frame="head" lids />}
        </span>
      </span>
    ))
  }
</span>

<style>
  .deer {
    /* How far away the reader's eye is, and where it is: across, from
       deer.ts (the middle of the screen, plus the pointer); down, from the
       scroll. */
    --p: 1200px;
    --ex: calc(var(--eye-x, 50%) + var(--look-x, 0px));
    --ly: var(--look-y, 0px);
    /* How far behind the page the deer starts. */
    --rise: 28cqi;
    /* The purple behind the page: the icon's own, light at the bottom left. */
    --purple-from: #db7df5;
    --purple-to: #9a6cf1;
    /* The cut edge of the page, in shade. */
    --cut-1: color-mix(in oklab, var(--color-surface), #000 5%);
    --cut-2: color-mix(in oklab, var(--color-surface), #000 9%);
    --cut-3: color-mix(in oklab, var(--color-surface), #000 13%);

    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform-origin: 0 0;
    /* Seen from just above, as when the section sits a little low on screen
       (the scroll moves the eye, below). The page itself (depth 0) is where
       it always is; only what is behind or in front of it moves. */
    transform: translate(var(--ex), calc(25% + var(--ly))) perspective(var(--p))
      translate(calc(var(--ex) * -1), calc(-25% - var(--ly)));
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    /* It is artwork: forced colours keep its colours. */
    forced-color-adjust: none;
  }

  :global(:root[data-theme='dark']) .deer {
    --cut-1: color-mix(in oklab, var(--color-surface), #fff 4%);
    --cut-2: color-mix(in oklab, var(--color-surface), #fff 2.5%);
    --cut-3: color-mix(in oklab, var(--color-surface), #000 20%);
  }

  :global(:root[data-season='christmas']) .deer {
    --purple-from: #d779f2;
    --purple-to: #9569ec;
  }

  .deer__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .deer__image[data-season='christmas'] {
    display: none;
  }

  :global(:root[data-season='christmas']) .deer__image[data-season='everyday'] {
    display: none;
  }

  :global(:root[data-season='christmas']) .deer__image[data-season='christmas'] {
    display: block;
  }

  /* ---- The hole ----
     The icon's outline, measured on the artwork: 13.72 to 346.08 across, 0.27
     to 358.8 down (of 360), corners of 72.6. */
  .deer__inside,
  .deer__cut {
    position: absolute;
    inset: 0.075% 3.867% 0.333% 3.811%;
    border-radius: 20.167cqi;
  }

  /* The space behind the page: a purple plane far back, the hole's shape
     30cqi larger all round (enough to fill the hole from wherever the eye
     is), a little lighter in the middle. */
  .deer__back {
    position: absolute;
    inset: calc(0.075% - 30cqi) calc(3.867% - 30cqi) calc(0.333% - 30cqi) calc(3.811% - 30cqi);
    border-radius: 50.167cqi;
    translate: 0 0 -30cqi;
    background:
      radial-gradient(closest-side, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0)),
      linear-gradient(to top right, var(--purple-from) 18%, var(--purple-to) 80%);
  }

  /* Veils of the same purple between it and the page: the further back the
     deer is, the more of them it is behind and the more it fades into the
     purple; out of the hole, it is clear. Each is the hole's shape, larger
     the deeper (to fill the hole from wherever the eye is). */
  .deer__haze {
    position: absolute;
    inset: calc(0.075% - var(--grow)) calc(3.867% - var(--grow)) calc(0.333% - var(--grow))
      calc(3.811% - var(--grow));
    border-radius: calc(20.167cqi + var(--grow));
    background: linear-gradient(to top right, var(--purple-from), var(--purple-to));
    opacity: 0.22;
  }

  .deer__haze[data-depth='1'] {
    --grow: 20cqi;
    translate: 0 0 -21cqi;
  }

  .deer__haze[data-depth='2'] {
    --grow: 13cqi;
    translate: 0 0 -14cqi;
  }

  .deer__haze[data-depth='3'] {
    --grow: 7cqi;
    translate: 0 0 -7cqi;
  }

  /* 15, 0; 330 wide, within the plane. */
  .deer__snow {
    position: absolute;
    left: 19.93%;
    top: 18.75%;
    width: 60.18%;
  }

  /* Just inside the hole, the light falls off towards its edge. */
  .deer__inside {
    translate: 0 0 -1.6cqi;
    box-shadow: inset 0 0 5cqi 1cqi rgb(30 8 60 / 0.4);
  }

  /* The page's cut edge: four rings, darker the deeper. */
  .deer__cut {
    border: 1.3cqi solid var(--cut);
  }

  .deer__cut[data-depth='1'] {
    --cut: var(--cut-1);
    translate: 0 0 -0.05cqi;
  }

  .deer__cut[data-depth='2'] {
    --cut: var(--cut-1);
    translate: 0 0 -0.5cqi;
  }

  .deer__cut[data-depth='3'] {
    --cut: var(--cut-2);
    translate: 0 0 -1cqi;
  }

  .deer__cut[data-depth='4'] {
    --cut: var(--cut-3);
    translate: 0 0 -1.5cqi;
  }

  /* The page round the hole: a band in the section's colour, wide enough to
     hide whatever is behind the page from wherever the eye is (the band is
     the border; the mask leaves out the hole inside it). The purple glows a
     little onto it. */
  .deer__page,
  .deer__shade {
    position: absolute;
    inset: calc(0.075% - 54cqi) calc(3.867% - 54cqi) calc(0.333% - 54cqi) calc(3.811% - 54cqi);
    border: 54cqi solid transparent;
    border-radius: 74.167cqi;
    -webkit-mask:
      linear-gradient(#000 0 0) padding-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) padding-box exclude,
      linear-gradient(#000 0 0);
  }

  .deer__page {
    background:
      radial-gradient(closest-side, rgb(176 112 242 / 0.16), rgb(176 112 242 / 0) 70%) border-box,
      var(--color-surface);
  }

  /* The deer's shade on the page, once it is out (the image's box, 0, 15,
     360 by 400, from the band's outer corner). */
  .deer__shade {
    translate: 0 0 0.05cqi;
    background: url('../assets/brand/deer/hevalo-shade-144.webp') 50.189cqi 58.092cqi / 100cqi 111.111cqi
      no-repeat border-box;
  }

  :global(:root[data-season='christmas']) .deer__shade {
    background-image: url('../assets/brand/deer/hevalo-christmas-shade-144.webp');
  }

  :global(:root[data-theme='dark']) .deer__shade {
    opacity: 0.7;
  }

  /* ---- The deer ----
     Each layer at its place in the icon's 360 px square (the boxes from
     deer-layers.cjs), and at its depth once out: in front of the page
     (positive) or behind it. */
  .deer__layer {
    position: absolute;
    display: block;
    translate: 0 0 var(--z);
  }

  .deer__part {
    position: relative;
    display: block;
  }

  /* 105, 290; 150 wide (the soft copy), 110, 290; 140 wide (the others). */
  .deer__neck-copy {
    top: 80.5556%;
  }

  .deer__neck {
    left: 29.1667%;
    width: 41.6667%;
  }

  .deer__neck-core,
  .deer__neck-back {
    left: 30.5556%;
    width: 38.8889%;
  }

  .deer__neck-copy[data-z='-8.6'] {
    --z: -8.6cqi;
  }

  .deer__neck-copy[data-z='-7.6'] {
    --z: -7.6cqi;
  }

  .deer__neck-copy[data-z='-6.6'] {
    --z: -6.6cqi;
  }

  .deer__neck-copy[data-z='-5.6'] {
    --z: -5.6cqi;
  }

  .deer__neck-copy[data-z='-4.6'] {
    --z: -4.6cqi;
  }

  .deer__neck-copy[data-z='-3.6'] {
    --z: -3.6cqi;
  }

  .deer__neck-copy[data-z='-2.6'] {
    --z: -2.6cqi;
  }

  .deer__neck-copy[data-z='-1.6'] {
    --z: -1.6cqi;
  }

  .deer__neck-copy[data-z='-0.6'] {
    --z: -0.6cqi;
  }

  .deer__neck-copy[data-z='0.4'] {
    --z: 0.4cqi;
  }

  .deer__neck-copy[data-z='1.2'] {
    --z: 1.2cqi;
  }

  .deer__neck-copy[data-z='1.8'] {
    --z: 1.8cqi;
  }

  .deer__neck-copy[data-z='2.4'] {
    --z: 2.4cqi;
  }

  /* 25, 15; 300 wide */
  .deer__antlers {
    --z: 1.5cqi;
    left: 6.9444%;
    top: 4.1667%;
    width: 83.3333%;
  }

  /* 0 and 250, 90; 110 wide. Each turns about where it meets the head, and
     sits just behind it: near enough that where it goes under the head never
     shows, far enough to part from it as the view changes. */
  .deer__ear-left,
  .deer__ear-right {
    --z: 2.2cqi;
    top: 25%;
    width: 30.5556%;
  }

  .deer__ear-left {
    left: 0;
  }

  .deer__ear-right {
    left: 69.4444%;
  }

  .deer__ear-left .deer__part {
    transform-origin: 80% 69.6%;
  }

  .deer__ear-right .deer__part {
    transform-origin: 20% 69.6%;
  }

  /* 65, 110; 230 wide (305 tall, for the Christmas scarf) */
  .deer__head {
    --z: 3cqi;
    left: 18.0556%;
    top: 30.5556%;
    width: 63.8889%;
  }

  /* 145, 270; 70 wide. It sniffs from its middle. */
  .deer__nose {
    --z: 4.6cqi;
    left: 40.2778%;
    top: 75%;
    width: 19.4444%;
  }

  .deer__nose .deer__part {
    transform-origin: 50% 49%;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* As the page scrolls, the eye goes down past the hole (from half a
       screen above it to half a screen below), so what is behind and in
       front of the page moves as it would behind a real window. As the
       section comes into view, the deer comes forward through the hole. On
       the graphics card, in step with the scroll; where the browser cannot,
       the deer is simply out, seen from just above. */
    @supports (animation-timeline: view()) {
      /* Separate properties, so the minifier cannot fold the timeline into
         the `animation` shorthand (which browsers do not accept). */
      .deer {
        view-timeline-name: --deer;
        animation-name: deer-eye;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }

      .deer__layer {
        animation-name: deer-out;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --deer;
        animation-range: entry 0% cover 50%;
      }

      .deer__shade {
        animation-name: deer-shade-in;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --deer;
        animation-range: entry 0% cover 50%;
      }
    }

    /* Life (deer.ts sets these for the length of each). */
    :global([data-blink]) :global(.lid__skin) {
      animation: deer-blink 0.26s var(--ease-in-out);
    }

    :global([data-twitch='left']) .deer__ear-left .deer__part,
    :global([data-twitch='both']) .deer__ear-left .deer__part {
      animation: deer-twitch-left 0.7s var(--ease-out);
    }

    :global([data-twitch='right']) .deer__ear-right .deer__part,
    :global([data-twitch='both']) .deer__ear-right .deer__part {
      animation: deer-twitch-right 0.7s var(--ease-out);
    }

    :global([data-sniff]) .deer__nose .deer__part {
      animation: deer-sniff 0.8s ease-in-out;
    }
  }

  /* The eye, from half a screen above the hole to half a screen below it. */
  @keyframes deer-eye {
    from {
      transform: translate(var(--ex), calc(-50vh + var(--ly))) perspective(var(--p))
        translate(calc(var(--ex) * -1), calc(50vh - var(--ly)));
    }

    to {
      transform: translate(var(--ex), calc(50vh + 100% + var(--ly))) perspective(var(--p))
        translate(calc(var(--ex) * -1), calc(-50vh - 100% - var(--ly)));
    }
  }

  /* From deep behind the page to out in front of it. */
  @keyframes deer-out {
    from {
      translate: 0 0 calc(var(--z) - var(--rise));
    }
  }

  /* Its shade on the page comes once its head is through (it crosses the
     page at 1 - 3 / 28 of the way, about 89%). */
  @keyframes deer-shade-in {
    from,
    90% {
      opacity: 0;
    }
  }

  @keyframes deer-blink {
    45%,
    55% {
      translate: 0 0;
    }
  }

  @keyframes deer-twitch-left {
    25% {
      rotate: -11deg;
    }

    50% {
      rotate: 5deg;
    }

    75% {
      rotate: -2deg;
    }
  }

  @keyframes deer-twitch-right {
    25% {
      rotate: 11deg;
    }

    50% {
      rotate: -5deg;
    }

    75% {
      rotate: 2deg;
    }
  }

  @keyframes deer-sniff {
    20%,
    60% {
      scale: 1.07;
    }

    40%,
    80% {
      scale: 1;
    }
  }
</style>
