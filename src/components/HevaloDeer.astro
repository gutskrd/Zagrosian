---
/**
 * Hevalo's app icon as a window the deer leans out of, for the products
 * section (ProductShowcase.astro). The icon's purple square is a frame; the
 * purple behind the deer is the back of the window, set into it behind its
 * walls; and the deer, taken apart into its layers (scripts/deer-layers.cjs),
 * comes out through the opening towards the reader: its neck from the back of
 * the window, then the antlers, the ears, the head with its eyes and the nose,
 * each at its own depth in front of the frame. As the showcase turns it,
 * the walls show, the back stays inside and the deer stands out of it.
 * (The layers only ever move together, with the icon: turned on its own, a
 * part this wide would swing back through the frame.)
 *
 * It is alive, never busy: it blinks, now and then twitches an ear or sniffs,
 * and answers a tap or click with all three (src/scripts/deer.ts). Its eyes
 * follow the pointer (src/scripts/eyes.ts). None of this moves when the
 * visitor prefers reduced motion.
 *
 * Like the flat icon (HevaloIcon.astro), it comes in two seasons, and only the
 * one in season is downloaded (the images are lazy). Depths are in `cqi`, so
 * it must sit in an inline-size container (the showcase's art).
 */
import type { ImageMetadata } from 'astro';
import HevaloEyes from './HevaloEyes.astro';

interface Props {
  /** The icon's rendered width, widest screens first, e.g. [['(min-width: 64rem)', 21], [null, 14]] (rem). */
  widths: [string | null, number][];
}

const { widths } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/brand/deer/*.webp', { eager: true });
const image = (name: string) => {
  const file = files[`../assets/brand/deer/${name}.webp`];
  if (!file) throw new Error(`Missing deer layer ${name}`);
  return file.default;
};

/** Each layer's width, as a fraction of the icon's (from its box in deer-layers.cjs). */
const layers = {
  face: { width: 340 / 360, frames: [288, 576] },
  shade: { width: 340 / 360, frames: [144] },
  neck: { width: 140 / 360, frames: [288, 576] },
  'neck-core': { width: 140 / 360, frames: [288, 576] },
  'neck-back': { width: 140 / 360, frames: [288, 576] },
  antlers: { width: 300 / 360, frames: [288, 576] },
  'ear-left': { width: 110 / 360, frames: [288, 576] },
  'ear-right': { width: 110 / 360, frames: [288, 576] },
  head: { width: 230 / 360, frames: [288, 576] },
  nose: { width: 70 / 360, frames: [288, 576] },
} as const;

type Layer = keyof typeof layers;

const seasons = [
  { season: 'everyday', prefix: 'hevalo' },
  { season: 'christmas', prefix: 'hevalo-christmas' },
];

/** A layer's images: one per season, or one for both (the neck). */
const images = (layer: Layer) => {
  const { width, frames } = layers[layer];
  const sizes = widths.map(([query, rem]) => `${query ? `${query} ` : ''}${(rem * width).toFixed(2)}rem`).join(', ');
  const shared = layer.startsWith('neck');
  return (shared ? [{ season: undefined, prefix: 'hevalo' }] : seasons).map(({ season, prefix }) => {
    const set = frames.map((frame) => image(`${prefix}-${layer}-${frame}`));
    const fallback = set[set.length - 1];
    return {
      season,
      attributes: {
        src: fallback.src,
        srcset: set.map((file) => `${file.src} ${file.width}w`).join(', '),
        sizes,
        width: fallback.width,
        height: fallback.height,
      },
    };
  });
};

/** The window's walls: rings of the frame's shape, from just behind the frame to the back. */
const walls = Array.from({ length: 8 }, (_, index) => index + 1);

/**
 * The neck, in copies from the back of the window to just behind the head
 * (depths in cqi): behind the frame it goes on down out of sight; in front of
 * it, it stops at the sill; the copy nearest the head keeps the soft edge.
 */
const neck: { z: number; layer: Layer }[] = [
  ...[-6.2, -5.4, -4.6, -3.8, -3, -2.2, -1.4, -0.6].map((z) => ({ z, layer: 'neck-back' as const })),
  ...[0.2, 1, 1.8].map((z) => ({ z, layer: 'neck-core' as const })),
  { z: 2.4, layer: 'neck' },
];
---

<span class="deer" data-deer data-hevalo-eyes>
  {/* The window: its back, the shade the deer casts on it, its walls, its frame. */}
  {
    (['face', 'shade'] as const).map((layer) => (
      <span class:list={['deer__layer', `deer__${layer}`]}>
        {images(layer).map((img) => (
          <img class="deer__image" data-season={img.season} {...img.attributes} alt="" loading="lazy" decoding="async" draggable="false" />
        ))}
      </span>
    ))
  }
  <span class="deer__layer deer__depth"></span>
  {walls.map((depth) => <span class="deer__layer deer__wall" data-depth={depth} />)}
  <span class="deer__frame"></span>

  {/* The deer, leaning out. */}
  {
    neck.map(({ z, layer }) => (
      <span class="deer__layer deer__neck" data-z={z}>
        {images(layer).map((img) => (
          <img class="deer__image" {...img.attributes} alt="" loading="lazy" decoding="async" draggable="false" />
        ))}
      </span>
    ))
  }
  {
    (['antlers', 'ear-left', 'ear-right', 'head', 'nose'] as const).map((layer) => (
      <span class:list={['deer__layer', `deer__${layer}`]}>
        <span class="deer__part">
          {images(layer).map((img) => (
            <img class="deer__image" data-season={img.season} {...img.attributes} alt="" loading="lazy" decoding="async" draggable="false" />
          ))}
          {layer === 'head' && <HevaloEyes frame="head" lids />}
        </span>
      </span>
    ))
  }
</span>

<style>
  .deer {
    /* How far the back of the window is set in, and the frame's width (14 of
       the icon's 360 units). */
    --window: 7cqi;
    --band: 3.889cqi;
    /* The frame's purple: the icon's own, light at the bottom left. */
    --frame-from: #db7df5;
    --frame-to: #9a6cf1;

    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    /* It is artwork: forced colours keep its colours. */
    forced-color-adjust: none;
  }

  :global(:root[data-season='christmas']) .deer {
    --frame-from: #d779f2;
    --frame-to: #9569ec;
  }

  /* Each layer at its place in the icon's 360 px square (the boxes from
     deer-layers.cjs), and at its depth: behind the frame (negative) or in
     front of it. */
  .deer__layer {
    position: absolute;
    display: block;
    translate: 0 0 var(--z);
  }

  .deer__part {
    position: relative;
    display: block;
  }

  .deer__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .deer__image[data-season='christmas'] {
    display: none;
  }

  :global(:root[data-season='christmas']) .deer__image[data-season='everyday'] {
    display: none;
  }

  :global(:root[data-season='christmas']) .deer__image[data-season='christmas'] {
    display: block;
  }

  /* ---- The window ----
     The square's outline, measured on the artwork: 13.72 to 346.08 across,
     0.27 to 358.8 down, corners of 72.6. */
  .deer__depth,
  .deer__wall,
  .deer__frame {
    position: absolute;
    inset: 0.075% 3.867% 0.333% 3.811%;
    border-radius: 21.84% / 20.25%;
  }

  /* 10, 0; 340 wide: the back of the window. */
  .deer__face {
    --z: calc(var(--window) * -1);
    left: 2.7778%;
    top: 0;
    width: 94.4444%;
  }

  /* Its corners and edges in shadow, as at the back of any window. */
  .deer__depth {
    --z: calc(var(--window) * -1 + 0.1cqi);
    box-shadow: inset 0 0 4cqi 0.5cqi rgb(46 14 92 / 0.38);
  }

  /* 10, 15; 340 wide: soft, so a small image stretched. */
  .deer__shade {
    --z: calc(var(--window) * -1 + 0.4cqi);
    opacity: 0.85;
    left: 2.7778%;
    top: 4.1667%;
    width: 94.4444%;
  }

  /* The walls: rings as wide as the frame, darker the deeper they are. */
  .deer__wall {
    border: var(--band) solid var(--wall);
  }

  .deer__wall[data-depth='1'] {
    --z: -0.8cqi;
    --wall: #a464e5;
  }

  .deer__wall[data-depth='2'] {
    --z: -1.6cqi;
    --wall: #9a5cdc;
  }

  .deer__wall[data-depth='3'] {
    --z: -2.4cqi;
    --wall: #9055d2;
  }

  .deer__wall[data-depth='4'] {
    --z: -3.2cqi;
    --wall: #864ec8;
  }

  .deer__wall[data-depth='5'] {
    --z: -4cqi;
    --wall: #7b46bd;
  }

  .deer__wall[data-depth='6'] {
    --z: -4.8cqi;
    --wall: #703fb2;
  }

  .deer__wall[data-depth='7'] {
    --z: -5.6cqi;
    --wall: #6538a6;
  }

  .deer__wall[data-depth='8'] {
    --z: -6.4cqi;
    --wall: #5a319a;
  }

  /* The frame: the icon's purple in a band round the opening (the band is
     the border; the mask leaves out everything inside it). Under a mouse it
     catches the light where the pointer is (--glare-x/--glare-y, motion.ts). */
  .deer__frame {
    border: var(--band) solid transparent;
    background: linear-gradient(to top right, var(--frame-from), var(--frame-to)) border-box;
    -webkit-mask:
      linear-gradient(#000 0 0) padding-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) padding-box exclude,
      linear-gradient(#000 0 0);
  }

  .deer__frame::after {
    content: '';
    position: absolute;
    inset: calc(var(--band) * -1);
    border-radius: inherit;
    background: radial-gradient(
      circle at var(--glare-x, 30%) var(--glare-y, 10%),
      rgb(255 255 255 / 0.5),
      rgb(255 255 255 / 0) 60%
    );
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  :global([data-tilting]) .deer__frame::after {
    opacity: 1;
  }

  /* ---- The deer ---- */

  /* 110, 290; 140 wide: the neck, from the back of the window to the head. */
  .deer__neck {
    left: 30.5556%;
    top: 80.5556%;
    width: 38.8889%;
  }

  .deer__neck[data-z='-6.2'] {
    --z: -6.2cqi;
  }

  .deer__neck[data-z='-5.4'] {
    --z: -5.4cqi;
  }

  .deer__neck[data-z='-4.6'] {
    --z: -4.6cqi;
  }

  .deer__neck[data-z='-3.8'] {
    --z: -3.8cqi;
  }

  .deer__neck[data-z='-3'] {
    --z: -3cqi;
  }

  .deer__neck[data-z='-2.2'] {
    --z: -2.2cqi;
  }

  .deer__neck[data-z='-1.4'] {
    --z: -1.4cqi;
  }

  .deer__neck[data-z='-0.6'] {
    --z: -0.6cqi;
  }

  .deer__neck[data-z='0.2'] {
    --z: 0.2cqi;
  }

  .deer__neck[data-z='1'] {
    --z: 1cqi;
  }

  .deer__neck[data-z='1.8'] {
    --z: 1.8cqi;
  }

  .deer__neck[data-z='2.4'] {
    --z: 2.4cqi;
  }

  /* 25, 15; 300 wide */
  .deer__antlers {
    --z: 1.5cqi;
    left: 6.9444%;
    top: 4.1667%;
    width: 83.3333%;
  }

  /* 0 and 250, 90; 110 wide. Each turns about where it meets the head, and
     sits just behind it: near enough that where it goes under the head never
     shows, far enough to part from it as the icon turns. */
  .deer__ear-left,
  .deer__ear-right {
    --z: 2.2cqi;
    top: 25%;
    width: 30.5556%;
  }

  .deer__ear-left {
    left: 0;
  }

  .deer__ear-right {
    left: 69.4444%;
  }

  .deer__ear-left .deer__part {
    transform-origin: 80% 69.6%;
  }

  .deer__ear-right .deer__part {
    transform-origin: 20% 69.6%;
  }

  /* 65, 110; 230 wide (305 tall, for the Christmas scarf) */
  .deer__head {
    --z: 3cqi;
    left: 18.0556%;
    top: 30.5556%;
    width: 63.8889%;
  }

  /* 145, 270; 70 wide. It sniffs from its middle. */
  .deer__nose {
    --z: 4.6cqi;
    left: 40.2778%;
    top: 75%;
    width: 19.4444%;
  }

  .deer__nose .deer__part {
    transform-origin: 50% 49%;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* As the section comes into view, the window opens and the deer leans
       out of it: everything starts nearly flat on the frame and moves to its
       depth as the icon turns to the reader, on the graphics card, in step
       with the scroll. Where the browser cannot, it simply rests so. */
    @supports (animation-timeline: view()) {
      .deer {
        view-timeline-name: --deer;
      }

      /* Separate properties, so the minifier cannot fold the timeline into
         the `animation` shorthand (which browsers do not accept). */
      .deer__layer {
        animation-name: deer-rise;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --deer;
        animation-range: entry 30% cover 50%;
      }

      .deer__shade {
        animation-name: deer-rise, deer-shade-in;
      }
    }

    /* Life (deer.ts sets these for the length of each). */
    :global([data-blink]) :global(.lid__skin) {
      animation: deer-blink 0.26s var(--ease-in-out);
    }

    :global([data-twitch='left']) .deer__ear-left .deer__part,
    :global([data-twitch='both']) .deer__ear-left .deer__part {
      animation: deer-twitch-left 0.7s var(--ease-out);
    }

    :global([data-twitch='right']) .deer__ear-right .deer__part,
    :global([data-twitch='both']) .deer__ear-right .deer__part {
      animation: deer-twitch-right 0.7s var(--ease-out);
    }

    :global([data-sniff]) .deer__nose .deer__part {
      animation: deer-sniff 0.8s ease-in-out;
    }
  }

  /* Not quite flat at first, so the layers never share a plane (which would
     leave their order to chance). */
  @keyframes deer-rise {
    from {
      translate: 0 0 calc(var(--z) * 0.1);
    }
  }

  @keyframes deer-shade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes deer-blink {
    45%,
    55% {
      translate: 0 0;
    }
  }

  @keyframes deer-twitch-left {
    25% {
      rotate: -11deg;
    }

    50% {
      rotate: 5deg;
    }

    75% {
      rotate: -2deg;
    }
  }

  @keyframes deer-twitch-right {
    25% {
      rotate: 11deg;
    }

    50% {
      rotate: -5deg;
    }

    75% {
      rotate: 2deg;
    }
  }

  @keyframes deer-sniff {
    20%,
    60% {
      scale: 1.07;
    }

    40%,
    80% {
      scale: 1;
    }
  }
</style>
