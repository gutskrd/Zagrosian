---
/**
 * Hevalo's deer in 3D, for the products section (ProductShowcase.astro). The
 * app icon is taken apart into its layers (scripts/deer-layers.cjs), each held
 * at its own depth above the purple face: the shade it casts, the antlers, the
 * ears, the head with its eyes, the nose. Inside the showcase's 3D tile they
 * part as the tile turns, so the deer stands out of its icon as a relief does.
 * (The layers only ever move together, with the tile: turned on its own, a
 * part this wide would swing back through the face.)
 *
 * It is alive, never busy: it blinks, now and then twitches an ear or sniffs,
 * and answers a tap or click with all three (src/scripts/deer.ts). Its eyes
 * follow the pointer (src/scripts/eyes.ts). None of this moves when the
 * visitor prefers reduced motion.
 *
 * Like the flat icon (HevaloIcon.astro), it comes in two seasons, and only the
 * one in season is downloaded (the images are lazy). Depths are in `cqi`, so
 * it must sit in an inline-size container (the showcase's art).
 */
import type { ImageMetadata } from 'astro';
import HevaloEyes from './HevaloEyes.astro';

interface Props {
  /** The deer's rendered width, widest screens first, e.g. [['(min-width: 64rem)', 21], [null, 14]] (rem). */
  widths: [string | null, number][];
}

const { widths } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/brand/deer/*.webp', { eager: true });
const image = (name: string) => {
  const file = files[`../assets/brand/deer/${name}.webp`];
  if (!file) throw new Error(`Missing deer layer ${name}`);
  return file.default;
};

/** Each layer's width, as a fraction of the deer's (from its box in deer-layers.cjs). */
const layers = {
  face: { width: 330 / 360, frames: [288, 576] },
  shade: { width: 330 / 360, frames: [144] },
  antlers: { width: 300 / 360, frames: [288, 576] },
  'ear-left': { width: 110 / 360, frames: [288, 576] },
  'ear-right': { width: 110 / 360, frames: [288, 576] },
  head: { width: 230 / 360, frames: [288, 576] },
  nose: { width: 70 / 360, frames: [288, 576] },
} as const;

type Layer = keyof typeof layers;

const seasons = [
  { season: 'everyday', prefix: 'hevalo' },
  { season: 'christmas', prefix: 'hevalo-christmas' },
];

const images = (layer: Layer) => {
  const { width, frames } = layers[layer];
  const sizes = widths.map(([query, rem]) => `${query ? `${query} ` : ''}${(rem * width).toFixed(2)}rem`).join(', ');
  return seasons.map(({ season, prefix }) => {
    const set = frames.map((frame) => image(`${prefix}-${layer}-${frame}`));
    const fallback = set[set.length - 1];
    return {
      season,
      attributes: {
        src: fallback.src,
        srcset: set.map((file) => `${file.src} ${file.width}w`).join(', '),
        sizes,
        width: fallback.width,
        height: fallback.height,
      },
    };
  });
};
---

<span class="deer" data-deer data-hevalo-eyes>
  {
    (['face', 'shade', 'antlers', 'ear-left', 'ear-right', 'head', 'nose'] as const).map((layer) => (
      <span class:list={['deer__layer', `deer__${layer}`]}>
        <span class="deer__part">
          {images(layer).map((img) => (
            <img class="deer__image" data-season={img.season} {...img.attributes} alt="" loading="lazy" decoding="async" draggable="false" />
          ))}
          {layer === 'head' && <HevaloEyes frame="head" lids />}
        </span>
      </span>
    ))
  }
</span>

<style>
  .deer {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* Each layer at its place in the 360 px square of the icon (the boxes from
     deer-layers.cjs), and at its depth above the face. */
  .deer__layer {
    position: absolute;
    display: block;
    translate: 0 0 var(--z);
  }

  .deer__part {
    position: relative;
    display: block;
  }

  .deer__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .deer__image[data-season='christmas'] {
    display: none;
  }

  :global(:root[data-season='christmas']) .deer__image[data-season='everyday'] {
    display: none;
  }

  :global(:root[data-season='christmas']) .deer__image[data-season='christmas'] {
    display: block;
  }

  /* 15, 0; 330 wide */
  .deer__face {
    --z: 0px;
    left: 4.1667%;
    top: 0;
    width: 91.6667%;
  }

  /* 15, 15; 330 wide: soft, so a small image stretched */
  .deer__shade {
    --z: 0.6cqi;
    opacity: 0.85;
    left: 4.1667%;
    top: 4.1667%;
    width: 91.6667%;
  }

  /* 25, 15; 300 wide */
  .deer__antlers {
    --z: 2.6cqi;
    left: 6.9444%;
    top: 4.1667%;
    width: 83.3333%;
  }

  /* 0 and 250, 90; 110 wide. Each turns about where it meets the head. */
  .deer__ear-left,
  .deer__ear-right {
    --z: 3.6cqi;
    top: 25%;
    width: 30.5556%;
  }

  .deer__ear-left {
    left: 0;
  }

  .deer__ear-right {
    left: 69.4444%;
  }

  .deer__ear-left .deer__part {
    transform-origin: 80% 69.6%;
  }

  .deer__ear-right .deer__part {
    transform-origin: 20% 69.6%;
  }

  /* 65, 110; 230 wide (305 tall, for the Christmas scarf) */
  .deer__head {
    --z: 5cqi;
    left: 18.0556%;
    top: 30.5556%;
    width: 63.8889%;
  }

  /* 145, 270; 70 wide. It sniffs from its middle. */
  .deer__nose {
    --z: 6.6cqi;
    left: 40.2778%;
    top: 75%;
    width: 19.4444%;
  }

  .deer__nose .deer__part {
    transform-origin: 50% 49%;
  }

  @media (forced-colors: active) {
    .deer__shade {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* As the section comes into view, the deer rises out of its icon: the
       layers start flat on the face and part as the tile turns to the reader,
       on the graphics card, in step with the scroll. Where the browser cannot,
       they simply rest apart. */
    @supports (animation-timeline: view()) {
      .deer {
        view-timeline-name: --deer;
      }

      /* Separate properties, so the minifier cannot fold the timeline into
         the `animation` shorthand (which browsers do not accept). */
      .deer__layer:not(.deer__face) {
        animation-name: deer-rise;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --deer;
        animation-range: entry 30% cover 50%;
      }

      .deer__shade {
        animation-name: deer-rise, deer-shade-in;
      }
    }

    /* Life (deer.ts sets these for the length of each). */
    :global([data-blink]) :global(.lid__skin) {
      animation: deer-blink 0.26s var(--ease-in-out);
    }

    :global([data-twitch='left']) .deer__ear-left .deer__part,
    :global([data-twitch='both']) .deer__ear-left .deer__part {
      animation: deer-twitch-left 0.7s var(--ease-out);
    }

    :global([data-twitch='right']) .deer__ear-right .deer__part,
    :global([data-twitch='both']) .deer__ear-right .deer__part {
      animation: deer-twitch-right 0.7s var(--ease-out);
    }

    :global([data-sniff]) .deer__nose .deer__part {
      animation: deer-sniff 0.8s ease-in-out;
    }
  }

  /* Not quite flat at first, so the layers never share a plane (which would
     leave their order to chance). */
  @keyframes deer-rise {
    from {
      translate: 0 0 calc(var(--z) * 0.1);
    }
  }

  @keyframes deer-shade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes deer-blink {
    45%,
    55% {
      translate: 0 0;
    }
  }

  @keyframes deer-twitch-left {
    25% {
      rotate: -11deg;
    }

    50% {
      rotate: 5deg;
    }

    75% {
      rotate: -2deg;
    }
  }

  @keyframes deer-twitch-right {
    25% {
      rotate: 11deg;
    }

    50% {
      rotate: -5deg;
    }

    75% {
      rotate: 2deg;
    }
  }

  @keyframes deer-sniff {
    20%,
    60% {
      scale: 1.07;
    }

    40%,
    80% {
      scale: 1;
    }
  }
</style>
