---
/**
 * Hevalo's app icon as a hole in the page, and the deer coming out of it from
 * behind the page, for the products section (ProductShowcase.astro). The page
 * is cut in the icon's shape; through it is the purple space behind the page.
 *
 * As the section scrolls into view, the deer comes up from deep in that space,
 * small and hazed with its purple, its ears laid back, and pushes forward
 * through the hole until its head is out in front of the page: there its ears
 * spring up, it casts its shade on the page round the hole, and it comes to
 * rest as the icon has it, its neck going back into the hole. Scrolling back
 * takes it back in.
 *
 * Behind the page it is clipped by the hole; in front, it is not. Each part
 * goes from one to the other (two copies, one in the hole and one in front,
 * the one swapped for the other) at the moment it crosses the page, when it is
 * well inside the hole, so the swap cannot be seen and nothing is ever cut by
 * the hole's edge: the ears lie back to pass through and only open out once
 * they are in front. Everything that moves is scaled, moved, turned or faded
 * on the graphics card in step with the scroll (no script, no 3D scene, no
 * masks), so it stays smooth on any device, scrolling down or up. The deer is
 * taken apart for this by scripts/deer-layers.cjs.
 *
 * It is alive, never busy: it blinks, now and then twitches an ear or sniffs,
 * and answers a tap or click with all three (src/scripts/deer.ts). Its eyes
 * follow the pointer (src/scripts/eyes.ts). With reduced motion, or where the
 * browser cannot tie animation to the scroll, it is simply out of its hole.
 *
 * Like the flat icon (HevaloIcon.astro), it comes in two seasons, and only the
 * one in season is downloaded (the images are lazy). Sizes are in `cqi`, so it
 * must sit in an inline-size container (the showcase's art).
 */
import type { ImageMetadata } from 'astro';
import HevaloEyes from './HevaloEyes.astro';

interface Props {
  /** The icon's rendered width, widest screens first, e.g. [['(min-width: 64rem)', 21], [null, 14]] (rem). */
  widths: [string | null, number][];
}

const { widths } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/brand/deer/*.webp', { eager: true });
const image = (name: string) => {
  const file = files[`../assets/brand/deer/${name}.webp`];
  if (!file) throw new Error(`Missing deer layer ${name}`);
  return file.default;
};

/** Each layer's width, as a fraction of the icon's (from its box in deer-layers.cjs), and its seasons. */
const layers = {
  snow: { width: 330 / 360, frames: [288, 576], seasons: ['christmas'] },
  shade: { width: 360 / 360, frames: [144], seasons: ['everyday', 'christmas'] },
  neck: { width: 150 / 360, frames: [288, 576], seasons: ['shared'] },
  antlers: { width: 300 / 360, frames: [288, 576], seasons: ['everyday', 'christmas'] },
  'ear-left': { width: 110 / 360, frames: [288, 576], seasons: ['everyday', 'christmas'] },
  'ear-right': { width: 110 / 360, frames: [288, 576], seasons: ['everyday', 'christmas'] },
  head: { width: 230 / 360, frames: [288, 576], seasons: ['everyday', 'christmas'] },
  nose: { width: 70 / 360, frames: [288, 576], seasons: ['everyday', 'christmas'] },
} as const;

type Layer = keyof typeof layers;

const prefixes: Record<string, string> = { everyday: 'hevalo', christmas: 'hevalo-christmas', shared: 'hevalo' };

/** A layer's images: one per season (the neck serves both). */
const images = (layer: Layer) => {
  const { width, frames, seasons } = layers[layer];
  const sizes = widths.map(([query, rem]) => `${query ? `${query} ` : ''}${(rem * width).toFixed(2)}rem`).join(', ');
  return seasons.map((season) => {
    const set = frames.map((frame) => image(`${prefixes[season]}-${layer}-${frame}`));
    const fallback = set[set.length - 1];
    return {
      season: season === 'shared' ? undefined : season,
      attributes: {
        src: fallback.src,
        srcset: set.map((file) => `${file.src} ${file.width}w`).join(', '),
        sizes,
        width: fallback.width,
        height: fallback.height,
      },
    };
  });
};

/** The parts that come out, back to front. */
const parts = ['antlers', 'ear-left', 'ear-right', 'head', 'nose'] as const;
---

<span class="deer" data-deer data-hevalo-eyes>
  <span class="deer__glow"></span>

  {/* The hole: the purple space behind the page, and the deer while it is behind the page. */}
  <span class="deer__hole">
    <span class="deer__back">
      {
        images('snow').map((img) => (
          <img class="deer__image deer__snow" data-season={img.season} {...img.attributes} alt="" loading="lazy" decoding="async" draggable="false" />
        ))
      }
    </span>
    <span class="deer__body deer__body--neck">
      <span class="deer__layer deer__neck">
        {
          images('neck').map((img) => (
            <img class="deer__image" {...img.attributes} alt="" loading="lazy" decoding="async" draggable="false" />
          ))
        }
      </span>
    </span>
    <span class="deer__body deer__body--behind">
      {
        parts.map((layer) => (
          <span class:list={['deer__layer', `deer__${layer}`]}>
            <span class="deer__part">
              {images(layer).map((img) => (
                <img class="deer__image" data-season={img.season} {...img.attributes} alt="" loading="lazy" decoding="async" draggable="false" />
              ))}
              {layer === 'head' && <HevaloEyes frame="head" lids />}
            </span>
          </span>
        ))
      }
    </span>
    <span class="deer__veil"></span>
  </span>
  <span class="deer__rim"></span>

  {/* In front of the page: the deer's shade on it, and the deer. */}
  <span class="deer__body deer__body--shade">
    <span class="deer__shade">
      {
        images('shade').map((img) => (
          <img class="deer__image" data-season={img.season} {...img.attributes} alt="" loading="lazy" decoding="async" draggable="false" />
        ))
      }
    </span>
  </span>
  <span class="deer__body deer__body--front">
    {
      parts.map((layer) => (
        <span class:list={['deer__layer', `deer__${layer}`]}>
          <span class="deer__part">
            {images(layer).map((img) => (
              <img class="deer__image" data-season={img.season} {...img.attributes} alt="" loading="lazy" decoding="async" draggable="false" />
            ))}
            {layer === 'head' && <HevaloEyes frame="head" lids />}
          </span>
        </span>
      ))
    }
  </span>
</span>

<style>
  .deer {
    /* Which way the reader's eye is across, as the section is laid out: in
       the middle on narrow screens; on wide ones the icon is to the right of
       the middle (to the left, right to left). The purple far behind slides
       a little towards it. */
    --look: 0;
    /* The purple behind the page: the icon's own, light at the bottom left. */
    --purple-from: #db7df5;
    --purple-to: #9a6cf1;
    --purple-haze: #b775f3;

    position: absolute;
    inset: 0;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    /* It is artwork: forced colours keep its colours. */
    forced-color-adjust: none;
  }

  @media (min-width: 64rem) {
    .deer {
      --look: -1;
    }

    :global([dir='rtl']) .deer {
      --look: 1;
    }
  }

  :global(:root[data-season='christmas']) .deer {
    --purple-from: #d779f2;
    --purple-to: #9569ec;
    --purple-haze: #b271ef;
  }

  .deer__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .deer__image[data-season='christmas'] {
    display: none;
  }

  :global(:root[data-season='christmas']) .deer__image[data-season='everyday'] {
    display: none;
  }

  :global(:root[data-season='christmas']) .deer__image[data-season='christmas'] {
    display: block;
  }

  /* A little of the purple's light on the page round the hole. */
  .deer__glow {
    position: absolute;
    inset: -22%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(176 112 242 / 0.16), rgb(176 112 242 / 0));
  }

  /* ---- The hole ----
     The icon's outline, measured on the artwork: 13.72 to 346.08 across, 0.27
     to 358.8 down (of 360), corners of 72.6. Everything in it is behind the
     page, so it is clipped to it. */
  .deer__hole,
  .deer__rim {
    position: absolute;
    inset: 0.075% 3.867% 0.333% 3.811%;
    border-radius: 20.167cqi;
  }

  .deer__hole {
    overflow: clip;
  }

  /* Its cut edge: the page's edge throws a shade inside the hole, deepest
     under its top edge, where the light comes from. It falls on the deer too,
     while it is behind the page. */
  .deer__rim {
    box-shadow:
      inset 0 1.4cqi 3cqi rgb(28 6 58 / 0.32),
      inset 0 0 0 0.35cqi rgb(28 6 58 / 0.08);
  }

  /* Far behind the page, the purple, larger than the hole so that it fills it
     however far it slides. */
  .deer__back {
    --dx: calc(var(--look) * 2.5cqi);
    --dy: 7cqi;

    position: absolute;
    inset: -14cqi;
    translate: var(--dx) calc(var(--dy) * -0.3);
    background:
      radial-gradient(closest-side, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0)),
      linear-gradient(to top right, var(--purple-from) 12%, var(--purple-to) 88%);
  }

  /* 15, 0; 330 wide, within it. */
  .deer__snow {
    position: absolute;
    left: 11.93%;
    top: 10.91%;
    width: 76.18%;
  }

  /* The haze of that space, over the deer while it is far in it. */
  .deer__veil {
    position: absolute;
    inset: 0;
    background: var(--purple-haze);
    opacity: 0;
  }

  /* ---- The deer ----
     Each copy of the deer is drawn in the icon's square (inside the hole,
     offset by the hole's own inset), and moves in depth as one about its
     middle. At rest it is in front of the page, as the icon has it. */
  .deer__body {
    position: absolute;
    left: 0;
    top: 0;
    width: 100cqi;
    height: 100cqi;
    transform-origin: 50% 50%;
  }

  .deer__hole > .deer__body {
    left: -3.811cqi;
    top: -0.075cqi;
  }

  .deer__body--behind {
    opacity: 0;
  }

  .deer__layer {
    position: absolute;
    display: block;
  }

  .deer__part {
    position: relative;
    display: block;
  }

  /* Each part at its place in the icon's 360 px square (the boxes from
     deer-layers.cjs). */

  /* 105, 290; 150 wide, going back into the hole, below its edge. */
  .deer__neck {
    left: 29.1667%;
    top: 80.5556%;
    width: 41.6667%;
  }

  /* 0, 15; 360 wide: its shade, on the page and in the hole. */
  .deer__shade {
    position: absolute;
    left: 0;
    top: 4.1667%;
    width: 100%;
  }

  :global(:root[data-theme='dark']) .deer__shade {
    opacity: 0.7;
  }

  /* 25, 15; 300 wide */
  .deer__antlers {
    left: 6.9444%;
    top: 4.1667%;
    width: 83.3333%;
  }

  /* 0 and 250, 90; 110 wide. Each turns about where it meets the head. */
  .deer__ear-left,
  .deer__ear-right {
    top: 25%;
    width: 30.5556%;
  }

  .deer__ear-left {
    left: 0;
  }

  .deer__ear-right {
    left: 69.4444%;
  }

  .deer__ear-left,
  .deer__ear-left .deer__part {
    transform-origin: 80% 69.6%;
  }

  .deer__ear-right,
  .deer__ear-right .deer__part {
    transform-origin: 20% 69.6%;
  }

  /* 65, 110; 230 wide (305 tall, for the Christmas scarf) */
  .deer__head {
    left: 18.0556%;
    top: 30.5556%;
    width: 63.8889%;
  }

  /* 145, 270; 70 wide. It sniffs from its middle. */
  .deer__nose {
    left: 40.2778%;
    top: 75%;
    width: 19.4444%;
  }

  .deer__nose .deer__part {
    transform-origin: 50% 49%;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Coming out, from when the icon is part way into the screen until it is
       just past the middle. Separate properties, so the minifier cannot fold
       the timeline into the `animation` shorthand (which browsers do not
       accept). */
    @supports (animation-timeline: view()) {
      .deer {
        view-timeline-name: --deer;
      }

      .deer__back,
      .deer__body,
      .deer__veil,
      .deer__ear-left,
      .deer__ear-right {
        animation-fill-mode: both;
        animation-timeline: --deer;
        animation-range: entry 40% cover 55%;
      }

      /* The purple slides across the icon's whole way over the screen. */
      .deer__back {
        animation-name: deer-back;
        animation-timing-function: linear;
        animation-range: cover 0% cover 100%;
      }

      .deer__body {
        animation-name: deer-depth;
        animation-timing-function: cubic-bezier(0.4, 0.05, 0.25, 1);
      }

      .deer__body--behind,
      .deer__body--front,
      .deer__body--shade {
        animation-timing-function: cubic-bezier(0.4, 0.05, 0.25, 1), linear;
      }

      .deer__body--behind {
        animation-name: deer-depth, deer-behind;
      }

      .deer__body--front {
        animation-name: deer-depth, deer-front;
      }

      .deer__body--shade {
        animation-name: deer-depth, deer-shade;
      }

      .deer__veil {
        animation-name: deer-veil;
        animation-timing-function: linear;
      }

      .deer__ear-left,
      .deer__ear-right {
        animation-timing-function: linear;
      }

      .deer__ear-left {
        animation-name: deer-ear-left;
      }

      .deer__ear-right {
        animation-name: deer-ear-right;
      }
    }

    /* Life (deer.ts sets these for the length of each). */
    :global([data-blink]) :global(.lid__skin) {
      animation: deer-blink 0.26s var(--ease-in-out);
    }

    :global([data-twitch='left']) .deer__ear-left .deer__part,
    :global([data-twitch='both']) .deer__ear-left .deer__part {
      animation: deer-twitch-left 0.7s var(--ease-out);
    }

    :global([data-twitch='right']) .deer__ear-right .deer__part,
    :global([data-twitch='both']) .deer__ear-right .deer__part {
      animation: deer-twitch-right 0.7s var(--ease-out);
    }

    :global([data-sniff]) .deer__nose .deer__part {
      animation: deer-sniff 0.8s ease-in-out;
    }
  }

  /* As the icon crosses the screen, the purple far behind slides, from as
     seen from above (the icon low on the screen) to as seen from below. */
  @keyframes deer-back {
    from {
      translate: var(--dx) calc(var(--dy) * -1);
    }

    to {
      translate: var(--dx) var(--dy);
    }
  }

  /* From deep in the hole (smaller, a little lower) to in front of the page.
     It crosses the page at 70% of its size, 35.34% of the way, where every
     part is well inside the hole (checked against the artwork). */
  @keyframes deer-depth {
    from {
      scale: 0.42;
      translate: 0 6cqi;
    }

    to {
      scale: 1;
      translate: 0 0;
    }
  }

  /* At the crossing, the copy in the hole gives way to the copy in front. */
  @keyframes deer-behind {
    0%,
    35.3% {
      opacity: 1;
    }

    35.34%,
    100% {
      opacity: 0;
    }
  }

  @keyframes deer-front {
    0%,
    35.3% {
      opacity: 0;
    }

    35.34%,
    100% {
      opacity: 1;
    }
  }

  /* Its shade comes onto the page as it comes out. */
  @keyframes deer-shade {
    0%,
    35.34% {
      opacity: 0;
    }

    62%,
    100% {
      opacity: 1;
    }
  }

  /* The haze clears as it nears the page. */
  @keyframes deer-veil {
    0% {
      opacity: 0.6;
    }

    18% {
      opacity: 0.32;
    }

    35.34%,
    100% {
      opacity: 0;
    }
  }

  /* Laid back to pass through; out in front, they spring up, past where
     they rest, and settle. */
  @keyframes deer-ear-left {
    0%,
    35.34% {
      rotate: -22deg;
      scale: 0.88;
    }

    47% {
      rotate: 8deg;
      scale: 1.04;
    }

    58% {
      rotate: -2deg;
      scale: 1;
    }

    66%,
    100% {
      rotate: 0deg;
      scale: 1;
    }
  }

  @keyframes deer-ear-right {
    0%,
    35.34% {
      rotate: 22deg;
      scale: 0.88;
    }

    47% {
      rotate: -8deg;
      scale: 1.04;
    }

    58% {
      rotate: 2deg;
      scale: 1;
    }

    66%,
    100% {
      rotate: 0deg;
      scale: 1;
    }
  }

  @keyframes deer-blink {
    45%,
    55% {
      translate: 0 0;
    }
  }

  @keyframes deer-twitch-left {
    25% {
      rotate: -11deg;
    }

    50% {
      rotate: 5deg;
    }

    75% {
      rotate: -2deg;
    }
  }

  @keyframes deer-twitch-right {
    25% {
      rotate: 11deg;
    }

    50% {
      rotate: -5deg;
    }

    75% {
      rotate: 2deg;
    }
  }

  @keyframes deer-sniff {
    20%,
    60% {
      scale: 1.07;
    }

    40%,
    80% {
      scale: 1;
    }
  }
</style>
