---
/**
 * Language menu in the header: a button with the world icon (and, on wider
 * screens, the language code) that opens a popover listing every language,
 * each linking to the same page in that language. Uses the Popover
 * API, so it opens, closes on Escape or an outside click, and returns focus
 * without any JavaScript.
 */
import { i18n, localizePath, locales } from '../i18n';
import Globe from './Globe.astro';

const { locale, info, t, base } = i18n(Astro.url);

// The button shows the language code (DE); its accessible name also gives the
// language in full, and includes the visible code for voice control users.
const buttonLabel = `${t.language.label}: ${info.name} (${locale.toUpperCase()})`;
---

<div class="language">
  <button class="language__button" type="button" popovertarget="language-menu" aria-label={buttonLabel}>
    <Globe class="language__icon" />
    <span class="language__code" aria-hidden="true">{locale.toUpperCase()}</span>
  </button>

  <nav id="language-menu" class="language__menu" popover aria-label={t.language.label}>
    <ul class="language__list">
      {
        locales.map(({ code, name, dir }) => (
          <li>
            <a
              class="language__link"
              href={localizePath(code, base)}
              hreflang={code}
              lang={code}
              aria-current={code === locale ? 'true' : undefined}
            >
              {/* The name keeps its own direction, but every name starts at the
                  menu's edge, so the list reads as one aligned column. */}
              <span dir={dir}>{name}</span>
              {code === locale && (
                <svg class="language__check" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <path d="M3.5 8.5l3 3 6-7" />
                </svg>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  .language__button {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2.5rem;
    padding: 0 0.75rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    color: var(--color-ink-soft);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  @media (hover: hover) {
    .language__button:hover {
      border-color: var(--color-line-strong);
      color: var(--color-ink);
    }
  }

  .language__button :global(.language__icon) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .language__code {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  /* On phones, the world icon alone, in a circle like the other controls. */
  @media (max-width: 47.99rem) {
    .language__button {
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
    }

    .language__code {
      display: none;
    }
  }

  /* The menu drops down from the header, aligned with its end edge. */
  .language__menu {
    position: fixed;
    inset: auto;
    inset-block-start: calc(var(--header-height) + 0.25rem);
    inset-inline-end: var(--gutter);
    width: min(16rem, calc(100vw - 2 * var(--gutter)));
    margin: 0;
    padding: 0.375rem;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 12px 32px rgb(0 0 0 / 0.12);
    opacity: 0;
    transform: translateY(-0.375rem) scale(0.98);
    transform-origin: top right;
    transition:
      opacity 0.2s ease,
      transform 0.25s var(--ease-out),
      overlay 0.25s allow-discrete,
      display 0.25s allow-discrete;
  }

  :global([dir='rtl']) .language__menu {
    transform-origin: top left;
  }

  .language__menu:popover-open {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .language__menu:popover-open {
      opacity: 0;
      transform: translateY(-0.375rem) scale(0.98);
    }
  }

  .language__list {
    display: grid;
  }

  .language__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    border-radius: 0.625rem;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .language__link:hover,
  .language__link:focus-visible {
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .language__link[aria-current] {
    color: var(--color-ink);
    font-weight: 500;
  }

  .language__check {
    flex: none;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  :global([data-theme='dark']) .language__menu {
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.5);
  }
</style>
