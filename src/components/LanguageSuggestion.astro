---
/**
 * A small note offering this page in the visitor's own language, when their
 * browser prefers one of the site's other languages. It never redirects. The
 * text for every language is in the page, written in that language; the script
 * (src/scripts/language.ts) shows the matching one, and remembers a dismissal.
 */
import { i18n, localizePath, locales, messages } from '../i18n';

const { locale, base } = i18n(Astro.url);
const others = locales.filter(({ code }) => code !== locale);
---

<aside class="suggest" data-language-suggestion hidden>
  {
    others.map(({ code, dir }) => {
      const m = messages(code);
      return (
        <div class="suggest__card" data-locale={code} lang={code} dir={dir} hidden>
          <p class="suggest__text">{m.language.suggestion}</p>
          <a class="suggest__link" href={localizePath(code, base)} hreflang={code} data-language-link>
            {m.language.switchTo}
          </a>
          <button class="suggest__close" type="button" data-language-suggestion-dismiss aria-label={m.language.dismiss}>
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M4 4l8 8M12 4l-8 8" />
            </svg>
          </button>
        </div>
      );
    })
  }
</aside>

<style>
  .suggest {
    position: fixed;
    inset-block-end: max(var(--gutter), env(safe-area-inset-bottom));
    inset-inline-end: var(--gutter);
    z-index: 60;
    width: min(22rem, calc(100vw - 2 * var(--gutter)));
    /* It slides up from below the edge of the screen rather than fading in,
       so its text is never shown at reduced contrast. */
    transform: translateY(calc(100% + 2 * var(--gutter)));
    transition: transform 0.7s var(--ease-out);
  }

  .suggest[data-visible] {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .suggest {
      transition: none;
    }
  }

  .suggest__card {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: 0.75rem 1rem;
    padding: 1.125rem;
    padding-inline-start: 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 16px 40px rgb(0 0 0 / 0.14);
  }

  .suggest__text {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-ink-soft);
  }

  .suggest__link {
    grid-column: 1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }

  .suggest__close {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-block-start: -0.5rem;
    margin-inline-end: -0.5rem;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-muted);
    cursor: pointer;
  }

  .suggest__close:hover {
    color: var(--color-ink);
  }

  .suggest__close svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  :global([data-theme='dark']) .suggest__card {
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.5);
  }
</style>
