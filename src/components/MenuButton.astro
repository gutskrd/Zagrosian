---
/**
 * The menu button: two dots beside a label, nothing around them.
 *
 * - Hover: the dots flip across to each other's side, and the label rolls
 *   with them.
 * - Open: the dots stretch into an X; the menu (SiteMenu.astro) has its own
 *   button, in the same place, that shows the X and closes it, and it takes
 *   focus when the menu opens. Closing turns the X back into the dots.
 *
 * It uses the Popover API, so it works without JavaScript. On narrow phones
 * only the dots show; the label stays as the button's name.
 */
import { i18n } from '../i18n';
import RollText from './RollText.astro';

interface Props {
  /** `open` in the header; `close` inside the menu. */
  action?: 'open' | 'close';
}

const { action = 'open' } = Astro.props;
const { t } = i18n(Astro.url);
---

<button
  class:list={['menu-button', `menu-button--${action}`]}
  type="button"
  popovertarget="site-menu"
  popovertargetaction={action === 'close' ? 'hide' : 'show'}
  aria-controls="site-menu"
  autofocus={action === 'close'}
>
  <span class="menu-button__label"><RollText text={action === 'close' ? t.common.close : t.common.menu} /></span>
  <span class="menu-button__icon" aria-hidden="true">
    <span class="menu-button__dot"></span>
    <span class="menu-button__dot"></span>
  </span>
</button>

<style>
  .menu-button {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
  }

  /* The two dots, side by side, in a small square they turn within. */
  .menu-button__icon {
    position: relative;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    transition: rotate 0.7s var(--ease-spring);
  }

  .menu-button__dot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: currentColor;
    translate: calc(-50% - 5px) -50%;
    transition:
      width 0.45s var(--ease-out),
      height 0.45s var(--ease-out),
      translate 0.45s var(--ease-out),
      rotate 0.6s var(--ease-spring);
  }

  .menu-button__dot + .menu-button__dot {
    translate: calc(-50% + 5px) -50%;
  }

  /* Hover: the pair turns half a circle, so each dot flips to the other side. */
  @media (hover: hover) {
    .menu-button:hover .menu-button__icon {
      rotate: 180deg;
    }
  }

  .menu-button:focus-visible .menu-button__icon {
    rotate: 180deg;
  }

  /* Open: the dots meet in the middle and stretch into an X. This is the
     menu's own button, and the header's underneath it, which turns back
     into dots as the menu lifts. */
  .menu-button--close .menu-button__dot,
  :global(.site-header:has(.site-menu:popover-open)) .menu-button--open .menu-button__dot {
    width: 20px;
    height: 2px;
    border-radius: 1px;
    translate: -50% -50%;
    rotate: 45deg;
  }

  .menu-button--close .menu-button__dot + .menu-button__dot,
  :global(.site-header:has(.site-menu:popover-open)) .menu-button--open .menu-button__dot + .menu-button__dot {
    rotate: -45deg;
  }

  /* The X turns a quarter under the pointer. */
  @media (hover: hover) {
    .menu-button--close:hover .menu-button__icon {
      rotate: 90deg;
    }
  }

  .menu-button--close:focus-visible .menu-button__icon {
    rotate: 90deg;
  }

  /* The menu's button arrives as two dots, then becomes the X, a moment
     after the menu starts to drop. */
  .menu-button--close .menu-button__dot {
    transition-delay: 0.2s;
  }

  @starting-style {
    .menu-button--close .menu-button__dot {
      width: 6px;
      height: 6px;
      border-radius: 3px;
      translate: calc(-50% - 5px) -50%;
      rotate: 0deg;
    }

    .menu-button--close .menu-button__dot + .menu-button__dot {
      translate: calc(-50% + 5px) -50%;
    }
  }

  /* The header's button turns back into dots as the menu lifts away. */
  .menu-button--open .menu-button__dot {
    transition-delay: 0.25s;
  }

  .menu-button:active .menu-button__icon {
    scale: 0.85;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-button__icon,
    .menu-button__dot {
      transition: none;
    }
  }

  /* On narrow phones, the dots alone. */
  @media (max-width: 29.99rem) {
    .menu-button__label :global(.roll__track) {
      display: none;
    }

    .menu-button {
      gap: 0;
    }
  }
</style>
