---
/**
 * The download of Hevalo's book: the PDF, saved under its own name. As the
 * main action, a pill with its facts under it ("PDF · 2.6 MB · 192 pages"),
 * and under them, in an app's own browser, how to get it there (`inApp`); in
 * the reader's bar and its contents menu, a small button, and on a phone's
 * bar a round one with only its icon.
 *
 * A plain link with `download`, so it works without JavaScript; the server
 * sends the file as an attachment too, for browsers that ignore the
 * attribute, and as plain bytes rather than as a PDF, so a browser that can
 * show a PDF itself saves this one instead of opening it (public/_headers).
 */
import { format, i18n } from '../i18n';
import { pageCountText, pdfSize } from '../lib/book';
import { book } from '../site';
import Cta from './Cta.astro';

interface Props {
  variant?: 'pill' | 'small' | 'icon';
  /** Under the pill: the line for apps' own browsers, which often cannot download (shown by book.ts). */
  inApp?: boolean;
  class?: string;
}

const { variant = 'pill', inApp = false, class: className } = Astro.props;
const { locale, t } = i18n(Astro.url);
const facts = format(t.book.facts, { size: pdfSize(locale), pages: pageCountText(locale) });
---

{
  variant === 'pill' ? (
    <div class:list={['book-download', className]}>
      <Cta href={book.pdf} download={book.fileName} type="application/pdf" arrow="down" label={t.book.download} data-book-download />
      <p class="book-download__facts">{facts}</p>
      {inApp && (
        <p class="book-download__inapp" data-book-inapp hidden>
          {t.book.inAppHint}
        </p>
      )}
    </div>
  ) : variant === 'icon' ? (
    <a class:list={['book-download__icon', className]} href={book.pdf} download={book.fileName} type="application/pdf" data-book-download>
      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path d="M10 3v10M5.5 8.75 10 13.25l4.5-4.5M4 16.5h12" />
      </svg>
      <span class="visually-hidden">
        {t.book.download} ({facts})
      </span>
    </a>
  ) : (
    <a class:list={['book-download__small', className]} href={book.pdf} download={book.fileName} type="application/pdf" data-book-download>
      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path d="M10 3v10M5.5 8.75 10 13.25l4.5-4.5M4 16.5h12" />
      </svg>
      <span>{t.book.downloadShort}</span>
      <span class="visually-hidden">({facts})</span>
    </a>
  )
}

<style>
  .book-download {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }

  .book-download__facts {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .book-download__small {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.2s ease;
  }

  @media (hover: hover) {
    .book-download__small:hover {
      border-color: var(--color-ink);
    }
  }

  .book-download__inapp {
    max-width: 22rem;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .book-download__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    color: var(--color-ink);
    transition: border-color 0.2s ease;
  }

  @media (hover: hover) {
    .book-download__icon:hover {
      border-color: var(--color-ink);
    }
  }

  .book-download__icon svg,
  .book-download__small svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
