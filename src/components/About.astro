---
import { hevalo, site } from '../site';

const basedIn = site.country.charAt(0).toUpperCase() + site.country.slice(1);
---

<section id="about" class="about section" aria-labelledby="about-title">
  <div class="container about__grid">
    <p class="eyebrow" data-reveal>About</p>

    <div class="about__body" data-reveal>
      <h2 id="about-title" class="about__statement">An independent technology company with Kurdish&nbsp;roots.</h2>
      <p class="about__text lead">
        {site.name} takes its name from the Zagros mountains. We are privately owned, based in {site.country}, and
        we design, build and operate our products ourselves.
      </p>

      <dl class="about__facts">
        <div>
          <dt>Based in</dt>
          <dd>{basedIn}</dd>
        </div>
        <div>
          <dt>Products</dt>
          <dd><a href={hevalo.url}>{hevalo.name}</a></dd>
        </div>
        <div>
          <dt>Contact</dt>
          <dd><a href={`mailto:${site.emails.contact}`}>{site.emails.contact}</a></dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--color-surface);
  }

  .about__grid {
    display: grid;
    gap: 1.25rem;
  }

  .about__statement {
    max-width: 17ch;
    font-size: var(--text-h2);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .about__text {
    max-width: 36rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .about__facts {
    display: grid;
    gap: 1.25rem;
    margin: clamp(3rem, 2rem + 3vw, 5rem) 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line-strong);
    font-size: var(--text-sm);
  }

  .about__facts dt {
    color: var(--color-muted);
  }

  .about__facts dd {
    margin: 0.25rem 0 0;
    overflow-wrap: anywhere;
  }

  .about__facts a {
    text-decoration-color: var(--color-underline);
    transition: text-decoration-color 0.2s ease;
  }

  .about__facts a:hover {
    text-decoration-color: currentColor;
  }

  @media (min-width: 48rem) {
    .about__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }

  @media (min-width: 64rem) {
    .about__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
    }

    .about__grid > .eyebrow {
      grid-column: 1 / span 3;
      padding-top: 0.6rem;
    }

    .about__body {
      grid-column: 4 / -1;
    }
  }
</style>
