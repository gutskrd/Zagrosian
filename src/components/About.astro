---
import SplitText from './SplitText.astro';
import { hevalo, site } from '../site';
---

<section id="about" class="about section" aria-labelledby="about-title">
  <div class="container about__grid">
    <p class="eyebrow" data-reveal>About</p>

    <div class="about__body" data-reveal>
      <SplitText
        id="about-title"
        class="about__statement"
        effect="highlight"
        text={"Millions of people speak Kurdish.\nFew of their apps do."}
      />
      <div class="about__text lead">
        <p>
          We build apps in Kurdish, for people who speak it, are learning it or want their children to grow up with
          it. {hevalo.name} is the first.
        </p>
        <p>
          The name comes from the Zagros, the mountains many Kurds call home.
          We&rsquo;re based in {site.country} and make everything ourselves.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--color-surface);
  }

  .about__grid {
    display: grid;
    gap: 1.25rem;
  }

  .about__statement {
    max-width: 17ch;
    font-size: var(--text-h2);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .about__text {
    display: grid;
    gap: 1.25rem;
    max-width: 36rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  @media (min-width: 64rem) {
    .about__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
    }

    .about__grid > .eyebrow {
      grid-column: 1 / span 3;
      padding-top: 0.6rem;
    }

    .about__body {
      grid-column: 4 / -1;
    }
  }
</style>
