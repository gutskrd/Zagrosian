---
import { i18n } from '../i18n';
import { hevalo, site } from '../site';
import SplitText from './SplitText.astro';

const { t } = i18n(Astro.url);
---

<section id="about" class="about section" aria-labelledby="about-title">
  <div class="container about__grid">
    <p class="eyebrow" data-reveal>{t.about.eyebrow}</p>

    <div class="about__body" data-reveal>
      <SplitText id="about-title" class="about__statement" effect="highlight" text={t.about.mission} />
      <p class="about__text lead">{t.about.approach}</p>

      <dl class="about__facts rule">
        <div>
          <dt>{t.about.headquartersLabel}</dt>
          <dd>
            {t.about.headquarters}
            <span
              class="about__time"
              data-local-time
              data-time-zone={site.timeZone}
              data-template={t.about.localTime}
              hidden></span>
          </dd>
        </div>
        <div>
          <dt>{t.about.productsLabel}</dt>
          <dd><a href={hevalo.url} lang="en" dir="ltr">{hevalo.name}</a></dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--color-surface);
  }

  .about__grid {
    display: grid;
    gap: 1.25rem;
  }

  .about__statement {
    max-width: 20ch;
    font-size: var(--text-h2);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .about__text {
    max-width: 36rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .about__facts {
    display: grid;
    gap: 1.25rem;
    margin: clamp(3rem, 2rem + 3vw, 5rem) 0 0;
    padding-top: 1.5rem;
    --rule-color: var(--color-line-strong);
    font-size: var(--text-sm);
  }

  .about__facts dt {
    color: var(--color-muted);
  }

  .about__facts dd {
    margin: 0.25rem 0 0;
  }

  /* The live local time, under the country. */
  .about__time {
    display: block;
    margin-top: 0.25rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .about__time::before {
    content: '';
    display: inline-block;
    width: 0.375rem;
    height: 0.375rem;
    margin-inline-end: 0.5rem;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
    vertical-align: 0.1em;
  }

  .about__time[hidden] {
    display: none;
  }

  .about__facts a {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    text-decoration-color: var(--color-underline);
    transition: text-decoration-color 0.2s ease;
  }

  .about__facts a:hover {
    text-decoration-color: currentColor;
  }

  @media (min-width: 48rem) {
    .about__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }

  @media (min-width: 64rem) {
    .about__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
    }

    .about__grid > .eyebrow {
      grid-column: 1 / span 3;
      padding-top: 0.6rem;
    }

    .about__body {
      grid-column: 4 / -1;
    }
  }
</style>
