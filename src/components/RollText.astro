---
/**
 * Label that rolls on hover: each letter slides up and out as its copy rises from below, in
 * sequence (styles: `.roll` in global.css).
 *
 * The label appears once as real, visually hidden text, so screen readers, search engines and
 * copy/paste get it exactly once. The visible letters are generated by CSS from `data-char`
 * attributes and are aria-hidden. Arabic script is cursive and splitting it would break the joins,
 * so Arabic, Persian and Sorani labels roll word by word.
 *
 * Each word is its own one-line mask with real spaces between words, so long labels wrap between
 * words like normal text and the waiting copies stay hidden. (A single mask showed the first line's
 * copies over the second line when wrapped.) `data-i` numbers the pieces across the whole label,
 * for the stagger order.
 */
interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;

const joined = /[؀-ۿݐ-ݿࢠ-ࣿﭐ-﷿ﹰ-﻿]/.test(text);
let count = 0;
const words = text
  .split(/\s+/)
  .filter(Boolean)
  .map((word) =>
    (joined ? [word] : [...new Intl.Segmenter(undefined, { granularity: 'grapheme' }).segment(word)].map((s) => s.segment)).map(
      (piece) => ({ piece, i: count++ }),
    ),
  );
// Split letters are separate boxes, which an RTL page would lay out right to left ("Hevalo" as
// "olaveH"), so split labels are forced LTR.
const dir = joined ? undefined : 'ltr';
---

<span class:list={['roll', className]} dir={dir}
  ><span class="visually-hidden">{text}</span><span class="roll__track" aria-hidden="true"
    >{
      words.map((pieces, index) => (
        <>
          {index > 0 && ' '}
          <span class="roll__word">
            {pieces.map(({ piece, i }) => (
              <span class="roll__piece" data-char={piece} data-i={i} />
            ))}
          </span>
        </>
      ))
    }</span
  ></span
>
