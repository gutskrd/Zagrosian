---
/** Homepage, in the URL's locale (src/pages/index.astro and src/pages/[lang]/index.astro). */
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/home/About.astro';
import Contact from '../components/home/Contact.astro';
import Faq from '../components/home/Faq.astro';
import Hero from '../components/home/Hero.astro';
import ProductShowcase from '../components/home/ProductShowcase.astro';
import Proverb from '../components/home/Proverb.astro';
import Story from '../components/home/Story.astro';
import Underneath from '../components/home/Underneath.astro';
import shading from '../assets/brand/lifted-logo-shading.webp?url';
import shadowLight from '../assets/brand/lifted-logo-shadow-light.webp?url';
import shadowDark from '../assets/brand/lifted-logo-shadow-dark.webp?url';
---

<BaseLayout>
  {
    /* The hero logo's soft shading and shadow are CSS backgrounds, found only
       once the stylesheet is read; fetched at once instead, they are there
       when the logo first appears (theme-init.js waits a moment for them). */
  }
  <Fragment slot="head">
    <link rel="preload" as="image" href={shading} />
    <link rel="preload" as="image" href={shadowLight} media="(prefers-color-scheme: light)" />
    <link rel="preload" as="image" href={shadowDark} media="(prefers-color-scheme: dark)" />
  </Fragment>
  {/* Order: who we are, then the story, Hevalo and the studio; then the rug with the paper plane
     underneath, and the sheet it unfolds into. */}
  <Hero />
  <Story />
  <ProductShowcase />
  <About />
  <Underneath />
  <Proverb />
  <Faq />
  <Contact />
</BaseLayout>
