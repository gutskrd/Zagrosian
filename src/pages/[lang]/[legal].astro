---
import type { GetStaticPaths } from 'astro';
import LegalPage from '../../components/LegalPage.astro';
import { documentSlugs, prefixedLocales } from '../../i18n';

export const getStaticPaths = (() =>
  prefixedLocales.flatMap((lang) => documentSlugs.map((legal) => ({ params: { lang, legal }, props: { slug: legal } })))) satisfies GetStaticPaths;

const { slug } = Astro.props;
---

<LegalPage slug={slug} />
