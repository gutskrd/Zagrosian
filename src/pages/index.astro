---
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Hero from '../components/Hero.astro';
import Principles from '../components/Principles.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { hevalo, site } from '../site';

const home = `${site.url}/`;

// WebSite gives Google the site name; Organization gives it the logo and company details.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      name: site.name,
      url: home,
      publisher: { '@id': `${home}#organization` },
      inLanguage: 'en',
    },
    {
      '@type': 'Organization',
      '@id': `${home}#organization`,
      name: site.name,
      url: home,
      logo: {
        '@type': 'ImageObject',
        url: `${site.url}/logo.png`,
        width: 512,
        height: 512,
      },
      description: site.description,
      email: site.contactEmail,
      address: { '@type': 'PostalAddress', addressCountry: 'NL' },
      brand: site.products.map((product) => ({
        '@type': 'Brand',
        name: product.name,
        url: product.url,
      })),
    },
  ],
};
---

<BaseLayout>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />

  <Hero />
  <ProductShowcase product={hevalo} />
  <Principles />
  <About />
  <Contact email={site.contactEmail} />
</BaseLayout>
