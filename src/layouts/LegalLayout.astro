---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { format, formatMinutes, i18n } from '../i18n';
import { site } from '../site';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'legal'>;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const { title, description, eyebrow, updated } = entry.data;
const { locale, info, t, base } = i18n(Astro.url);

const dateOptions = { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' } as const;
const localDate = new Intl.DateTimeFormat(info.intl, dateOptions);
// Where the language's calendar is not the Gregorian one (Persian uses the
// Solar Hijri calendar), the Gregorian date of the English original follows in
// brackets: "۷ مهر ۱۴۰۵ (۲۹ سپتامبر ۲۰۲۶)".
const gregorian =
  localDate.resolvedOptions().calendar === 'gregory'
    ? ''
    : ` (${new Intl.DateTimeFormat(`${info.intl}-u-ca-gregory`, dateOptions).format(updated)})`;
const updatedLabel = localDate.format(updated) + gregorian;

const sections = headings.filter((heading) => heading.depth === 2);

// The title is sized so its longest word fits a phone screen: long compounds
// such as "Datenschutzerklärung" step the size down (see .legal__title--*).
const longestWord = Math.max(...title.split(/\s+/).map((word) => [...word].length));
const fit = longestWord <= 15 ? undefined : longestWord <= 17 ? 'md' : 'sm';
const isTranslation = locale !== 'en';

// About 200 words a minute, the usual estimate for reading on screen.
const words = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));
const readingTime = format(t.legal.readingTime, { duration: formatMinutes(locale, minutes, t.legal.readingTimeUnit) });
---

<BaseLayout
  title={`${title} — ${site.name}`}
  description={description}
  breadcrumb={title}
  dateModified={updated.toISOString().slice(0, 10)}
>
  <div class="reading-progress" aria-hidden="true" data-reading-progress><span></span></div>

  <article
    class="legal"
    aria-labelledby="legal-title"
    data-legal
    data-copy-link={t.legal.copyLink}
    data-link-copied={t.legal.linkCopied}
  >
    <header class="container legal__header">
      <p class="eyebrow">{eyebrow ?? t.legal.eyebrow}</p>
      <h1 id="legal-title" class:list={['legal__title', fit && `legal__title--${fit}`]}>{title}</h1>
      <div class="legal__meta">
        <p class="legal__updated">
          {t.legal.updated} <time datetime={updated.toISOString().slice(0, 10)}>{updatedLabel}</time>
          <span class="legal__separator" aria-hidden="true">·</span>
          <span class="legal__reading">{readingTime}</span>
        </p>
        <button class="legal__print" type="button" data-print>
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="M5.5 7.5V3.25h9V7.5M5.5 14H3.25V7.5h13.5V14H14.5M5.5 11.5h9v5.25h-9z" />
          </svg>
          {t.legal.print}
        </button>
      </div>
      {
        isTranslation && (
          <p class="legal__notice">
            {t.legal.translationNotice}{' '}
            <a href={base} hreflang="en">
              {t.legal.readEnglish}
            </a>
          </p>
        )
      }
    </header>

    <div class="container legal__grid">
      {
        sections.length > 0 && (
          <nav class="legal__toc" aria-label={t.legal.contents}>
            <details class="legal__toc-details" data-toc>
              <summary class="legal__toc-title">{t.legal.contents}</summary>
              <ol>
                {sections.map((section) => (
                  <li>
                    <a href={`#${section.slug}`}>{section.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          </nav>
        )
      }

      <div class="legal__content" data-legal-content>
        <slot />
      </div>
    </div>
    <p class="visually-hidden" role="status" data-legal-status></p>
  </article>
</BaseLayout>

<style>
  /* A hairline under the header that fills as you read. Without JavaScript it stays empty. */
  .reading-progress {
    position: fixed;
    top: var(--header-height);
    right: 0;
    left: 0;
    z-index: 40;
    height: 2px;
    pointer-events: none;
  }

  .reading-progress span {
    display: block;
    height: 100%;
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: var(--start);
  }

  /* Where the browser can, it fills the bar itself, in step with the scroll;
     elsewhere (and with reduced motion) motion.ts does it with a script.
     Written as separate properties: the build's minifier would otherwise fold
     the timeline into the `animation` shorthand, which browsers do not accept. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .reading-progress span {
        animation-name: reading-progress;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
      }
    }
  }

  @keyframes reading-progress {
    to {
      transform: scaleX(1);
    }
  }

  .legal {
    padding-block: clamp(4.5rem, 2.5rem + 7vw, 8rem) var(--section-space);
  }

  .legal__header {
    container-type: inline-size;
  }

  .legal__title {
    margin-top: 1.25rem;
    font-size: var(--text-h2);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .legal__title--md {
    font-size: min(var(--text-h2), 10.5cqi);
  }

  .legal__title--sm {
    font-size: min(var(--text-h2), 9.2cqi);
  }

  .legal__notice {
    max-width: 42rem;
    margin-top: 1.25rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  /* The padding enlarges the tap area to 24px without moving the text. */
  .legal__notice a {
    padding-block: 0.1875rem;
    color: var(--color-ink);
    text-decoration-color: var(--color-underline);
  }

  .legal__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
  }

  .legal__updated {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .legal__separator {
    margin-inline: 0.5rem;
  }

  /* On a narrow screen the reading time moves to the next line whole. */
  .legal__reading {
    white-space: nowrap;
  }

  /* Shown only where the script can run, and from the first paint, so it
     never shifts the page. */
  .legal__print {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: none;
    color: var(--color-ink-soft);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  :global(:root[data-theme]) .legal__print {
    display: inline-flex;
  }

  @media (hover: hover) {
    .legal__print:hover {
      border-color: var(--color-line-strong);
      color: var(--color-ink);
    }
  }

  .legal__print svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  /* Copy-link buttons beside section headings (added by src/scripts/site.ts).
     When the script can run (the theme script has set data-theme), headings
     keep room for the button at their end from the first paint, so adding it
     never moves the text. */
  :global(:root[data-theme]) .legal__content :global(h2) {
    position: relative;
    padding-inline-end: 2.5rem;
  }

  .legal__content :global(.heading-link) {
    position: absolute;
    /* The heading's top padding, then centred on its first line. */
    inset-block-start: calc(2rem + 0.25em);
    inset-inline-end: 0;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    border-radius: 0.5rem;
    background: none;
    color: var(--color-muted);
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.2s ease,
      color 0.2s ease;
  }

  .legal__content :global(h2:hover .heading-link),
  .legal__content :global(.heading-link:focus-visible),
  .legal__content :global(.heading-link[data-copied]) {
    opacity: 1;
  }

  /* Without a mouse to hover with, the buttons are always visible. */
  @media (hover: none) {
    .legal__content :global(.heading-link) {
      opacity: 1;
    }
  }

  .legal__content :global(.heading-link:hover) {
    color: var(--color-ink);
  }

  .legal__content :global(.heading-link svg) {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .legal__content :global(.heading-link[data-copied]) {
    color: var(--color-ink);
  }

  .legal__grid {
    display: grid;
    gap: 3rem;
    margin-top: clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  /* Table of contents */

  .legal__toc {
    border-block: 1px solid var(--color-line);
    font-size: var(--text-sm);
  }

  .legal__toc-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.25rem;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }

  .legal__toc-title::-webkit-details-marker {
    display: none;
  }

  /* A plus that turns into a minus when open. */
  .legal__toc-title::after {
    content: '';
    width: 0.75rem;
    height: 0.75rem;
    background:
      linear-gradient(currentColor, currentColor) center / 100% 1.5px no-repeat,
      linear-gradient(currentColor, currentColor) center / 1.5px 100% no-repeat;
  }

  .legal__toc-details[open] .legal__toc-title::after {
    background: linear-gradient(currentColor, currentColor) center / 100% 1.5px no-repeat;
  }

  /* On small screens, where the list is collapsible, it opens and closes smoothly. */
  @media (max-width: 63.99rem) and (prefers-reduced-motion: no-preference) {
    .legal__toc-details::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 0.4s var(--ease-out),
        content-visibility 0.4s allow-discrete;
    }

    .legal__toc-details[open]::details-content {
      block-size: auto;
    }
  }

  .legal__toc ol {
    display: grid;
    padding-bottom: 1rem;
  }

  .legal__toc a {
    display: block;
    padding-block: 0.3rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .legal__toc a[aria-current] {
    color: var(--color-ink);
    font-weight: 500;
  }

  .legal__toc a:hover {
    color: var(--color-ink);
  }

  /* Long-form text */

  .legal__content {
    max-width: 42rem;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-ink-soft);
  }

  .legal__content > :global(p:first-child) {
    font-size: var(--text-lead);
    line-height: 1.55;
    letter-spacing: -0.011em;
    color: var(--color-ink);
  }

  .legal__content :global(h2) {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--color-ink);
  }

  .legal__content :global(h3) {
    margin-top: 2.25rem;
    font-size: 1.125rem;
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }

  .legal__content :global(:is(p, ul, ol)) {
    margin-top: 1.125rem;
  }

  .legal__content :global(:is(h2, h3) + :is(p, ul, ol)) {
    margin-top: 1rem;
  }

  .legal__content :global(ul) {
    padding-inline-start: 1.25rem;
    list-style: disc;
  }

  .legal__content :global(ol) {
    padding-inline-start: 1.25rem;
    list-style: decimal;
  }

  .legal__content :global(li) {
    padding-inline-start: 0.25rem;
  }

  .legal__content :global(li + li) {
    margin-top: 0.5rem;
  }

  .legal__content :global(li::marker) {
    color: var(--color-muted);
  }

  .legal__content :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }

  .legal__content :global(a) {
    color: var(--color-ink);
    text-decoration-color: var(--color-underline);
    transition: text-decoration-color 0.2s ease;
  }

  .legal__content :global(a:hover) {
    text-decoration-color: currentColor;
  }

  .legal__content :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 0.25rem;
    background: var(--color-surface);
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.875em;
    color: var(--color-ink);
  }

  @media (min-width: 64rem) {
    .legal__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      align-items: start;
    }

    .legal__toc {
      grid-column: 1 / span 3;
      position: sticky;
      top: calc(var(--header-height) + 2rem);
      border: 0;
    }

    .legal__toc-title {
      min-height: auto;
      margin-bottom: 0.75rem;
      pointer-events: none;
    }

    .legal__toc-title::after {
      display: none;
    }

    .legal__content {
      grid-column: 5 / span 7;
    }

    .legal__content :global(h2:first-child) {
      margin-top: 0;
    }
  }
</style>
