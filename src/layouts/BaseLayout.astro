---
import interLatin from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';
import vazirmatnArabic from '@fontsource-variable/vazirmatn/files/vazirmatn-arabic-wght-normal.woff2?url';
import themeInit from '../scripts/theme-init.js?url';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import CommandMenu from '../components/CommandMenu.astro';
import LanguageSuggestion from '../components/LanguageSuggestion.astro';
import SoundPrompt from '../components/SoundPrompt.astro';
import { defaultLocale, i18n, localizePath, locales } from '../i18n';
import { structuredData, toJsonLd } from '../lib/structured-data';
import { site } from '../site';
import '../styles/global.css';

interface Props {
  /** Full document title. Defaults to the site title in the page's language. */
  title?: string;
  description?: string;
  /** Keep error pages out of search results. */
  noindex?: boolean;
  /** The page's name in breadcrumbs, for pages below the homepage. */
  breadcrumb?: string;
  /** Date of the last material change (YYYY-MM-DD). */
  dateModified?: string;
}

const { locale, info, t, base } = i18n(Astro.url);
const { title = t.meta.title, description = t.meta.description, noindex = false, breadcrumb, dateModified } = Astro.props;

const absolute = (path: string) => new URL(path, site.url).href;
// Pages build to /name.html, but are served (and should be linked) as /name.
const path = localizePath(locale, base);
const canonical = absolute(path);
// Every page except the 404 page exists in every language.
const alternates = noindex
  ? []
  : [
      ...locales.map(({ code }) => ({ hreflang: code, href: absolute(localizePath(code, base)) })),
      { hreflang: 'x-default', href: absolute(base) },
    ];
const ogImage = absolute(locale === defaultLocale ? '/og.png' : `/og/${locale}.png`);
// Every indexable page also has a Markdown version: /index.md, /de/index.md, /de/privacy.md.
const markdown = base === '/' ? `${path === '/' ? '' : path}/index.md` : `${path}.md`;
const jsonLd = noindex
  ? undefined
  : toJsonLd(
      structuredData({
        url: canonical,
        title,
        description,
        locale,
        home: { name: t.nav.home, url: absolute(localizePath(locale, '/')) },
        breadcrumb,
        dateModified,
      }),
    );
---

<!doctype html>
<html lang={locale} dir={info.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src={themeInit}></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    {!noindex && <link rel="alternate" type="text/markdown" href={markdown} title="Markdown" />}

    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon-96-dark.png" type="image/png" sizes="96x96" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={info.ogLocale} />
    {
      locales
        .filter(({ code }) => code !== locale)
        .map(({ ogLocale }) => <meta property="og:locale:alternate" content={ogLocale} />)
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${t.meta.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    {
      // Arabic-script pages (Arabic, Sorani, Persian) need Vazirmatn from the
      // first paint; loading it late would reflow headings as the font swaps in.
      info.dir === 'rtl' && <link rel="preload" href={vazirmatnArabic} as="font" type="font/woff2" crossorigin />
    }
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.common.skipToContent}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <LanguageSuggestion />
    <SoundPrompt />
    <CommandMenu />

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
