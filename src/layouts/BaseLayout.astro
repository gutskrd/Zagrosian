---
import interLatin from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';
import vazirmatnArabic from '@fontsource-variable/vazirmatn/files/vazirmatn-arabic-wght-normal.woff2?url';
import themeInit from '../scripts/theme-init.js?url';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import CommandMenu from '../components/layout/CommandMenu.astro';
import LanguageSuggestion from '../components/layout/LanguageSuggestion.astro';
import SoundPrompt from '../components/layout/SoundPrompt.astro';
import { defaultLocale, i18n, localizePath, locales } from '../i18n';
import { structuredData, toJsonLd } from '../lib/structured-data';
import { site } from '../site';
import '../styles/global.css';

interface Props {
  /** Full document title. Defaults to the localized site title. */
  title?: string;
  description?: string;
  /** Exclude from search (error pages). */
  noindex?: boolean;
  /** Breadcrumb label, for pages below the homepage. */
  breadcrumb?: string;
  /** Last material change (YYYY-MM-DD). */
  dateModified?: string;
  /** Page-specific social image; defaults to the localized site image (og.png, og/<locale>.png). */
  image?: { url: string; type: string; width: number; height: number; alt: string };
  /** Extra schema.org nodes for this page, and the @id of its main entity. */
  nodes?: Record<string, unknown>[];
  mainEntity?: string;
}

const { locale, info, t, base } = i18n(Astro.url);
const { title = t.meta.title, description = t.meta.description, noindex = false, breadcrumb, dateModified, image, nodes, mainEntity } = Astro.props;

const absolute = (path: string) => new URL(path, site.url).href;
// Pages build to /name.html but are served and linked as /name.
const path = localizePath(locale, base);
const canonical = absolute(path);
// Every page except 404 exists in every locale.
const alternates = noindex
  ? []
  : [
      ...locales.map(({ code }) => ({ hreflang: code, href: absolute(localizePath(code, base)) })),
      { hreflang: 'x-default', href: absolute(base) },
    ];
const ogImage = absolute(image?.url ?? (locale === defaultLocale ? '/og.png' : `/og/${locale}.png`));
const ogSize = { width: image?.width ?? 1200, height: image?.height ?? 630 };
const ogAlt = image?.alt ?? `${site.name}: ${t.meta.tagline}`;
// Every indexable page has a Markdown version: /index.md, /de/index.md, /de/privacy.md.
const markdown = base === '/' ? `${path === '/' ? '' : path}/index.md` : `${path}.md`;
const jsonLd = noindex
  ? undefined
  : toJsonLd(
      structuredData({
        url: canonical,
        title,
        description,
        locale,
        home: { name: t.nav.home, url: absolute(localizePath(locale, '/')) },
        breadcrumb,
        dateModified,
        nodes,
        mainEntity,
      }),
    );
---

<!doctype html>
<html lang={locale} dir={info.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src={themeInit}></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          {/* Allow large image previews and full snippets. */}
          <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        </>
      )
    }
    {alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    {!noindex && <link rel="alternate" type="text/markdown" href={markdown} title="Markdown" />}

    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    {/* Favicon that matches the browser theme: black on light, white on dark. The SVG contains both
       and switches via prefers-color-scheme; browsers without SVG favicons get the matching PNG,
       and the oldest the ICO (black only). The ICO is declared as 32x32 only: declaring 16x16 makes
       Chrome prefer it over the SVG as an exact match, showing the black logo on dark tab strips. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon-96-dark.png" type="image/png" sizes="96x96" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Home screen label (the title is too long for it). */}
    <meta name="application-name" content={site.name} />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={info.ogLocale} />
    {
      locales
        .filter(({ code }) => code !== locale)
        .map(({ ogLocale }) => <meta property="og:locale:alternate" content={ogLocale} />)
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={image?.type ?? 'image/png'} />
    <meta property="og:image:width" content={String(ogSize.width)} />
    <meta property="og:image:height" content={String(ogSize.height)} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* X reads the rest from the og: tags, but not the image alt text. */}
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    {
      // Arabic-script pages (Arabic, Sorani, Persian) need Vazirmatn from first paint; loading it
      // late would reflow headings on swap.
      info.dir === 'rtl' && <link rel="preload" href={vazirmatnArabic} as="font" type="font/woff2" crossorigin />
    }
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.common.skipToContent}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <LanguageSuggestion />
    <SoundPrompt />
    <CommandMenu />

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
