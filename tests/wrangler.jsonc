// Serves the built site (dist/) for tests exactly as in production: with the
// headers from public/_headers (including the CSP) and the same URL handling as
// wrangler.jsonc, without rebuilding (run `npm run build` before `npm test`).
{
  "name": "zagrosian-tests",
  "compatibility_date": "2026-09-28",
  "main": "../worker/index.ts",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_astro/*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
