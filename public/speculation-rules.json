{
  "prerender": [
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/*.md" } },
          { "not": { "href_matches": "/*.txt" } },
          { "not": { "href_matches": "/*.xml" } }
        ]
      },
      "eagerness": "moderate"
    }
  ]
}
