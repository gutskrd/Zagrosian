  Content-Language: ku

/ku/*
  ! Content-Language
  Content-Language: ku

/ckb
  ! Content-Language
  Content-Language: ckb

/ckb/*
  ! Content-Language
  Content-Language: ckb

/nl
  ! Content-Language
