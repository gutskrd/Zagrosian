# Response headers for static assets (same format for Workers and Pages):
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# When multiple rules match, Cloudflare joins duplicate headers with a comma,
# which would corrupt policies like the CSP, so each security header is defined
# exactly once, in the /* rule.
#
# CSP: same-origin resources only, no inline code. Any third-party script
# (analytics, embeds, Cloudflare Web Analytics) must be allowlisted here.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-create=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Speculation-Rules: "/speculation-rules.json"
  Content-Language: en
  ! Access-Control-Allow-Origin

# Plain-text and XML files render in the browser's built-in viewers, which use
# inline styles the page CSP would block. They get a sandboxed policy instead:
# no scripts, viewer styling only.
/robots.txt
  ! Content-Security-Policy
  Content-Security-Policy: sandbox; default-src 'none'; style-src 'unsafe-inline'

/7c9302be7e61891041f0aa00b0435b84.txt
  ! Content-Security-Policy
  Content-Security-Policy: sandbox; default-src 'none'; style-src 'unsafe-inline'

/sitemap.xml
  ! Content-Security-Policy
  Content-Security-Policy: sandbox; default-src 'none'; style-src 'unsafe-inline'; img-src data:

/.well-known/security.txt
  ! Content-Security-Policy
  Content-Security-Policy: sandbox; default-src 'none'; style-src 'unsafe-inline'

# The SVG favicon switches between the black and white logo via an internal
# <style> (prefers-color-scheme). It contains no script.
/favicon.svg
  ! Content-Security-Policy
  Content-Security-Policy: sandbox; default-src 'none'; style-src 'unsafe-inline'

# Registration details for the footer (src/pages/registration.json.ts): shown
# to visitors, kept out of search. Also disallowed in robots.txt.
/registration.json
  ! Content-Security-Policy
  Content-Security-Policy: sandbox; default-src 'none'
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# Machine-readable versions (Markdown pages, llms.txt): noindex so search
# results show the HTML pages, while still readable by assistants and tools.
/*.md
  ! Content-Security-Policy
  Content-Security-Policy: sandbox; default-src 'none'; style-src 'unsafe-inline'
  X-Robots-Tag: noindex

/llms.txt
  ! Content-Security-Policy
  Content-Security-Policy: sandbox; default-src 'none'; style-src 'unsafe-inline'
  X-Robots-Tag: noindex

/llms-full.txt
  ! Content-Security-Policy
  Content-Security-Policy: sandbox; default-src 'none'; style-src 'unsafe-inline'
  X-Robots-Tag: noindex

# Content-Language per locale (English unless the path has a locale prefix),
# matching each page's lang attribute. Codes as in src/i18n/locales.ts.
/ku
