# Cloudflare response headers for the static assets (Workers and Pages use
# the same format).
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# Cloudflare joins a header with a comma when more than one matching rule sets
# it, which would corrupt policies such as the CSP. Each security header is
# therefore defined exactly once, in the /* rule.
#
# Content-Security-Policy: the site only loads its own files and runs no inline
# code. Adding a third-party script (analytics, embeds, Cloudflare Web
# Analytics) requires listing it here, or it will be blocked.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-create=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Speculation-Rules: "/speculation-rules.json"
  Content-Language: en
  ! Access-Control-Allow-Origin

# Plain-text and XML files: browsers display these with built-in viewers that
# use inline styles, which the page policy above would block. They get their
# own policy instead: sandboxed, no scripts, only the viewer's styling.
/robots.txt
  ! Content-Security-Policy
  Content-Security-Policy: sandbox; default-src 'none'; style-src 'unsafe-inline'

/sitemap.xml
  ! Content-Security-Policy
  Content-Security-Policy: sandbox; default-src 'none'; style-src 'unsafe-inline'; img-src data:

/.well-known/security.txt
  ! Content-Security-Policy
  Content-Security-Policy: sandbox; default-src 'none'; style-src 'unsafe-inline'

# The SVG favicon switches between the black and the white logo with the
# browser's colour scheme, through a <style> inside it. It holds no script.
/favicon.svg
  ! Content-Security-Policy
  Content-Security-Policy: sandbox; default-src 'none'; style-src 'unsafe-inline'

# Plain-text versions for machines: each page as Markdown and the llms.txt
# summary. Search results should show the HTML pages, so these are noindex;
# AI assistants and other tools can still read them.
/*.md
  ! Content-Security-Policy
  Content-Security-Policy: sandbox; default-src 'none'; style-src 'unsafe-inline'
  X-Robots-Tag: noindex

/llms.txt
  ! Content-Security-Policy
  Content-Security-Policy: sandbox; default-src 'none'; style-src 'unsafe-inline'
  X-Robots-Tag: noindex

/llms-full.txt
  ! Content-Security-Policy
  Content-Security-Policy: sandbox; default-src 'none'; style-src 'unsafe-inline'
  X-Robots-Tag: noindex

# The language of each page (English unless the address starts with another
# language), matching the lang attribute of its HTML. The same codes as
# src/i18n/locales.ts.
/ku
  ! Content-Language
  Content-Language: ku

/ku/*
  ! Content-Language
  Content-Language: ku

/ckb
  ! Content-Language
  Content-Language: ckb

/ckb/*
  ! Content-Language
  Content-Language: ckb

/nl
  ! Content-Language
  Content-Language: nl

/nl/*
  ! Content-Language
  Content-Language: nl

/de
  ! Content-Language
  Content-Language: de

/de/*
  ! Content-Language
  Content-Language: de

/es
  ! Content-Language
  Content-Language: es

/es/*
  ! Content-Language
  Content-Language: es

/fr
  ! Content-Language
  Content-Language: fr

/fr/*
  ! Content-Language
  Content-Language: fr

/tr
  ! Content-Language
  Content-Language: tr

/tr/*
  ! Content-Language
  Content-Language: tr

/ar
  ! Content-Language
  Content-Language: ar

/ar/*
  ! Content-Language
  Content-Language: ar

/fa
  ! Content-Language
  Content-Language: fa

/fa/*
  ! Content-Language
  Content-Language: fa

# Prerender same-site pages when a visitor hovers or taps a link, so they open
# instantly (Chrome and Edge). Sent as a header so no inline script is needed.
/speculation-rules.json
  ! Content-Type
  Content-Type: application/speculationrules+json

# Fingerprinted build assets never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Keep Cloudflare's own addresses out of search results, so Google only indexes
# zagrosian.com: the Worker's *.workers.dev address and its preview URLs.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
