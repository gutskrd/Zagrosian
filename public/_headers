/nl/*
  ! Content-Language
  Content-Language: nl

/de
  ! Content-Language
  Content-Language: de

/de/*
  ! Content-Language
  Content-Language: de

/es
  ! Content-Language
  Content-Language: es

/es/*
  ! Content-Language
  Content-Language: es

/fr
