/fa/*
  ! Content-Language
  Content-Language: fa

# Hevalo's book PDF: downloaded under its own filename (BookDownload.astro also
# sets `download`), noindex like the Markdown versions (the book page is what
# gets indexed), in Kurmanji and English. Served as application/octet-stream:
# browsers with a built-in PDF viewer (mobile Safari, Firefox, most iOS
# browsers) tend to open PDFs even when asked to save them. The .pdf extension
# still makes the OS open the saved file as a PDF.
/book/reya-kurmanci.pdf
  ! Content-Type
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="Reya-Kurmanci-Pirtuka-Hevalo.pdf"
  X-Robots-Tag: noindex
  ! Content-Language
  Content-Language: ku, en

# Prerender same-site pages on hover or tap so they open instantly (Chrome and
# Edge). Delivered as a header, so no inline script is needed.
/speculation-rules.json
  ! Content-Type
  Content-Type: application/speculationrules+json

# Content-hashed build assets are immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Keep Cloudflare's hostnames (*.workers.dev and preview URLs) out of search
# so only zagrosian.com is indexed.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
