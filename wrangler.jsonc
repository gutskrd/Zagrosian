// Cloudflare Workers config. The site is served as static assets from dist/,
// behind a small Worker (worker/index.ts) that redirects HTTP to HTTPS.
// `npx wrangler deploy` (the Workers Builds deploy command) builds the site and
// uploads both.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zagrosian",
  "compatibility_date": "2026-09-28",
  "main": "./worker/index.ts",
  // Workers Logs disabled: Cloudflare enables them by default for new Workers,
  // and they'd retain request details and location for days. The privacy policy
  // states the site keeps no server logs.
  "observability": { "enabled": false },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every request except fingerprinted build assets hits the Worker first, so
    // HTTP page requests are redirected to HTTPS.
    "run_worker_first": ["/*", "!/_astro/*"],
    // Pages are built as privacy.html etc. and linked as /privacy.
    "html_handling": "drop-trailing-slash",
    // Unknown URLs get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  }
}
