{
  "ci": {
    "collect": {
      "startServerCommand": "npx wrangler dev --config tests/wrangler.jsonc --port 8788 --ip 127.0.0.1",
      "startServerReadyPattern": "Ready on",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://127.0.0.1:8788/",
        "http://127.0.0.1:8788/privacy",
        "http://127.0.0.1:8788/de",
        "http://127.0.0.1:8788/ar",
        "http://127.0.0.1:8788/fa/security"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "categories:seo": ["error", { "minScore": 1, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
